{
  "_说明": [
    "aiwork 自己的关卡策略。关卡代码在 gate/，本文件在调用方检出里，由 workflow 用 AIWORK_POLICY_PATH 传入。",
    "check_name 为 aiwork-gate-shadow：只报不拦。转真拦截前不要把它设为必过。",
    "builders 只登记单一模型账号。多家模型共用的 aiwork-build[bot] 不登记，作者记成未知，要业主批准。",
    "judging_surface 罩住 workflow、关卡、规则，以及 CI 拉进来的公共框架文件。high 罩住 bin 里碰私钥、令牌、推送、发布的文件。两边都由 tests/test_aiwork_gate_workflow.mjs 从仓库推出。"
  ],
  "check_name": "aiwork-gate-shadow",
  "gate_app_id": 5121026,
  "owner": "SunJ1ayu",
  "builders": {
    "SunJ1ayuBoT": "anthropic"
  },
  "reviewer_bot": "aiwork-review[bot]",
  "merge_label": "aiwork:merge",
  "merge_requesters": [],
  "ci": {
    "workflow_path": ".github/workflows/ci.yml",
    "event": "pull_request"
  },
  "judging_surface": [
    ".github/**",
    ".aiwork/**",
    "gate/**",
    "REVIEW-RULES.md",
    "AGENTS.md",
    "CLAUDE.md",
    "workflow/**",
    "bin/rust-check-review-tooling",
    "bin/_panel-roster-lib.sh",
    "bin/_review_result.py",
    "tests/_no-egress.sh",
    "tests/_no_egress.py",
    "tests/_test_settings.py",
    "tests/_oracle_hash.sh",
    "templates/aiwork-gate.yml",
    "templates/aiwork-review-ping.yml"
  ],
  "high": [
    "bin/gh-app-token",
    "bin/aiwork-config",
    "bin/_aiwork_config.py",
    "bin/privacy-check",
    "bin/_secret-shapes",
    "bin/_secret_shapes.py",
    "bin/review-pr"
  ]
}
