{
  "_说明": [
    "aiwork 自己的关卡策略。关卡代码在 gate/，本文件在调用方检出里，由 workflow 用 AIWORK_POLICY_PATH 传入。",
    "check_name 怎么从 shadow 转为真拦截，见 gate/README.md「从 shadow 转为真拦截」。",
    "builders 只登记单一模型账号。多家模型共用的 aiwork-build[bot] 不登记，作者记成未知，要业主批准。",
    "判卷面和 high 怎么从仓库推出来，见 tests/test_aiwork_gate_workflow.mjs。"
  ],
  "check_name": "aiwork-gate",
  "gate_app_id": 5121026,
  "owner": "SunJ1ayu",
  "builders": {
    "SunJ1ayuBoT": "anthropic"
  },
  "reviewer_bot": "aiwork-review[bot]",
  "merge_label": "aiwork:merge",
  "merge_requesters": [],
  "ci": {
    "workflow_path": ".github/workflows/ci.yml",
    "event": "pull_request"
  },
  "judging_surface": [
    ".github/**",
    ".aiwork/**",
    "gate/**",
    "REVIEW-RULES.md",
    "AGENTS.md",
    "CLAUDE.md",
    "workflow/**",
    "bin/rust-check-review-tooling",
    "bin/aiwork-timeout",
    "bin/_review_result.py",
    "bin/_review-platform.sh",
    "bin/_python",
    "bin/_programs.sh",
    "tests/_*",
    "tests/test_aiwork_gate*.mjs",
    "tests/test-aiwork-gate.sh",
    "templates/aiwork-gate.yml",
    "templates/aiwork-review-ping.yml"
  ],
  "high_min_families": 2,
  "modification_rounds": {
    "summary_account": "SunJ1ayuBoT"
  },
  "high": [
    "bin/_aiwork_config.py",
    "bin/_cursor-stream.py",
    "bin/_kimi_preflight.py",
    "bin/_leg_session.py",
    "bin/_paths.py",
    "bin/_programs.sh",
    "bin/_python",
    "bin/_reader_tools.py",
    "bin/_review-home-guard.sh",
    "bin/_review-platform.sh",
    "bin/_review-reader-context.sh",
    "bin/_review-workspace.sh",
    "bin/_review_dispatch.mjs",
    "bin/_review_result.py",
    "bin/_secret-shapes",
    "bin/_secret_shapes.py",
    "bin/aiwork-config",
    "bin/aiwork-timeout",
    "bin/gh-app-token",
    "bin/privacy-check",
    "bin/review-pr",
    "bin/ro-repo-exec",
    "bin/subagent",
    "bin/subcodex",
    "bin/subcursor",
    "bin/subdeepseek-agent",
    "bin/subkimi",
    "bin/submimo",
    "kimi-review-home/config.toml",
    "kimi-review-home/hooks/guard.mjs"
  ],
  "review_dispatch": {
    "targets": {
      "documentation": 1,
      "code": 2,
      "high": 3
    },
    "documentation_paths": [
      "*.md",
      "**/*.md",
      "*.rst",
      "**/*.rst",
      "*.txt",
      "**/*.txt"
    ],
    "order": [
      "subdeepseek-agent",
      "subkimi",
      "subcursor",
      "subcodex",
      "submimo"
    ],
    "high_only": [
      "subkimi",
      "subcursor",
      "subcodex"
    ],
    "minimum_families": 1
  }
}
