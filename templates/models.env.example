# Copy to ~/.config/aiwork/models.env and replace each example with an available model ID.
# Model settings only: do not put credentials in this file.
codex=gpt-example
cursor=composer-example
deepseek=deepseek-example
kimi=kimi-code/example
# Required together with kimi; replace with the selected model's /models metadata.
# Lists are comma-separated without spaces; default_effort must be in support_efforts.
# The only example profile lives here; subkimi refuses missing/invalid parameters (78).
kimi_max_context_size=1048576
kimi_capabilities=thinking,always_thinking,image_in,video_in,tool_use
kimi_support_efforts=max
kimi_default_effort=max
kimi_thinking=true
mimo=mimo-example
