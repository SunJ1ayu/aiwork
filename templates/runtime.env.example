# Optional ~/.config/aiwork/runtime.env. These are custom examples, not defaults.
# Omit this file or any row to keep the code fallback. No migration is required.
# Available keys and direct/reader fallbacks: bin/aiwork-config runtime --help
# Nonempty environment overrides take precedence. Invalid file entries still fail.
# Timeouts (seconds) and turn caps: decimal positive integers, no leading zeros.
# Effort values: validated by aiwork-config; invalid values print the allowed set.
MIMO_TIMEOUT=7200
DEEPSEEK_MAX_TURNS=300
SUBCODEX_EFFORT=medium
