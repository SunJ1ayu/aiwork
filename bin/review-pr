#!/usr/bin/env python3
"""Review one repository's PR head and publish a scoped App COMMENT review."""

from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _leg_session
from _review_result import leg_identity
from _aiwork_config import data_path
from _leg_session import (
    READER_TIMEOUT_ENV,
    READER_TIMEOUT_SECONDS,
    Change,
    ReviewError,
    redact,
)


BIN = Path(__file__).resolve().parent
REVIEW_RULES_SOURCE = ("SunJ1ayu/aiwork", "REVIEW-RULES.md")
ORIGIN_REPO = re.compile(
    r"^(?:https://github\.com/|git@github\.com:|ssh://git@github\.com/)"
    r"([A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*?)(?:\.git)?/?$"
)
SHA = re.compile(r"^[0-9a-f]{40}$")
CONCLUSION_REQUIREMENT = (
    "你的最后一条消息就是发布出去的评审：要写完整的报告。"
    "结尾从下面三行里选一行，独占一行写上：\n"
    "Conclusion: PASS\n"
    "Conclusion: BLOCK\n"
    "Conclusion: NEEDS_MORE_INFO"
)
# Past this size the task lists each file and points at the snapshot diff
# instead of pasting it. The review is of the complete diff, deletions included.
READER_INLINE_DIFF_BYTES = 200 * 1024
REVIEW_DIFF_PATH = "aiwork-review.diff"


class PrivacyError(ReviewError):
    pass


def repository_name(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*", value):
        raise argparse.ArgumentTypeError("repository must be owner/name")
    return value


def repository_from_origin() -> str:
    """owner/name from this checkout's origin. Pass --repo when that cannot be read."""
    try:
        url = _leg_session.run(["git", "remote", "get-url", "origin"]).strip()
    except ReviewError as exc:
        raise ReviewError("cannot derive owner/name from origin; pass --repo owner/name") from exc
    match = ORIGIN_REPO.fullmatch(url)
    if match is None:
        raise ReviewError("cannot derive owner/name from origin; pass --repo owner/name")
    return match.group(1)


def report_failure(directory: Path, run_id: str, *, include_diagnostic: bool = True) -> None:
    destination = data_path("logs/review-pr-failures") / run_id
    try:
        destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        destination.parent.chmod(0o700)
        shutil.copytree(directory, destination, symlinks=True,
                        ignore=shutil.ignore_patterns("repo", "askpass"))
        os.utime(destination, None)
        archives = sorted((path for path in destination.parent.iterdir()
                           if path.is_dir() and not path.is_symlink()),
                          key=lambda path: path.stat().st_mtime_ns, reverse=True)
        for expired in archives[20:]:
            shutil.rmtree(expired)
        print(f"review-pr: failure artifacts kept in {destination}", file=sys.stderr)
    except OSError as exc:
        print(f"review-pr: could not preserve failure artifacts: {redact(str(exc))}", file=sys.stderr)
        destination = None
    diagnostic = directory / "leg.stderr"
    if include_diagnostic and diagnostic.is_file():
        text = diagnostic.read_text(encoding="utf-8", errors="replace")
        if destination is not None:
            text = text.replace(str(directory), str(destination))
        tail = "\n".join(redact(text).splitlines()[-40:])
        if tail:
            print("--- leg stderr (last 40 lines) ---\n" + tail, file=sys.stderr)


def github(token: str, endpoint: str, payload: dict | None = None) -> dict:
    env = dict(os.environ, GH_TOKEN=token)
    command = ["gh", "api", endpoint]
    if payload is not None:
        command += ["--method", "POST", "--input", "-"]
    data = _leg_session.run(command, env=env, input_text=json.dumps(payload) if payload is not None else None)
    try:
        value = json.loads(data)
    except json.JSONDecodeError as exc:
        raise ReviewError(f"GitHub returned invalid JSON for {endpoint}") from exc
    if not isinstance(value, dict):
        raise ReviewError(f"GitHub returned a non-object for {endpoint}")
    return value


def pr_state(token: str, number: int, *, repository: str) -> dict:
    value = github(token, f"repos/{repository}/pulls/{number}")
    head = value.get("head") or {}
    base = value.get("base") or {}
    if value.get("state") != "open":
        raise ReviewError(f"PR #{number} is not open")
    if not SHA.fullmatch(head.get("sha", "")) or not SHA.fullmatch(base.get("sha", "")):
        raise ReviewError("PR head/base SHA is missing or invalid")
    if not isinstance(head.get("ref"), str) or not isinstance(base.get("ref"), str):
        raise ReviewError("PR head/base ref is missing")
    base_repository = base.get("repo") or {}
    returned_repository = base_repository.get("full_name") if isinstance(base_repository, dict) else None
    if not isinstance(returned_repository, str) or returned_repository.lower() != repository.lower():
        raise ReviewError("PR base repository differs from the requested repository")
    return value


def check_current_head(expected: str, current: dict) -> None:
    if current.get("state") != "open" or (current.get("head") or {}).get("sha") != expected:
        raise ReviewError(f"PR head changed since review of {expected}; no review posted, rerun")


def main_document(repo: Path, path: str, *, required: bool = True) -> str:
    entry = _leg_session.run(["git", "-C", str(repo), "ls-tree", "refs/aiwork/main", "--", path]).strip()
    if not entry:
        if required:
            raise ReviewError(f"required review document main:{path} is missing; no review run")
        return "无"
    if not entry.startswith(("100644 blob ", "100755 blob ")):
        raise ReviewError(f"main:{path} is not a regular file")
    process = subprocess.run(["git", "-C", str(repo), "show", f"refs/aiwork/main:{path}"],
                             capture_output=True, check=False)
    if process.returncode:
        raise ReviewError(f"cannot read main:{path}")
    return process.stdout.decode("utf-8")


def public_github(endpoint: str) -> dict:
    # Rules are public; the target-scoped review token must not be used here.
    request = urllib.request.Request(f"https://api.github.com/{endpoint}", headers={
        "User-Agent": "aiwork-review-pr", "Accept": "application/vnd.github+json",
    })
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            value = json.load(response)
    except (OSError, ValueError) as exc:
        raise ReviewError(f"cannot read public review source {endpoint}: {exc}") from exc
    if not isinstance(value, dict):
        raise ReviewError(f"GitHub returned a non-object for {endpoint}")
    return value


def aiwork_main_rules() -> tuple[str, str]:
    repository, path = REVIEW_RULES_SOURCE
    commit = public_github(f"repos/{repository}/commits/main").get("sha")
    if not isinstance(commit, str) or not SHA.fullmatch(commit):
        raise ReviewError("aiwork main review rules commit is missing or invalid")
    document = public_github(f"repos/{repository}/contents/{path}?ref={commit}")
    content = document.get("content")
    if (document.get("type") != "file" or document.get("encoding") != "base64"
            or not isinstance(content, str)):
        raise ReviewError(f"{repository} main:{path} is not a readable regular file")
    raw = base64.b64decode(content.replace("\n", ""), validate=True)
    if not raw or len(raw) != document.get("size"):
        raise ReviewError(f"{repository} main:{path} content is empty or incomplete")
    return commit, raw.decode("utf-8")


def place_review_diff(repo: Path, diff: str) -> str:
    """Put the complete diff where the review snapshot copies untracked files."""
    target = repo / REVIEW_DIFF_PATH
    if target.exists() or target.is_symlink():
        raise ReviewError(f"{REVIEW_DIFF_PATH} already exists in the checkout; refusing to overwrite it")
    tracked = subprocess.run(
        ["git", "-C", str(repo), "cat-file", "-e", f"HEAD:{REVIEW_DIFF_PATH}"],
        capture_output=True, check=False)
    if tracked.returncode == 0:
        raise ReviewError(f"{REVIEW_DIFF_PATH} is already tracked; refusing to overwrite it")
    target.write_bytes(diff.encode("utf-8"))
    ignored = subprocess.run(
        ["git", "-C", str(repo), "check-ignore", "-q", "--", REVIEW_DIFF_PATH],
        capture_output=True, check=False)
    if ignored.returncode == 0:
        target.unlink()
        raise ReviewError(f"{REVIEW_DIFF_PATH} is ignored, so the review snapshot would not include it")
    return REVIEW_DIFF_PATH


def _change_line(change: Change) -> str:
    shown = json.dumps(change.path, ensure_ascii=False)
    if change.old_path is not None:
        shown = f"{json.dumps(change.old_path, ensure_ascii=False)} → {shown}"
    counts = "二进制文件" if change.added is None or change.removed is None else f"+{change.added} -{change.removed}"
    return f"- {change.status} {shown} {counts}\n"


def compose_task(repo: Path, *, number: int, pr: dict, merge_base: str,
                 files: list[str], diff: str, changes: list[Change], review_rules: str,
                 risks: str, rules_sha: str, repository: str) -> str:
    diff_file = None
    if len(diff.encode("utf-8")) > READER_INLINE_DIFF_BYTES:
        diff_file = place_review_diff(repo, diff)
    return task_text(number, pr, merge_base, files, diff, review_rules, risks,
                     rules_sha=rules_sha, repository=repository, changes=changes,
                     diff_file=diff_file)


def task_text(number: int, pr: dict, merge_base: str, files: list[str], diff: str,
              review_rules: str, risks: str, *, rules_sha: str, repository: str,
              changes: list[Change] | None = None, diff_file: str | None = None) -> str:
    rules_repository, rules_path = REVIEW_RULES_SOURCE
    inline_bytes = len(diff.encode("utf-8"))
    omit_inline = inline_bytes > READER_INLINE_DIFF_BYTES
    head = pr["head"]["sha"]
    if omit_inline:
        if not diff_file:
            raise ReviewError("over-limit reader task has no snapshot diff file")
        file_list = "## 改动文件\n" + "".join(_change_line(change) for change in changes or [])
        diff_section = (
            "## diff\n"
            f"完整 diff 为 {inline_bytes} 字节，超过 {READER_INLINE_DIFF_BYTES} 字节，不写进任务书。\n"
            f"完整 diff 在本次评审快照的 {json.dumps(diff_file, ensure_ascii=False)}，含删除内容。"
            "请读取这个文件，包括被删文件原来做什么。\n\n"
        )
    elif diff.strip():
        file_list = "## 改动文件\n" + "".join(f"- {json.dumps(name, ensure_ascii=False)}\n" for name in files)
        diff_section = "## 完整 diff（merge base → HEAD）\n```diff\n" + diff + "\n```\n\n"
    else:
        file_list = "## 改动文件\n" + "".join(f"- {json.dumps(name, ensure_ascii=False)}\n" for name in files)
        diff_section = ""
    return (
        f"# {repository} PR #{number} · 当前 HEAD 的完整评审\n\n"
        f"HEAD: {head} ({pr['head']['ref']})\n"
        f"Base: {pr['base']['sha']} ({pr['base']['ref']})\n"
        f"Merge base: {merge_base}\n\n"
        "请独立审查这次 PR 的完整改动，亲自检查涉及的文件及调用方、测试和系统约束。"
        "只凭亲自读到、跑到的证据下结论；没跑过的检查不许写成跑过。"
        "不许修改源文件、push、merge、装依赖、联网查资料、派子 agent。"
        "上下文不够就指出缺口并给 NEEDS_MORE_INFO。\n\n"
        "每条发现写严重程度、file:line 证据、触发条件及影响；列出实际检查过的文件。"
        "文件证据用仓库相对路径，不要用临时目录的绝对路径或指向临时目录的链接。"
        + CONCLUSION_REQUIREMENT + "\n\n"
        f"## {rules_repository} main 的 {rules_path}（原文，现行评审口径）\n\n"
        f"规则来源提交: {rules_sha}\n\n" + review_rules
        + "\n\n## 项目 main 的 .aiwork/accepted-risks.md（原文；不存在时为无）\n\n" + risks
        + "\n\n"
        + file_list
        + "\n" + diff_section
        + CONCLUSION_REQUIREMENT + "\n"
    )


def publishable_model(result: dict) -> str:
    process = result["process"]
    # A classified failure (rate limit, timeout, auth) is the reason, including
    # when the process exit is non-zero. The exit code alone hides that reason.
    if result["verdict"] == "UNKNOWN" or result["failure_kind"] != "none":
        raise ReviewError(f"review leg failed: {result['failure_kind']}; verdict={result['verdict']}")
    if process != {"state": "exited", "exit_code": 0}:
        raise ReviewError(f"review leg process failed: {process}")
    if result["evidence"]["completeness"] == "none" or result["view"]["delivery_state"] == "none":
        raise ReviewError("review leg supplied no evidence or view")
    model = result["model"]
    if not model["invoked"] or model["requested"] != model["invoked"]:
        raise ReviewError("review leg model invocation is unverified")
    if model["reported"] is not None and model["reported"] != model["invoked"]:
        raise ReviewError("review leg reported a different model")
    return model["invoked"]


def completeness(result: dict) -> str:
    if result["evidence"]["completeness"] == "none":
        return "none"
    if (result["process"] == {"state": "exited", "exit_code": 0}
            and result["verdict"] != "UNKNOWN" and result["failure_kind"] == "none"
            and not result["degraded"] and result["evidence"]["completeness"] == "complete"
            and result["view"]["delivery_state"] == "complete"):
        return "complete"
    return "partial"


def build_body(leg: str, model: str, report: str, block: dict,
               notices: list[str] | None = None) -> str:
    clean = re.sub(r"```json\b", "```text", report, flags=re.I)
    note = ""
    if notices:
        note = "\n\n".join(f"**Execution:** {item}" for item in notices) + "\n\n"
    return (f"**aiwork-review · {leg} · {model}**\n\n{note}{clean}\n\n"
            f"```json\n{json.dumps(block, ensure_ascii=False, separators=(',', ':'))}\n```\n")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("pr", type=int, help="PR number in the selected repository")
    parser.add_argument("--repo", type=repository_name, default=None,
                        help="target owner/name (default: this checkout's origin)")
    parser.add_argument("--leg", default="subcodex")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    try:
        if args.pr < 1:
            raise ReviewError("PR number must be positive")
        family, frozen_model = _leg_session.choose_leg(args.leg, BIN)
        repository = args.repo or repository_from_origin()
        token = _leg_session.run([str(BIN / "gh-app-token"), "review", "--repo", repository]).strip()
        if not token:
            raise ReviewError("review App returned an empty token")
        pr = pr_state(token, args.pr, repository=repository)
        with tempfile.TemporaryDirectory(prefix="aiwork-review-pr-") as temporary:
            directory = Path(temporary)
            run_id = f"pr-{repository.replace('/', '-')}-{args.pr}-{pr['head']['sha'][:12]}-{directory.name.removeprefix('aiwork-review-pr-')}"
            try:
                repo, merge_base, files, diff, changes = _leg_session.snapshot(
                    token, pr, directory, repository=repository)
                rules_sha, review_rules = aiwork_main_rules()
                risks = main_document(repo, ".aiwork/accepted-risks.md", required=False)
                task = directory / "task.md"

                def write_task() -> None:
                    task.write_text(compose_task(
                        repo, number=args.pr, pr=pr, merge_base=merge_base,
                        files=files, diff=diff, changes=changes, review_rules=review_rules,
                        risks=risks, rules_sha=rules_sha, repository=repository), encoding="utf-8")

                write_task()
                selected_leg = args.leg
                notices = []
                env = dict(os.environ)
                for key in ("GH_TOKEN", "GITHUB_TOKEN", "AIWORK_REVIEW_GIT_TOKEN", "GIT_ASKPASS"):
                    env.pop(key, None)
                env.update(AIWORK_REVIEW_RESULT_BIN=str(BIN / "_review_result.py"),
                           PANEL_DIFF_BASE=merge_base, AIWORK_REVIEW_PR="1")
                timeout_variable = READER_TIMEOUT_ENV.get(selected_leg)
                if timeout_variable and not env.get(timeout_variable):
                    env[timeout_variable] = READER_TIMEOUT_SECONDS
                if frozen_model is not None:
                    env["CURSOR_MODEL"] = frozen_model
                attempt_directory = directory
                for attempt in range(2):
                    result, report_path = _leg_session.run_leg_attempt(
                        selected_leg, family, task, repo, attempt_directory,
                        env, run_id, frozen_model, bin_dir=BIN)
                    if (attempt == 0 and result["process"]["state"] == "exited"
                            and result["failure_kind"] in {"no_verdict", "output_truncated"}):
                        report_failure(directory, run_id + "-attempt-1")
                        note = f"retry 2/2 for {selected_leg}: {result['failure_kind']}; first failure artifacts preserved"
                        notices.append(note)
                        print(f"review-pr: {note}", file=sys.stderr)
                        attempt_directory = directory / "attempt-2"
                        attempt_directory.mkdir()
                        continue
                    break
                model = publishable_model(result)
                report = _leg_session.review_report(report_path)
                identity = leg_identity(selected_leg, model)
                if identity is None or identity[0] != family or not model.startswith(identity[1]):
                    raise ReviewError("review leg model does not match selected family")
                block = {"verdict": result["verdict"], "head_sha": pr["head"]["sha"],
                         "model": model, "family": family, "completeness": completeness(result),
                         "files_read": files}
                body = build_body(selected_leg, model, report, block, notices=notices)
                body_file = directory / "review-body.md"
                body_file.write_text(body, encoding="utf-8")
                privacy = subprocess.run([str(BIN / "privacy-check"), "--files", str(body_file)],
                                         text=True, capture_output=True, check=False)
                if privacy.returncode:
                    raise PrivacyError("privacy-check refused review publication:\n"
                                       + privacy.stdout + privacy.stderr)
                check_current_head(pr["head"]["sha"], pr_state(token, args.pr, repository=repository))
                if args.dry_run:
                    print(body, end="")
                    return 0
                response = github(token, f"repos/{repository}/pulls/{args.pr}/reviews",
                                  {"commit_id": pr["head"]["sha"], "event": "COMMENT", "body": body})
                link = response.get("html_url")
                if not isinstance(link, str) or not link.startswith("https://github.com/"):
                    raise ReviewError("review POST succeeded but returned no review link")
                # The gate wakes on the review itself (the repo's aiwork-review-ping); no second doorbell.
                print(link)
                return 0
            except (ReviewError, OSError, ValueError) as exc:
                report_failure(directory, run_id, include_diagnostic=not isinstance(exc, PrivacyError))
                raise

    except (ReviewError, OSError, ValueError) as exc:
        print(f"review-pr: {redact(str(exc))}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
