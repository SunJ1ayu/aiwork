sys.path.insert(0, str(Path(__file__).resolve().parent))
import _leg_session
import _review_ci
from _review_dispatch import DispatchStopped, StopReason, dispatch
from _review_result import ADAPTER_IDENTITIES, leg_identity, sha256_bytes
from _aiwork_config import (
    check_app_role, ConfigError, check_programs, data_dir, data_path, prune_data, program,
)
from _leg_session import (
    Change,
    ReviewError,
    SHA,
    redact,
)


BIN = Path(__file__).resolve().parent
REVIEW_RULES_SOURCE = ("SunJ1ayu/aiwork", "REVIEW-RULES.md")
ORIGIN_REPO = re.compile(
    r"^(?:https://github\.com/|git@github\.com:|ssh://git@github\.com/)"
    r"([A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*?)(?:\.git)?/?$"
)
CONCLUSION_REQUIREMENT = (
    "你的最后一条消息就是发布出去的评审：要写完整的报告。"
    "结尾从下面三行里选一行，独占一行写上：\n"
    "Conclusion: PASS\n"
    "Conclusion: BLOCK\n"
    "Conclusion: NEEDS_MORE_INFO"
)
# Past this size the task lists each file and points at the snapshot diff
# instead of pasting it. The review is of the complete diff, deletions included.
READER_INLINE_DIFF_BYTES = 200 * 1024
REVIEW_DIFF_PATH = "aiwork-review.diff"


class UnsentWriteError(ReviewError):
    """Transport proved that the target request was not sent."""


class PrivacyError(ReviewError):
    pass


def repository_name(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*", value):
        raise argparse.ArgumentTypeError("repository must be owner/name")
    return value


def saved_run_id(value: str) -> str:
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]*', value):
        raise argparse.ArgumentTypeError('must name one saved run, not an empty value or a path')
    return value


def drop_inherited_git_env() -> None:
    """Drop git settings inherited from the caller. This process sets its own."""
    for key in list(os.environ):
        if key.startswith("GIT_"):
            os.environ.pop(key, None)


def require_latest_aiwork_main(main_sha: str) -> None:
    """Refuse unless the checkout containing this script is clean and at main_sha.

    main_sha is the aiwork main commit already read for this run. The checkout
    is BIN's parent. It is not the repository named by --repo, and it is not cwd.
    """
    sentence = "review-pr 只能从最新 main 的 aiwork 检出跑"
    checkout = BIN.parent
    top = _leg_session.run(["git", "-C", str(BIN), "rev-parse", "--show-toplevel"]).strip()
    if Path(top).resolve() != checkout.resolve():
        raise ReviewError(f"{sentence}\ngit 认出的仓库根目录不是 review-pr 所在的检出")
    status = _leg_session.run(
        ["git", "-C", str(BIN), "status", "--porcelain", "--untracked-files=all"])
    if status.strip():
        raise ReviewError(f"{sentence}\n有未提交的改动")
    head = _leg_session.run(["git", "-C", str(BIN), "rev-parse", "HEAD"]).strip()
    if head != main_sha:
        raise ReviewError(
            f"{sentence}\nHEAD 不是 aiwork 的最新 main\n"
            f"当前提交 {head}\nmain 的提交 {main_sha}")


def repository_from_origin() -> str:
    """owner/name from this checkout's origin. Pass --repo when that cannot be read."""
    try:
        url = _leg_session.run(["git", "remote", "get-url", "origin"]).strip()
    except ReviewError as exc:
        raise ReviewError("cannot derive owner/name from origin; pass --repo owner/name") from exc
    match = ORIGIN_REPO.fullmatch(url)
    if match is None:
        raise ReviewError("cannot derive owner/name from origin; pass --repo owner/name")
    return match.group(1)


def report_failure(directory: Path, run_id: str, *, include_diagnostic: bool = True) -> None:
    destination = None
    try:
        root = data_path("review-failures")
    except ConfigError:
        print("review-pr: 失败记录没能写进数据目录", file=sys.stderr)
    else:
        destination = root / run_id
        try:
            destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            destination.parent.chmod(0o700)
            shutil.copytree(directory, destination, symlinks=True,
                            ignore=shutil.ignore_patterns("repo", "askpass"))
            print(f"review-pr: failure artifacts kept in {destination}", file=sys.stderr)
            record_file = destination / "publication.json"
            if record_file.is_file():
                try:
                    record = json.loads(record_file.read_text(encoding="utf-8"))
                    print_retry_command(run_id, record)
                except (OSError, ValueError, KeyError, TypeError):
                    print('review-pr: 保存的发布记录不可读，不能重发', file=sys.stderr)
        except OSError as exc:
            print(f"review-pr: could not preserve failure artifacts: {redact(str(exc))}", file=sys.stderr)
            destination = None
    diagnostic = directory / "leg.stderr"
    if include_diagnostic and diagnostic.is_file():
        text = diagnostic.read_text(encoding="utf-8", errors="replace")
        if destination is not None:
            text = text.replace(str(directory), str(destination))
        tail = "\n".join(redact(text).splitlines()[-40:])
        if tail:
            print("--- leg stderr (last 40 lines) ---\n" + tail, file=sys.stderr)


def github(token: str, endpoint: str, payload: dict | None = None, *,
           raw: bool = False, timeout: float | None = None, method: str = "POST",
           retry_reads: bool = True) -> dict | str:
    if payload is None:
        env = dict(os.environ, GH_TOKEN=token)
        command = ["gh", "api", endpoint]
        if timeout is not None:
            command = [str(BIN / "aiwork-timeout"), "-k", "1", str(timeout), *command]
        def request():
            return _leg_session.run(command, env=env)
        data = _leg_session.network_read(request) if retry_reads else request()
    else:
        data = github_write(token, endpoint, payload, method=method, timeout=timeout or 30)
    if raw:
        return data
    try:
        value = json.loads(data)
    except json.JSONDecodeError as exc:
        raise ReviewError(f"GitHub returned invalid JSON for {endpoint}") from exc
    if not isinstance(value, dict):
        raise ReviewError(f"GitHub returned a non-object for {endpoint}")
    return value


def github_write(token: str, endpoint: str, payload: dict, *, method: str, timeout: float) -> str:
    """One direct HTTPS write, with an explicit boundary before any HTTP bytes.

    http.client neither follows redirects nor replays a request. Connection/TLS
    failures before request() are provably unsent; every later error is uncertain.
    Authentication stays in memory, not argv, files or diagnostics.
    """
    connection = http.client.HTTPSConnection('api.github.com', timeout=timeout)
    try:
        try:
            connection.connect()
        except (OSError, http.client.HTTPException) as exc:
            raise UnsentWriteError('GitHub connection failed before sending request: ' + redact(str(exc))) from exc
        try:
            connection.request(method, '/' + endpoint, body=json.dumps(payload).encode('utf-8'),
                headers={'Authorization': 'Bearer ' + token, 'Accept': 'application/vnd.github+json',
                         'Content-Type': 'application/json', 'User-Agent': 'aiwork-review-pr',
                         'X-GitHub-Api-Version': '2022-11-28'})
            response = connection.getresponse()
            data = response.read()
            if not 200 <= response.status < 300:
                raise ReviewError(f'GitHub write returned HTTP {response.status}; publication unconfirmed')
            return data.decode('utf-8')
        except (OSError, http.client.HTTPException, UnicodeError) as exc:
            raise ReviewError('GitHub write result unconfirmed: ' + redact(str(exc))) from exc
    finally:
        connection.close()


def review_token(repository: str) -> str:
    token = _leg_session.run([str(BIN / "gh-app-token"), "review", "--repo", repository]).strip()
    if not token:
        raise ReviewError("review App returned an empty token")
    return token


def pr_state(token: str, number: int, *, repository: str, preview: bool = False) -> dict:
    value = github(token, f"repos/{repository}/pulls/{number}")
    head = value.get("head") or {}
    base = value.get("base") or {}
    if value.get("state") != "open" and not (preview and value.get("state") == "closed"):
        raise ReviewError(f"PR #{number} is not open")
    if not SHA.fullmatch(head.get("sha", "")) or not SHA.fullmatch(base.get("sha", "")):
        raise ReviewError("PR head/base SHA is missing or invalid")
    if not isinstance(head.get("ref"), str) or not isinstance(base.get("ref"), str):
        raise ReviewError("PR head/base ref is missing")
    base_repository = base.get("repo") or {}
    returned_repository = base_repository.get("full_name") if isinstance(base_repository, dict) else None
    if not isinstance(returned_repository, str) or returned_repository.lower() != repository.lower():
        raise ReviewError("PR base repository differs from the requested repository")
    return value


def check_current_head(expected: str, current: dict) -> None:
    if current.get("state") != "open" or (current.get("head") or {}).get("sha") != expected:
        raise ReviewError(f"PR head changed since review of {expected}; no review posted, rerun")


def main_document(repo: Path, path: str, *, required: bool = True,
                  ref: str = "refs/aiwork/main") -> str:
    entry = _leg_session.run(["git", "-C", str(repo), "ls-tree", ref, "--", path]).strip()
    if not entry:
        if required:
            raise ReviewError(f"required review document main:{path} is missing; no review run")
        return "无"
    if not entry.startswith(("100644 blob ", "100755 blob ")):
        raise ReviewError(f"main:{path} is not a regular file")
    raw = _leg_session.run(
        ["git", "-C", str(repo), "show", f"{ref}:{path}"], binary=True)
    return raw.decode("utf-8")


def aiwork_main_commit() -> str:
    """The one commit this run treats as aiwork main. Rules are read at this commit."""
    repository, _path = REVIEW_RULES_SOURCE
    unread = "review-pr 只能从最新 main 的 aiwork 检出跑\n读不到 aiwork 的 main"
    try:
        output = _leg_session.network_read(lambda: _leg_session.run([
            "git", "-C", str(BIN), "ls-remote", "--exit-code", "--refs",
            f"https://github.com/{repository}.git", "refs/heads/main"]))
    except ReviewError as exc:
        raise ReviewError(f"{unread}\n{exc}") from exc
    fields = output.strip().split()
    if len(fields) != 2 or not SHA.fullmatch(fields[0]) or fields[1] != "refs/heads/main":
        raise ReviewError(f"{unread}\ngit ls-remote 没有返回有效的 refs/heads/main 提交")
    return fields[0]


def aiwork_main_rules(commit: str) -> tuple[str, str]:
    _repository, path = REVIEW_RULES_SOURCE
    rules = main_document(BIN.parent, path, ref=commit)
    if not rules:
        raise ReviewError(f"aiwork main:{path} content is empty")
    return commit, rules


def place_review_diff(repo: Path, diff: str) -> str:
    """Put the complete diff where the review snapshot copies untracked files."""
    target = repo / REVIEW_DIFF_PATH
    if target.exists() or target.is_symlink():
        raise ReviewError(f"{REVIEW_DIFF_PATH} already exists in the checkout; refusing to overwrite it")
    target.write_bytes(diff.encode("utf-8"))
    try:
        listed = _leg_session.run(
            ["git", "-C", str(repo), "ls-files", "-z", "--others", "--exclude-standard",
             "--", REVIEW_DIFF_PATH],
            binary=True)
    except ReviewError:
        target.unlink()
        raise
    if listed != REVIEW_DIFF_PATH.encode() + b"\0":
        target.unlink()
        raise ReviewError(
            f"{REVIEW_DIFF_PATH} is not an untracked, unignored file, so the review snapshot would not include it")
    return REVIEW_DIFF_PATH


def _change_line(change: Change) -> str:
    shown = json.dumps(change.path, ensure_ascii=False)
    if change.old_path is not None:
        shown = f"{json.dumps(change.old_path, ensure_ascii=False)} → {shown}"
    counts = "二进制文件" if change.added is None or change.removed is None else f"+{change.added} -{change.removed}"
    return f"- {change.status} {shown} {counts}\n"


def compose_task(repo: Path, *, number: int, pr: dict, merge_base: str,
                 files: list[str], diff: str, changes: list[Change], review_rules: str,
                 risks: str, rules_sha: str, repository: str, ci: str | None = None) -> str:
    diff_file = None
    if len(diff.encode("utf-8")) > READER_INLINE_DIFF_BYTES:
        diff_file = place_review_diff(repo, diff)
    return task_text(number, pr, merge_base, files, diff, review_rules, risks,
                     rules_sha=rules_sha, repository=repository, changes=changes,
                     diff_file=diff_file, ci=ci)


def task_text(number: int, pr: dict, merge_base: str, files: list[str], diff: str,
              review_rules: str, risks: str, *, rules_sha: str, repository: str,
              changes: list[Change] | None = None, diff_file: str | None = None,
              ci: str | None = None) -> str:
    rules_repository, rules_path = REVIEW_RULES_SOURCE
    inline_bytes = len(diff.encode("utf-8"))
    omit_inline = inline_bytes > READER_INLINE_DIFF_BYTES
    head = pr["head"]["sha"]
    if omit_inline:
        if not diff_file:
            raise ReviewError("over-limit reader task has no snapshot diff file")
        file_list = "## 改动文件\n" + "".join(_change_line(change) for change in changes or [])
        diff_section = (
            "## diff\n"
            f"完整 diff 为 {inline_bytes} 字节，超过 {READER_INLINE_DIFF_BYTES} 字节，不写进任务书。\n"
            f"完整 diff 在本次评审快照的 {json.dumps(diff_file, ensure_ascii=False)}，含删除内容。"
            "请读取这个文件，包括被删文件原来做什么。\n\n"
        )
    elif diff.strip():
        file_list = "## 改动文件\n" + "".join(f"- {json.dumps(name, ensure_ascii=False)}\n" for name in files)
        diff_section = "## 完整 diff（merge base → HEAD）\n```diff\n" + diff + "\n```\n\n"
    else:
        file_list = "## 改动文件\n" + "".join(f"- {json.dumps(name, ensure_ascii=False)}\n" for name in files)
        diff_section = ""
    return (
        f"# {repository} PR #{number} · 当前 HEAD 的完整评审\n\n"
        f"HEAD: {head} ({pr['head']['ref']})\n"
        f"Base: {pr['base']['sha']} ({pr['base']['ref']})\n"
        f"Merge base: {merge_base}\n\n"
        "请独立审查这次 PR 的完整改动，亲自检查涉及的文件及调用方、测试和系统约束。"
        "只凭亲自读到、跑到的证据下结论；没跑过的检查不许写成跑过。"
        "不许修改源文件、push、merge、装依赖、联网查资料、派子 agent。"
        "上下文不够就指出缺口并给 NEEDS_MORE_INFO。\n\n"
        "每条发现写严重程度、file:line 证据、触发条件及影响；列出实际检查过的文件。"
        "文件证据用仓库相对路径，不要用临时目录的绝对路径或指向临时目录的链接。"
        + CONCLUSION_REQUIREMENT + "\n\n"
        f"## {rules_repository} main 的 {rules_path}（原文，现行评审口径）\n\n"
        f"规则来源提交: {rules_sha}\n\n" + review_rules
        + "\n\n## 项目 main 的 .aiwork/accepted-risks.md（原文；不存在时为无）\n\n" + risks
        + "\n\n"
        + (ci if ci is not None else _review_ci.render(head, "未查询", {})) + "\n"
        + file_list
        + "\n" + diff_section
        + CONCLUSION_REQUIREMENT + "\n"
    )


def _differing(expected: tuple, actual: tuple, names: tuple[str, ...]) -> list[str]:
    return [name for name, left, right in zip(names, expected, actual, strict=True) if left != right]


def rebuild_retry_view(
    directory: Path, *, token: str, pr: dict, repository: str,
    merge_base: str, files: list[str], diff: str, changes: list[Change],
    task_bytes: bytes, number: int, review_rules: str, risks: str,
    rules_sha: str, ci: str | None,
) -> tuple[Path, Path, Path]:
    """New snapshot and task for a retry, checked against the values saved before the leg ran.

    The leg can write the snapshot and the task file it was given. Those are the
    files the next attempt would read, so the retry builds another view and
    compares it to the saved values instead of copying the used ones.
    """
    attempt_directory = directory / "attempt-2"
    attempt_directory.mkdir()
    repo, new_base, new_files, new_diff, new_changes = _leg_session.snapshot(
        token, pr, attempt_directory, repository=repository)
    mismatched = _differing(
        (merge_base, files, diff, changes),
        (new_base, new_files, new_diff, new_changes),
        ("merge_base", "files", "diff", "changes"))
    if mismatched:
        raise ReviewError(
            "rebuilt snapshot does not match the first attempt (" + ", ".join(mismatched) + ")")
    task = attempt_directory / "task.md"
    task.write_text(compose_task(
        repo, number=number, pr=pr, merge_base=merge_base, files=files, diff=diff,
        changes=changes, review_rules=review_rules, risks=risks, rules_sha=rules_sha,
        repository=repository, ci=ci), encoding="utf-8")
    if task.read_bytes() != task_bytes:
        raise ReviewError("rebuilt task does not match the first attempt")
    if len(diff.encode("utf-8")) > READER_INLINE_DIFF_BYTES:
        placed = repo / REVIEW_DIFF_PATH
        if not placed.is_file() or placed.is_symlink():
            raise ReviewError("rebuilt snapshot is missing the diff file")
        if placed.read_bytes() != diff.encode("utf-8"):
            raise ReviewError("rebuilt snapshot diff file does not match the first attempt")
    return task, repo, attempt_directory


def publishable_model(result: dict) -> str:
    process = result["process"]
    # A classified failure (rate limit, timeout, auth) is the reason, including
    # when the process exit is non-zero. The exit code alone hides that reason.
    if result["verdict"] == "UNKNOWN" or result["failure_kind"] != "none":
        raise ReviewError(f"review leg failed: {result['failure_kind']}; verdict={result['verdict']}")
    if process != {"state": "exited", "exit_code": 0}:
        raise ReviewError(f"review leg process failed: {process}")
    if result["evidence"]["completeness"] == "none" or result["view"]["delivery_state"] == "none":
        raise ReviewError("review leg supplied no evidence or view")
    model = result["model"]
    if not model["invoked"] or model["requested"] != model["invoked"]:
        raise ReviewError("review leg model invocation is unverified")
    if model["reported"] is not None and model["reported"] != model["invoked"]:
        raise ReviewError("review leg reported a different model")
    return model["invoked"]


def completeness(result: dict) -> str:
    if result["evidence"]["completeness"] == "none":
        return "none"
    if (result["process"] == {"state": "exited", "exit_code": 0}
            and result["verdict"] != "UNKNOWN" and result["failure_kind"] == "none"
            and not result["degraded"] and result["evidence"]["completeness"] == "complete"
            and result["view"]["delivery_state"] == "complete"):
        return "complete"
    return "partial"


def build_body(leg: str, model: str, report: str, block: dict,
               notices: list[str] | None = None) -> str:
    clean = re.sub(r"```json\b", "```text", report, flags=re.I)
    note = ""
    if notices:
        note = "\n\n".join(f"**Execution:** {item}" for item in notices) + "\n\n"
    return (f"**aiwork-review · {leg} · {model}**\n\n{note}{clean}\n\n"
            f"```json\n{json.dumps(block, ensure_ascii=False, separators=(',', ':'))}\n```\n")


def publication_body(body: str) -> str:
    # Equal reports from distinct model runs must not share a publication receipt.
    return body + f"\n<!-- aiwork-publication:{uuid.uuid4().hex} -->\n"


def poll_publication(reconcile):
    """Bound receipt reads, including empty results; never infer failure from absence."""
    for attempt in range(_leg_session.RETRY_ATTEMPTS):
        try:
            receipt = reconcile()
            if receipt is not None:
                return receipt
        except (ReviewError, OSError):
            pass
        if attempt < _leg_session.RETRY_ATTEMPTS - 1:
            time.sleep(_leg_session.retry_delay(attempt))
    return None


def write_publication(write, reconcile, *, before_write=lambda: None,
                      mark_attempt=lambda: None, clear_unsent=lambda: None):
    """Retry proven unsent writes only; ambiguous writes get receipt queries only."""
    for attempt in range(_leg_session.RETRY_ATTEMPTS):
        before_write()
        mark_attempt()
        try:
            return write()
        except UnsentWriteError:
            clear_unsent()
            if attempt == _leg_session.RETRY_ATTEMPTS - 1:
                raise
            time.sleep(_leg_session.retry_delay(attempt))
        except (ReviewError, OSError):
            receipt = poll_publication(reconcile)
            if receipt is not None:
                return receipt
            raise


def publication_attempt(directory: Path, *, unsent: bool = False) -> None:
    # Persist uncertainty before sending, including across --retry-publish recovery.
    marker = directory / 'publication-attempted'
    if unsent:
        marker.unlink()
    else:
        with marker.open('wb') as stream:
            stream.write(b'query receipt before any further write\n')
            stream.flush()
            os.fsync(stream.fileno())
    fd = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def publication_binding(record: dict) -> str:
    return sha256_bytes(json.dumps(record, sort_keys=True, ensure_ascii=False,
                                  separators=(',', ':')).encode('utf-8'))


def save_publication(directory: Path, *, body: str, repository: str,
                     number: int, leg: str, head: str) -> None:
    body_bytes = publication_body(body).encode('utf-8')
    record = {"version": 1, "repository": repository, "pr": number, "leg": leg,
              "head_sha": head, "body_sha256": sha256_bytes(body_bytes)}
    record["binding_sha256"] = publication_binding(record)
    (directory / "review-body.md").write_bytes(body_bytes)
    (directory / "publication.json").write_text(json.dumps(record) + '\n', encoding='utf-8')


def load_publication(directory: Path, *, repository: str, number: int, leg: str) -> tuple[dict, str]:
    record = json.loads((directory / "publication.json").read_text(encoding='utf-8'))
    keys = {'version', 'repository', 'pr', 'leg', 'head_sha', 'body_sha256', 'binding_sha256'}
    if not isinstance(record, dict) or set(record) != keys or record['version'] != 1:
        raise ReviewError('saved publication.json is invalid or unsupported; refusing publication')
    if record['repository'] != repository or type(record['pr']) is not int or record['pr'] != number:
        raise ReviewError('saved publication target differs from --repo/PR; refusing publication')
    if record['leg'] != leg:
        raise ReviewError('saved publication leg differs from --leg; refusing publication')
    binding = record.pop('binding_sha256')
    if (not isinstance(record['head_sha'], str) or not SHA.fullmatch(record['head_sha'])
            or publication_binding(record) != binding):
        raise ReviewError('saved publication binding mismatch; refusing publication')
    body = (directory / "review-body.md").read_bytes()
    if sha256_bytes(body) != record['body_sha256']:
        raise ReviewError('saved review body digest mismatch; refusing publication')
    return record, body.decode('utf-8')


def print_retry_command(run_id: str, record: dict) -> None:
    command = ['review-pr', str(record['pr']), '--repo', record['repository'],
               '--leg', record['leg'], '--retry-publish', run_id]
    print('review-pr: 发布恢复入口（不重新调用模型）: ' + shlex.join(command), file=sys.stderr)


@contextmanager
def publication_lock():
    # Serialize local publishers: two retries must not both pass the remote duplicate check.
    root = data_path('review-failures')
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(root, os.O_RDONLY)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def project_reviewer_bot(token: str, repository: str) -> str:
    response = github(token, f'repos/{repository}/contents/.aiwork/policy.json?ref=main')
    invalid = 'project main .aiwork/policy.json reviewer_bot is missing or invalid; refusing publication'
    content = response.get('content')
    if response.get('type') != 'file' or response.get('encoding') != 'base64' or not isinstance(content, str):
        raise ReviewError(invalid)
    try:
        policy = json.loads(base64.b64decode(''.join(content.split()), validate=True).decode('utf-8'))
    except ValueError as exc:
        raise ReviewError(invalid) from exc
    bot = policy.get('reviewer_bot') if isinstance(policy, dict) else None
    if not isinstance(bot, str) or not bot.endswith('[bot]'):
        raise ReviewError(invalid)
    return bot


def find_published_review(token: str, *, repository: str, number: int,
                          head: str, body: str, reviewer_bot: str) -> str | None:
    page = 1
    while True:
        raw = github(token, f'repos/{repository}/pulls/{number}/reviews?per_page=100&page={page}', raw=True,
                     timeout=30, retry_reads=False)
        reviews = json.loads(raw)
        if not isinstance(reviews, list) or any(not isinstance(item, dict) for item in reviews):
            raise ReviewError('cannot check existing reviews; refusing publication')
        for item in reviews:
            user = item.get('user')
            if (item.get('commit_id') == head and item.get('state') != 'PENDING'
                    and isinstance(user, dict) and user.get('type') == 'Bot'
                    and user.get('login') == reviewer_bot and item.get('body') == body):
                link = item.get('html_url')
                if not isinstance(link, str) or not link.startswith('https://github.com/'):
                    raise ReviewError('saved review already published but has no valid link; refusing duplicate publication')
                return link
        if len(reviews) < 100:
            return None
        page += 1


def publish_saved(directory: Path, *, repository: str, number: int, leg: str,
                  recover_published: bool = False) -> str:
    with publication_lock():
        record, body = load_publication(directory, repository=repository, number=number, leg=leg)
        privacy = subprocess.run([str(BIN / 'privacy-check'), '--files', str(directory / 'review-body.md')],
                                 text=True, capture_output=True, check=False)
        if privacy.returncode:
            raise PrivacyError('privacy-check refused review publication:\n' + privacy.stdout + privacy.stderr)
        token = _leg_session.network_read(lambda: review_token(repository))
        head = record['head_sha']

        def check_head():
            check_current_head(head, pr_state(token, number, repository=repository))

        bot = None
        def reconcile():
            nonlocal bot
            check_head()
            if bot is None:
                bot = project_reviewer_bot(token, repository)
            return find_published_review(token, repository=repository, number=number,
                                         head=head, body=body, reviewer_bot=bot)

        check_head()
        if (directory / 'publication-attempted').exists():
            existing = poll_publication(reconcile)
            if existing is not None:
                return existing
            raise ReviewError('previous publication is unconfirmed; refusing another POST')
        # Legacy archives predate the attempted marker. Preserve their receipt lookup.
        if recover_published:
            existing = reconcile()
            if existing is not None:
                return existing

        def write():
            response = github(token, f'repos/{repository}/pulls/{number}/reviews',
                              {'commit_id': head, 'event': 'COMMENT', 'body': body})
            link = response.get('html_url')
            if not isinstance(link, str) or not link.startswith('https://github.com/'):
                raise ReviewError('review POST succeeded but returned no review link')
            return link

        return write_publication(write, reconcile, before_write=check_head,
            mark_attempt=lambda: publication_attempt(directory),
            clear_unsent=lambda: publication_attempt(directory, unsent=True))


def read_dispatch_state(repository: str, number: int, builder_family: str) -> dict:
    token = review_token(repository)
    try:
        result = subprocess.run(
            [str(program('node')), str(BIN / '_review_dispatch.mjs')],
            input=json.dumps(dict(repository=repository, number=number, builder_family=builder_family)),
            env=dict(os.environ, GH_TOKEN=token), text=True, capture_output=True,
            timeout=300, check=False)
    except subprocess.TimeoutExpired as exc:
        raise ReviewError('dispatch facts query timed out') from exc
    if result.returncode:
        raise ReviewError('dispatch facts unavailable: ' + redact(result.stderr[-2000:]))
    return json.loads(result.stdout)


def review_request(repository: str, number: int, builder_family: str) -> dict:
    """Public handoff facts only; the dispatcher chooses the destination itself."""
    token = _leg_session.run([str(BIN / 'gh-app-token'), 'build', '--repo', repository]).strip()
    if not token:
        raise ReviewError('build App returned an empty token')
    pr = pr_state(token, number, repository=repository)
    head = pr['head']['sha']
    return dict(v=1, repository=repository, pr=number, head=head,
                builder_family=builder_family,
                argv=['review-pr', str(number), '--repo', repository, '--auto',
                      '--builder-family', builder_family, '--expected-head', head])


def public_dispatch_report(report):
    legs = set(ADAPTER_IDENTITIES) | {'subcursor'}
    public = {}
    for key in ('head', 'policy_sha'):
        value = report.get(key)
        if isinstance(value, str) and SHA.fullmatch(value):
            public[key] = value
    for key in ('draw', 'initial', 'reserve'):
        public[key] = [leg for leg in report.get(key, []) if isinstance(leg, str) and leg in legs]
    plan = report.get('plan', {})
    public['plan'] = {key: value for key in ('target', 'minimum')
                      if type(value := plan.get(key)) is int and value >= 0}
    if plan.get('tier') in ('documentation', 'code', 'high'):
        public['plan']['tier'] = plan['tier']
    stopped = report.get('stopped')
    if stopped:
        try:
            reason = StopReason(stopped)
        except (ValueError, TypeError):
            reason = StopReason.DISPATCH_ERROR
        public.update(stopped=reason.value, stop_reason=reason.description)
    public['attempts'] = []
    for attempt in report.get('attempts', []):
        if attempt.get('leg') not in legs:
            continue
        item = {'leg': attempt['leg']}
        if attempt.get('status') in ('running', 'finished') or attempt.get('started') is True:
            item['started'] = True
        if not stopped and type(attempt.get('confirmed')) is bool:
            item['confirmed'] = attempt['confirmed']
        public['attempts'].append(item)
    return public


def find_dispatch_comment(token, repository, number, body):
    bot = project_reviewer_bot(token, repository)
    page = 1
    while True:
        comments = json.loads(github(token,
            f'repos/{repository}/issues/{number}/comments?per_page=100&page={page}',
            raw=True, timeout=30, retry_reads=False))
        if not isinstance(comments, list) or any(not isinstance(item, dict) for item in comments):
            raise ReviewError('cannot check existing dispatch comments')
        for item in comments:
            user = item.get('user')
            identifier = item.get('id')
            if (isinstance(user, dict) and user.get('type') == 'Bot'
                    and user.get('login') == bot and item.get('body') == body
                    and type(identifier) is int and identifier > 0):
                return identifier
        if len(comments) < 100:
            return None
        page += 1


def publish_dispatch_comment(repository, number, body, comment_id=None, *, pending=None):
    if pending is None:
        pending = {}
    token = _leg_session.network_read(lambda: review_token(repository))
    # If creation previously lost its response, recover its ID before updating the
    # evolving report. A later report must not blindly create a second comment.
    if pending.get('body') is not None:
        comment_id = poll_publication(lambda: find_dispatch_comment(
            token, repository, number, pending['body']))
        if comment_id is None:
            raise ReviewError('dispatch comment creation remains unconfirmed; refusing another POST')
        pending.clear()
    body = publication_body(body)
    with tempfile.TemporaryDirectory(prefix='dispatch-record-') as temporary:
        path = Path(temporary) / 'body.md'
        path.write_text(body, encoding='utf-8')
        _leg_session.run([str(BIN / 'privacy-check'), '--files', str(path)])
    endpoint = (f'repos/{repository}/issues/{number}/comments' if comment_id is None
                else f'repos/{repository}/issues/comments/{comment_id}')

    def write():
        if comment_id is None:
            result = github(token, endpoint, {'body': body})
        else:
            result = github(token, endpoint, {'body': body}, method='PATCH')
        identifier = result.get('id')
        if type(identifier) is not int or identifier < 1 or (comment_id is not None and identifier != comment_id):
            raise ReviewError('dispatch comment response has no valid id')
        return identifier

    def reconcile():
        if comment_id is None:
            return find_dispatch_comment(token, repository, number, body)
        result = github(token, endpoint, timeout=30, retry_reads=False)
        bot = project_reviewer_bot(token, repository)
        user = result.get('user')
        if (result.get('id') == comment_id and result.get('body') == body
                and isinstance(user, dict) and user.get('login') == bot and user.get('type') == 'Bot'):
            return comment_id
        return None

    result = write_publication(write, reconcile,
        mark_attempt=lambda: pending.update(body=body) if comment_id is None else None,
        clear_unsent=pending.clear)
    pending.clear()
    return result


def publish_dispatch_record(repository, number, report, comment_id=None, *, pending=None):
    body = ('评审派发记录（合并条件以关卡为准）\n\n```json\n'
            + json.dumps(public_dispatch_report(report), ensure_ascii=False, indent=2) + '\n```')
    return publish_dispatch_comment(repository, number, body, comment_id, pending=pending)


def publish_dispatch_failure(repository, number, head, attempted, report=None, *, pending=None):
    if report is None:
        report = dict(head=head, stopped=StopReason.DISPATCH_ERROR.value,
                      attempts=[dict(leg=leg, started=True) for leg in attempted])
    body = ('评审派发状态通知；合并条件以关卡结论为准。仅列已知事实，不判断腿的失败原因。\n\n```json\n'
            + json.dumps(public_dispatch_report(report), ensure_ascii=False, indent=2) + '\n```')
    return publish_dispatch_comment(repository, number, body, pending=pending)


def record_dispatch_failure(repository, number, head, attempted, report=None, *, pending=None):
    try:
        publish_dispatch_failure(repository, number, head, attempted, report, pending=pending)
    except (ValueError, OSError):
        print('review-pr: failure notice could not be published; details remain local', file=sys.stderr)


def auto_dispatch(repository: str, number: int, builder_family: str, *,
                  expected_head: str | None = None) -> int:
    # Logs stay outside the repository and are not included in later legs' tasks.
    root = data_path('logs')
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    directory = Path(tempfile.mkdtemp(prefix=f'review-dispatch-{number}-', dir=root))
    attempts = []
    comment_id = None
    latest = {}
    pending_comment = {}

    def record(report):
        nonlocal comment_id, latest
        latest = report
        (directory / "summary.json").write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        try:
            comment_id = publish_dispatch_record(repository, number, report, comment_id, pending=pending_comment)
        except (ValueError, OSError) as exc:
            try:
                with (directory / 'record-errors.log').open('a', encoding='utf-8') as stream:
                    stream.write(redact(str(exc)) + '\n')
            except OSError:
                pass
            print('review-pr: public record unavailable; continuing dispatch', file=sys.stderr)
        finally:
            (directory / 'pending-comment.json').write_text(
                json.dumps(pending_comment, ensure_ascii=False) + '\n', encoding='utf-8')

    def run(leg, model, head):
        env = dict(os.environ)
        for key in ('GH_TOKEN', 'GITHUB_TOKEN', 'AIWORK_REVIEW_GIT_TOKEN', 'GIT_ASKPASS'):
            env.pop(key, None)
        if model is not None:
            env['CURSOR_MODEL'] = model
        print(f'review-pr: dispatch {leg} at {head[:12]}', file=sys.stderr, flush=True)
        attempts.append(leg)
        result = subprocess.run([str(BIN / 'review-pr'), str(number), '--repo', repository,
                                 '--leg', leg, '--expected-head', head],
                                env=env, text=True, capture_output=True, check=False)
        diagnostic = redact(result.stdout + result.stderr)
        (directory / f'{leg}.log').write_text(diagnostic, encoding='utf-8')
        if result.returncode:
            return dict(ok=False, reason=redact(result.stderr[-2000:]) or f'review-pr exited {result.returncode}')
        urls = [line for line in result.stdout.splitlines() if line.startswith('https://github.com/')]
        return dict(ok=bool(urls), **({'url': urls[-1]} if urls else
                    {'reason': 'review-pr returned no publication URL'}))

    def read_state(family):
        state = _leg_session.network_read(lambda: read_dispatch_state(repository, number, family))
        if expected_head and state["head"] != expected_head:
            raise DispatchStopped(StopReason.HEAD_CHANGED)
        return state

    try:
        report = dispatch(read_state,
                          lambda leg: _leg_session.choose_leg(leg, BIN), run, builder_family, record=record)
    except (ValueError, OSError) as exc:
        causes = []
        cause = exc
        while cause is not None:
            causes.append(str(cause))
            cause = cause.__cause__
        (directory / 'failure.txt').write_text(redact('\n'.join(causes)), encoding='utf-8')
        stopped = dict(latest, stopped=exc.reason if isinstance(exc, DispatchStopped) else StopReason.DISPATCH_ERROR.value)
        stopped.setdefault('head', expected_head)
        outcomes = {item['leg']: item for item in latest.get('attempts', [])}
        stopped['attempts'] = [dict(outcomes.get(leg, {}), leg=leg, started=True) for leg in attempts]
        record(stopped)
        record_dispatch_failure(repository, number, expected_head, attempts, stopped, pending=pending_comment)
        raise
    finally:
        print(f'review-pr: dispatch record {directory}', file=sys.stderr)
    (directory / 'summary.json').write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
    if not report['target_met'] or not report['reviewed_families']:
        record_dispatch_failure(repository, number, report['head'], attempts, report, pending=pending_comment)
    print(json.dumps(public_dispatch_report(report), ensure_ascii=False, indent=2))
    return 0 if report['minimum_met'] else 2


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[1])
    parser.add_argument("pr", type=int, help="PR number in the selected repository")
    parser.add_argument("--repo", type=repository_name, default=None,
                        help="target owner/name (default: this checkout's origin)")
    parser.add_argument("--leg", default=None)
    parser.add_argument("--request", action="store_true",
                        help="emit public handoff JSON for the dispatcher; never invoke a review")
    parser.add_argument('--auto', action='store_true', help='dispatch from project main policy')
    parser.add_argument('--builder-family', help='exclude the actual implementing family; does not change gate author attribution')
    parser.add_argument('--expected-head', help=argparse.SUPPRESS)
    parser.add_argument("--dry-run", action="store_true",
                        help="print the task only; allow previewing merged PRs; never run a leg or publish")
    parser.add_argument('--retry-publish', metavar='RUN_ID', type=saved_run_id,
                        help='publish saved review-failures/RUN_ID artifacts without running a model')
    args = parser.parse_args()
    try:
        drop_inherited_git_env()
        if args.request:
            if (args.auto or args.leg or args.dry_run or args.retry_publish or args.expected_head
                    or args.pr < 1 or not re.fullmatch(r'[a-z][a-z0-9-]*', args.builder_family or '')):
                raise ReviewError('--request requires PR and --builder-family, without review options')
            configured_family = os.environ.get('AIWORK_BUILDER_FAMILY')
            if configured_family is not None and configured_family != args.builder_family:
                raise ReviewError('--builder-family does not match AIWORK_BUILDER_FAMILY')
            print(json.dumps(review_request(args.repo or repository_from_origin(), args.pr,
                                            args.builder_family), ensure_ascii=False, indent=2))
            return 0
        check_app_role('review')
        if args.expected_head and not SHA.fullmatch(args.expected_head):
            raise ReviewError('--expected-head is not a commit SHA')
        if args.auto:
            if args.leg or args.dry_run or args.retry_publish:
                raise ReviewError('--auto cannot be combined with --leg/--dry-run/--retry-publish')
            if not re.fullmatch(r'[a-z][a-z0-9-]*', args.builder_family or ''):
                raise ReviewError('--auto requires --builder-family')
            if args.pr < 1:
                raise ReviewError('PR number must be positive')
            _leg_session.check_leg_platform('review-pr', BIN)
            data_dir()
            check_programs('review-pr')
            require_latest_aiwork_main(aiwork_main_commit())
            return auto_dispatch(args.repo or repository_from_origin(), args.pr, args.builder_family,
                                 expected_head=args.expected_head)
        if args.builder_family:
            raise ReviewError('--builder-family requires --auto')
        args.leg = args.leg or 'subcodex'
        if args.retry_publish and args.dry_run:
            raise ReviewError('--retry-publish cannot be combined with --dry-run')
        if not args.retry_publish:
            _leg_session.check_leg_platform(args.leg, BIN)
        data_dir()
        if not args.retry_publish:
            if _leg_session.enabled():
                _leg_session.query(BIN, 'check-programs', args.leg)
            else:
                check_programs(args.leg)
        main_sha = aiwork_main_commit()
        if not args.dry_run:
            require_latest_aiwork_main(main_sha)
        if args.pr < 1:
            raise ReviewError("PR number must be positive")
        if not args.dry_run and not args.retry_publish:
            family, frozen_model = _leg_session.choose_leg(args.leg, BIN)
        repository = args.repo or repository_from_origin()
        if args.retry_publish:
            directory = data_path('review-failures') / args.retry_publish
            print(publish_saved(directory, repository=repository, number=args.pr,
                                leg=args.leg, recover_published=True))
            return 0
        if not args.dry_run:
            prune_data()
        token = review_token(repository)
        pr = (pr_state(token, args.pr, repository=repository, preview=True) if args.dry_run
              else pr_state(token, args.pr, repository=repository))
        if args.expected_head and pr['head']['sha'] != args.expected_head:
            raise ReviewError('PR head changed before dispatch; no review run')
        with tempfile.TemporaryDirectory(prefix="aiwork-review-pr-") as temporary:
            directory = Path(temporary)
            run_id = f"pr-{repository.replace('/', '-')}-{args.pr}-{pr['head']['sha'][:12]}-{directory.name.removeprefix('aiwork-review-pr-')}"
            try:
                repo, merge_base, files, diff, changes = _leg_session.snapshot(
                    token, pr, directory, repository=repository)
                rules_sha, review_rules = aiwork_main_rules(main_sha)
                risks = main_document(repo, ".aiwork/accepted-risks.md", required=False)
                try:
                    target_main = _leg_session.run(["git", "-C", str(repo), "rev-parse", "refs/aiwork/main"]).strip()
                except ReviewError:
                    target_main = None
                try:
                    ci_policy = json.loads(main_document(repo, ".aiwork/policy.json", required=False))
                    ci = ci_policy.get("ci") if isinstance(ci_policy, dict) else None
                    if (not isinstance(ci, dict) or not all(isinstance(value, str) and value for value in (
                            ci.get("workflow_path"), ci.get("event"), ci_policy.get("check_name")))
                            or type(ci_policy.get("gate_app_id")) is not int or ci_policy["gate_app_id"] <= 0):
                        ci_policy = None
                except (ReviewError, ValueError, AttributeError):
                    ci_policy = None
                ci = _review_ci.context(
                    lambda endpoint, **kwargs: github(token, endpoint, **kwargs),
                    repository=repository, head=pr["head"]["sha"], main=target_main,
                    number=args.pr, policy=ci_policy)
                task = directory / "task.md"

                def write_task() -> None:
                    task.write_text(compose_task(
                        repo, number=args.pr, pr=pr, merge_base=merge_base,
                        files=files, diff=diff, changes=changes, review_rules=review_rules,
                        risks=risks, rules_sha=rules_sha, repository=repository, ci=ci), encoding="utf-8")

                write_task()
                if args.dry_run:
                    print(task.read_text(encoding="utf-8"), end="")
                    return 0
                selected_leg = args.leg
                notices = []
                env = dict(os.environ)
                for key in ("GH_TOKEN", "GITHUB_TOKEN", "AIWORK_REVIEW_GIT_TOKEN", "GIT_ASKPASS"):
                    env.pop(key, None)
                env.update(AIWORK_REVIEW_RESULT_BIN=str(BIN / "_review_result.py"),
                           PANEL_DIFF_BASE=merge_base, AIWORK_REVIEW_PR="1")
                env = _leg_session.reader_environment(selected_leg, env)
                if frozen_model is not None:
                    env["CURSOR_MODEL"] = frozen_model
                task_bytes = task.read_bytes()
                attempt_directory = directory
                for attempt in range(2):
                    result, report_path = _leg_session.run_leg_attempt(
                        selected_leg, family, task, repo, attempt_directory,
                        env, run_id, frozen_model, bin_dir=BIN)
                    if (attempt == 0 and result["process"]["state"] == "exited"
                            and result["failure_kind"] in {"no_verdict", "output_truncated"}):
                        report_failure(directory, run_id + "-attempt-1")
                        try:
                            token = review_token(repository)
                            task, repo, attempt_directory = rebuild_retry_view(
                                directory, token=token, pr=pr, repository=repository,
                                merge_base=merge_base, files=files, diff=diff, changes=changes,
                                task_bytes=task_bytes, number=args.pr, review_rules=review_rules,
                                risks=risks, rules_sha=rules_sha, ci=ci)
                        except (ReviewError, OSError) as exc:
                            raise ReviewError(
                                f"retry refused after {result['failure_kind']}: {exc}") from exc
                        note = f"retry 2/2 for {selected_leg}: {result['failure_kind']}; first failure artifacts preserved"
                        notices.append(note)
                        print(f"review-pr: {note}", file=sys.stderr)
                        continue
                    break
                model = publishable_model(result)
                report = _leg_session.review_report(report_path)
                identity = leg_identity(selected_leg, model)
                if identity is None or identity[0] != family or not model.startswith(identity[1]):
                    raise ReviewError("review leg model does not match selected family")
                block = {"verdict": result["verdict"], "head_sha": pr["head"]["sha"],
                         "model": model, "family": family, "completeness": completeness(result)}
                body = build_body(selected_leg, model, report, block, notices=notices)
                save_publication(directory, body=body, repository=repository, number=args.pr,
                                 leg=selected_leg, head=pr['head']['sha'])
                link = publish_saved(directory, repository=repository, number=args.pr, leg=selected_leg)
                # The gate wakes on the review itself (the repo's aiwork-review-ping); no second doorbell.
                print(link)
                return 0
            except (ReviewError, OSError, ValueError) as exc:
                report_failure(directory, run_id, include_diagnostic=not isinstance(exc, PrivacyError))
                raise

    except (ReviewError, OSError, ValueError) as exc:
        print(f"review-pr: {redact(str(exc))}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
