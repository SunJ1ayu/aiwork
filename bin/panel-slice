#!/usr/bin/env bash
set -uo pipefail

# panel-slice —— 单层多家族切片评审(track sliced-panel-review,2026-09-13)。
#
# 借 Grok Build「切片 → 专项 worker 并行审 → 对抗验证 → 汇总」的编排,worker 直接换成
# aiwork 的不同家族评审腿:**一个工作项 = 一次钉住单腿的 `panel-review --scoped-review`**,
# 腿里不再派子 agent。主 agent 是唯一调度者和仲裁者。
#
# 为什么每项都去调 panel-review,而不是在这里自己起腿:panel-review 身上背着一串事故换来的
# 保证(反锚定闸、任务字节冻结、腿在 setsid 会话里自己落终态、typed result、健康/冷却/dead、
# 花名册从盘上重建)。在这里再写一份就是「同一件事写两处、只更新一处」。本文件只管:
# 健康探针 → 分配(Python 核心)→ 占额度 → 起进程 → 并发上限 → 汇总。
#
# 所有「为什么这么判」都在 bin/_panel_slice.py;本文件不解释 verdict、不算覆盖。

BIN="$(cd "$(dirname "$0")" && pwd)"
TOOL_ROOT="$(cd "$BIN/.." && pwd -P)"
HELPER="$BIN/_panel_slice.py"

. "$BIN/_panel-roster-lib.sh" || {
  echo "panel-slice: 找不到 $BIN/_panel-roster-lib.sh —— 腿表在它里面,拒绝空跑。" >&2
  exit 70
}
[[ -f "$HELPER" ]] || { echo "panel-slice: 找不到 $HELPER,拒绝派发。" >&2; exit 70; }
[[ -f "$BIN/panel-review" ]] || { echo "panel-slice: 找不到 $BIN/panel-review,拒绝派发。" >&2; exit 70; }

usage() {
  cat >&2 <<'EOF'
Usage:
  panel-slice run [--require-my-review PATH | --no-my-review] MANIFEST [REPO_DIR] [RUN_DIR]
  panel-slice verify RUN_DIR VERIFY_MANIFEST
  panel-slice retry  RUN_DIR ITEM_ID [--leg LEG]
  panel-slice decide RUN_DIR FINDING_ID confirmed|rejected|accepted-risk|inconclusive --reason TEXT
  panel-slice status RUN_DIR [--json]

run      main agent's manifest: goal + 2..8 slices + overall leg + extra budget.
         Each slice goes to one healthy leg of a distinct model family; the overall
         leg (default subcodex = GPT) reviews the whole change independently and its
         family is not used by any slice. N slices => exactly N+1 leg sessions.
verify   record findings (append-only) and dispatch targeted checks; every checker
         comes from a family that did not raise the finding. Uses extra budget.
retry    re-dispatch one item (failed / no verdict / timeout ...). Uses extra budget.
         Earlier attempts stay on disk; a later PASS never hides an earlier BLOCK.
decide   the main agent's disposition of one finding, appended with a reason.
status   rebuilt from disk only. run_state clean|attention|incomplete is a fact
         summary, never a verdict.

Manifest (JSON; paths relative to the manifest file):
  {"version": 1, "goal": "goal.md",
   "slices": [{"id": "dispatch", "title": "...", "brief": "slice-dispatch.md", "leg": null}, ...],
   "overall": {"leg": "subcodex", "brief": "overall-extra.md", "show_slice_plan": true},
   "budget": {"extra_sessions": 2, "max_concurrency": null}}
Verify manifest:
  {"version": 1,
   "findings": [{"id": "F1", "source": "dispatch|overall|<check>|main", "severity": "high",
                 "claim": "...", "evidence": "bin/x:12 ..."}],
   "checks": [{"id": "c1", "findings": ["F1"], "leg": null, "note": "..."}]}

Scoped results carry review_contract_version=2: they NEVER count as archive coverage,
and panel-slice never binds a track. Refusals print `panel-slice: REFUSED <rule>: ...`
and exit 3 before any leg starts.

Env: PANEL_STATE_DIR / PANEL_HEALTH_OVERRIDE / PANEL_<LEG>_LEG as in panel-review;
     PANEL_STAGGER_MAX (default 2) between launches; PANEL_SLICE_ASSIGN_START fixes the
     rotation offset; PANEL_SLICE_RUN_ROOT (default <tool-root>/logs) for default RUN_DIR.
EOF
}

refuse() { echo "panel-slice: REFUSED $1: $2" >&2; exit 3; }

TMPD=""
cleanup() { [[ -z "$TMPD" ]] || rm -rf -- "$TMPD"; }
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

stagger() {
  local max="${PANEL_STAGGER_MAX:-2}"
  [[ "$max" == 0 || "$max" == 0.0 ]] && return 0
  sleep "$(awk -v m="$max" -v r="$RANDOM" 'BEGIN{printf "%.3f", (r/32768)*m}')"
}

write_legs_table() {  # write_legs_table <file> —— 腿表只从唯一源导出,Python 不另抄一份
  local spec
  : > "$1"
  for spec in "${PANEL_LEG_SPECS[@]}"; do printf 'pool|%s\n' "$spec" >> "$1"; done
  for spec in "${PANEL_ROLE_LEG_SPECS[@]}"; do printf 'role|%s\n' "$spec" >> "$1"; done
}

# 健康探针 = scoped + risk self(预算 0):panel-review 只写 plan、不派任何腿、不推游标。
# 健康/冷却/dead/override 的判定规则因此只有 panel-review 里那一份。
probe_health() {  # probe_health <repo> <dir>  -> <dir>/probe.plan
  local repo="$1" dir="$2"
  printf '# panel-slice health probe: no leg is dispatched\n' > "$dir/probe-task.md"
  if ! env -u PANEL_ORACLE_CMD PANEL_STAGGER_MAX=0 bash "$BIN/panel-review" --scoped-review --no-track \
      --no-my-review --risk self "$dir/probe-task.md" "$repo" "$dir/probe" >"$dir/probe.out" 2>&1 \
      || [[ ! -s "$dir/probe.plan" ]]; then
    sed 's/^/  | /' "$dir/probe.out" >&2
    refuse probe "panel-review health probe did not produce a plan"
  fi
}

MR_ARGS=()
ATTEMPTS=()
LAUNCH_REFUSED=0

launch() {  # launch <item> <attempt> <leg> <family> <task> <prefix> <category>
  local item="$1" n="$2" leg="$3" family="$4" task="$5" prefix="$6" category="$7" adir
  adir="$(dirname "$prefix")"
  # 占额度在起进程**之前**落盘:控制器随时会被砍,「花了一次」不能只活在内存里。
  python3 "$HELPER" reserve --run-dir "$RUN_DIR" --item "$item" --attempt "$n" \
    --leg "$leg" --family "$family" --category "$category" || return 3
  (
    # setsid:腿和它的控制器进自己的会话 ⇒ 本控制器被整组砍掉时,它们照样跑完、自己落终态。
    env -u PANEL_ORACLE_CMD PANEL_STAGGER_MAX=0 setsid --wait bash "$BIN/panel-review" \
      --scoped-review --no-track "${MR_ARGS[@]}" --risk standard --budget 1 --pin-leg "$leg" \
      "$task" "$REPO" "$prefix" >"$adir/controller.log" 2>&1
    rc=$?
    printf '%s\n' "$rc" > "$adir/controller.exit.tmp" && mv -f "$adir/controller.exit.tmp" "$adir/controller.exit"
  ) &
  return 0
}

dispatch() {  # dispatch <launch-file>
  local file="$1" kind item n leg family task prefix category conc=1 launched=0
  conc="$(awk -F'\t' '$1=="concurrency"{print $2; exit}' "$file")"
  [[ "$conc" =~ ^[1-9][0-9]*$ ]] || conc=1
  while IFS=$'\t' read -r kind item n leg family task prefix category; do
    [[ "$kind" == launch ]] || continue
    while (( $(jobs -rp | wc -l) >= conc )); do wait -n 2>/dev/null || true; done
    [[ "$launched" -eq 0 ]] || stagger
    if launch "$item" "$n" "$leg" "$family" "$task" "$prefix" "$category"; then
      ATTEMPTS+=(--attempt "$item#$n")
      launched=$((launched + 1))
      echo "  $item#$n -> $leg (family: $family) · $(dirname "$prefix")"
    else
      LAUNCH_REFUSED=1
    fi
  done < "$file"
  wait
}

finish() {  # finish —— 汇总 + 退出码
  echo
  python3 "$HELPER" status --run-dir "$RUN_DIR"
  echo "  status.md -> $RUN_DIR/status.md(重建:panel-slice status $RUN_DIR)"
  local rc=0
  if [[ ${#ATTEMPTS[@]} -gt 0 ]]; then
    python3 "$HELPER" run-rc --run-dir "$RUN_DIR" "${ATTEMPTS[@]}" || rc=1
  fi
  [[ "$LAUNCH_REFUSED" -eq 0 ]] || rc=3
  exit "$rc"
}

mr_args_from_plan() {
  local mr
  mr="$(python3 -c 'import json,sys; v=json.load(open(sys.argv[1]))["my_review"]; print(v or "")' "$RUN_DIR/plan.json")" \
    || refuse run-dir "cannot read plan.json in $RUN_DIR"
  if [[ -n "$mr" ]]; then MR_ARGS=(--require-my-review "$mr"); else MR_ARGS=(--no-my-review); fi
}

cmd_run() {
  local my_review="" no_my_review=0 pos=() manifest stem
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --require-my-review) my_review="${2:-}"; [[ -n "$my_review" ]] || refuse my-review "--require-my-review needs a path"; shift 2 ;;
      --no-my-review) no_my_review=1; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) usage; exit 2 ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  [[ ${#pos[@]} -ge 1 && ${#pos[@]} -le 3 ]] || { usage; exit 2; }
  manifest="${pos[0]}"
  [[ -f "$manifest" ]] || refuse manifest "manifest not found: $manifest"
  manifest="$(realpath "$manifest")"
  REPO="$(git -C "${pos[1]:-$PWD}" rev-parse --show-toplevel 2>/dev/null)" \
    || refuse repo "not a Git worktree: ${pos[1]:-$PWD}"
  REPO="$(realpath "$REPO")"
  stem="$(basename "${manifest%.*}")"
  RUN_DIR="${pos[2]:-${PANEL_SLICE_RUN_ROOT:-$TOOL_ROOT/logs}/slice-$stem-$(date +%Y%m%d-%H%M%S)}"
  RUN_DIR="$(realpath -m "$RUN_DIR")"
  if [[ "$no_my_review" -eq 1 ]]; then
    my_review=""; MR_ARGS=(--no-my-review)
  else
    [[ -n "$my_review" ]] || my_review="$TOOL_ROOT/tasks/$stem-my-review.md"
    MR_ARGS=(--require-my-review "$my_review")
  fi
  python3 "$HELPER" check --run-dir "$RUN_DIR" --manifest "$manifest" --repo "$REPO" --my-review "$my_review" || exit 3

  TMPD="$(mktemp -d)"
  write_legs_table "$TMPD/legs"
  probe_health "$REPO" "$TMPD"
  python3 "$HELPER" plan --run-dir "$RUN_DIR" --manifest "$manifest" --repo "$REPO" \
    --my-review "$my_review" --legs-table "$TMPD/legs" --probe-plan "$TMPD/probe.plan" \
    --assign-start "${PANEL_SLICE_ASSIGN_START:-$RANDOM}" \
    --run-id "slice-$(date -u +%Y%m%dT%H%M%SZ)-$$" > "$TMPD/launch" || exit 3

  echo "panel-slice run: manifest=$manifest repo=$REPO"
  echo "  run dir -> $RUN_DIR"
  echo "  scoped results (review_contract_version=2) never count as archive coverage"
  dispatch "$TMPD/launch"
  finish
}

cmd_verify() {
  [[ $# -eq 2 ]] || { usage; exit 2; }
  RUN_DIR="$(realpath -m "$1")"
  local manifest="$2"
  [[ -f "$manifest" ]] || refuse manifest "verify manifest not found: $manifest"
  REPO="$(python3 "$HELPER" repo-of --run-dir "$RUN_DIR")" || exit 3
  mr_args_from_plan
  TMPD="$(mktemp -d)"
  write_legs_table "$TMPD/legs"
  probe_health "$REPO" "$TMPD"
  python3 "$HELPER" verify --run-dir "$RUN_DIR" --manifest "$(realpath "$manifest")" \
    --legs-table "$TMPD/legs" --probe-plan "$TMPD/probe.plan" \
    --assign-start "${PANEL_SLICE_ASSIGN_START:-$RANDOM}" > "$TMPD/launch" || exit 3
  echo "panel-slice verify: run=$RUN_DIR"
  dispatch "$TMPD/launch"
  finish
}

cmd_retry() {
  local pos=() leg=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --leg) leg="${2:-}"; [[ -n "$leg" ]] || { usage; exit 2; }; shift 2 ;;
      -*) usage; exit 2 ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  [[ ${#pos[@]} -eq 2 ]] || { usage; exit 2; }
  RUN_DIR="$(realpath -m "${pos[0]}")"
  REPO="$(python3 "$HELPER" repo-of --run-dir "$RUN_DIR")" || exit 3
  mr_args_from_plan
  TMPD="$(mktemp -d)"
  write_legs_table "$TMPD/legs"
  probe_health "$REPO" "$TMPD"
  python3 "$HELPER" retry --run-dir "$RUN_DIR" --item "${pos[1]}" ${leg:+--leg "$leg"} \
    --legs-table "$TMPD/legs" --probe-plan "$TMPD/probe.plan" \
    --assign-start "${PANEL_SLICE_ASSIGN_START:-$RANDOM}" > "$TMPD/launch" || exit 3
  echo "panel-slice retry: run=$RUN_DIR item=${pos[1]}"
  dispatch "$TMPD/launch"
  finish
}

cmd_decide() {
  local pos=() reason=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reason) reason="${2:-}"; shift 2 ;;
      -*) usage; exit 2 ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  [[ ${#pos[@]} -eq 3 ]] || { usage; exit 2; }
  RUN_DIR="$(realpath -m "${pos[0]}")"
  python3 "$HELPER" decide --run-dir "$RUN_DIR" --finding "${pos[1]}" --status "${pos[2]}" --reason "$reason" || exit 3
  python3 "$HELPER" status --run-dir "$RUN_DIR" >/dev/null || exit 3
  echo "panel-slice decide: ${pos[1]} -> ${pos[2]}(已追加进 $RUN_DIR/findings.jsonl)"
}

cmd_status() {
  local pos=() json=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=(--json); shift ;;
      -*) usage; exit 2 ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  [[ ${#pos[@]} -eq 1 ]] || { usage; exit 2; }
  python3 "$HELPER" status --run-dir "$(realpath -m "${pos[0]}")" ${json[@]+"${json[@]}"} || exit 3
}

sub="${1:-}"; [[ $# -gt 0 ]] && shift
case "$sub" in
  run) cmd_run "$@" ;;
  verify) cmd_verify "$@" ;;
  retry) cmd_retry "$@" ;;
  decide) cmd_decide "$@" ;;
  status) cmd_status "$@" ;;
  -h|--help|help) usage; exit 0 ;;
  *) usage; exit 2 ;;
esac
