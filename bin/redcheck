#!/usr/bin/env bash
set -uo pipefail

# redcheck —— 退回红检:把**实现**真退回基线,重新 build,再跑判据,**要求它红**。
#
# 为什么必须是"真退回"(2026-08-05 亲手证明,两种红检差一个数量级):
#   20:50 我用**手写桩**红检 ⇒ 一条前置恒真的断言是绿的,洞没露出来;
#   22:54 把实现**真退回 611dd49 再 build** ⇒ 才发现那条断言在旧实现上也绿。
#   **桩红不算数,对着退回的真实现红才算数。**
#   而且退回红检抓的是**所有**恒真断言,不是我当时想得起来的那几条 ——
#   这正是它比"记得写一条约定"值钱的地方。
#
# 红也分真假(08-04 本机实证:"红在 TypeError 上等于没红检过"):
#   build 都没过 ⇒ 这次红检**不算数**(rc=4),不是"红了真好";
#   给了 --must-fail 就要求判据的输出里真的出现那个失败标记 ⇒ 否则是**红错了地方**(rc=5)。
#
# 用法:
#   redcheck --base REF --impl PATH... --oracle 'CMD' [--build 'CMD']
#            [--must-fail '正则'] [--repo DIR]
#
# 退出码:
#   0 红检通过(旧实现下判据确实红,且红在该红的地方)
#   1 **旧实现下判据仍然绿** —— 有恒真断言/前置恒真,这份判据证明不了任何事
#   2 用法或前置不满足(工作树脏等,拒跑)
#   4 build 没过 ⇒ 红检无效(红在 build 上不算红检)
#   5 红了,但没红在 --must-fail 指定的地方
#   9 **恢复失败** —— 最响的那个:工作树被留在"基线构建"的状态,必须人来收拾

die()  { echo "redcheck: $*" >&2; exit 2; }

REPO="$PWD"; BASE=""; ORACLE=""; BUILD=""; MUSTFAIL=""; IMPL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) sed -n '/^# 用法:/,/^#   9 /p' "$0" | sed 's/^# \?//' >&2; exit 0 ;;
    --repo)      REPO="${2:-}";     shift 2 ;;
    --base)      BASE="${2:-}";     shift 2 ;;
    # --impl 收**变长**:`--impl a b c` 与 `--impl a --impl b` 等价。
    # 用法里写的就是 `--impl PATH...`,解析却只认单值 = 说明书和实现对不上,
    # 08-06 第一次真用它时我自己就被顶了回来。
    --impl)
      shift
      [[ $# -gt 0 && "$1" != --* ]] || die "--impl 要至少一个路径"
      while [[ $# -gt 0 && "$1" != --* ]]; do IMPL+=("$1"); shift; done ;;
    --oracle)    ORACLE="${2:-}";   shift 2 ;;
    --build)     BUILD="${2:-}";    shift 2 ;;
    --must-fail) MUSTFAIL="${2:-}"; shift 2 ;;
    *) die "不认识的参数:$1" ;;
  esac
done

[[ -d "$REPO" ]] || die "仓库目录不存在:$REPO"
git -C "$REPO" rev-parse HEAD >/dev/null 2>&1 || die "$REPO 不是 git 仓库"
[[ -n "$BASE" ]] || die "缺 --base(退回到哪一版实现)"
git -C "$REPO" rev-parse --verify --quiet "$BASE" >/dev/null || die "--base 解析不了:$BASE"
[[ ${#IMPL[@]} -gt 0 ]] || die "缺 --impl(要退回哪些实现文件;**判卷不要列进来**)"
[[ -n "$ORACLE" ]] || die "缺 --oracle(判据怎么跑)"

# 【高危,四审 subkimi 抓的】`--impl` 必须在仓内。
# 下面这行 `rm -rf "$REPO/$p"` 是本脚本**两处**破坏性动作之一(另一处是 `purge_pycache`
# 全仓清 `__pycache__`,根钉在 `REPO_REAL`、跟踪的跳过;2026-08-08 四审 subdeepseek F2
# 提醒:这句原本写着"唯一",会让后来的审者以为破坏面只有被守卫的这份清单):
# `--impl ../x` 会真删到仓外,
# 而**旧版没有任何拦截** —— 前置脏检查的 git 报错走 stderr、stdout 为空 ⇒ 静默放行,
# 收尾自证同样为空 ⇒ 还会打印"✅ 已恢复,工作树干净"。
# **不需要攻击者,敲错一个路径就够。**(subdeepseek 判成"低危、预检已挡",核对代码是错的:
# 那一行没有 2>&1。两腿判断打架时以代码为准。)
REPO_REAL="$(realpath "$REPO")"
for p in "${IMPL[@]}"; do
  case "$p" in /*) die "--impl 要相对仓库根的路径,不是绝对路径:$p" ;; esac
  pr="$(realpath -m "$REPO/$p")"
  case "$pr" in
    "$REPO_REAL"/*) ;;
    *) die "--impl 指到**仓外**了,拒跑(这个脚本会 rm -rf 它):
    给的是 $p
    解析成 $pr
    仓库是 $REPO_REAL" ;;
  esac
done

# 开工前必须干净:不替人猜哪些改动该留。脏树上做"退回再恢复"= 拿别人的活当赌注。
# 2>&1:git 的报错(坏 pathspec 之类)必须**进到判断里**,不许溜到 stderr 让 stdout 显得干净。
dirty="$(git -C "$REPO" status --porcelain -uall -- "${IMPL[@]}" 2>&1)"
[[ -z "$dirty" ]] || die "这些实现路径有未提交改动(或 git 不认这个路径),拒跑:
$(printf '%s\n' "$dirty" | sed 's/^/  /')"

BASE_SHA="$(git -C "$REPO" rev-parse "$BASE")"
HEAD_SHA="$(git -C "$REPO" rev-parse HEAD)"
# 开工前的全仓快照:收尾自证拿它当基准(见 restore)。
STATUS_BEFORE="$(git -C "$REPO" status --porcelain -uall 2>&1)"
echo "redcheck: repo=$REPO"
echo "  实现退回 ${BASE_SHA:0:12}(判卷留在 HEAD ${HEAD_SHA:0:12})"
echo "  实现:${IMPL[*]}"

# ── 字节码缓存:每次换代码之后必须清 ──────────────────────────────────────
# 2026-08-07 实事故:手搓红检把 `f"…{nonce}…"` 换成 `"…deadbeef…"`,**两串恰好同长**,
# 加上还原时 mtime 落在同一秒 ⇒ CPython 的 .pyc 有效性检查(源文件 mtime + size)
# 整个通过,"红检"跑的是**旧字节码** —— 先假绿(报告"这是死判据"),后假红。
# `git checkout` 写出来的 mtime 同样是"现在",**同长度回退照样撞得上**;
# 撞不上只是运气,不是这个工具对。红检的全部价值就是"判据到底证明了什么",
# 它自己被缓存骗过,上面那一整套(判据先行/退回红检/死断言闸)全落在流沙上。
#
# 只删 `__pycache__` 目录,且**跳过被 git 跟踪的**(极少见,但删了会把树弄脏,
# 而收尾自证会因此喊 rc=9 —— 一个为了正确性加的动作不该反过来触发"恢复没干净")。
#
# 三处是 2026-08-08 四审改的,都别改回去:
#   1. **`:(literal)`**(subdeepseek F3):pathspec 默认按 glob 解释。未跟踪的
#      `a[1]/__pycache__` 会撞上已跟踪的同名普通文件 `a1/__pycache__` ⇒ 误判"被跟踪"
#      ⇒ 跳过不清 ⇒ 残留旧字节码 ⇒ **假绿**。(腿举的另一个例子实测不成立:带通配符的
#      pathspec 不做目录前缀展开。方向核对过才落的。)
#   2. **一次问清楚谁被跟踪**,不是每个目录起一个 git 进程:带 venv 的仓里
#      `__pycache__` 数以千计,per-dir spawn 会让红检慢到没人愿意跑 ——
#      而"没人跑"是这道防线最终失效的方式。
#   3. **`-prune`,并且剪掉 `site-packages`**:第三方包的字节码不可能对"被测实现是
#      哪一版"撒谎(两个 commit 之间它们根本没变),删了全是代价零收益。
#      剪 `site-packages` 而不是猜 venv 目录叫什么 —— 任何 venv 布局都有它。
purge_pycache() {
  local d rel f
  local -A tracked=()
  while IFS= read -r f; do
    [[ -n "$f" ]] && tracked["${f%/*}"]=1
  done < <(git -C "$REPO" ls-files -- '*__pycache__/*' 2>/dev/null)
  while IFS= read -r d; do
    rel="${d#"$REPO_REAL"/}"
    if [[ -n "${tracked[$rel]:-}" ]]; then
      # 不静默跳过:跳过的那个目录就是这道防线的洞,得让人看见。
      echo "  ⚠️ $rel 被 git 跟踪,没清 —— 这次红检可能跑的是它里面的旧字节码。" >&2
      continue
    fi
    rm -rf "$d"
  done < <(find "$REPO_REAL" \
                \( -name .git -o -name node_modules -o -name site-packages \
                   -o -name .tox -o -name .nox \) -prune -o \
                -type d -name __pycache__ -print 2>/dev/null)
}

RESTORED=0
restore() {
  [[ $RESTORED -eq 1 ]] && return 0
  RESTORED=1
  echo
  echo "redcheck: 恢复实现到 HEAD ..."
  # 三步,缺一不可(08-06 在 design-studio 真 build 上实测):
  #   ① checkout 铺回 HEAD 的内容 —— 但它**只按 HEAD 的文件名铺**,而且会把结果**入暂存区**;
  #   ② reset 把暂存区退回 HEAD:退回那一步的 checkout 也是入暂存的,不退就留下一堆 "A " 项;
  #   ③ clean 清掉**基线特有的产物** —— vite 那种 `index-<hash>.js` 按内容改名,
  #      基线构建出的文件名在 HEAD 里根本不存在,①②都碰不到它。
  # 只在 --impl 范围内动手,且开工前已要求这些路径干净 ⇒ 不会误删谁的活。
  git -C "$REPO" checkout "$HEAD_SHA" -- "${IMPL[@]}" 2>/dev/null
  git -C "$REPO" reset -q "$HEAD_SHA" -- "${IMPL[@]}" 2>/dev/null
  git -C "$REPO" clean -fdq -- "${IMPL[@]}" 2>/dev/null
  git -C "$REPO" checkout "$HEAD_SHA" -- "${IMPL[@]}" 2>/dev/null   # clean 之后再铺一次,补上被清掉的跟踪文件
  # 恢复也要清:否则盘上留着**基线**的字节码,下一个人跑判据跑的是退回后的代码。
  # (和下面"恢复之后必须重新 build"同一个道理,只是这一份缓存 build 管不着。)
  purge_pycache
  # 恢复之后**必须重新 build**:本机 dist 入库,不重 build 就把一棵"基线构建的树"
  # 留在盘上 —— 那和"盘上和运行时对不上"是同一种事故,只是发生在仓库里。
  local build_failed=0
  if [[ -n "$BUILD" ]]; then
    ( cd "$REPO" && bash -c "$BUILD" ) >/dev/null 2>&1 || build_failed=1
  fi
  # 恢复 build 失败**必须非零退出**(四审 subdeepseek F6):旧版只 echo 一句警告就照常
  # exit 0 —— 而那时树里躺的是没重建的源码/基线产物,正是"盘上和运行时对不上"。
  if [[ $build_failed -eq 1 ]]; then
    echo "  ❌ 恢复后的 build 没过 —— 工作树里可能还带着基线的产物,**不算恢复完成**。" >&2
    echo "     自己去看一眼:git -C $REPO status;必要时 git checkout $HEAD_SHA -- ${IMPL[*]}" >&2
    exit 9
  fi
  # 自证:不喊"恢复好了",而是让 git 说话。
  # 范围**不止 --impl**:build 产物常落在 impl 之外(本机 dist 入库),
  # 只查 impl 就会出现"树是脏的、自证说干净"(四审 subdeepseek F5:design 写了、实现漏了)。
  # 拿开工前的**全仓快照**做基准比较:仓里本来就有的无关脏东西(别的 track 的草稿之类)
  # 不算我留下的,否则这道自证会天天误报、然后被忽略。
  local left
  left="$(comm -13 <(printf '%s\n' "$STATUS_BEFORE" | sort) \
                   <(git -C "$REPO" status --porcelain -uall 2>&1 | sort))"
  if [[ -n "$left" ]]; then
    echo "  ❌ 恢复没干净,工作树还留着东西:" >&2
    printf '%s\n' "$left" | sed 's/^/     /' >&2
    echo "     手工收拾:git -C $REPO checkout $HEAD_SHA -- ${IMPL[*]}" >&2
    exit 9
  fi
  echo "  ✅ 已恢复,工作树干净(git 说的,不是我说的)。"
}
trap 'restore' EXIT
trap 'echo; echo "redcheck: 收到中断信号,先恢复再退出。" >&2; restore; exit 130' INT TERM

# ── 退回 ────────────────────────────────────────────────────────────────
# 基线上**还不存在**的实现文件(整单新增一个模块/工具就是这形状):
# "退回"对它的正确含义是**删掉**。`git checkout <base> -- <新文件>` 会 pathspec 报错,
# 照着报错走就等于这条路上根本没红检 —— 08-06 拿 redcheck 红检 redcheck 自己时撞到的。
have=(); gone=()
for p in "${IMPL[@]}"; do
  if git -C "$REPO" cat-file -e "$BASE_SHA:$p" 2>/dev/null; then have+=("$p")
  elif [[ -d "$REPO/$p" ]]; then have+=("$p")   # 目录:交给 checkout,内部差异它自己处理
  else gone+=("$p"); fi
done
if [[ ${#have[@]} -gt 0 ]]; then
  git -C "$REPO" checkout "$BASE_SHA" -- "${have[@]}" || die "退回失败(checkout $BASE -- ...)"
fi
for p in "${gone[@]}"; do
  echo "  (基线上没有 $p ⇒ 退回 = 删掉它)"
  rm -rf "${REPO:?}/$p"
done
purge_pycache      # 换完代码就清:否则下面跑的可能是上一版的字节码

if [[ -n "$BUILD" ]]; then
  echo "  build ..."
  if ! ( cd "$REPO" && bash -c "$BUILD" ) >/tmp/redcheck-build.$$ 2>&1; then
    echo "  ❌ 旧实现上 **build 就没过** ⇒ 这次红检**不算数**(红在 build 上等于没红检过)。"
    tail -n 15 /tmp/redcheck-build.$$ | sed 's/^/     /'
    rm -f /tmp/redcheck-build.$$
    exit 4
  fi
  rm -f /tmp/redcheck-build.$$
fi

# ── 跑判据(要求它红)──────────────────────────────────────────────────
echo "  跑判据 ..."
OUT="$(cd "$REPO" && bash -c "$ORACLE" 2>&1)"; ORC=$?
printf '%s\n' "$OUT" | sed 's/^/     | /'

if [[ $ORC -eq 0 ]]; then
  echo
  echo "  ❌ 旧实现下判据**仍然绿** —— 这份判据证明不了任何事:"
  echo "     它在没有本轮改动的代码上也过,说明有恒真断言 / 前置永远成立 /"
  echo "     断言问的根本不是这次改的东西。**先修判据,别派活。**"
  exit 1
fi

if [[ -n "$MUSTFAIL" ]]; then
  if ! printf '%s' "$OUT" | grep -qE "$MUSTFAIL"; then
    echo
    echo "  ❌ 判据红了,但**没红在该红的地方**:输出里找不到 /$MUSTFAIL/。"
    echo "     红在别处(炸了、依赖缺了、语法错了)和没红检过是一回事。"
    exit 5
  fi
  echo "  ✅ 红在目标断言上(命中 /$MUSTFAIL/)。"
fi

echo
echo "  ✅ 红检通过:旧实现下判据是红的(rc=$ORC)。这份判据确实在问本轮的改动。"
exit 0
