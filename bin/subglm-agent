#!/usr/bin/env bash
set -euo pipefail

# subglm-agent - GLM review employee on an AGENT base: Claude Code run
# headless against an Anthropic-compatible endpoint. Unlike the chat leg
# (subglm -> subchat), the model explores the repo itself (Read/Glob/Grep +
# read-only git), so no blind reviews and no manual INCLUDE feeding.
#
#   review  -> claude -p, read-only tool allowlist, verdict-gated. Works now.
#   explore -> claude -p, same read-only posture, no verdict gate.
#   fix    -> NOT supported here on purpose: panel reviewers stay review-only.
#             Use `submimo fix` (mimo) for fix work.
#
# Zhipu env is injected into the child process ONLY - this wrapper must never
# write ~/.claude/settings.json (that would hijack the main harness).

# GLM 后端沿革:bigmodel(1113 余额不足)→ 百炼(429)→ 火山方舟(07-17,
# Anthropic 面只有 /api/coding 且要 CodingPlan 订阅)→ **07-25 切回智谱开放平台**:
# 方舟账号的 glm-5-2 触发 SetLimitExceeded(安全体验模式限额,工具侧无解),
# 而方舟上没有 glm-4.6 系。bigmodel 的 Anthropic 面 = /api/anthropic,不要订阅,
# 实测 glm-4.6v 可用。方舟 key 备份在 auth.json.ark-bak。
DEFAULT_MODEL="glm-4.6v"
# 智谱开放平台 Anthropic-compatible endpoint (Claude Code base URL)。
BASE_URL="${ZHIPU_ANTHROPIC_URL:-https://open.bigmodel.cn/api/anthropic}"
AUTH_FILE="${ZHIPU_AUTH_FILE:-$HOME/.config/zhipu/auth.json}"

usage() {
  cat >&2 <<'EOF'
Usage:
  subglm-agent review TASK_FILE LOG_FILE [REPO_DIR]
  subglm-agent explore TASK_FILE LOG_FILE [REPO_DIR]
  subglm-agent fix    TASK_FILE LOG_FILE [REPO_DIR]   (unsupported - see notes)

Runs Zhipu GLM as an agentic read-only review sub-agent: Claude Code headless
(`claude -p`) pointed at Zhipu's Anthropic-compatible endpoint. The reviewer
reads the repo itself (Read/Glob/Grep + read-only git commands); write tools
are hard-disallowed.

Environment:
  ZHIPU_MODEL         optional, model id (default: glm-5-2-260617, Volcano Ark)
  ZHIPU_TIMEOUT       optional, seconds before timeout (default 900)
  ZHIPU_MAX_TURNS     optional, agent turn cap (default 40)
  ZHIPU_API_KEY       optional, overrides the key read from the auth file
  ZHIPU_ANTHROPIC_URL optional, default https://open.bigmodel.cn/api/anthropic
                      (Volcano Ark; needs a CodingPlan subscription)
  ZHIPU_AUTH_FILE     optional, default ~/.config/zhipu/auth.json

Examples:
  subglm-agent review /root/aiwork/tasks/001-review.md /root/aiwork/logs/001-review.log /path/to/repo
  subglm-agent explore /root/aiwork/tasks/001-brief.md /root/aiwork/logs/001-explore.log /path/to/repo
EOF
}

die() { echo "subglm-agent: $*" >&2; exit 1; }

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then usage; exit 0; fi
if [[ $# -lt 3 || $# -gt 4 ]]; then usage; exit 2; fi

MODE="$1"; TASK_FILE="$2"; LOG_FILE="$3"; REPO_DIR="${4:-$PWD}"
MODEL="${ZHIPU_MODEL:-$DEFAULT_MODEL}"
TIMEOUT_SECONDS="${ZHIPU_TIMEOUT:-900}"
MAX_TURNS="${ZHIPU_MAX_TURNS:-40}"

if [[ "$MODE" == "fix" ]]; then
  die "fix is not supported: panel reviewers are review-only. Use: submimo fix $TASK_FILE $LOG_FILE $REPO_DIR"
fi
[[ "$MODE" == "review" || "$MODE" == "explore" ]] || { usage; exit 2; }

[[ -f "$TASK_FILE" ]] || die "task file not found: $TASK_FILE"
[[ -d "$REPO_DIR" ]]  || die "repo dir not found: $REPO_DIR"
command -v claude >/dev/null 2>&1 || die "claude CLI not found on PATH"

# Load API key (env wins over auth file), same contract as subchat zhipu.
API_KEY="${ZHIPU_API_KEY:-}"
if [[ -z "$API_KEY" ]]; then
  [[ -f "$AUTH_FILE" ]] || die "auth file not found: $AUTH_FILE (set ZHIPU_API_KEY or create it as {\"key\":\"...\"})"
  API_KEY="$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['key'])" "$AUTH_FILE")" \
    || die "could not read 'key' from $AUTH_FILE"
fi
[[ -n "$API_KEY" ]] || die "empty ZHIPU_API_KEY"

# Absolute log path: the agent runs with cwd = REPO_DIR.
case "$LOG_FILE" in /*) ;; *) LOG_FILE="$PWD/$LOG_FILE" ;; esac
mkdir -p "$(dirname "$LOG_FILE")"

REVIEW_PROMPT="You are an independent code reviewer running inside a read-only harness.
Explore the repository yourself with the tools you have (Read, Glob, Grep, and
read-only git commands). Do not take the task's claims at face value - verify
them against the actual files.

Report findings with file:line references and a severity each. You MUST end
your review with a final line of exactly this form:
Conclusion: PASS | BLOCK | NEEDS_MORE_INFO

--- REVIEW TASK ---
$(cat "$TASK_FILE")"

EXPLORE_SYSTEM_PROMPT="${REVIEW_SYSTEM_PROMPT:-You are an independent design-exploration agent running inside a read-only harness. Explore the repository yourself with the tools you have (Read, Glob, Grep, and read-only git commands) when the codebase matters to the brief. You are one of several DIFFERENT models each answering the SAME design brief in isolation - you cannot see the others. Your value is the angle YOUR perspective favors, not consensus.

Rules:
- Propose exactly ONE concrete direction. Do NOT hedge across multiple options or output a menu.
- Do NOT output PASS/BLOCK/approve/reject - this is not a review.
- Commit to a position even under uncertainty; state your assumptions.
- Ground claims in the supplied brief and the repository; do not invent facts about the codebase.

Output format (use exactly these labels):
Direction: <one-line name of the approach you propose>
Core bet: <the single key assumption/trade-off this direction bets on>
How it works: <concrete shape - components, flow, key decisions>
Best at: <what it optimizes for / where it wins>
Sacrifices: <what it gives up; when it is the wrong choice>
Blind spots in the brief: <what the brief seems to be missing, mis-framing, or under-specifying - risks the author may not have seen>
Smallest first step: <the first concrete thing to build to validate this>}"

if [[ "$MODE" == "explore" ]]; then
  PROMPT="${EXPLORE_SYSTEM_PROMPT}

--- DESIGN BRIEF ---
$(cat "$TASK_FILE")"
else
  PROMPT="$REVIEW_PROMPT"
fi

{
  echo "# subglm-agent $MODE log"
  echo "time: $(date -Iseconds)"
  echo "mode: $MODE (agent base: claude-code headless)"
  echo "base_url: $BASE_URL"
  echo "model: $MODEL"
  echo "repo: $REPO_DIR"
  echo "task: $TASK_FILE"
  echo
} > "$LOG_FILE"

# env is per-invocation only; the stray real ANTHROPIC_API_KEY from the parent
# harness is scrubbed so it cannot outrank the Zhipu token.
# The prompt goes in via stdin: --allowedTools/--disallowedTools are variadic
# and would swallow a trailing positional prompt as more tool names.
RC=0
(
  cd "$REPO_DIR"
  printf '%s\n' "$PROMPT" | env -u ANTHROPIC_API_KEY \
    ANTHROPIC_AUTH_TOKEN="$API_KEY" \
    ANTHROPIC_BASE_URL="$BASE_URL" \
    ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL" \
    ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL" \
    ANTHROPIC_DEFAULT_HAIKU_MODEL="$MODEL" \
    timeout "$TIMEOUT_SECONDS" claude -p \
      --model sonnet \
      --setting-sources project \
      --max-turns "$MAX_TURNS" \
      --allowedTools Read Glob Grep "Bash(git diff:*)" "Bash(git log:*)" "Bash(git status:*)" \
      --disallowedTools Write Edit NotebookEdit WebFetch WebSearch Task Agent
) >> "$LOG_FILE" || RC=$?

if [[ $RC -ne 0 ]]; then
  [[ $RC -eq 124 ]] && die "claude timed out after ${TIMEOUT_SECONDS}s (log: $LOG_FILE)"
  die "claude exited rc=$RC (log: $LOG_FILE)"
fi

if [[ "$MODE" == "review" ]]; then
  # Verdict gate (same semantics as the chat engine's review mode): a review that
  # never concludes is a failed review, but the log is kept for forensics.
  # Accept 「结论: PASS」/full-width colon too (Chinese backends drift to it);
  # ： via ANSI-C quoting per the 07-17 full-width-punctuation lesson.
  VERDICT_RE=$'(Conclusion|结论)(:|\uFF1A)[[:space:]]*(PASS|BLOCK|NEEDS_MORE_INFO)'
  grep -qE "$VERDICT_RE" "$LOG_FILE" \
    || die "model returned no verdict (expected 'Conclusion: PASS|BLOCK|NEEDS_MORE_INFO'; log: $LOG_FILE)"
fi

exit 0
