#!/usr/bin/env bash
# 本仓(/root/aiwork)的**总跑入口**:一条命令跑完全部离线判据套件,并给一行汇总。
# Exit 0 = 全绿,非零 = 有东西烂了(外部漂移、环境升级、我自己改坏了)——
# 目的是在真跑一次 review-pr / 真派一次活之前就把静默腐烂抓出来。
# 绿了也打一行心跳,这样 cron 死了本身也看得见(P0-2「静默过期」的教训)。
# 只跑桩/离线套件,不做真供应商探活(不烧额度)。
#
# 2026-08-06:改成清单驱动。此前是三行硬写的 T1/T2/T3,后加的套件
# 谁都没被总跑调用过,和 design-studio 那边 `tests/mcp-gate.sh` 成了孤儿脚本
# 是同一种病:病根不是缺哪条检查,是缺一个把它们全串起来的入口。
# **新增判据套件 = 往下面这张表里加一行。**
set -uo pipefail
ROOT="$(dirname "$(dirname "$(realpath "$0")")")"

SUITES=(
  "privacy-check|python3|$ROOT/tests/test_privacy_check.py"
  "machine-bits|python3|$ROOT/tests/test_machine_bits.py"
  "local-data|python3|$ROOT/tests/test_local_data.py"
  "local-settings|python3|$ROOT/tests/test_local_settings.py"
  "review-pr|python3|$ROOT/tests/test_review_pr.py"
  "explore|python3|$ROOT/tests/test_explore.py"
  "review-leg-reliability|python3|$ROOT/tests/test_review_leg_reliability.py"
  "app-token-scope|python3|$ROOT/tests/test_app_token_scope.py"
  "review-result|python3|$ROOT/tests/test_review_result.py"
  "subcursor|python3|$ROOT/tests/test_subcursor.py"
  "leg-quick-fixes|python3|$ROOT/tests/test_leg_quick_fixes.py"
  "leg-finish|python3|$ROOT/tests/test_leg_finish.py"
  "review-tooling|bash|$ROOT/tests/test-review-tooling.sh"
  "subcodex|bash|$ROOT/tests/test-subcodex.sh"
  "fix-oracle|bash|$ROOT/tests/test-submimo-fix-oracle.sh"
  "delegate-entry|bash|$ROOT/tests/test-delegate-entry.sh"
  "delegate-isolate|bash|$ROOT/tests/test-delegate-isolate.sh"
  "no-egress|bash|$ROOT/tests/test-no-egress.sh"
  "review-workspace|bash|$ROOT/tests/test-review-workspace.sh"
  "workflow-docs|bash|$ROOT/tests/test-workflow-docs.sh"
  "aiwork-gate|bash|$ROOT/tests/test-aiwork-gate.sh"
)

# ── 孤儿判据套件(2026-08-08 四审 F2 实证)──────────────────────────────
# 新写的判据套件没被加进上面那张表 ⇒ 落盘当天绿的,此后**没有任何入口
# 再跑它**,烂掉不会有人知道。本文件头部自己写着「新增判据套件 = 往那张表里加一行」——
# 靠"记得加"就等于没有闸。判卷面以 .aiwork/policy.json 为准,不在这里另列一份。
# 套件漏登记则硬红:`tests/test-*` 没有"运维脚本"那种歧义,
# 一个判据套件不进总跑,没有任何正当理由。
TESTS_DIR="${COVERAGE_TESTS_DIR:-$ROOT/bin/../tests}"
orphans=""
for f in "$TESTS_DIR"/test-*.sh "$TESTS_DIR"/test_*.sh "$TESTS_DIR"/test-*.py "$TESTS_DIR"/test_*.py; do
  [ -f "$f" ] || continue
  b="$(basename "$f")"
  case " ${SUITES[*]} " in *"/$b|"*|*"/$b "*) ;; *) orphans="$orphans $b" ;; esac
done

# --coverage-only:只问孤儿套件就退出(判据要问这件事,不该为此跑完 10 分钟的全套件)
if [[ "${1:-}" == "--coverage-only" ]]; then
  if [[ -n "$orphans" ]]; then
    echo "🔴 有判据套件不在 SUITES 里(写了没人跑 = 从此静默腐烂):$orphans"
    exit 1
  fi
  exit 0
fi


names=(); rcs=(); summaries=(); outs=()
for entry in "${SUITES[@]}"; do
  IFS='|' read -r name runner path <<< "$entry"
  if [[ ! -f "$path" ]]; then
    names+=("$name"); rcs+=(127); summaries+=("判据文件不见了:$path"); outs+=("")
    continue
  fi
  # 每个套件套 timeout(四审两腿都点到:没有超时的话,某个套件挂死 = 总跑跟着挂死,
  # 既不红也不绿、心跳也不打 —— 而这个脚本存在的理由就是"让静默腐烂看得见"）。
  out="$(timeout "${SUITE_TIMEOUT:-1800}" "$runner" "$path" 2>&1)"; rc=$?
  if [[ $rc -eq 124 ]]; then out="$out
（超时:超过 ${SUITE_TIMEOUT:-1800}s 没跑完,当红处理）"; fi
  s="$(printf '%s\n' "$out" | grep -oE 'total: [0-9]+ passed, [0-9]+ failed' | tail -1)"
  [[ -z "$s" ]] && s="$(printf '%s\n' "$out" | tail -1)"
  names+=("$name"); rcs+=("$rc"); summaries+=("$s"); outs+=("$out")
done

fail=0
line=""
for i in "${!names[@]}"; do
  [[ "${rcs[$i]}" -ne 0 ]] && fail=$((fail+1))
  line+=" | ${names[$i]}: ${summaries[$i]:-?}"
done

if [[ -n "$orphans" ]]; then
  echo "🔴 有判据套件不在 SUITES 里(写了没人跑 = 从此静默腐烂):$orphans"
  fail=$((fail+1))
fi
if [[ $fail -eq 0 ]]; then
  echo "✅ 工具链防锈通过${line}"
  exit 0
fi
echo "❌ 工具链防锈失败(外部漂移/环境升级?先跑本地判据复现):"
for i in "${!names[@]}"; do
  [[ "${rcs[$i]}" -eq 0 ]] && continue
  echo "--- ${names[$i]} (rc=${rcs[$i]}) ---"
  printf '%s\n' "${outs[$i]}" | grep -E 'FAIL|total' | tail -20
done
exit 1
