#!/usr/bin/env bash
. "$(/usr/bin/dirname "$(/bin/realpath "${BASH_SOURCE[0]}")")/_programs.sh" || exit 78
set -uo pipefail

BIN_DIR="$(/usr/bin/dirname "$(/bin/realpath "$0")")" || exit 78

. "$BIN_DIR/_review-platform.sh" || exit 78
# Provider differences live here; platform routing happens before any settings.
PROVIDER="${1:-}"
READ_ONLY=0
DEFAULT_MAX_TURNS=200
AUTH_ENV=ANTHROPIC_AUTH_TOKEN
case "$PROVIDER" in
  deepseek)
    PREFIX=DEEPSEEK; LABEL=subdeepseek-agent; MODEL_LEG=deepseek
    SETTINGS_FILE=deepseek.env; SETTINGS_VAR=DEEPSEEK_API_KEY
    DEFAULT_BASE_URL=https://api.deepseek.com/anthropic
    BILLING_MODE=api
    ;;
  mimo)
    PREFIX=MIMO; LABEL=submimo; MODEL_LEG=mimo
    SETTINGS_FILE=mimo.env; SETTINGS_VAR=MIMO_API_KEY
    READ_ONLY=1
    BILLING_MODE=api
    ;;
  *) PREFIX=DEEPSEEK; LABEL=subagent; MODEL_LEG=deepseek ;;
esac
review_platform_check "$LABEL" || exit 78
aiwork_init "$LABEL" || exit 78

# Credentials are passed only in the child environment, never written to Claude settings.

usage() {
  local default_model override
  override="${PREFIX}_MODEL"
  default_model="$("$BIN_DIR/aiwork-config" model "$MODEL_LEG" "${!override:-}")" || exit 1
  printf '%s default model: %s\n\n' "${PREFIX/DEEPSEEK/DeepSeek}" "$default_model" >&2
  cat >&2 <<'EOF'
Usage:
  subagent <provider> review  TASK_FILE LOG_FILE [REPO_DIR]
  subagent <provider> explore TASK_FILE LOG_FILE [REPO_DIR]

Providers (thin shims in parentheses; callers normally use the shim):
  deepseek  (subdeepseek-agent)
  mimo      (submimo; read-only tools in both modes)
Models: ~/.config/aiwork/models.env; MiMo credentials/address: mimo.env.

Environment (PREFIX = DEEPSEEK or MIMO):
  <PREFIX>_MODEL          model id
  <PREFIX>_TIMEOUT        seconds before timeout (default 900)
  <PREFIX>_MAX_TURNS      agent turn cap (default 200)
  DEEPSEEK_API_KEY        overrides the key from deepseek.env
  DEEPSEEK_ANTHROPIC_URL  overrides DeepSeek base URL
MiMo always reads MIMO_BASE_URL and MIMO_API_KEY from mimo.env.
EOF
}

die() { echo "${LABEL:-subagent}: $*" >&2; exit 1; }

# -h may arrive as $2 when invoked through a shim (`subdeepseek-agent -h`).
for a in "${1:-}" "${2:-}"; do
  if [[ "$a" == "-h" || "$a" == "--help" ]]; then usage; exit 0; fi
done
if [[ $# -lt 4 || $# -gt 5 ]]; then usage; exit 2; fi

PROVIDER="$1"; MODE="$2"; TASK_FILE="$3"; LOG_FILE="$4"; REPO_DIR="${5:-$PWD}"
SOURCE_REPO="$REPO_DIR"

if [[ "$MODE" == "review" || "$MODE" == "explore" ]]; then
  _SOURCE_TOP="$(git -C "$SOURCE_REPO" rev-parse --show-toplevel 2>/dev/null)" \
    || { echo "subagent: review/explore needs a Git worktree with HEAD: $SOURCE_REPO" >&2; exit 78; }
  SOURCE_REPO="$(cd "$_SOURCE_TOP" && pwd -P)" \
    || { echo "subagent: cannot resolve source repo: $_SOURCE_TOP" >&2; exit 78; }
  REPO_DIR="$SOURCE_REPO"
fi

[[ "$LABEL" != subagent ]] || die "unknown provider: $PROVIDER (supported: deepseek, mimo)"
v="${PREFIX}_MODEL"
MODEL="$("$BIN_DIR/aiwork-config" model "$MODEL_LEG" "${!v:-}")" || exit 1
CLAUDE_MODEL="$MODEL"
if [[ "$READ_ONLY" == 1 ]]; then
  DEFAULT_BASE_URL="$("$BIN_DIR/aiwork-config" value "$SETTINGS_FILE" MIMO_BASE_URL)" || exit 1
fi
v="${PREFIX}_TIMEOUT";        TIMEOUT_SECONDS="${!v:-900}"
v="${PREFIX}_MAX_TURNS";      MAX_TURNS="${!v:-$DEFAULT_MAX_TURNS}"
v="${PREFIX}_API_KEY";        API_KEY="${!v:-}"
v="${PREFIX}_ANTHROPIC_URL";  BASE_URL="${!v:-$DEFAULT_BASE_URL}"
if [[ "$READ_ONLY" == 1 ]]; then
  # MiMo uses machine settings exclusively; inherited provider variables cannot bypass them.
  BASE_URL="$DEFAULT_BASE_URL"
  API_KEY="$("$BIN_DIR/aiwork-config" value "$SETTINGS_FILE" "$SETTINGS_VAR")" || exit 1
  "$AIWORK_PROGRAMS/python3" - "$BASE_URL" <<'PYURL' || die 'mimo.env: invalid MIMO_BASE_URL (expected an HTTPS Anthropic base URL)'
import sys
from urllib.parse import urlsplit
try:
    u=urlsplit(sys.argv[1])
    ok=(u.scheme=='https' and bool(u.hostname) and not(u.username or u.password or u.query or u.fragment)
        and u.path.rstrip('/').endswith('/anthropic'))
except ValueError:
    ok=False
raise SystemExit(0 if ok else 1)
PYURL
  case "$BASE_URL" in https://token-plan-*.xiaomimimo.com/*) BILLING_MODE=subscription ;; esac
fi

if [[ "$MODE" == "fix" ]]; then
  die "fix is not supported on this command. Change code in your own worktree."
fi
[[ "$MODE" == "review" || "$MODE" == "explore" ]] || { usage; exit 2; }

[[ -f "$TASK_FILE" ]] || die "task file not found: $TASK_FILE"
[[ -d "$REPO_DIR" ]]  || die "repo dir not found: $REPO_DIR"

if [[ -z "$API_KEY" ]]; then
  if ! API_KEY="$("$BIN_DIR/aiwork-config" value "$SETTINGS_FILE" "$SETTINGS_VAR")"; then
    die "auth: 凭证读不到"
  fi
fi
[[ -n "$API_KEY" ]] || die "empty ${PREFIX}_API_KEY"
# 供应商表必须填 AUTH_ENV(认证 header 风格)。**这条守卫非有不可**:
# 实测 GNU coreutils 9.4,`env '=key' cmd` 会 **rc=0、不报错**,子进程拿到一个
# 名字为空的 `=key`,而真正的认证变量一个都没设 ⇒ 腿活着、每次 401,日志上只看得见
# "模型没回话"。也就是说 env 的失败方向是**静默放过**,守卫只能长在我们这边。
# (2026-08-18 四审:有两条评审腿都断言这里 fail-closed —— 实测证明它们都错了。)
[[ -n "${AUTH_ENV:-}" ]] || die "供应商表里 $PROVIDER 这一格没填 AUTH_ENV（认证 header 风格）；不填的话认证头会被静默丢掉、这条腿每次 401 而日志只显示模型没回话"

# 绝对日志路径:agent 以 cwd = REPO_DIR 运行
"$BIN_DIR/aiwork-config" data-path >/dev/null || exit 78
LOG_FILE="$("$AIWORK_PROGRAMS/python3" "$BIN_DIR/_paths.py" canon -- "$LOG_FILE")" || { echo 'subagent: canonicalize helper 失败' >&2; exit 78; }
mkdir -p "$(dirname "$LOG_FILE")"

# 能力清单按底座给:**不许宣称一个它没有的工具,也不许瞒着它有的**。
# 08-18 真跑撞过一次:bash 关掉后提示词还写着 "read-only git commands",
# 腿当场顶回来「The task's premise ... is incorrect」并为此白花几轮。
# review 的 Bash 跑在可丢弃副本，可运行本地 tests/lint/build；explore 仍保持旧能力边界。
TOOLS_SENTENCE="Read, Glob, Grep, and Bash for local tests, lint, build, and diagnostics"
TOOLS_SENTENCE_X=" - you also have read-only git via Bash (git diff/log/show)"
REVIEW_PROMPT="You are an independent code reviewer running inside a disposable writable repository snapshot.
Explore the repository yourself with the tools you have
(${TOOLS_SENTENCE}). Do not take the task's claims at face value - verify
them against the actual files.

Command outputs and caches may be written inside this disposable snapshot, but
do not intentionally edit source files. Do not push, merge, install dependencies,
run migrations, access production systems, or change credentials.

Report findings with file:line references and a severity each.

--- REVIEW TASK ---
$(cat "$TASK_FILE")
--- END OF REVIEW TASK ---"

EXPLORE_SYSTEM_PROMPT="You are an independent agent running inside a read-only harness. Read the repository with the tools you have (Read, Glob, Grep${TOOLS_SENTENCE_X}). Do not modify files, push, merge, install dependencies, or spawn other agents."

if [[ "$READ_ONLY" == 1 ]]; then
  READER_TOOLS="$("$AIWORK_PROGRAMS/python3" "$BIN_DIR/_reader_tools.py" claude-tools)" || exit 78
  READER_PROMPT="$("$AIWORK_PROGRAMS/python3" "$BIN_DIR/_reader_tools.py" claude-prompt)" || exit 78
  PROMPT="$READER_PROMPT

--- TASK ($MODE) ---
$(cat "$TASK_FILE")"
elif [[ "$MODE" == "explore" ]]; then
  PROMPT="${EXPLORE_SYSTEM_PROMPT}

--- DESIGN BRIEF ---
$(cat "$TASK_FILE")"
else
  PROMPT="${REVIEW_PROMPT}"
fi

REVIEW_WORKSPACE_ACTIVE=0
if [[ "$MODE" == "review" || "$MODE" == "explore" ]]; then
  _RW="$BIN_DIR/_review-workspace.sh"
  [ -f "$_RW" ] || { echo "$LABEL: 找不到 _review-workspace.sh ⇒ 拒绝派发(fail-closed)" >&2; exit 78; }
  # shellcheck source=_review-workspace.sh
  . "$_RW"
  review_workspace_reset_report || exit 78
  if ! review_workspace_prepare "$SOURCE_REPO" "$LABEL"; then
    echo "$LABEL: review workspace 准备失败 ⇒ 模型未启动" >&2
    exit 78
  fi
  REVIEW_WORKSPACE_ACTIVE=1
  SOURCE_REPO="$REVIEW_SOURCE_REPO"
  REPO_DIR="$(review_workspace_repo)" || exit 78
  FACT_MODEL="$MODEL"
  review_workspace_write_facts "$FACT_MODEL" "$FACT_MODEL" "$BILLING_MODE" || exit 78
fi

_subagent_cleanup() {
  local rc=$?
  if [[ "${REVIEW_WORKSPACE_ACTIVE:-0}" -eq 1 ]]; then
    review_workspace_cleanup \
      || echo "$LABEL: 警告:review workspace 清理失败:${REVIEW_WORKSPACE_DIR:-?}" >&2
  fi
  trap - EXIT
  exit "$rc"
}
trap _subagent_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
RUNTIME_HOME="$(review_workspace_home claude-home)" || exit 78
if [[ "$READ_ONLY" == 1 ]]; then
  [[ -f "$BIN_DIR/_review-reader-context.sh" ]] || die 'missing reader context helper ⇒ 拒绝派发'
  . "$BIN_DIR/_review-reader-context.sh"
  review_reader_context "$REPO_DIR" || exit 78
fi

STREAM_FILE="${LOG_FILE%.log}.stream.jsonl"
ERR_FILE="$(mktemp)"

{
  echo "# $LABEL $MODE log"
  echo "time: $(date -Iseconds)"
  echo "mode: $MODE (agent base: claude-code headless -> $PROVIDER)"
  echo "base_url: $BASE_URL"
  echo "model: $MODEL"
  echo "repo: $REPO_DIR"
  echo "source_repo: $SOURCE_REPO"
  echo "task: $TASK_FILE"
  if [[ "$READ_ONLY" == 1 ]]; then
    echo "视野: ${READER_TOOLS}，只读代码；不能跑命令。"
  elif [[ "$MODE" == "review" ]]; then
    echo "视野: 底座腿 —— 独立可写副本；Bash 可跑本地 tests/lint/build/诊断。"
    echo "      Write/Edit/Task 关闭；原仓由外层只读挂载保护。"
  else
    echo "视野: 底座腿 —— 自己读仓库(Read/Glob/Grep)+ 只读 git(自己跑 git diff/log/show)。"
  fi
  echo
} > "$LOG_FILE"

RC=0
# Linux retains the source repository guard; only audited MiMo can reach Mac here.
EXEC_NAME="$(basename "$0")"
[[ "$READ_ONLY" == 1 ]] && EXEC_NAME="$LABEL"
review_platform_ro_exec "$SOURCE_REPO" "$EXEC_NAME" || exit 78
[[ -x "$BIN_DIR/aiwork-timeout" ]] || { printf '%s: 少了 %s ⇒ 拒绝派发\n' "$EXEC_NAME" "$BIN_DIR/aiwork-timeout" >&2; exit 78; }
if [[ "$READ_ONLY" == 1 ]]; then
  READER_SETTINGS="$RUNTIME_HOME/reader-settings.json"
  "$AIWORK_PROGRAMS/python3" "$BIN_DIR/_reader_tools.py" claude-settings "$READER_SETTINGS" || exit 78
  IFS=, read -r -a CLAUDE_TOOLS <<< "$READER_TOOLS"
  CLAUDE_OPTIONS=(--setting-sources "" --settings "$READER_SETTINGS" --permission-prompts none --tools "$READER_TOOLS"
    --strict-mcp-config --mcp-config '{"mcpServers":{}}' --disable-slash-commands
    --allowedTools "${CLAUDE_TOOLS[@]}")
elif [[ "$MODE" == "review" ]]; then
  CLAUDE_OPTIONS=(--setting-sources project --allowedTools Read Glob Grep Bash
    --disallowedTools Write Edit NotebookEdit WebFetch WebSearch Task Agent)
else
  CLAUDE_OPTIONS=(--setting-sources project --allowedTools Read Glob Grep
    "Bash(git diff:*)" "Bash(git log:*)" "Bash(git status:*)" "Bash(git show:*)"
    --disallowedTools Write Edit NotebookEdit WebFetch WebSearch Task Agent)
fi
(
  cd "$REPO_DIR" || exit 78
  unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
  export "$AUTH_ENV=$API_KEY"
  export CLAUDE_CONFIG_DIR="$RUNTIME_HOME" ANTHROPIC_BASE_URL="$BASE_URL"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="$CLAUDE_MODEL" ANTHROPIC_DEFAULT_SONNET_MODEL="$CLAUDE_MODEL"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="$CLAUDE_MODEL"
  if [[ "$READ_ONLY" == 1 ]]; then
    unset CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL
    unset CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
    export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
  fi
  printf '%s\n' "$PROMPT" | ${RO_EXEC[@]+"${RO_EXEC[@]}"} "$BIN_DIR/aiwork-timeout" "$TIMEOUT_SECONDS" "$AIWORK_PROGRAMS/claude" -p \
    --model sonnet --no-session-persistence --max-turns "$MAX_TURNS" \
    --output-format stream-json --verbose "${CLAUDE_OPTIONS[@]}"
) > "$STREAM_FILE" 2>"$ERR_FILE" || RC=$?

# 渲染:把 stream-json 还原成人能读的日志。**撞上限/超时也要渲染** —— 那正是这条
# 改动的全部意义:护栏可以打断工作,不许没收工作。
"$AIWORK_PROGRAMS/python3" - "$STREAM_FILE" "$LOG_FILE" "$MAX_TURNS" "$RC" "$ERR_FILE" <<'PY'
import json, sys, pathlib

stream, log, cap, rc, errfile = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4]), sys.argv[5]
turns, out = 0, []
for line in pathlib.Path(stream).read_text(encoding="utf-8", errors="replace").split("\n"):
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        ev = json.loads(line)
    except json.JSONDecodeError:
        continue
    if not isinstance(ev, dict) or ev.get("type") != "assistant":
        continue
    turns += 1
    message = ev.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    for block in content if isinstance(content, list) else []:
        if not isinstance(block, dict):
            continue
        if block.get("type") == "text" and block.get("text", "").strip():
            out.append(block["text"].rstrip())
        elif block.get("type") == "tool_use":
            inp = block.get("input") if isinstance(block.get("input"), dict) else {}
            hint = inp.get("file_path") or inp.get("pattern") or inp.get("command") or ""
            out.append(f"  → {block.get('name','tool')} {hint}".rstrip())

err = pathlib.Path(errfile).read_text(encoding="utf-8", errors="replace") if pathlib.Path(errfile).exists() else ""
body = "\n\n".join(out) if out else "(模型没有产出任何可渲染的内容;原始流见 %s)" % stream

footer = ["", "-" * 60, f"turns: {turns} / 上限 {cap}"]
if "max turns" in err.lower() or "reached max turns" in err.lower():
    footer.append(f"⚠️  本次是被**轮次上限**打断的(max-turns {cap}),不是模型自己收尾的。")
    footer.append("    上面的内容是打断前已经产出的部分 —— 它是残缺的,但不是零。")
    footer.append("    要调上限请用这里的 turns 实测值,别再翻倍。")
elif rc == 124:
    footer.append("⚠️  本次是被**超时**打断的;上面是超时前已产出的部分。")
elif rc != 0:
    footer.append(f"⚠️  底座腿非零退出 rc={rc};上面是退出前已产出的部分。stderr:")
    footer.append("    " + " ".join(err.split())[:400])
footer.append(f"(原始 stream-json:{stream})")

with open(log, "a", encoding="utf-8") as fh:
    fh.write(body + "\n" + "\n".join(footer) + "\n")
PY

# 最后一条消息是 stream-json 的 result.result，不是渲染进日志的过程。
"$AIWORK_PROGRAMS/python3" - "$STREAM_FILE" "$REPORT" <<'PY'
import json, pathlib, sys
stream, dest = sys.argv[1:]
last = None
for line in pathlib.Path(stream).read_text(encoding="utf-8", errors="replace").split("\n"):
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        event = json.loads(line)
    except json.JSONDecodeError:
        continue
    if isinstance(event, dict) and event.get("type") == "result" and isinstance(event.get("result"), str):
        last = event["result"]
if not isinstance(last, str):
    raise SystemExit(0)
pathlib.Path(dest).write_text(last)
PY

if [[ -s "$ERR_FILE" ]]; then cat "$ERR_FILE" >&2; fi
rm -f "$ERR_FILE"

AUDIT_MESSAGE=""
audit_rc=0
if [[ "$READ_ONLY" == 1 ]]; then
  audit="$(review_workspace_reader_audit audit-claude "$STREAM_FILE")" || audit_rc=$?
  if [[ "$audit_rc" == 0 ]]; then
    printf '\n核实工具: %s\n' "$audit" >> "$LOG_FILE"
  elif [[ "$audit_rc" == 1 || "$audit_rc" == 3 ]]; then
    AUDIT_MESSAGE="$audit"
    printf '\n%s\n' "$audit" >> "$LOG_FILE"
  else
    printf '%s: %s ⇒ 拒绝派发\n' "$LABEL" "$audit" >&2
    exit 78
  fi
fi
review_workspace_finish "${LABEL:-subagent}" "$RC" "$MODE" \
  "$FACT_MODEL" "$BILLING_MODE" "" "" "$AUDIT_MESSAGE" "$audit_rc"
