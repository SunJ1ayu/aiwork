#!/usr/bin/env bash
# track — lightweight artifact scaffold borrowed from Comet, without the state
# machine. Driven by the main agent's judgment + the panel workflow.
#
#   track new <name> [project-dir]      scaffold tracks/<name>/ from templates
#   track archive <name> [project-dir] [--keep-trees|--discard-ignored]
#                                        move tracks/<name>/ -> tracks/archive/
#   track list [project-dir]            list active + archived tracks
#
# project-dir defaults to the current directory. No phases are enforced — write
# proposal/design/tasks/verify when they earn their keep; panel hooks live in
# the templates. See /root/aiwork/track/CONVENTION.md.

set -euo pipefail

TEMPLATES="/root/aiwork/track/templates"

usage() { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

_wt_repo_from_gitfile() {  # _wt_repo_from_gitfile <tree>
  local tree="$1" line gitdir repo
  [[ -f "$tree/.git" ]] || return 1
  IFS= read -r line < "$tree/.git" || return 1
  [[ "$line" == gitdir:\ * ]] || return 1
  gitdir="${line#gitdir: }"
  case "$gitdir" in
    /*) ;;
    *) gitdir="$(cd "$tree" && realpath -m "$gitdir")" ;;
  esac
  case "$gitdir" in
    */.git/worktrees/*)
      repo="${gitdir%%/.git/worktrees/*}"
      [[ -d "$repo" ]] || return 1
      printf '%s\n' "$repo"
      ;;
    *) return 1 ;;
  esac
}

_wt_default_branch() {  # _wt_default_branch <repo>
  local repo="$1" ref
  ref="$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [[ -n "$ref" ]] && git -C "$repo" rev-parse --verify -q "$ref^{commit}" >/dev/null 2>&1; then
    printf '%s\n' "$ref"
    return 0
  fi
  for ref in main master; do
    if git -C "$repo" rev-parse --verify -q "$ref^{commit}" >/dev/null 2>&1; then
      printf '%s\n' "$ref"
      return 0
    fi
  done
  return 1
}

_track_disposable_ignored() {  # 窄白名单:只有明确的解释器/测试缓存
  case "$1" in
    __pycache__/|__pycache__/*|*/__pycache__/|*/__pycache__/*|\
    .pytest_cache/|.pytest_cache/*|*/.pytest_cache/|*/.pytest_cache/*|\
    .mypy_cache/|.mypy_cache/*|*/.mypy_cache/|*/.mypy_cache/*|\
    .ruff_cache/|.ruff_cache/*|*/.ruff_cache/|*/.ruff_cache/*) return 0 ;;
  esac
  return 1
}

_track_archive_sweep_worktrees() {  # <track> <keep:0|1> <discard-ignored:0|1> <proj>
  local track="$1" keep="$2" discard_ignored="$3" proj_abs="$4"
  local root track_dir tree entry base total=0 tree_repo
  root="${DELEGATE_WORKTREE_ROOT:-/root/aiwork/worktrees}"
  [[ -d "$root" ]] || return 0
  track_dir="$root/$track"

  local owned=() outsiders=()
  [[ -n "$proj_abs" ]] && proj_abs="$(realpath -m "$proj_abs")"
  if [[ -d "$track_dir" ]]; then
    for tree in "$track_dir"/*; do
      [[ -d "$tree" ]] || continue
      # 【四审 subdeepseek 发现 2】归属键光有 track 名不够 —— 两个项目各建一个同名 track、
      # 共用同一个 worktree 根,A 的归档就会去动 B 的树(干净的删掉、脏的拦死 A)。
      # 所以"属于本轮"还要求:**这棵树的所属仓,就是正在归档的这个项目**。
      # 别人的树一律降级成"不属于本轮":只点名,不碰,也不拦我。
      tree_repo="$(_wt_repo_from_gitfile "$tree" 2>/dev/null || true)"
      if [[ -n "$proj_abs" && -n "$tree_repo" && "$(realpath -m "$tree_repo")" != "$proj_abs" ]]; then
        outsiders+=("$tree(别的仓:$tree_repo)")
        total=$((total+1))
        continue
      fi
      owned+=("$tree")
      total=$((total+1))
    done
  fi
  for entry in "$root"/*; do
    [[ -d "$entry" ]] || continue
    [[ -n "$(ls -A "$entry" 2>/dev/null)" ]] || continue   # 空壳不算树,别点它的名
    base="$(basename "$entry")"
    [[ "$base" == "$track" ]] && continue
    outsiders+=("$entry")
    total=$((total+1))
  done

  [[ $total -eq 0 ]] && return 0

  echo "worktree-sweep: $root"
  if [[ ${#outsiders[@]} -gt 0 ]]; then
    echo "  不属于本轮,只点名不触碰:"
    printf '    %s\n' "${outsiders[@]}"
  fi

  if [[ ${#owned[@]} -eq 0 ]]; then
    return 0
  fi

  echo "  本轮 worktree:"

  local clean_entries=() blocked=0 status_out repo head mainline branch mb_out
  local dirty_reason mainline_reason
  for tree in "${owned[@]}"; do
    dirty_reason=""; mainline_reason=""; repo=""; head=""; mainline=""; branch=""

    if ! status_out="$(git -C "$tree" status --porcelain -uall 2>&1)"; then
      dirty_reason="干净判据跑不了: $status_out"
    elif [[ -n "$status_out" ]]; then
      dirty_reason="树里有没保存的改动/未跟踪文件"
    fi

    if ! repo="$(_wt_repo_from_gitfile "$tree")"; then
      mainline_reason="所属仓判不出来(.git 不是 gitdir: <仓>/.git/worktrees/<名>)"
    elif ! head="$(git -C "$tree" rev-parse HEAD 2>&1)"; then
      mainline_reason="树的 HEAD 读不出来: $head"
    elif ! mainline="$(_wt_default_branch "$repo")"; then
      mainline_reason="主线判不出来(找不到 origin/HEAD、main、master)"
    elif ! mb_out="$(git -C "$repo" merge-base --is-ancestor "$head" "$mainline" 2>&1)"; then
      mainline_reason="树的 HEAD 没合进主线 $mainline${mb_out:+: $mb_out}"
    fi

    branch="$(git -C "$tree" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

    if [[ -z "$dirty_reason" && -z "$mainline_reason" ]]; then
      echo "    OK  $tree"
      clean_entries+=("$tree"$'\t'"$repo"$'\t'"$branch")
    else
      blocked=1
      echo "    BLOCK $tree"
      if [[ -n "$dirty_reason" ]]; then
        echo "      - 干净判据: $dirty_reason"
        echo "        下一步: git -C '$tree' status --porcelain -uall"
      fi
      if [[ -n "$mainline_reason" ]]; then
        echo "      - 主线判据: $mainline_reason"
        if [[ -n "$repo" && -n "$mainline" ]]; then
          echo "        下一步: git -C '$repo' merge-base --is-ancestor \$(git -C '$tree' rev-parse HEAD) '$mainline'"
        else
          echo "        下一步: 修正该仓 origin/HEAD,或明确建出 main/master 后再归档"
        fi
      fi
    fi
  done

  if [[ "$keep" -eq 1 ]]; then
    echo "  --keep-trees: 本次只报告,不清理,也不阻断归档。"
    return 0
  fi
  if [[ "$blocked" -ne 0 ]]; then
    echo "🔴 拒绝归档:本轮还有不能确认干净的 worktree。目录留在原地,没有半归档状态。" >&2
    echo "   处理后重跑 track archive；确实要保留这些树就显式加 --keep-trees。" >&2
    return 1
  fi

  # `status -uall` 看不见 ignored 文件，但 worktree remove 会连它们一起删。
  # 必须先把**所有树**预检完再做第一次删除，避免前一棵已删、后一棵才发现唯一副本。
  local record remove_out branch_out ignored_out all_ignored ignored ignored_blocked=0
  for record in "${clean_entries[@]}"; do
    IFS=$'\t' read -r tree repo branch <<< "$record"
    all_ignored="$(git -C "$tree" status --porcelain -uall --ignored 2>/dev/null \
      | grep '^!!' | cut -c4- || true)"
    ignored_out=""
    while IFS= read -r ignored; do
      [[ -n "$ignored" ]] || continue
      _track_disposable_ignored "$ignored" && continue
      ignored_out+="${ignored_out:+$'\n'}$ignored"
    done <<< "$all_ignored"
    if [[ -n "$ignored_out" ]]; then
      ignored_blocked=1
      echo "  ⚠️ $tree 中会随树删除的 ignored 文件:"
      printf '%s\n' "$ignored_out" | sed 's/^/       /'
    fi
  done
  if [[ "$ignored_blocked" -ne 0 && "$discard_ignored" -ne 1 ]]; then
    echo "🔴 拒绝归档:ignored 文件会随 worktree 删除。所有树仍在原地。" >&2
    echo "   确认这些文件可丢弃后，显式重跑: track archive ... --discard-ignored" >&2
    return 1
  fi
  if [[ "$ignored_blocked" -ne 0 ]]; then
    echo "  --discard-ignored: 已显式确认删除以上 ignored 文件。"
  fi

  for record in "${clean_entries[@]}"; do
    IFS=$'\t' read -r tree repo branch <<< "$record"
    if ! remove_out="$(git -C "$repo" worktree remove "$tree" 2>&1)"; then
      echo "🔴 git worktree remove 拒绝清理:$tree(注意:排在它前面的树可能已经收掉了)" >&2
      printf '%s\n' "$remove_out" >&2
      return 1
    fi
    echo "  已收掉: $tree"
    if [[ -n "$branch" && "$branch" != "HEAD" ]]; then
      if ! branch_out="$(git -C "$repo" branch -d "$branch" 2>&1)"; then
        echo "  ⚠️ 分支删不掉(不影响归档): $branch: $(printf '%s\n' "$branch_out" | head -n 1)"
      else
        echo "  已删分支: $branch"
      fi
    fi
  done
  # 收空之后连轮次目录一起收掉:留个空壳的话,以后每一次归档都会把它当"别人的树"
  # 点一遍名 —— 唠叨的报告和误报的守卫一样,响多了就没人看了。
  # 只用 rmdir(非空会自己拒绝),不 rm -rf。
  # `|| true` 不是装饰:轮次目录里要是还搁着别的东西(不是树),rmdir 会失败,
  # 而这个脚本是 `set -e` —— 那会让整个归档**一声不吭地死掉**(判据 S9 就是问这个)。
  [[ -d "$track_dir" ]] && { rmdir "$track_dir" 2>/dev/null || true; }
  return 0
}

cmd="${1:-}"; shift || true

case "$cmd" in
  new)
    name="${1:-}"; proj="${2:-$PWD}"
    [ -z "$name" ] && { echo "ERROR: need a track name" >&2; usage 1; }
    # 名字直接拼进路径,而 track-guard 的归档正则只认**单层** `tracks/archive/<名>/`:
    # 建一个 `foo/bar` 就能让那道闸结构上看不见它(二轮四审 subdeepseek)。
    case "$name" in
      */*|*..*|.|archive|-*) echo "ERROR: track 名不许带 '/'、'..',也不许叫 '.' 或 'archive':$name" >&2; exit 1 ;;
    esac
    dir="$proj/tracks/$name"
    [ -e "$dir" ] && { echo "ERROR: $dir already exists" >&2; exit 1; }
    [ -e "$proj/tracks/archive/$name" ] && {
      echo "ERROR: track 名全生命周期必须唯一，已存在 archived track:$proj/tracks/archive/$name" >&2
      exit 1
    }
    mkdir -p "$dir"
    date="$(date +%Y-%m-%d)"
    baseref="$(git -C "$proj" rev-parse --verify -q HEAD 2>/dev/null || true)"
    [ -z "$baseref" ] && baseref="<no commit yet>"
    for f in proposal design tasks verify; do
      sed -e "s|__NAME__|$name|g" \
          -e "s|__DATE__|$date|g" \
          -e "s|__BASEREF__|$baseref|g" \
          "$TEMPLATES/$f.md" > "$dir/$f.md"
    done
    sed -e "s|__NAME__|$name|g" "$TEMPLATES/decision.json" > "$dir/decision.json"
    if ! "$(dirname "$0")/track-record" validate --phase shape "$dir" >/dev/null; then
      echo "ERROR: 新建 decision.json 未通过 shape 校验:$dir" >&2
      exit 1
    fi
    echo "created $dir"
    ls -1 "$dir"
    ;;
  archive)
    keep_trees=0; discard_ignored=0; archive_args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --keep-trees) keep_trees=1; shift ;;
        --discard-ignored) discard_ignored=1; shift ;;
        *) archive_args+=("$1"); shift ;;
      esac
    done
    name="${archive_args[0]:-}"; proj="${archive_args[1]:-$PWD}"
    [ -z "$name" ] && { echo "ERROR: need a track name" >&2; usage 1; }
    src="$proj/tracks/$name"
    [ -d "$src" ] || { echo "ERROR: $src not found" >&2; exit 1; }
    # typed facts 是唯一机器事实源；必须在 evidence 检查、worktree sweep 和 mv 之前判。
    # 无 decision 的旧 track 由 validator 明示为 legacy，继续走下面的旧 verify 规则。
    if ! "$(dirname "$0")/track-record" validate --phase archive "$src"; then
      echo "🔴 拒绝归档:typed decision 未完成。目录留在原地,尚未触碰 worktree。" >&2
      exit 1
    fi
    typed=0; [ -f "$src/decision.json" ] && typed=1
    # 上面那条用 **working** 视图判(index + 工作树 + 未跟踪文件),而归档那次 commit 的
    # hook 校验的是 **staged**(只有 index)。两者只在"交付内容上工作树是干净的"时相等。
    # 这个前置条件以前从没被说出来过:2026-09-09 归档 review-delivery-binding 时,
    # 仓里 26 份未跟踪任务书让它必然不等,于是 working 这关放行、目录搬走、炸在 commit 上,
    # 而那条 BLOCK 让人去重跑 panel(实测无效,每圈烧一轮 panel)。挡在 mv 之前,并点名文件。
    if [[ "$typed" -eq 1 ]] && python3 -c 'import json,sys; sys.exit(0 if json.load(open(sys.argv[1])).get("schema_version")==2 else 1)' "$src/decision.json" 2>/dev/null; then
      repo_root="$(git -C "$proj" rev-parse --show-toplevel 2>/dev/null)" || repo_root=""
      if [ -n "$repo_root" ]; then
        if ! views="$(python3 "$(dirname "$0")/_review_delivery.py" --repo "$repo_root" --track "$name" --explain-views 2>&1)"; then
          echo "🔴 拒绝归档:算不出两个交付视图($views)。目录留在原地。" >&2
          exit 1
        fi
        if [ -n "$views" ]; then
          echo "🔴 拒绝归档:评审看的 working 视图和归档 commit 校验的 staged 视图不是同一份内容。" >&2
          echo "   下面这些文件只在其中一个视图里(未跟踪 / 已改未暂存):" >&2
          printf '%s\n' "$views" | head -20 | sed 's/^/     /' >&2
          [ "$(printf '%s\n' "$views" | wc -l)" -gt 20 ] && echo "     …(还有 $(( $(printf '%s\n' "$views" | wc -l) - 20 )) 个)" >&2
          echo "   处理办法:**属于本单的**,git add 它们、删掉、或写进 .gitignore。" >&2
          echo "   **属于别的 track 的(tracks/<别的名字>/…),让那一单自己先提交** ——" >&2
          echo "   把它 git add 进这次归档,等于让别人的在途内容借本单的 PASS 混进库," >&2
          echo "   而归档复验只验被归档的这一单,吸进来的部分没有任何人看过。" >&2
          echo "   ⚠️ 重跑 panel-review 解决不了这件事(实测:药方无效,每圈烧掉一整轮 panel)。" >&2
          echo "   目录留在原地,一个文件都没动。" >&2
          exit 1
        fi
      fi
    fi
    # 归档 = 宣布做完了。没有主裁结论就没做完 —— 在**动目录之前**挡,
    # 别留下「已归档但没结论」的半截状态(pre-commit 的规矩3 只挡痕迹被提交那一步,
    # 目录那时早就搬走了)。现存 51 个已归档 track 实测无一缺 verify.md、
    # 无一是占位符 ⇒ 这两条硬挡不会误报到历史工件上。
    v="$src/verify.md"
    if [ ! -f "$v" ]; then
      echo "🔴 拒绝归档:$v 不存在(归档 = 宣布做完了,没有 verify.md 就没有结论)" >&2
      exit 1
    fi
    if [[ "$typed" -eq 0 ]] && grep -qE '^-[[:space:]]*Verdict:[[:space:]]*<' "$v"; then
      echo "🔴 拒绝归档:$v 的结论栏还是模板占位符(空着 = 没判过)。" >&2
      echo "   路线被取代、不是验收通过的,也要如实写(例:ARCHIVED-SUPERSEDED)," >&2
      echo "   别拿一个 PASS 充数。" >&2
      exit 1
    fi
    # 规矩5 的归档半边(5b 最后一份收据要被引用 / 5c 零证据要显式认账)。
    # 和上面结论栏那两条同一个道理:守在**动作发生那一刻**,别留下「已归档但证据缺着」
    # 的半截状态。5d(证据进没进 git)不在这儿查 —— 归档时收据常常还没 add,
    # 那一条属于提交那一刻,由 pre-commit 查。
    # shellcheck source=/root/aiwork/bin/_evidence.sh
    . "$(dirname "$0")/_evidence.sh" 2>/dev/null || {
      echo "🔴 找不到 _evidence.sh —— 归档检查缺件,拒绝归档(fail closed)" >&2; exit 1; }
    if ! ev_check "$src" "$v" archive "track archive"; then
      echo "🔴 拒绝归档:机器证据没对齐(见上)。目录留在原地,没有半归档状态。" >&2
      exit 1
    fi
    # 证据寿命要守在归档这一刻:归档是在承诺工件以后还能读,所以会话临时目录引用
    # 这时必须要么进仓,要么逐行写明「不承重」。放在 worktree sweep 前,是因为 sweep
    # 可能会清理本轮树;先判叙述证据,避免后续动作掩盖真正的拒绝理由。
    # shellcheck source=/root/aiwork/bin/_ephemeral-refs.sh
    . "$(dirname "$0")/_ephemeral-refs.sh" 2>/dev/null || {
      echo "🔴 找不到 _ephemeral-refs.sh —— 归档检查缺件,拒绝归档(fail closed)" >&2; exit 1; }
    if ! eph_check "$src" "track archive"; then
      echo "🔴 拒绝归档:工件引用了会话临时目录(见上)。目录留在原地,没有半归档状态。" >&2
      exit 1
    fi
    # 裸 `mv` 在**目标目录已存在**时不失败,而是把整个目录塞进去 ⇒ 落成
    # tracks/archive/<n>/<n>/ 且 rc=0。最常见的来源:上一次取回只搬走了跟踪文件
    # (`git mv` 不管未跟踪的),归档目录物理上还留着 —— 而 index 视图里它是空的,
    # 谁都看不见。(2026-09-09 第四轮 subdeepseek 提出,主裁在真实路径上复现;G15 钉住。)
    # ⚠️ 位置有讲究:这一条必须排在 worktree sweep **之前** —— 和上面证据寿命那一段
    # 同一个道理。sweep 走通时会真的 `git worktree remove`(不可逆),排在它后面就会
    # 出现"树删了、归档还是失败了",而拒绝的文案却在说"目录留在原地,没有半归档状态"。
    # (第一版就是排在后面的,主裁自审咬到;G15② 带对照组钉住。)
    if [ -e "$proj/tracks/archive/$name" ]; then
      echo "🔴 拒绝归档:$proj/tracks/archive/$name 已经存在。" >&2
      echo "   常见来源:上一次取回只搬走了跟踪文件,未跟踪残留还留在那儿(git 看不见它)。" >&2
      echo "   直接 mv 不会报错,只会静默嵌套成 tracks/archive/$name/$name/。" >&2
      echo "   先看一眼 \`ls -a $proj/tracks/archive/$name\` 决定那份残留的去留,再重跑归档。" >&2
      echo "   目录留在原地,没有半归档状态。" >&2
      exit 1
    fi
    _track_archive_sweep_worktrees "$name" "$keep_trees" "$discard_ignored" "$proj"
    mkdir -p "$proj/tracks/archive"
    mv "$src" "$proj/tracks/archive/$name"
    echo "archived -> $proj/tracks/archive/$name"
    ;;
  list)
    proj="${1:-$PWD}"
    echo "active:"
    # 结论栏还是模板占位符的,当场标出来。守卫钉在归档那一刻(那时"做完了"没有歧义),
    # 但 stage-timer 那种「已合并上线、就是一直不归档」的漏网守卫够不到 —— 靠这里每次
    # list 都看得见。软提示,不阻断。
    for t in $(ls -1 "$proj/tracks" 2>/dev/null | grep -v '^archive$'); do
      v="$proj/tracks/$t/verify.md"
      if [ -f "$proj/tracks/$t/decision.json" ]; then
        if ! "$(dirname "$0")/track-record" validate --phase archive "$proj/tracks/$t" >/dev/null 2>&1; then
          echo "  $t  ⚠️ typed outcome/coverage 还没满足归档条件"
        else
          echo "  $t"
        fi
      elif [ -f "$v" ] && grep -qE '^-[[:space:]]*Verdict:[[:space:]]*<' "$v"; then
        echo "  $t  ⚠️ 结论栏还空着(空着 = 没判过)"
      else
        echo "  $t"
      fi
    done
    echo "archived:"
    ls -1 "$proj/tracks/archive" 2>/dev/null | sed 's/^/  /' || true
    ;;
  -h|--help|help|"") usage 0 ;;
  *) echo "ERROR: unknown command '$cmd'" >&2; usage 1 ;;
esac
