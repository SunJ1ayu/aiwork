#!/usr/bin/env python3
"""Typed track facts: validate now; observations and ledger are added by later slices."""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import Any


MISSING = object()
IMPACT_LEVELS = ("self", "standard", "high")
IMPACT_FACTORS = (
    "new_write_surface",
    "permissions",
    "auth",
    "money",
    "data_consistency",
    "migration",
    "cross_module",
    "judging_control",
    "sandbox_boundary",
    "production_side_effect",
    "sensitive_data",
)
HIGH_IMPACT_FACTORS = {
    "new_write_surface",
    "permissions",
    "auth",
    "money",
    "data_consistency",
    "migration",
    "judging_control",
    "sandbox_boundary",
    "production_side_effect",
    "sensitive_data",
}
UNCERTAINTY_LEVELS = ("low", "high")
PREMISE_STATUSES = ("pending", "not_required", "done")
VERDICTS = ("PASS", "BLOCK", "NEEDS_MORE_INFO", "ARCHIVED-SUPERSEDED")
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
TOKEN_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]*$")
LABEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
CONTROLLERS = ("runlog", "panel-review", "delegate-codex")
EVENTS = ("execution_finished", "received")
BILLING_MODES = ("subscription", "api", "local")


class DecisionError(Exception):
    def __init__(self, rule: str, path: str, actual: Any, expected: Any):
        self.rule = rule
        self.path = path
        self.actual = actual
        self.expected = expected


def rendered(value: Any) -> str:
    if value is MISSING:
        return '"<missing>"'
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))


def block(error: DecisionError) -> int:
    print(
        "track-record: "
        f"rule={error.rule} path={error.path} actual={rendered(error.actual)} "
        f"expected={rendered(error.expected)} verdict=BLOCK",
        file=sys.stderr,
    )
    return 1


def required(obj: dict[str, Any], key: str, path: str) -> Any:
    if key not in obj:
        raise DecisionError("field.required", f"{path}.{key}".lstrip("."), MISSING, "present (null allowed by shape)")
    return obj[key]


def exact_object(value: Any, path: str, keys: tuple[str, ...]) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise DecisionError("field.type", path, value, "object")
    missing = [key for key in keys if key not in value]
    if missing:
        raise DecisionError("field.required", f"{path}.{missing[0]}".lstrip("."), MISSING, "present (null allowed by shape)")
    extra = sorted(set(value) - set(keys))
    if extra:
        raise DecisionError("field.unknown", f"{path}.{extra[0]}".lstrip("."), value[extra[0]], "no unknown fields in schema v1")
    return value


def nullable_enum(value: Any, path: str, choices: tuple[str, ...]) -> None:
    if value is not None and value not in choices:
        raise DecisionError("field.enum", path, value, "|".join(choices))


def nullable_token(value: Any, path: str) -> None:
    if value is not None and (not isinstance(value, str) or not TOKEN_RE.fullmatch(value)):
        raise DecisionError("field.type", path, value, "null or non-empty identifier")


def git_root(track_dir: Path) -> Path | None:
    result = subprocess.run(
        ["git", "-C", os.fspath(track_dir), "rev-parse", "--show-toplevel"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    return Path(result.stdout.strip()) if result.returncode == 0 else None


def decision_was_tracked(track_dir: Path) -> bool:
    repo = git_root(track_dir)
    if repo is None:
        return False
    try:
        rel = (track_dir / "decision.json").resolve().relative_to(repo.resolve())
    except ValueError:
        return False
    rel_text = rel.as_posix()
    in_index = subprocess.run(
        ["git", "-C", os.fspath(repo), "ls-files", "--error-unmatch", "--", rel_text],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0
    if in_index:
        return True
    history = subprocess.run(
        ["git", "-C", os.fspath(repo), "log", "--all", "-1", "--format=%H", "--", rel_text],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    return history.returncode == 0 and bool(history.stdout.strip())


def staged_decision_text(track_dir: Path) -> str | None:
    repo = git_root(track_dir)
    if repo is None:
        raise DecisionError("git.repository", "track_dir", os.fspath(track_dir), "track inside a git repository")
    try:
        rel = (track_dir / "decision.json").resolve().relative_to(repo.resolve())
    except ValueError as exc:
        raise DecisionError("git.repository", "decision.json", os.fspath(track_dir), "path inside git repository") from exc
    result = subprocess.run(
        ["git", "-C", os.fspath(repo), "show", f":{rel.as_posix()}"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode != 0:
        if decision_was_tracked(track_dir):
            raise DecisionError("decision.required", "decision.json", MISSING, "typed decision present in staged snapshot")
        return None
    try:
        return result.stdout.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise DecisionError("json.parse", "decision.json", str(exc), "valid UTF-8 JSON") from exc


def load_decision(track_dir: Path, source: str) -> dict[str, Any] | None:
    path = track_dir / "decision.json"
    if source == "staged":
        text = staged_decision_text(track_dir)
        if text is None:
            return None
    else:
        if not path.is_file():
            if decision_was_tracked(track_dir):
                raise DecisionError("decision.required", "decision.json", MISSING, "tracked typed decision must exist")
            return None
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            raise DecisionError("json.parse", "decision.json", str(exc), "valid UTF-8 JSON") from exc
    try:
        value = json.loads(text)
    except json.JSONDecodeError as exc:
        raise DecisionError("json.parse", "decision.json", str(exc), "valid UTF-8 JSON") from exc
    if not isinstance(value, dict):
        raise DecisionError("field.type", "decision.json", value, "object")
    return value


def validate_shape(data: dict[str, Any], track_dir: Path) -> None:
    root = exact_object(
        data,
        "",
        ("schema_version", "track", "impact", "design", "execution_plan", "outcome"),
    )
    version = required(root, "schema_version", "")
    if type(version) is not int or version != 1:
        raise DecisionError("schema.version", "schema_version", version, 1)
    track = required(root, "track", "")
    if not isinstance(track, str) or not NAME_RE.fullmatch(track):
        raise DecisionError("field.type", "track", track, "single safe track name")
    if track != track_dir.name:
        raise DecisionError("track.identity", "track", track, track_dir.name)

    impact = exact_object(required(root, "impact", ""), "impact", ("level", "factors"))
    level = required(impact, "level", "impact")
    nullable_enum(level, "impact.level", IMPACT_LEVELS)
    factors = required(impact, "factors", "impact")
    if factors is not None:
        if not isinstance(factors, list):
            raise DecisionError("field.type", "impact.factors", factors, "null or array")
        if any(not isinstance(item, str) or item not in IMPACT_FACTORS for item in factors):
            bad = next(item for item in factors if not isinstance(item, str) or item not in IMPACT_FACTORS)
            raise DecisionError("field.enum", "impact.factors[]", bad, "|".join(IMPACT_FACTORS))
        if len(factors) != len(set(factors)):
            raise DecisionError("field.unique", "impact.factors", factors, "unique values")

    design = exact_object(required(root, "design", ""), "design", ("uncertainty", "premise_attack"))
    uncertainty = required(design, "uncertainty", "design")
    nullable_enum(uncertainty, "design.uncertainty", UNCERTAINTY_LEVELS)
    premise = exact_object(
        required(design, "premise_attack", "design"),
        "design.premise_attack",
        ("status", "evidence"),
    )
    nullable_enum(required(premise, "status", "design.premise_attack"), "design.premise_attack.status", PREMISE_STATUSES)
    evidence = required(premise, "evidence", "design.premise_attack")
    if not isinstance(evidence, list):
        raise DecisionError("field.type", "design.premise_attack.evidence", evidence, "array")
    for item in evidence:
        if not isinstance(item, str) or not item or Path(item).is_absolute() or ".." in Path(item).parts:
            raise DecisionError("evidence.path", "design.premise_attack.evidence[]", item, "safe track-relative path")

    execution = exact_object(required(root, "execution_plan", ""), "execution_plan", ("adapter", "model"))
    nullable_token(required(execution, "adapter", "execution_plan"), "execution_plan.adapter")
    nullable_token(required(execution, "model", "execution_plan"), "execution_plan.model")
    outcome = exact_object(required(root, "outcome", ""), "outcome", ("verdict",))
    nullable_enum(required(outcome, "verdict", "outcome"), "outcome.verdict", VERDICTS)


def require_value(data: dict[str, Any], path: tuple[str, ...], expected: str) -> Any:
    value: Any = data
    for key in path:
        value = value[key]
    if value is None:
        raise DecisionError("field.decided", ".".join(path), value, expected)
    return value


def validate_dispatch(data: dict[str, Any], track_dir: Path) -> None:
    level = require_value(data, ("impact", "level"), "self|standard|high before dispatch")
    factors = require_value(data, ("impact", "factors"), "array before dispatch")
    uncertainty = require_value(data, ("design", "uncertainty"), "low|high before dispatch")
    status = require_value(data, ("design", "premise_attack", "status"), "not_required|done before dispatch")
    require_value(data, ("execution_plan", "adapter"), "non-empty adapter before dispatch")
    high_factors = sorted(set(factors) & HIGH_IMPACT_FACTORS)
    if high_factors and level != "high":
        raise DecisionError("impact.high_factor", "impact.level", level, f"high because factors={','.join(high_factors)}")
    evidence = data["design"]["premise_attack"]["evidence"]
    if uncertainty == "high" and (status != "done" or not evidence):
        raise DecisionError(
            "design.premise_required",
            "design.premise_attack",
            {"status": status, "evidence": evidence},
            "status=done and non-empty evidence when uncertainty=high",
        )
    if uncertainty == "low" and status not in ("not_required", "done"):
        raise DecisionError("design.premise_status", "design.premise_attack.status", status, "not_required|done")
    if status == "done":
        for rel in evidence:
            candidate = track_dir / rel
            try:
                candidate.resolve().relative_to(track_dir.resolve())
            except ValueError as exc:
                raise DecisionError("evidence.path", "design.premise_attack.evidence[]", rel, "path inside track") from exc
            if candidate.is_symlink() or not candidate.is_file():
                raise DecisionError("evidence.exists", "design.premise_attack.evidence[]", rel, "existing non-symlink file")


def validate(track_dir: Path, phase: str, source: str, expected_impact: str | None = None) -> int:
    try:
        data = load_decision(track_dir, source)
        if data is None:
            print(f"track-record: status=legacy phase={phase} source={source} track={track_dir.name}")
            return 0
        validate_shape(data, track_dir)
        if expected_impact is not None and data["impact"]["level"] != expected_impact:
            raise DecisionError("impact.expected", "impact.level", data["impact"]["level"], expected_impact)
        if phase in ("dispatch", "archive"):
            validate_dispatch(data, track_dir)
        if phase == "archive" and data["outcome"]["verdict"] is None:
            raise DecisionError("field.decided", "outcome.verdict", None, "PASS|BLOCK|NEEDS_MORE_INFO|ARCHIVED-SUPERSEDED")
    except DecisionError as exc:
        return block(exc)
    print(f"track-record: status=valid phase={phase} source={source} track={data['track']}")
    return 0


def safe_identifier(value: str, path: str, pattern: re.Pattern[str], limit: int = 200) -> str:
    if not value or len(value) > limit or not pattern.fullmatch(value):
        raise DecisionError("observation.identifier", path, value, f"safe identifier <= {limit} chars")
    return value


def iso8601_utc(value: str, path: str) -> str:
    if not value.endswith("Z"):
        raise DecisionError("observation.timestamp", path, value, "ISO-8601 UTC ending in Z")
    try:
        parsed = datetime.fromisoformat(value[:-1] + "+00:00")
    except ValueError as exc:
        raise DecisionError("observation.timestamp", path, value, "ISO-8601 UTC ending in Z") from exc
    if parsed.tzinfo is None or parsed.utcoffset() != timezone.utc.utcoffset(parsed):
        raise DecisionError("observation.timestamp", path, value, "ISO-8601 UTC ending in Z")
    return value


def nullable_nonnegative(value: int | float | None, path: str) -> int | float | None:
    if value is not None and (isinstance(value, bool) or value < 0):
        raise DecisionError("observation.range", path, value, "null or non-negative number")
    return value


def track_location(repo: Path, name: str) -> tuple[Path, str]:
    safe_identifier(name, "track", NAME_RE)
    repo = repo.resolve()
    for rel in (Path("tracks") / name, Path("tracks/archive") / name):
        candidate = repo / rel
        if candidate.is_dir() and not candidate.is_symlink():
            try:
                candidate.resolve().relative_to(repo)
            except ValueError as exc:
                raise DecisionError("observation.boundary", "track", os.fspath(candidate), "track inside repo") from exc
            return candidate, rel.as_posix()
    raise DecisionError("track.directory", "track", name, "existing active or archived track")


def write_observation(track_dir: Path, rel_track: str, payload: dict[str, Any]) -> str:
    obs_dir = track_dir / "observations"
    if obs_dir.is_symlink():
        raise DecisionError("observation.boundary", "observations", os.fspath(obs_dir), "real directory, not symlink")
    obs_dir.mkdir(mode=0o755, parents=False, exist_ok=True)
    if not obs_dir.is_dir() or obs_dir.is_symlink():
        raise DecisionError("observation.boundary", "observations", os.fspath(obs_dir), "real directory")
    body = (json.dumps(payload, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
    stamp = payload["finished_at"].replace("-", "").replace(":", "").replace("T", "T").replace("Z", "Z")
    base = f"{stamp}-{payload['controller']}-{payload['event']}"
    temp = obs_dir / f".{base}.{os.getpid()}.tmp"
    temp_fd = None
    try:
        temp_fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        with os.fdopen(temp_fd, "wb") as stream:
            temp_fd = None
            stream.write(body)
            stream.flush()
            os.fsync(stream.fileno())
        for counter in range(1, 1000):
            final = obs_dir / f"{base}-{counter:03d}.json"
            try:
                os.link(temp, final)
                os.unlink(temp)
                return f"{rel_track}/observations/{final.name}"
            except FileExistsError:
                continue
        raise DecisionError("observation.collision", "observations", 999, "fewer than 999 same-stamp events")
    finally:
        if temp_fd is not None:
            os.close(temp_fd)
        try:
            temp.unlink()
        except FileNotFoundError:
            pass


def observe(args: argparse.Namespace) -> int:
    try:
        repo = args.repo.resolve()
        if not repo.is_dir():
            raise DecisionError("git.repository", "repo", os.fspath(repo), "existing repository directory")
        track_dir, rel_track = track_location(repo, args.track)
        run_id = safe_identifier(args.run_id, "run_id", LABEL_RE)
        label = safe_identifier(args.label, "label", LABEL_RE, 128)
        adapter = safe_identifier(args.adapter, "actual.adapter", TOKEN_RE)
        model = None if args.model is None else safe_identifier(args.model, "actual.model", TOKEN_RE)
        started = iso8601_utc(args.started_at, "started_at")
        finished = iso8601_utc(args.finished_at, "finished_at")
        if datetime.fromisoformat(finished[:-1] + "+00:00") < datetime.fromisoformat(started[:-1] + "+00:00"):
            raise DecisionError("observation.time_order", "finished_at", finished, ">= started_at")
        nullable_nonnegative(args.duration_ms, "duration_ms")
        nullable_nonnegative(args.input_tokens, "usage.input_tokens")
        nullable_nonnegative(args.output_tokens, "usage.output_tokens")
        nullable_nonnegative(args.total_tokens, "usage.total_tokens")
        nullable_nonnegative(args.api_cost, "usage.api_cost")
        if args.risk is not None and args.risk not in IMPACT_LEVELS:
            raise DecisionError("field.enum", "actual.risk", args.risk, "|".join(IMPACT_LEVELS))
        degraded = {None: None, "null": None, "true": True, "false": False}[args.degraded]
        nullable_nonnegative(args.exit_code, "exit_code")
        nullable_nonnegative(args.work_exit_code, "actual.work_exit_code")
        legs: list[dict[str, Any]] | None = [] if args.controller == "panel-review" else None
        for spec in args.leg or []:
            parts = spec.split(",")
            if len(parts) != 6:
                raise DecisionError(
                    "observation.leg",
                    "actual.legs[]",
                    spec,
                    "name,family,adapter,exit_code,verdict|null,degraded(true|false)",
                )
            name, family, leg_adapter, leg_rc_text, verdict, leg_degraded = parts
            safe_identifier(name, "actual.legs[].name", LABEL_RE)
            safe_identifier(family, "actual.legs[].family", LABEL_RE)
            safe_identifier(leg_adapter, "actual.legs[].adapter", TOKEN_RE)
            try:
                leg_rc = int(leg_rc_text)
            except ValueError as exc:
                raise DecisionError("observation.leg", "actual.legs[].exit_code", leg_rc_text, "integer") from exc
            nullable_nonnegative(leg_rc, "actual.legs[].exit_code")
            if verdict == "null":
                leg_verdict = None
            elif verdict in ("PASS", "BLOCK", "NEEDS_MORE_INFO"):
                leg_verdict = verdict
            else:
                raise DecisionError("field.enum", "actual.legs[].verdict", verdict, "null|PASS|BLOCK|NEEDS_MORE_INFO")
            if leg_degraded not in ("true", "false"):
                raise DecisionError("field.enum", "actual.legs[].degraded", leg_degraded, "true|false")
            assert legs is not None
            legs.append(
                {
                    "name": name,
                    "family": family,
                    "adapter": leg_adapter,
                    "model": None,
                    "state": "completed" if leg_rc == 0 else "failed",
                    "exit_code": leg_rc,
                    "verdict": leg_verdict,
                    "degraded": leg_degraded == "true",
                    "duration_ms": None,
                    "usage": {
                        "input_tokens": None,
                        "output_tokens": None,
                        "total_tokens": None,
                        "api_cost": None,
                        "billing_mode": None,
                    },
                }
            )
        payload = {
            "schema_version": 1,
            "track": args.track,
            "run_id": run_id,
            "controller": args.controller,
            "event": args.event,
            "label": label,
            "started_at": started,
            "finished_at": finished,
            "duration_ms": args.duration_ms,
            "exit_code": args.exit_code,
            "actual": {
                "adapter": adapter,
                "model": model,
                "risk": args.risk,
                "degraded": degraded,
                "work_exit_code": args.work_exit_code,
                "legs": legs,
            },
            "usage": {
                "input_tokens": args.input_tokens,
                "output_tokens": args.output_tokens,
                "total_tokens": args.total_tokens,
                "api_cost": args.api_cost,
                "billing_mode": args.billing_mode,
            },
        }
        rel_file = write_observation(track_dir, rel_track, payload)
    except (DecisionError, OSError) as exc:
        if isinstance(exc, DecisionError):
            return block(exc)
        return block(DecisionError("observation.write", "observations", str(exc), "atomic JSON write"))
    print(f"track-record: observed file={rel_file}")
    return 0


def parser() -> argparse.ArgumentParser:
    top = argparse.ArgumentParser(prog="track-record")
    commands = top.add_subparsers(dest="command", required=True)
    check = commands.add_parser("validate", help="validate a track decision")
    check.add_argument("--phase", required=True, choices=("shape", "dispatch", "archive"))
    check.add_argument("--source", default="working", choices=("working", "staged"))
    check.add_argument("--expected-impact", choices=IMPACT_LEVELS)
    check.add_argument("track_dir", type=Path)
    event = commands.add_parser("observe", help="write one compact controller observation")
    event.add_argument("--repo", required=True, type=Path)
    event.add_argument("--track", required=True)
    event.add_argument("--run-id", required=True)
    event.add_argument("--controller", required=True, choices=CONTROLLERS)
    event.add_argument("--event", required=True, choices=EVENTS)
    event.add_argument("--label", required=True)
    event.add_argument("--started-at", required=True)
    event.add_argument("--finished-at", required=True)
    event.add_argument("--duration-ms", required=True, type=int)
    event.add_argument("--exit-code", required=True, type=int)
    event.add_argument("--adapter", required=True)
    event.add_argument("--work-exit-code", required=True, type=int)
    event.add_argument("--model")
    event.add_argument("--risk", choices=IMPACT_LEVELS)
    event.add_argument("--degraded", choices=("null", "true", "false"))
    event.add_argument("--input-tokens", type=int)
    event.add_argument("--output-tokens", type=int)
    event.add_argument("--total-tokens", type=int)
    event.add_argument("--api-cost", type=float)
    event.add_argument("--billing-mode", choices=BILLING_MODES)
    event.add_argument(
        "--leg",
        action="append",
        help="panel leg: name,family,adapter,exit_code,verdict|null,degraded(true|false)",
    )
    return top


def main() -> int:
    args = parser().parse_args()
    if args.command == "validate":
        if not args.track_dir.is_dir():
            return block(DecisionError("track.directory", "track_dir", os.fspath(args.track_dir), "existing directory"))
        return validate(args.track_dir.resolve(), args.phase, args.source, args.expected_impact)
    if args.command == "observe":
        return observe(args)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
