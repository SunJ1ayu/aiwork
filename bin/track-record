#!/usr/bin/env python3
"""Typed track facts: validate now; observations and ledger are added by later slices."""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import Any


MISSING = object()
IMPACT_LEVELS = ("self", "standard", "high")
IMPACT_FACTORS = (
    "new_write_surface",
    "permissions",
    "auth",
    "money",
    "data_consistency",
    "migration",
    "cross_module",
    "judging_control",
    "sandbox_boundary",
    "production_side_effect",
    "sensitive_data",
)
HIGH_IMPACT_FACTORS = {
    "new_write_surface",
    "permissions",
    "auth",
    "money",
    "data_consistency",
    "migration",
    "judging_control",
    "sandbox_boundary",
    "production_side_effect",
    "sensitive_data",
}
UNCERTAINTY_LEVELS = ("low", "high")
PREMISE_STATUSES = ("pending", "not_required", "done")
VERDICTS = ("PASS", "BLOCK", "NEEDS_MORE_INFO", "ARCHIVED-SUPERSEDED")
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
TOKEN_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]*$")
LABEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
CONTROLLERS = ("runlog", "panel-review", "delegate-codex")
EVENTS = ("execution_finished", "received")
BILLING_MODES = ("subscription", "api", "local")


class DecisionError(Exception):
    def __init__(self, rule: str, path: str, actual: Any, expected: Any):
        self.rule = rule
        self.path = path
        self.actual = actual
        self.expected = expected


def rendered(value: Any) -> str:
    if value is MISSING:
        return '"<missing>"'
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))


def block(error: DecisionError) -> int:
    print(
        "track-record: "
        f"rule={error.rule} path={error.path} actual={rendered(error.actual)} "
        f"expected={rendered(error.expected)} verdict=BLOCK",
        file=sys.stderr,
    )
    return 1


def required(obj: dict[str, Any], key: str, path: str) -> Any:
    if key not in obj:
        raise DecisionError("field.required", f"{path}.{key}".lstrip("."), MISSING, "present (null allowed by shape)")
    return obj[key]


def exact_object(value: Any, path: str, keys: tuple[str, ...]) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise DecisionError("field.type", path, value, "object")
    missing = [key for key in keys if key not in value]
    if missing:
        raise DecisionError("field.required", f"{path}.{missing[0]}".lstrip("."), MISSING, "present (null allowed by shape)")
    extra = sorted(set(value) - set(keys))
    if extra:
        raise DecisionError("field.unknown", f"{path}.{extra[0]}".lstrip("."), value[extra[0]], "no unknown fields in schema v1")
    return value


def nullable_enum(value: Any, path: str, choices: tuple[str, ...]) -> None:
    if value is not None and value not in choices:
        raise DecisionError("field.enum", path, value, "|".join(choices))


def nullable_token(value: Any, path: str) -> None:
    if value is not None and (not isinstance(value, str) or not TOKEN_RE.fullmatch(value)):
        raise DecisionError("field.type", path, value, "null or non-empty identifier")


def git_root(track_dir: Path) -> Path | None:
    result = subprocess.run(
        ["git", "-C", os.fspath(track_dir), "rev-parse", "--show-toplevel"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    return Path(result.stdout.strip()) if result.returncode == 0 else None


def decision_was_tracked(track_dir: Path) -> bool:
    repo = git_root(track_dir)
    if repo is None:
        return False
    try:
        rel = (track_dir / "decision.json").resolve().relative_to(repo.resolve())
    except ValueError:
        return False
    rel_text = rel.as_posix()
    in_index = subprocess.run(
        ["git", "-C", os.fspath(repo), "ls-files", "--error-unmatch", "--", rel_text],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0
    if in_index:
        return True
    history = subprocess.run(
        ["git", "-C", os.fspath(repo), "log", "--all", "-1", "--format=%H", "--", rel_text],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    return history.returncode == 0 and bool(history.stdout.strip())


def staged_decision_text(track_dir: Path) -> str | None:
    repo = git_root(track_dir)
    if repo is None:
        raise DecisionError("git.repository", "track_dir", os.fspath(track_dir), "track inside a git repository")
    try:
        rel = (track_dir / "decision.json").resolve().relative_to(repo.resolve())
    except ValueError as exc:
        raise DecisionError("git.repository", "decision.json", os.fspath(track_dir), "path inside git repository") from exc
    result = subprocess.run(
        ["git", "-C", os.fspath(repo), "show", f":{rel.as_posix()}"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode != 0:
        if decision_was_tracked(track_dir):
            raise DecisionError("decision.required", "decision.json", MISSING, "typed decision present in staged snapshot")
        return None
    try:
        return result.stdout.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise DecisionError("json.parse", "decision.json", str(exc), "valid UTF-8 JSON") from exc


def load_decision(track_dir: Path, source: str) -> dict[str, Any] | None:
    path = track_dir / "decision.json"
    if source == "staged":
        text = staged_decision_text(track_dir)
        if text is None:
            return None
    else:
        if not path.is_file():
            if decision_was_tracked(track_dir):
                raise DecisionError("decision.required", "decision.json", MISSING, "tracked typed decision must exist")
            return None
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            raise DecisionError("json.parse", "decision.json", str(exc), "valid UTF-8 JSON") from exc
    try:
        value = json.loads(text)
    except json.JSONDecodeError as exc:
        raise DecisionError("json.parse", "decision.json", str(exc), "valid UTF-8 JSON") from exc
    if not isinstance(value, dict):
        raise DecisionError("field.type", "decision.json", value, "object")
    return value


def validate_shape(data: dict[str, Any], track_dir: Path) -> None:
    root = exact_object(
        data,
        "",
        ("schema_version", "track", "impact", "design", "execution_plan", "outcome"),
    )
    version = required(root, "schema_version", "")
    if type(version) is not int or version != 1:
        raise DecisionError("schema.version", "schema_version", version, 1)
    track = required(root, "track", "")
    if not isinstance(track, str) or not NAME_RE.fullmatch(track):
        raise DecisionError("field.type", "track", track, "single safe track name")
    if track != track_dir.name:
        raise DecisionError("track.identity", "track", track, track_dir.name)

    impact = exact_object(required(root, "impact", ""), "impact", ("level", "factors"))
    level = required(impact, "level", "impact")
    nullable_enum(level, "impact.level", IMPACT_LEVELS)
    factors = required(impact, "factors", "impact")
    if factors is not None:
        if not isinstance(factors, list):
            raise DecisionError("field.type", "impact.factors", factors, "null or array")
        if any(not isinstance(item, str) or item not in IMPACT_FACTORS for item in factors):
            bad = next(item for item in factors if not isinstance(item, str) or item not in IMPACT_FACTORS)
            raise DecisionError("field.enum", "impact.factors[]", bad, "|".join(IMPACT_FACTORS))
        if len(factors) != len(set(factors)):
            raise DecisionError("field.unique", "impact.factors", factors, "unique values")

    design = exact_object(required(root, "design", ""), "design", ("uncertainty", "premise_attack"))
    uncertainty = required(design, "uncertainty", "design")
    nullable_enum(uncertainty, "design.uncertainty", UNCERTAINTY_LEVELS)
    premise = exact_object(
        required(design, "premise_attack", "design"),
        "design.premise_attack",
        ("status", "evidence"),
    )
    nullable_enum(required(premise, "status", "design.premise_attack"), "design.premise_attack.status", PREMISE_STATUSES)
    evidence = required(premise, "evidence", "design.premise_attack")
    if not isinstance(evidence, list):
        raise DecisionError("field.type", "design.premise_attack.evidence", evidence, "array")
    for item in evidence:
        if not isinstance(item, str) or not item or Path(item).is_absolute() or ".." in Path(item).parts:
            raise DecisionError("evidence.path", "design.premise_attack.evidence[]", item, "safe track-relative path")

    execution = exact_object(required(root, "execution_plan", ""), "execution_plan", ("adapter", "model"))
    nullable_token(required(execution, "adapter", "execution_plan"), "execution_plan.adapter")
    nullable_token(required(execution, "model", "execution_plan"), "execution_plan.model")
    outcome = exact_object(required(root, "outcome", ""), "outcome", ("verdict",))
    nullable_enum(required(outcome, "verdict", "outcome"), "outcome.verdict", VERDICTS)


def require_value(data: dict[str, Any], path: tuple[str, ...], expected: str) -> Any:
    value: Any = data
    for key in path:
        value = value[key]
    if value is None:
        raise DecisionError("field.decided", ".".join(path), value, expected)
    return value


def validate_dispatch(data: dict[str, Any], track_dir: Path) -> None:
    level = require_value(data, ("impact", "level"), "self|standard|high before dispatch")
    factors = require_value(data, ("impact", "factors"), "array before dispatch")
    uncertainty = require_value(data, ("design", "uncertainty"), "low|high before dispatch")
    status = require_value(data, ("design", "premise_attack", "status"), "not_required|done before dispatch")
    require_value(data, ("execution_plan", "adapter"), "non-empty adapter before dispatch")
    high_factors = sorted(set(factors) & HIGH_IMPACT_FACTORS)
    if high_factors and level != "high":
        raise DecisionError("impact.high_factor", "impact.level", level, f"high because factors={','.join(high_factors)}")
    evidence = data["design"]["premise_attack"]["evidence"]
    if uncertainty == "high" and (status != "done" or not evidence):
        raise DecisionError(
            "design.premise_required",
            "design.premise_attack",
            {"status": status, "evidence": evidence},
            "status=done and non-empty evidence when uncertainty=high",
        )
    if uncertainty == "low" and status not in ("not_required", "done"):
        raise DecisionError("design.premise_status", "design.premise_attack.status", status, "not_required|done")
    if status == "done":
        for rel in evidence:
            candidate = track_dir / rel
            try:
                candidate.resolve().relative_to(track_dir.resolve())
            except ValueError as exc:
                raise DecisionError("evidence.path", "design.premise_attack.evidence[]", rel, "path inside track") from exc
            if candidate.is_symlink() or not candidate.is_file():
                raise DecisionError("evidence.exists", "design.premise_attack.evidence[]", rel, "existing non-symlink file")


def validate_archive_observations(data: dict[str, Any], track_dir: Path) -> None:
    if data["outcome"]["verdict"] != "PASS":
        return
    obs_dir = track_dir / "observations"
    if obs_dir.is_symlink() or not obs_dir.is_dir():
        raise DecisionError(
            "observation.required",
            "observations",
            MISSING,
            "at least one successful execution_finished event before PASS archive",
        )
    observations = [observation_for_ledger(path, data["track"]) for path in sorted(obs_dir.glob("*.json"))]
    executions = [item for item in observations if item["event"] == "execution_finished"]
    if not executions:
        raise DecisionError(
            "observation.required",
            "observations[].event",
            MISSING,
            "execution_finished before PASS archive",
        )
    if not any(item["exit_code"] == 0 for item in executions):
        raise DecisionError(
            "observation.success_required",
            "observations[].exit_code",
            [item["exit_code"] for item in executions],
            "at least one execution_finished with exit_code=0 before PASS archive",
        )
    if data["execution_plan"]["adapter"] == "delegate-codex":
        delegate_runs = {item["run_id"] for item in executions if item["controller"] == "delegate-codex"}
        if not delegate_runs:
            raise DecisionError(
                "observation.delegate_required",
                "observations[].controller",
                sorted({item["controller"] for item in executions}),
                "delegate-codex execution_finished for planned delegate-codex execution",
            )
        received_ok = {
            item["run_id"]
            for item in observations
            if item["controller"] == "delegate-codex" and item["event"] == "received" and item["exit_code"] == 0
        }
        missing = sorted(delegate_runs - received_ok)
        if missing:
            raise DecisionError(
                "observation.received_required",
                "observations[].event",
                missing,
                "received with exit_code=0 for every delegate execution run_id",
            )


def validate(track_dir: Path, phase: str, source: str, expected_impact: str | None = None) -> int:
    try:
        data = load_decision(track_dir, source)
        if data is None:
            print(f"track-record: status=legacy phase={phase} source={source} track={track_dir.name}")
            return 0
        validate_shape(data, track_dir)
        if expected_impact is not None and data["impact"]["level"] != expected_impact:
            raise DecisionError("impact.expected", "impact.level", data["impact"]["level"], expected_impact)
        if phase in ("dispatch", "archive"):
            validate_dispatch(data, track_dir)
        if phase == "archive" and data["outcome"]["verdict"] is None:
            raise DecisionError("field.decided", "outcome.verdict", None, "PASS|BLOCK|NEEDS_MORE_INFO|ARCHIVED-SUPERSEDED")
        if phase == "archive":
            validate_archive_observations(data, track_dir)
    except DecisionError as exc:
        return block(exc)
    print(f"track-record: status=valid phase={phase} source={source} track={data['track']}")
    return 0


def safe_identifier(value: str, path: str, pattern: re.Pattern[str], limit: int = 200) -> str:
    if not value or len(value) > limit or not pattern.fullmatch(value):
        raise DecisionError("observation.identifier", path, value, f"safe identifier <= {limit} chars")
    return value


def iso8601_utc(value: str, path: str) -> str:
    if not value.endswith("Z"):
        raise DecisionError("observation.timestamp", path, value, "ISO-8601 UTC ending in Z")
    try:
        parsed = datetime.fromisoformat(value[:-1] + "+00:00")
    except ValueError as exc:
        raise DecisionError("observation.timestamp", path, value, "ISO-8601 UTC ending in Z") from exc
    if parsed.tzinfo is None or parsed.utcoffset() != timezone.utc.utcoffset(parsed):
        raise DecisionError("observation.timestamp", path, value, "ISO-8601 UTC ending in Z")
    return value


def nullable_nonnegative(value: int | float | None, path: str) -> int | float | None:
    if value is not None and (isinstance(value, bool) or value < 0):
        raise DecisionError("observation.range", path, value, "null or non-negative number")
    return value


def track_location(repo: Path, name: str) -> tuple[Path, str]:
    safe_identifier(name, "track", NAME_RE)
    repo = repo.resolve()
    for rel in (Path("tracks") / name, Path("tracks/archive") / name):
        candidate = repo / rel
        if candidate.is_dir() and not candidate.is_symlink():
            try:
                candidate.resolve().relative_to(repo)
            except ValueError as exc:
                raise DecisionError("observation.boundary", "track", os.fspath(candidate), "track inside repo") from exc
            return candidate, rel.as_posix()
    raise DecisionError("track.directory", "track", name, "existing active or archived track")


def control_repo(repo: Path) -> Path:
    """Return the main checkout even when *repo* is an attached worktree."""
    resolved = repo.resolve()
    try:
        common = subprocess.run(
            ["git", "-C", os.fspath(resolved), "rev-parse", "--path-format=absolute", "--git-common-dir"],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return resolved
    common_path = Path(common).resolve()
    if common_path.name == ".git" and common_path.parent.is_dir():
        return common_path.parent
    return resolved


def write_observation(track_dir: Path, rel_track: str, payload: dict[str, Any]) -> str:
    obs_dir = track_dir / "observations"
    if obs_dir.is_symlink():
        raise DecisionError("observation.boundary", "observations", os.fspath(obs_dir), "real directory, not symlink")
    obs_dir.mkdir(mode=0o755, parents=False, exist_ok=True)
    if not obs_dir.is_dir() or obs_dir.is_symlink():
        raise DecisionError("observation.boundary", "observations", os.fspath(obs_dir), "real directory")
    body = (json.dumps(payload, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
    stamp = payload["finished_at"].replace("-", "").replace(":", "").replace("T", "T").replace("Z", "Z")
    base = f"{stamp}-{payload['controller']}-{payload['event']}"
    temp = obs_dir / f".{base}.{os.getpid()}.tmp"
    temp_fd = None
    try:
        temp_fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        with os.fdopen(temp_fd, "wb") as stream:
            temp_fd = None
            stream.write(body)
            stream.flush()
            os.fsync(stream.fileno())
        for counter in range(1, 1000):
            final = obs_dir / f"{base}-{counter:03d}.json"
            try:
                os.link(temp, final)
                os.unlink(temp)
                return f"{rel_track}/observations/{final.name}"
            except FileExistsError:
                continue
        raise DecisionError("observation.collision", "observations", 999, "fewer than 999 same-stamp events")
    finally:
        if temp_fd is not None:
            os.close(temp_fd)
        try:
            temp.unlink()
        except FileNotFoundError:
            pass


def observe(args: argparse.Namespace) -> int:
    try:
        repo = args.repo.resolve()
        if not repo.is_dir():
            raise DecisionError("git.repository", "repo", os.fspath(repo), "existing repository directory")
        track_dir, rel_track = track_location(repo, args.track)
        run_id = safe_identifier(args.run_id, "run_id", LABEL_RE)
        label = safe_identifier(args.label, "label", LABEL_RE, 128)
        adapter = safe_identifier(args.adapter, "actual.adapter", TOKEN_RE)
        model = None if args.model is None else safe_identifier(args.model, "actual.model", TOKEN_RE)
        started = iso8601_utc(args.started_at, "started_at")
        finished = iso8601_utc(args.finished_at, "finished_at")
        if datetime.fromisoformat(finished[:-1] + "+00:00") < datetime.fromisoformat(started[:-1] + "+00:00"):
            raise DecisionError("observation.time_order", "finished_at", finished, ">= started_at")
        nullable_nonnegative(args.duration_ms, "duration_ms")
        nullable_nonnegative(args.input_tokens, "usage.input_tokens")
        nullable_nonnegative(args.output_tokens, "usage.output_tokens")
        nullable_nonnegative(args.total_tokens, "usage.total_tokens")
        nullable_nonnegative(args.api_cost, "usage.api_cost")
        if args.risk is not None and args.risk not in IMPACT_LEVELS:
            raise DecisionError("field.enum", "actual.risk", args.risk, "|".join(IMPACT_LEVELS))
        degraded = {None: None, "null": None, "true": True, "false": False}[args.degraded]
        nullable_nonnegative(args.exit_code, "exit_code")
        nullable_nonnegative(args.work_exit_code, "actual.work_exit_code")
        legs: list[dict[str, Any]] | None = [] if args.controller == "panel-review" else None
        for spec in args.leg or []:
            parts = spec.split(",")
            if len(parts) != 6:
                raise DecisionError(
                    "observation.leg",
                    "actual.legs[]",
                    spec,
                    "name,family,adapter,exit_code,verdict|null,degraded(true|false)",
                )
            name, family, leg_adapter, leg_rc_text, verdict, leg_degraded = parts
            safe_identifier(name, "actual.legs[].name", LABEL_RE)
            safe_identifier(family, "actual.legs[].family", LABEL_RE)
            safe_identifier(leg_adapter, "actual.legs[].adapter", TOKEN_RE)
            try:
                leg_rc = int(leg_rc_text)
            except ValueError as exc:
                raise DecisionError("observation.leg", "actual.legs[].exit_code", leg_rc_text, "integer") from exc
            nullable_nonnegative(leg_rc, "actual.legs[].exit_code")
            if verdict == "null":
                leg_verdict = None
            elif verdict in ("PASS", "BLOCK", "NEEDS_MORE_INFO"):
                leg_verdict = verdict
            else:
                raise DecisionError("field.enum", "actual.legs[].verdict", verdict, "null|PASS|BLOCK|NEEDS_MORE_INFO")
            if leg_degraded not in ("true", "false"):
                raise DecisionError("field.enum", "actual.legs[].degraded", leg_degraded, "true|false")
            assert legs is not None
            legs.append(
                {
                    "name": name,
                    "family": family,
                    "adapter": leg_adapter,
                    "model": None,
                    "state": "completed" if leg_rc == 0 else "failed",
                    "exit_code": leg_rc,
                    "verdict": leg_verdict,
                    "degraded": leg_degraded == "true",
                    "duration_ms": None,
                    "usage": {
                        "input_tokens": None,
                        "output_tokens": None,
                        "total_tokens": None,
                        "api_cost": None,
                        "billing_mode": None,
                    },
                }
            )
        payload = {
            "schema_version": 1,
            "track": args.track,
            "run_id": run_id,
            "controller": args.controller,
            "event": args.event,
            "label": label,
            "started_at": started,
            "finished_at": finished,
            "duration_ms": args.duration_ms,
            "exit_code": args.exit_code,
            "actual": {
                "adapter": adapter,
                "model": model,
                "risk": args.risk,
                "degraded": degraded,
                "work_exit_code": args.work_exit_code,
                "legs": legs,
            },
            "usage": {
                "input_tokens": args.input_tokens,
                "output_tokens": args.output_tokens,
                "total_tokens": args.total_tokens,
                "api_cost": args.api_cost,
                "billing_mode": args.billing_mode,
            },
        }
        rel_file = write_observation(track_dir, rel_track, payload)
    except (DecisionError, OSError) as exc:
        if isinstance(exc, DecisionError):
            return block(exc)
        return block(DecisionError("observation.write", "observations", str(exc), "atomic JSON write"))
    print(f"track-record: observed file={rel_file}")
    return 0


def import_delegate(args: argparse.Namespace) -> int:
    """Import only the compact, whitelisted fields from a delegate receipt."""
    try:
        with args.receipt.open(encoding="utf-8") as stream:
            receipt = json.load(stream)
        if not isinstance(receipt, dict):
            raise DecisionError("delegate.receipt", "receipt", type(receipt).__name__, "JSON object")
        if receipt.get("dry_run") is True or receipt.get("track") is None:
            print("track-record: delegate observation skipped (dry-run or no track)")
            return 0

        def text_field(key: str, pattern: re.Pattern[str], limit: int = 200) -> str:
            value = receipt.get(key, MISSING)
            if not isinstance(value, str):
                raise DecisionError("delegate.receipt", key, value, "string")
            return safe_identifier(value, key, pattern, limit)

        repo_value = receipt.get("repo", MISSING)
        if not isinstance(repo_value, str) or not repo_value:
            raise DecisionError("delegate.receipt", "repo", repo_value, "non-empty path string")
        track = text_field("track", NAME_RE)
        run_id = text_field("run_id", LABEL_RE)
        label = text_field("label", LABEL_RE, 128)
        model_value = receipt.get("model")
        model = None
        if model_value is not None:
            if not isinstance(model_value, str):
                raise DecisionError("delegate.receipt", "model", model_value, "null or string")
            model = safe_identifier(model_value, "model", TOKEN_RE)

        if args.event == "execution_finished":
            started_key, finished_key, duration_key, rc_key = (
                "started_at",
                "finished_at",
                "duration_ms",
                "codex_rc",
            )
        else:
            started_key, finished_key, duration_key, rc_key = (
                "receive_started_at",
                "received_at",
                "receive_duration_ms",
                "receive_rc",
            )
        started_value = receipt.get(started_key, MISSING)
        finished_value = receipt.get(finished_key, MISSING)
        if not isinstance(started_value, str):
            raise DecisionError("delegate.receipt", started_key, started_value, "ISO-8601 UTC string")
        if not isinstance(finished_value, str):
            raise DecisionError("delegate.receipt", finished_key, finished_value, "ISO-8601 UTC string")
        started = iso8601_utc(started_value, started_key)
        finished = iso8601_utc(finished_value, finished_key)
        if datetime.fromisoformat(finished[:-1] + "+00:00") < datetime.fromisoformat(started[:-1] + "+00:00"):
            raise DecisionError("observation.time_order", finished_key, finished, f">= {started_key}")
        duration = receipt.get(duration_key, MISSING)
        rc = receipt.get(rc_key, MISSING)
        if not isinstance(duration, int) or isinstance(duration, bool):
            raise DecisionError("delegate.receipt", duration_key, duration, "non-negative integer")
        if not isinstance(rc, int) or isinstance(rc, bool):
            raise DecisionError("delegate.receipt", rc_key, rc, "non-negative integer")
        nullable_nonnegative(duration, duration_key)
        nullable_nonnegative(rc, rc_key)

        repo = control_repo(Path(repo_value))
        track_dir, rel_track = track_location(repo, track)
        payload = {
            "schema_version": 1,
            "track": track,
            "run_id": run_id,
            "controller": "delegate-codex",
            "event": args.event,
            "label": label,
            "started_at": started,
            "finished_at": finished,
            "duration_ms": duration,
            "exit_code": rc,
            "actual": {
                "adapter": "delegate-codex",
                "model": model,
                "risk": None,
                "degraded": False,
                "work_exit_code": rc,
                "legs": None,
            },
            "usage": {
                "input_tokens": None,
                "output_tokens": None,
                "total_tokens": None,
                "api_cost": None,
                "billing_mode": "subscription",
            },
        }
        rel_file = write_observation(track_dir, rel_track, payload)
    except (DecisionError, OSError, json.JSONDecodeError) as exc:
        if isinstance(exc, DecisionError):
            return block(exc)
        return block(DecisionError("delegate.receipt", "receipt", str(exc), "readable compact JSON receipt"))
    print(f"track-record: observed file={rel_file}")
    return 0


def metric(values: list[int | float | None]) -> dict[str, Any]:
    known = [value for value in values if value is not None]
    unknown = len(values) - len(known)
    known_total: int | float | None = sum(known) if known else None
    return {
        "value": known_total if known and unknown == 0 else None,
        "known_total": known_total,
        "known_events": len(known),
        "unknown_events": unknown,
    }


def empty_cost() -> dict[str, Any]:
    return {
        "execution_duration_ms": None,
        "receive_duration_ms": None,
        "input_tokens": metric([]),
        "output_tokens": metric([]),
        "total_tokens": metric([]),
        "api_cost": metric([]),
        "billing_modes": [],
    }


def observation_for_ledger(path: Path, track: str) -> dict[str, Any]:
    if path.is_symlink() or not path.is_file():
        raise DecisionError("ledger.observation", "observations", os.fspath(path), "non-symlink JSON file")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise DecisionError("ledger.observation", "observations", str(exc), "valid UTF-8 JSON") from exc
    if not isinstance(value, dict):
        raise DecisionError("ledger.observation", "observations", type(value).__name__, "JSON object")
    if value.get("schema_version") != 1 or value.get("track") != track:
        raise DecisionError(
            "ledger.observation",
            "observations.track",
            {"schema_version": value.get("schema_version"), "track": value.get("track")},
            {"schema_version": 1, "track": track},
        )
    if value.get("event") not in EVENTS or value.get("controller") not in CONTROLLERS:
        raise DecisionError("ledger.observation", "observations.event", value.get("event"), "known controller/event")
    for key in ("run_id", "label"):
        if not isinstance(value.get(key), str):
            raise DecisionError("ledger.observation", f"observations.{key}", value.get(key), "string")
    for key in ("duration_ms", "exit_code"):
        field = value.get(key)
        if not isinstance(field, int) or isinstance(field, bool) or field < 0:
            raise DecisionError("ledger.observation", f"observations.{key}", field, "non-negative integer")
    actual = value.get("actual")
    usage = value.get("usage")
    if not isinstance(actual, dict) or not isinstance(usage, dict):
        raise DecisionError("ledger.observation", "observations.actual/usage", None, "objects")
    if not isinstance(actual.get("adapter"), str):
        raise DecisionError("ledger.observation", "observations.actual.adapter", actual.get("adapter"), "string")
    if actual.get("model") is not None and not isinstance(actual.get("model"), str):
        raise DecisionError("ledger.observation", "observations.actual.model", actual.get("model"), "null or string")
    legs = actual.get("legs")
    if legs is not None and not isinstance(legs, list):
        raise DecisionError("ledger.observation", "observations.actual.legs", legs, "null or array")
    for key in ("input_tokens", "output_tokens", "total_tokens", "api_cost"):
        field = usage.get(key)
        if field is not None and (isinstance(field, bool) or not isinstance(field, (int, float)) or field < 0):
            raise DecisionError("ledger.observation", f"observations.usage.{key}", field, "null or non-negative number")
    if usage.get("billing_mode") is not None and usage.get("billing_mode") not in BILLING_MODES:
        raise DecisionError(
            "ledger.observation",
            "observations.usage.billing_mode",
            usage.get("billing_mode"),
            "null|subscription|api|local",
        )
    return value


def ledger_track(track_dir: Path, location: str) -> tuple[dict[str, Any], list[dict[str, Any]]]:
    name = track_dir.name
    decision: dict[str, Any] | None = None
    status = "legacy"
    record_error: dict[str, Any] | None = None
    try:
        decision = load_decision(track_dir, "working")
        if decision is not None:
            validate_shape(decision, track_dir)
            status = "typed"
    except DecisionError as exc:
        status = "invalid"
        decision = None
        record_error = {
            "rule": exc.rule,
            "path": exc.path,
            "actual": None if exc.actual is MISSING else exc.actual,
            "expected": exc.expected,
        }

    observations: list[dict[str, Any]] = []
    invalid_observations = 0
    obs_dir = track_dir / "observations"
    if obs_dir.is_dir() and not obs_dir.is_symlink():
        for path in sorted(obs_dir.glob("*.json"), key=lambda item: item.name):
            try:
                observations.append(observation_for_ledger(path, name))
            except DecisionError:
                invalid_observations += 1

    executions = [item for item in observations if item["event"] == "execution_finished"]
    receives = [item for item in observations if item["event"] == "received"]
    execution_duration = sum(item["duration_ms"] for item in executions) if executions else None
    receive_duration = sum(item["duration_ms"] for item in receives) if receives else None
    usage_metrics = {
        key: metric([item["usage"].get(key) for item in executions])
        for key in ("input_tokens", "output_tokens", "total_tokens", "api_cost")
    }
    billing_modes = sorted(
        {item["usage"].get("billing_mode") for item in executions if item["usage"].get("billing_mode") is not None}
    )

    panel_legs = [leg for item in executions for leg in (item["actual"].get("legs") or [])]
    dispatch_count = sum(len(item["actual"].get("legs") or []) or 1 for item in executions)
    failed_legs = sum(1 for leg in panel_legs if leg.get("exit_code") != 0)
    degraded = sum(1 for item in executions if item["actual"].get("degraded") is True)
    degraded += sum(1 for leg in panel_legs if leg.get("degraded") is True)

    impact = decision["impact"]["level"] if decision is not None else None
    uncertainty = decision["design"]["uncertainty"] if decision is not None else None
    planned = (
        {
            "adapter": decision["execution_plan"]["adapter"],
            "model": decision["execution_plan"]["model"],
        }
        if decision is not None
        else {"adapter": None, "model": None}
    )
    outcome = decision["outcome"]["verdict"] if decision is not None else None

    primary_controllers = {
        "delegate-codex": "delegate-codex",
        "panel-review": "panel-review",
        "runlog": "runlog",
    }
    primary_name = primary_controllers.get(planned["adapter"])
    primary = [item for item in executions if item["controller"] == primary_name] if primary_name else []
    adapter_mismatch: bool | None = None
    model_mismatch: bool | None = None
    if primary and planned["adapter"] is not None:
        adapter_mismatch = any(item["actual"].get("adapter") != planned["adapter"] for item in primary)
    if primary and planned["model"] is not None:
        model_mismatch = any(item["actual"].get("model") != planned["model"] for item in primary)

    missing: list[str] = []
    if invalid_observations:
        missing.append("valid_observations")
    if status == "typed" and outcome == "PASS":
        if not executions:
            missing.append("execution_finished")
        elif not any(item["exit_code"] == 0 for item in executions):
            missing.append("successful_execution_finished")
        delegate_runs = {item["run_id"] for item in executions if item["controller"] == "delegate-codex"}
        received_ok = {item["run_id"] for item in receives if item["exit_code"] == 0}
        for run_id in sorted(delegate_runs - received_ok):
            missing.append(f"received:{run_id}")
    eligible = status == "typed" and outcome == "PASS" and not missing

    item = {
        "track": name,
        "location": location,
        "record_status": status,
        "record_error": record_error,
        "impact_level": impact,
        "design_uncertainty": uncertainty,
        "planned": planned,
        "outcome": outcome,
        "coverage": {
            "events": len(observations),
            "execution_finished": len(executions),
            "received": len(receives),
            "invalid_observations": invalid_observations,
        },
        "quality": {
            "controller_runs": len(executions),
            "dispatch_count": dispatch_count,
            "failed_controller_runs": sum(1 for item in executions if item["exit_code"] != 0),
            "panel_legs": len(panel_legs),
            "failed_panel_legs": failed_legs,
            "degraded_runs_or_legs": degraded,
        },
        "cost": {
            "execution_duration_ms": execution_duration,
            "receive_duration_ms": receive_duration,
            **usage_metrics,
            "billing_modes": billing_modes,
        },
        "mismatch": {"adapter": adapter_mismatch, "model": model_mismatch},
        "successful_cost_eligible": eligible,
        "missing": missing,
    }
    return item, executions


def aggregate_cost(items: list[tuple[dict[str, Any], list[dict[str, Any]]]]) -> dict[str, Any]:
    executions = [event for _, events in items for event in events]
    total = {
        "track_count": len(items),
        "execution_duration_ms": sum(event["duration_ms"] for event in executions) if executions else None,
        **{
            key: metric([event["usage"].get(key) for event in executions])
            for key in ("input_tokens", "output_tokens", "total_tokens", "api_cost")
        },
    }
    by_mode: dict[str, Any] = {}
    for mode in (*BILLING_MODES, "unknown"):
        selected = [
            (item, [event for event in events if (event["usage"].get("billing_mode") or "unknown") == mode])
            for item, events in items
        ]
        selected = [(item, events) for item, events in selected if events]
        events = [event for _, group in selected for event in group]
        by_mode[mode] = {
            "track_count": len(selected),
            "execution_duration_ms": sum(event["duration_ms"] for event in events) if events else None,
            **{
                key: metric([event["usage"].get(key) for event in events])
                for key in ("input_tokens", "output_tokens", "total_tokens", "api_cost")
            },
        }
    total["by_billing_mode"] = by_mode
    return total


def ledger_data(repo: Path) -> dict[str, Any]:
    locations: list[tuple[Path, str]] = []
    active = repo / "tracks"
    archive = active / "archive"
    if active.is_dir() and not active.is_symlink():
        locations.extend(
            (path, "active")
            for path in active.iterdir()
            if path.name != "archive" and path.is_dir() and not path.is_symlink()
        )
    if archive.is_dir() and not archive.is_symlink():
        locations.extend(
            (path, "archive") for path in archive.iterdir() if path.is_dir() and not path.is_symlink()
        )
    results = [ledger_track(path, location) for path, location in sorted(locations, key=lambda pair: pair[0].name)]
    tracks = [item for item, _ in results]
    eligible = [result for result in results if result[0]["successful_cost_eligible"]]
    successful = [item for item in tracks if item["record_status"] == "typed" and item["outcome"] == "PASS"]
    return {
        "schema_version": 1,
        "source": ["decision.json", "observations/*.json"],
        "summary": {
            "tracks_total": len(tracks),
            "typed_tracks": sum(1 for item in tracks if item["record_status"] == "typed"),
            "legacy_tracks": sum(1 for item in tracks if item["record_status"] == "legacy"),
            "invalid_tracks": sum(1 for item in tracks if item["record_status"] == "invalid"),
            "successful_tracks": len(successful),
            "successful_cost_eligible": len(eligible),
            "successful_cost_missing": sorted(
                item["track"] for item in successful if not item["successful_cost_eligible"]
            ),
            "successful_cost": aggregate_cost(eligible),
        },
        "tracks": tracks,
    }


def markdown_ledger(data: dict[str, Any]) -> str:
    lines = [
        "# aiwork cost-quality ledger",
        "",
        "| Track | Location | Record | Outcome | Impact | Runs | Dispatches | Duration ms | Tokens | API cost | Eligible | Missing |",
        "|---|---|---|---|---|---:|---:|---:|---:|---:|---|---|",
    ]
    for item in data["tracks"]:
        cost = item["cost"]
        token_value = cost["total_tokens"]["value"]
        api_value = cost["api_cost"]["value"]
        lines.append(
            "| "
            + " | ".join(
                (
                    item["track"],
                    item["location"],
                    item["record_status"],
                    item["outcome"] or "unknown",
                    item["impact_level"] or "unknown",
                    str(item["quality"]["controller_runs"]),
                    str(item["quality"]["dispatch_count"]),
                    str(cost["execution_duration_ms"] if cost["execution_duration_ms"] is not None else "unknown"),
                    str(token_value if token_value is not None else "unknown"),
                    str(api_value if api_value is not None else "unknown"),
                    "yes" if item["successful_cost_eligible"] else "no",
                    ",".join(item["missing"]) or "-",
                )
            )
            + " |"
        )
    summary = data["summary"]
    lines.extend(
        (
            "",
            f"Successful cost coverage: {summary['successful_cost_eligible']}/{summary['successful_tracks']}",
            "Unknown remains unknown; legacy prose and raw logs are not parsed.",
        )
    )
    return "\n".join(lines) + "\n"


def ledger(args: argparse.Namespace) -> int:
    repo = control_repo(args.repo)
    if not repo.is_dir() or not (repo / "tracks").is_dir():
        return block(DecisionError("ledger.repository", "repo", os.fspath(repo), "repository with tracks/"))
    try:
        data = ledger_data(repo)
    except OSError as exc:
        return block(DecisionError("ledger.read", "tracks", str(exc), "readable decision/observation files"))
    if args.format == "json":
        print(json.dumps(data, ensure_ascii=False, indent=2, sort_keys=False))
    else:
        print(markdown_ledger(data), end="")
    return 0


def parser() -> argparse.ArgumentParser:
    top = argparse.ArgumentParser(prog="track-record")
    commands = top.add_subparsers(dest="command", required=True)
    check = commands.add_parser("validate", help="validate a track decision")
    check.add_argument("--phase", required=True, choices=("shape", "dispatch", "archive"))
    check.add_argument("--source", default="working", choices=("working", "staged"))
    check.add_argument("--expected-impact", choices=IMPACT_LEVELS)
    check.add_argument("track_dir", type=Path)
    event = commands.add_parser("observe", help="write one compact controller observation")
    event.add_argument("--repo", required=True, type=Path)
    event.add_argument("--track", required=True)
    event.add_argument("--run-id", required=True)
    event.add_argument("--controller", required=True, choices=CONTROLLERS)
    event.add_argument("--event", required=True, choices=EVENTS)
    event.add_argument("--label", required=True)
    event.add_argument("--started-at", required=True)
    event.add_argument("--finished-at", required=True)
    event.add_argument("--duration-ms", required=True, type=int)
    event.add_argument("--exit-code", required=True, type=int)
    event.add_argument("--adapter", required=True)
    event.add_argument("--work-exit-code", required=True, type=int)
    event.add_argument("--model")
    event.add_argument("--risk", choices=IMPACT_LEVELS)
    event.add_argument("--degraded", choices=("null", "true", "false"))
    event.add_argument("--input-tokens", type=int)
    event.add_argument("--output-tokens", type=int)
    event.add_argument("--total-tokens", type=int)
    event.add_argument("--api-cost", type=float)
    event.add_argument("--billing-mode", choices=BILLING_MODES)
    event.add_argument(
        "--leg",
        action="append",
        help="panel leg: name,family,adapter,exit_code,verdict|null,degraded(true|false)",
    )
    delegated = commands.add_parser("import-delegate", help="import compact fields from a delegate receipt")
    delegated.add_argument("--receipt", required=True, type=Path)
    delegated.add_argument("--event", required=True, choices=EVENTS)
    report = commands.add_parser("ledger", help="derive a read-only cost/quality ledger")
    report.add_argument("--repo", required=True, type=Path)
    report.add_argument("--format", default="json", choices=("json", "markdown"))
    return top


def main() -> int:
    args = parser().parse_args()
    if args.command == "validate":
        if not args.track_dir.is_dir():
            return block(DecisionError("track.directory", "track_dir", os.fspath(args.track_dir), "existing directory"))
        return validate(args.track_dir.resolve(), args.phase, args.source, args.expected_impact)
    if args.command == "observe":
        return observe(args)
    if args.command == "import-delegate":
        return import_delegate(args)
    if args.command == "ledger":
        return ledger(args)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
