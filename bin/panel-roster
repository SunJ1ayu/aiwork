#!/usr/bin/env bash
# panel-roster <日志前缀> —— 从盘上重建 panel-review 的花名册。
#
# 存在的理由(两次真事故):控制器被杀之后整轮零记录,而腿的完整日志就躺在盘上。
# 08-23 我手工翻日志重建了一遍花了 20 分钟;08-19 那次我没重建,
# 于是"原因不明"被写进了记忆、也讲给了业主。**这条命令就是那 20 分钟。**
#
# 它是纯函数:同样的盘上状态,算多少遍都一样;控制器活着与否都能算。
set -uo pipefail
. "$(dirname "$0")/_panel-roster-lib.sh"

usage() { cat >&2 <<'U'
用法: panel-roster <日志前缀>
  例: panel-roster /root/aiwork/logs/panel-minanim-r3
读 <前缀>.plan / <前缀>.<腿>.state / <前缀>.final,打印花名册到 stdout。
派出去却没有 state 的腿印成 KILLED(未收尾) —— 不许读成通过。
U
}
[[ $# -eq 1 && "$1" != "-h" && "$1" != "--help" ]] || { usage; exit 64; }
render_roster "$1"
