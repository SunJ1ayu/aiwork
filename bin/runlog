#!/usr/bin/env bash
# runlog —— 让**机器**写下它跑了什么(2026-08-08,track machine-evidence-gate)。
#
# 为什么有它:verify.md 里的判据结果一直是我打字写进去的。我可能真跑过,也可能记错、
# 跑了一半、把「跳过」读成「通过」——**从字面上分辨不出来**。08-05 turn_id 那单就是
# 这个形状:我写「python 866/0」,听起来完美,实际上回归用的解释器没装 mcp,
# 一整块闸被整块 SKIP,汇总照印 OK。**汇总会撒谎,细节不会。**
#
#   runlog [--final] -t <track> [-n <slug>] [--repo <dir>] -- <命令...>
#
# ⚠️ **跑 `--final` 的那段时间里,任何人都不许写这个仓库** —— 包括并发的后台任务、
#    panel-review 收尾往 observations 写、以及你自己顺手编辑工件。跑完发现仓库变过,
#    它会判 `source-stable: no` 并把 rc 变成 **65**(命令本身的 rc 另记在 command-rc)。
#    那不是「命令失败了」,是「这遍不能当最终证据」。2026-08-24 一天撞两次立的。
#
# 它做四件事:
#   1. 在**跑之前**记下 commit 和工作树脏不脏(顺序不能反 —— 收据文件本身会弄脏工作树);
#   2. 跑命令,输出先在仓外缓冲；扫描安全后再回显并写入收据(stdout/stderr 合并);
#   3. 收据落进 tracks/<track>/evidence/<UTC时间戳>-<序号>-<slug>.txt,
#      文件名字典序 = 时间序(track-guard 规矩5b 取「最后一份」靠这个);
#   4. 末行打印一行**收据行**,粘进 verify.md。守卫会逐字节比对。
#
# 退出码:**原样透传被跑的命令**。runlog 要是把红的跑成绿的,它就成了它要堵的那种病。
#         用法错误用 64(发生在任何命令开跑之前,且不留下任何文件)。
#
# 强度声明:手改收据文件仍然骗得过守卫。这道闸堵的是**顺手四舍五入**,不是蓄意伪造。
set -uo pipefail

die() { printf 'runlog: %s\n' "$*" >&2; exit 64; }

has_secret_shape() {
  LC_ALL=C grep -aEq \
    'sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|AIza[A-Za-z0-9_-]{20,}|AKIA[A-Z0-9]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
}

source_view_repo() {  # source_view_repo <repo> [排除的仓内路径]
  local repo="$1" exclude_rel="${2:-}" rel path kind mode digest nested head
  {
    git -C "$repo" ls-files -co --exclude-standard -z \
      | LC_ALL=C sort -z \
      | while IFS= read -r -d '' rel; do
          [[ -n "$exclude_rel" && "$rel" = "$exclude_rel" ]] && continue
          path="$repo/$rel"
          if [ -L "$path" ]; then
            kind=symlink; mode="$(stat -c '%A' -- "$path" 2>/dev/null || echo missing)"
            digest="$(readlink -- "$path" 2>/dev/null | sha256sum | awk '{print $1}')"
          elif [ -f "$path" ]; then
            kind=file; mode="$(stat -c '%A' -- "$path" 2>/dev/null || echo missing)"
            digest="$(sha256sum < "$path" | awk '{print $1}')"
          elif [ -d "$path" ] && [ -e "$path/.git" ]; then
            # 外仓把 submodule 记成一个 gitlink；实际测试视图还要绑定它当前
            # checkout 的 HEAD 和内部 tracked/non-ignored 内容，不能只哈目录名。
            kind=gitlink; mode="$(stat -c '%A' -- "$path" 2>/dev/null || echo missing)"
            head="$(git -C "$path" rev-parse HEAD 2>/dev/null || echo nocommit)"
            nested="$(source_view_repo "$path")"
            digest="$(printf '%s\0%s' "$head" "$nested" | sha256sum | awk '{print $1}')"
          elif [ -d "$path" ]; then
            kind=directory; mode="$(stat -c '%A' -- "$path" 2>/dev/null || echo missing)"; digest=-
          else
            kind=missing; mode=-; digest=-
          fi
          printf '%s\0%s\0%s\0%s\0' "$rel" "$kind" "$mode" "$digest"
        done
  } | sha256sum | awk '{print $1}'
}

source_view() {  # tracked + non-ignored untracked；排除本次 receipt 本身
  source_view_repo "$REPO" "$1"
}

TRACK=""; SLUG=""; REPO=""; FINAL=0
while [ $# -gt 0 ]; do
  case "$1" in
    --final)     FINAL=1; shift ;;
    -t|--track) TRACK="${2:-}"; shift 2 || die "-t 后面要跟 track 名" ;;
    -n|--name)  SLUG="${2:-}";  shift 2 || die "-n 后面要跟 slug" ;;
    --repo)     REPO="${2:-}";  shift 2 || die "--repo 后面要跟目录" ;;
    -h|--help)  sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 0 ;;
    --)         shift; break ;;
    *)          die "不认识的参数 '$1'(命令要写在 -- 后面)" ;;
  esac
done

[ -n "$TRACK" ] || die "缺 -t <track>"
[ $# -gt 0 ]    || die "-- 后面没有命令"
# track 名直接拼进路径,所以先把范围钉死:`-t ../../x` 只要那个目录存在,
# 收据就会写到**仓外**去。runlog 是新增的写口,写口的第一件事是划边界。
case "$TRACK" in
  */*|*..*|-*) die "track 名里不许有斜杠、'..' 或打头的 '-':$TRACK" ;;
  .|archive)   die "'$TRACK' 不是 track 名(它是 tracks/ 或归档目录)" ;;
esac

if [ -z "$REPO" ]; then
  REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || true
  [ -n "$REPO" ] || die "不在 git 仓里(用 --repo 指一个)"
fi
[ -d "$REPO" ] || die "--repo 指的目录不存在:$REPO"

# track 目录:进行中的和已归档的都认(收尾常在归档前后来回)
REL="tracks/$TRACK"
[ -d "$REPO/$REL" ] || REL="tracks/archive/$TRACK"
[ -d "$REPO/$REL" ] || die "找不到 track:$REPO/tracks/$TRACK(也不在 archive/ 里)"

# argv 会原样进入 cmd 字段。先扫、后运行、后写文件；命中时不回显原文。
for ARG in "$@"; do
  if printf '%s' "$ARG" | has_secret_shape; then
    die "命令参数疑似包含秘密，已在执行和写收据前拒绝；请改用脱敏参数"
  fi
done
unset ARG

# slug 默认取命令的第一个词,清干净只留 [A-Za-z0-9._-]
if [ -z "$SLUG" ]; then
  SLUG="$(basename -- "$1")"
  SLUG="${SLUG%.sh}"
fi
SLUG="$(printf '%s' "$SLUG" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//; s/-*$//')"
[ -n "$SLUG" ] || SLUG="run"
# observation schema 的 label 上限是 128；这里先收口，不能让命令成功后
# 只因 producer 生成了过长标签而丢失账本事件。清洗后只剩 ASCII，按字节截安全。
SLUG="${SLUG:0:128}"

# ---- 身份:必须在跑之前、写任何文件之前采 ----
COMMIT="$(git -C "$REPO" rev-parse --short=7 HEAD 2>/dev/null || echo nocommit)"
# 未跟踪文件也算脏:闸① 的教训 —— 未跟踪文件在 diff 里是隐形的,而它恰恰是
# 「这次跑的到底是什么代码」最容易失真的地方(往 tests/ 里塞一个 conftest.py)。
if [ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]; then DIRTY=yes; else DIRTY=no; fi
TS="$(date -u +%Y%m%dT%H%M%SZ)"
AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
START_NS="$(date +%s%N)"

EVDIR="$REPO/$REL/evidence"
mkdir -p "$EVDIR" || die "建不了 $EVDIR"
# 序号 = 同一秒里的第几份。**不能只靠 slug 去重**:同一秒跑 c、b、a 三条,
# 光看文件名字典序会排成 a<b<c,和时间序正好反过来 ⇒ 规矩5b 会挑错「最后一份」。
# 用 noclobber 原子占位,不是「先看在不在、再创建」——那中间有空隙,
# 同秒并发的两个 runlog 会算出同一个序号、写同一个文件(四审 subkimi F5)。
n=$(find "$EVDIR" -maxdepth 1 -name "$TS-*" 2>/dev/null | wc -l)
while :; do
  n=$((n+1))
  FILE="$EVDIR/$TS-$(printf '%02d' "$n")-$SLUG.txt"
  if (set -C; : > "$FILE") 2>/dev/null; then break; fi
  [ "$n" -lt 99 ] || die "同一秒里已经有 99 份收据了,这不正常"
done
RELFILE="$REL/evidence/$(basename "$FILE")"

CMDSTR="$(printf '%q ' "$@")"; CMDSTR="${CMDSTR% }"

HEAD_BEFORE=""; SOURCE_BEFORE=""
if [ "$FINAL" -eq 1 ]; then
  HEAD_BEFORE="$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo nocommit)"
  SOURCE_BEFORE="$(source_view "$RELFILE")"
fi

{
  printf '# runlog receipt —— 机器写的,别手改(改了守卫看不出来,但闸③ 会在 diff 里看见)\n'
  printf 'slug:    %s\n' "$SLUG"
  printf 'cmd:     %s\n' "$CMDSTR"
  printf 'cwd:     %s(仓根)\n' "$REPO"
  printf 'commit:  %s\n' "$COMMIT"
  printf 'dirty:   %s(跑之前采的;含未跟踪文件)\n' "$DIRTY"
  if [ "$FINAL" -eq 1 ]; then
    printf 'head-before: %s\n' "$HEAD_BEFORE"
    printf 'source-view-before: sha256:%s\n' "$SOURCE_BEFORE"
  fi
  printf 'started: %s\n' "$AT"
  printf -- '---------------- 输出开始 ----------------\n'
} > "$FILE"

# 横幅**不许**以 `runlog: ` 打头:那样它和下面该粘的收据行长得一模一样,
# 顺手粘错一行就是一次莫名其妙的 5a 挡下(四审 subdeepseek L7)。
printf '[runlog] 跑 %s @%s dirty=%s → %s\n' "$CMDSTR" "$COMMIT" "$DIRTY" "$RELFILE" >&2

OUTFILE=""
if ! OUTFILE="$(mktemp)" || [ -z "$OUTFILE" ]; then
  rm -f "$FILE"
  die "建不了仓外输出缓冲，原命令未执行"
fi
if ! chmod 600 "$OUTFILE"; then
  rm -f "$FILE" "$OUTFILE"
  die "锁不住仓外输出缓冲权限，原命令未执行"
fi
trap 'rm -f "${OUTFILE:-}"' EXIT HUP INT TERM
( cd "$REPO" && "$@" ) > "$OUTFILE" 2>&1
RC="$?"

# 所有 receipt 都可能进 Git，所以 final / non-final 不能有两套秘密边界。
# 确认安全前也不回显：否则虽然删了 receipt，秘密仍已经泄到终端日志。
if has_secret_shape < "$OUTFILE"; then
  rm -f "$FILE" "$OUTFILE"
  printf 'runlog: 命令输出疑似包含秘密；已抑制原文并拒绝形成收据，请先脱敏\n' >&2
  exit 65
fi
tee -a "$FILE" < "$OUTFILE"
rm -f "$OUTFILE"; OUTFILE=""
trap - EXIT HUP INT TERM

COMMAND_RC="$RC"
FINAL_FIELD=""; SOURCE_STABLE=""
if [ "$FINAL" -eq 1 ]; then
  HEAD_AFTER="$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo nocommit)"
  SOURCE_AFTER="$(source_view "$RELFILE")"
  SOURCE_STABLE=yes
  if [ "$HEAD_BEFORE" != "$HEAD_AFTER" ] || [ "$SOURCE_BEFORE" != "$SOURCE_AFTER" ]; then
    SOURCE_STABLE=no
    [ "$RC" -ne 0 ] || RC=65
    # 🔴 **当场把话说清楚,别只把 rc 悄悄改成 65。**
    #    收据文件里本来就写着 `source-stable: no`,可 2026-08-24 那天我两次撞上 65,
    #    看着收据也没懂,还得 `sed -n` 翻这个文件才明白 —— 缺的从来不是记录,
    #    是**跑的人当场看得见的一句人话**。
    #    打到 stderr:stdout 已经 tee 进收据了,而这段是给人看的,不该混进证据。
    {
      printf '\n'
      # rc 用 $RC 打,**不许写死 65**:65 只在命令自己绿的时候才加(见上面那行判定)。
      # 命令红 + 漂移时 rc 保持命令自己的,写死 65 就是让人在屏幕上找一个不存在的数
      # (2026-08-24 panel subdeepseek 抓到,判据 A6)。
      printf 'runlog: 🔴 这份 --final 收据不算数(rc=%s)——跑的过程中,这个仓库被改动过。\n' "$RC"
      printf '        --final 的意思是「这是最后一遍」,而它跑的那个快照已经不是现在这个了。\n'
      [ "$HEAD_BEFORE" != "$HEAD_AFTER" ] && \
        printf '        变的是 HEAD:%s → %s\n' "${HEAD_BEFORE:0:7}" "${HEAD_AFTER:0:7}"
      [ "$SOURCE_BEFORE" != "$SOURCE_AFTER" ] && \
        printf '        变的是工作树里的源码(收据文件自己已排除在外,不是它造成的)。\n'
      printf '        怎么办:让工作树静下来,确认没人在写,再重跑一遍。\n'
      printf '        常见元凶(按撞见频次):\n'
      printf '          · 并发的后台任务 —— 总跑/回归/红检和这一趟同时在跑;\n'
      printf '          · panel-review 收尾时往仓内 tracks/*/observations/ 写事件;\n'
      printf '          · **自己**在收据跑的过程中编辑 verify.md / 工件。\n'
      if [ "$COMMAND_RC" -eq 0 ]; then
        printf '        命令本身是绿的(收据里 command-rc: 0)。65 是 runlog 加的,\n'
        printf '        它说的是「这遍不能当最终证据」,不是「你的命令失败了」。\n'
      else
        printf '        命令本身也失败了(收据里 command-rc: %s),所以这次的退出码就是它 ——\n' "$COMMAND_RC"
        printf '        runlog 只在命令绿时才把 rc 换成 65,这一路看不到 65:两件事都得修。\n'
      fi
    } >&2
  fi
  FINAL_FIELD=" final=yes"
fi

LINE="runlog: $SLUG rc=$RC commit=$COMMIT dirty=$DIRTY${FINAL_FIELD} at=$AT file=$RELFILE"
{
  if [ "$FINAL" -eq 1 ]; then
    printf 'command-rc: %s\n' "$COMMAND_RC"
    printf 'head-after: %s\n' "$HEAD_AFTER"
    printf 'source-view-after:  sha256:%s\n' "$SOURCE_AFTER"
    printf 'source-stable: %s\n' "$SOURCE_STABLE"
  fi
  printf -- '---------------- 输出结束 ----------------\n'
  printf '%s\n' "$LINE"
} >> "$FILE"

# 紧凑观测只收白名单元数据；完整 argv/output 继续只在可清理 receipt。
# writer 失败必须可见，但不能把原命令的 rc 改写成另一件事。
FINISHED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
END_NS="$(date +%s%N)"
DURATION_MS=$(( (END_NS - START_NS) / 1000000 ))
RUN_ID="$(basename "${FILE%.txt}")"
TRACK_RECORD_BIN="${TRACK_RECORD_BIN:-$(dirname "$0")/track-record}"
if ! "$TRACK_RECORD_BIN" observe \
    --repo "$REPO" --track "$TRACK" --run-id "$RUN_ID" \
    --controller runlog --event execution_finished --label "$SLUG" \
    --started-at "$AT" --finished-at "$FINISHED_AT" --duration-ms "$DURATION_MS" \
    --exit-code "$RC" --adapter runlog --work-exit-code "$COMMAND_RC" >/dev/null; then
  printf 'runlog: OBSERVATION_WRITE_FAILED track=%s run_id=%s (controller rc 保持 %s)\n' \
    "$TRACK" "$RUN_ID" "$RC" >&2
fi

{
  printf -- '---- 粘这一行进 verify.md(逐字节,别改数)----\n'
  printf '%s\n' "$LINE"
  printf -- '---- 完整输出:%s ----\n' "$RELFILE"
} >&2

exit "$RC"
