#!/usr/bin/env bash
set -uo pipefail

# panel-review - select healthy review employees for one task, run them in
# parallel, then let the main agent (the frontier model) arbitrate.
# The reviewer pool comes only from _panel-roster-lib.sh; no second leg list here.
#
# Each reviewer writes its own log; this script does NOT decide anything - it just
# fans out the work and reports where the reports landed.

BIN="$(dirname "$0")"

# verdict_of / roster 渲染 / 腿池都住在 _panel-roster-lib.sh —— **只许有一份**。
# usage 也从它渲染成员；否则新增腿时最先撒谎的就是 `--help`。
. "$BIN/_panel-roster-lib.sh" || {
  echo "🔴 panel-review: 找不到 $BIN/_panel-roster-lib.sh —— 花名册与腿池都在它里面,拒绝空跑。" >&2
  exit 70
}

usage() {
  cat >&2 <<'EOF'
Usage:
  panel-review [--track NAME|--no-track] TASK_FILE [REPO_DIR] [LOG_PREFIX]

Default: impact-risk=high, rotate 2 healthy reviewer families in parallel.
Failure, degraded fallback, missing verdict, NEEDS_MORE_INFO or conflict adds
one healthy spare. `--all` requests the entire current reviewer pool: every
enabled leg whose configured executable is available.

Reviewer pool (from _panel-roster-lib.sh):
EOF
  local spec name family agent chat switch fallback
  for spec in "${PANEL_LEG_SPECS[@]}"; do
    IFS='|' read -r name family agent chat switch <<< "$spec"
    fallback="${chat:+; chat fallback=$chat}"
    printf '  %-14s family=%-10s agent=%-20s switch=%s%s\n' \
      "$name" "$family" "$agent" "$switch" "$fallback" >&2
  done
  cat >&2 <<'EOF'

Args:
  TASK_FILE    markdown task/review brief (required)
  REPO_DIR     repo to review (default: $PWD)
  LOG_PREFIX   log path prefix (default: <tool-root>/logs/panel-<taskname>-<ts>)

Options / env:
  --risk self|standard|high  external-review budget 0 / 1 / 2 (default: high)
  --budget N                 explicit initial budget, 0..current pool size
  --all                      explicit full-pool review (special high risk)
  --track NAME               bind dispatch/observation to a typed track in the main repo
  --no-track                 explicitly state that this review belongs to no track
  PANEL_HEALTH_OVERRIDE      comma list, e.g. subkimi=quota,subglm=auth
  PANEL_STATE_DIR            rotation/health state (default: <tool-root>/logs/.panel-state)
  PANEL_HEALTH_COOLDOWN_SEC  failed/degraded leg cooldown (default: 21600)
  PANEL_HEALTH_DEAD_STREAK   连续这么多轮 rc≠0 就**停止轮换**该腿,冷却过了也不放回
                             (默认 3;0=关掉)。只有 rc≠0 计数——INCOMPLETE/DEGRADED
                             是 rc=0,腿产出了东西,算进去会把干活的腿踢掉。
                             放回:PANEL_HEALTH_OVERRIDE=<leg>=healthy(成功一次即清零)
  (my-review gate is DEFAULT-ON) With no flag, panel-review looks for the
                             convention file <tool-root>/tasks/<taskname>-my-review.md
                             (taskname = TASK_FILE basename) and REFUSES to dispatch
                             if it is absent - so forgetting to write your own review
                             stops the panel instead of silently skipping the gate.
  --require-my-review PATH   use PATH instead of the convention path (still must
                             exist and live OUTSIDE REPO_DIR - the engine inlines
                             untracked repo files into reviewer prompts).
  --no-my-review             explicit opt-out: run without the gate (a conscious
                             choice, e.g. a task that has no diff to self-review).
  PANEL_ORACLE_CMD           if set, run it (in REPO_DIR) BEFORE dispatching and
                             record 'ORACLE: <cmd> rc=<N>' + <prefix>.oracle.log.
                             Records only, never blocks: 07-04 lesson - three
                             reviewers PASSed a broken oracle nobody had run.

The main agent reads ALL logs and makes the final call. Reviewers are advisors,
not voters. A failure in one reviewer does not block the others.
EOF
}

MY_REVIEW=""
NO_MY_REVIEW=0
IMPACT_RISK="${PANEL_IMPACT_RISK:-high}"
REVIEW_BUDGET="${PANEL_REVIEW_BUDGET:-}"
ALL_REVIEWERS=0
TRACK_NAME=""
NO_TRACK=0
POSARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --require-my-review)
      MY_REVIEW="${2:-}"
      [[ -n "$MY_REVIEW" ]] || { echo "panel-review: --require-my-review needs a path" >&2; exit 2; }
      shift 2 ;;
    --no-my-review) NO_MY_REVIEW=1; shift ;;
    --risk)
      IMPACT_RISK="${2:-}"
      [[ -n "$IMPACT_RISK" ]] || { echo "panel-review: --risk needs self|standard|high" >&2; exit 2; }
      shift 2 ;;
    --budget)
      REVIEW_BUDGET="${2:-}"
      [[ -n "$REVIEW_BUDGET" ]] || { echo "panel-review: --budget needs a non-negative integer" >&2; exit 2; }
      shift 2 ;;
    --all) ALL_REVIEWERS=1; shift ;;
    --track)
      TRACK_NAME="${2:-}"
      [[ -n "$TRACK_NAME" ]] || { echo "panel-review: --track needs a name" >&2; exit 2; }
      shift 2 ;;
    --no-track) NO_TRACK=1; shift ;;
    *) POSARGS+=("$1"); shift ;;
  esac
done
set -- "${POSARGS[@]}"
if [[ $# -lt 1 || $# -gt 3 ]]; then usage; exit 2; fi

case "$IMPACT_RISK" in
  self) RISK_BUDGET=0 ;;
  standard) RISK_BUDGET=1 ;;
  high) RISK_BUDGET=2 ;;
  *) echo "panel-review: invalid --risk '$IMPACT_RISK' (need self|standard|high)" >&2; exit 2 ;;
esac
[[ -n "$REVIEW_BUDGET" ]] || REVIEW_BUDGET="$RISK_BUDGET"
POOL_SIZE="${#PANEL_LEGS_ORDER[@]}"
if [[ ! "$REVIEW_BUDGET" =~ ^(0|[1-9][0-9]*)$ ]] || (( REVIEW_BUDGET > POOL_SIZE )); then
  echo "panel-review: invalid review budget '$REVIEW_BUDGET' (need 0..$POOL_SIZE, derived from current pool)" >&2
  exit 2
fi
if [[ "$ALL_REVIEWERS" -eq 1 ]]; then REVIEW_BUDGET="$POOL_SIZE"; fi
# `--all` and an explicit maximum budget are the compatibility/high-risk path:
# retry the entire current pool even when a previous round cooled a leg down.
# Explicit off or a missing executable still wins.
FORCE_ALL=0
[[ "$ALL_REVIEWERS" -eq 1 || "$REVIEW_BUDGET" -eq "$POOL_SIZE" ]] && FORCE_ALL=1

TOOL_ROOT="$(cd "$BIN/.." && pwd -P)"
TASK_FILE="$1"
REPO_DIR="${2:-$PWD}"

[[ -f "$TASK_FILE" ]] || { echo "panel-review: task file not found: $TASK_FILE" >&2; exit 1; }
[[ -d "$REPO_DIR" ]]  || { echo "panel-review: repo dir not found: $REPO_DIR" >&2; exit 1; }

[[ -z "$TRACK_NAME" || "$NO_TRACK" -eq 0 ]] || {
  echo "panel-review: --track and --no-track are mutually exclusive" >&2; exit 2; }

# A review may target an isolated worktree, but durable controller facts must land in
# the main checkout that owns the common Git dir; otherwise archive sweep deletes them.
CONTROL_REPO="$(realpath "$REPO_DIR")"
_common="$(git -C "$REPO_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
if [[ -n "$_common" && "$(basename "$_common")" == ".git" ]]; then
  CONTROL_REPO="$(dirname "$_common")"
fi
unset _common

TRACK_RECORD_BIN="${TRACK_RECORD_BIN:-$(dirname "$0")/track-record}"
_typed_active=()
if [[ -d "$CONTROL_REPO/tracks" ]]; then
  while IFS= read -r _decision; do
    _typed_active+=("$(basename "$(dirname "$_decision")")")
  done < <(find "$CONTROL_REPO/tracks" -mindepth 2 -maxdepth 2 -type f -name decision.json \
           -not -path '*/archive/*' -print 2>/dev/null | sort)
fi
if [[ -z "$TRACK_NAME" && "$NO_TRACK" -eq 0 && "${#_typed_active[@]}" -gt 0 ]]; then
  echo "panel-review: typed active track exists; choose --track NAME or --no-track before dispatch" >&2
  printf '  active: %s\n' "${_typed_active[*]}" >&2
  exit 2
fi
if [[ -n "$TRACK_NAME" ]]; then
  case "$TRACK_NAME" in
    */*|*..*|-*|.|archive) echo "panel-review: invalid --track '$TRACK_NAME'" >&2; exit 2 ;;
  esac
  TRACK_DIR="$CONTROL_REPO/tracks/$TRACK_NAME"
  [[ -d "$TRACK_DIR" ]] || { echo "panel-review: active track not found: $TRACK_DIR" >&2; exit 2; }
  if ! "$TRACK_RECORD_BIN" validate --phase dispatch --expected-impact "$IMPACT_RISK" "$TRACK_DIR"; then
    echo "panel-review: typed track is not dispatch-ready or --risk mismatches; no leg was started" >&2
    exit 2
  fi
  if [[ "$REVIEW_BUDGET" -lt "$RISK_BUDGET" ]]; then
    echo "panel-review: typed track budget=$REVIEW_BUDGET is below impact-risk=$IMPACT_RISK minimum=$RISK_BUDGET; no leg was started" >&2
    exit 2
  fi
fi
unset _decision _typed_active

# The my-review gate is DEFAULT-ON. Unless explicitly opted out, resolve a path:
# an explicit --require-my-review wins; otherwise derive the convention path from
# the task name. Then require it to exist and to live outside the repo. This flips
# the anti-anchoring discipline from "remember to arm it" to "forgetting stops you".
if [[ $NO_MY_REVIEW -eq 0 && -z "$MY_REVIEW" ]]; then
  MY_REVIEW="$TOOL_ROOT/tasks/$(basename "${TASK_FILE%.*}")-my-review.md"
fi
if [[ $NO_MY_REVIEW -eq 0 ]]; then
  if [[ ! -f "$MY_REVIEW" ]]; then
    echo "panel-review: my-review file not found: $MY_REVIEW" >&2
    echo "  write your OWN review there first (anti-anchoring), then dispatch;" >&2
    echo "  or pass --no-my-review to consciously opt out." >&2
    exit 1
  fi
  RPD="$(realpath "$REPO_DIR")"
  # Check BOTH the symlink-resolved path AND the lexical path (realpath -s, which
  # resolves .. but does NOT follow a final-component symlink). A review file that
  # is physically a symlink inside the repo resolves outside via plain realpath but
  # is still listed by `git ls-files --others` and read-followed by the engine -
  # so the lexical location is what actually decides the leak.
  for MRV in "$(realpath "$MY_REVIEW")" "$(realpath -s "$MY_REVIEW")"; do
    case "$MRV" in
      "$RPD"/*)
        echo "panel-review: my-review file is INSIDE the repo under review: $MRV" >&2
        echo "  the engine inlines untracked repo files into reviewer prompts and would leak it" >&2
        echo "  (a symlink physically in the repo counts too). Move it outside," >&2
        echo "  e.g. $TOOL_ROOT/tasks/<name>-my-review.md" >&2
        exit 1 ;;
    esac
  done
fi

TS="$(date +%Y%m%d-%H%M%S)"
PANEL_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
PANEL_START_NS="$(date +%s%N)"
TASKNAME="$(basename "${TASK_FILE%.*}")"
LOG_PREFIX="${3:-$TOOL_ROOT/logs/panel-${TASKNAME}-${TS}}"
mkdir -p "$(dirname "$LOG_PREFIX")"

# ── 各腿:表 → 本轮实际用哪个二进制 ───────────────────────────────────────
# 🔴 腿的身份(家族/底座腿/聊天腿/开关)**只写在 `_panel-roster-lib.sh` 的
# `PANEL_LEG_SPECS` 里**,连同各腿开关的历史与理由。这里只做解析,不再按腿名分支。
# 2026-08-26 之前这一段是五个手写的 if 块 + 一张手写的映射表 + 派发/家族/日志共六处
# case,加第五条腿时我漏了四处 —— 详情记在那张表上面。
#
# 开关取值:agent = 底座腿(自己读仓库,默认);chat = 聊天腿(只看得见喂给它的
# 东西,要配 PANEL_INCLUDE);off = 不派发、不报 rc。
# 要 agent 但没装底座腿 ⇒ 回落聊天腿(老行为,不许退化);没有聊天腿的腿就是它自己。
LEGS=("${PANEL_LEGS_ORDER[@]}")
declare -A LEG_CMD LEG_CHAT LEG_LOG LEG_ERR LEG_AVAILABLE LEG_HEALTH LEG_SELECTED LEG_RC LEG_OVERRIDE_OK
for _leg in "${LEGS[@]}"; do
  # fail-closed:表里没有这条腿就当场拒跑。静默继续 = 一条没有家族、没有二进制的
  # "腿"照样进花名册,而它的每一句都是假的。
  _agent="$(panel_leg_agent "$_leg")" || { echo "panel-review: 腿 $_leg 不在 PANEL_LEG_SPECS 表里 ⇒ 拒绝派发(fail-closed)" >&2; exit 70; }
  _chat="$(panel_leg_chat "$_leg")"
  _switch="$(panel_leg_switch "$_leg")"
  _mode="${!_switch:-agent}"
  if [[ "$_mode" == "off" ]]; then
    _cmd=""
  elif [[ "$_mode" == "agent" && -x "$BIN/$_agent" ]]; then
    _cmd="$BIN/$_agent"
  elif [[ -n "$_chat" ]]; then
    _cmd="$BIN/$_chat"
  else
    _cmd="$BIN/$_agent"
  fi
  LEG_CMD[$_leg]="$_cmd"
  LEG_CHAT[$_leg]="${_chat:+$BIN/$_chat}"
  LEG_LOG[$_leg]="${LOG_PREFIX}.$_leg.log"
  LEG_ERR[$_leg]="${LOG_PREFIX}.$_leg.log.err"
done
unset _leg _agent _chat _switch _mode _cmd

# ── 健康池 + 轮换选择 ────────────────────────────────────────────────────
# 不额外发探活请求；只吃显式状态和最近一次真实评审结果。未知视为可尝试。
PANEL_STATE_DIR="${PANEL_STATE_DIR:-$TOOL_ROOT/logs/.panel-state}"
HEALTH_FILE="$PANEL_STATE_DIR/health.tsv"
CURSOR_FILE="$PANEL_STATE_DIR/cursor"
HEALTH_COOLDOWN="${PANEL_HEALTH_COOLDOWN_SEC:-21600}"
# 连续硬失败到这个次数 ⇒ **停止轮换**这条腿(0 = 关掉整个机制)。
# 为什么要有它(2026-08-25,track panel-dead-leg-streak):subkimi 从 08-20 到 08-25
# 跨 **10 轮** panel,每轮死在同一句 "no credential configured" —— 那是要人跑一次
# `kimi login` 才会好的故障,而冷却重试对它永远无效:它每 6 小时复活一次、再死一次,
# 循环了 6 天。每轮的信号都是同一句 WARNING,响了 10 次,被当成背景噪音。
# ⇒ 缺的不是"再加一句提示",是**状态会变**。阈值取 3 是因为它横跨至少两个冷却窗口,
#   已经不像抖动;取 1 会把抖动当结构性故障,变成新的噪音源。
HEALTH_DEAD_STREAK="${PANEL_HEALTH_DEAD_STREAK:-3}"
# fail-closed:垃圾值不许**静默**把机制关掉(panel subglm 发现 3)。
# `abc` 会让判断永远失配;`08` 在 `(( ))` 里是非法八进制,同样静默不判死 ——
# 两种都表现为"我以为开着,其实关着",正是本仓最不能接受的那一类。判据 V44o。
if [[ ! "$HEALTH_DEAD_STREAK" =~ ^(0|[1-9][0-9]*)$ ]]; then
  echo "panel-review: PANEL_HEALTH_DEAD_STREAK='$HEALTH_DEAD_STREAK' 不是十进制非负整数(0=关掉)" >&2
  exit 64
fi
mkdir -p "$PANEL_STATE_DIR"

override_health() {  # override_health <leg>; prints explicit status or nothing
  local leg="$1" pair key value
  IFS=',' read -r -a _pairs <<< "${PANEL_HEALTH_OVERRIDE:-}"
  for pair in "${_pairs[@]}"; do
    key="${pair%%=*}"; value="${pair#*=}"
    [[ "$key" == "$leg" && "$pair" == *=* ]] && { printf '%s\n' "$value"; return 0; }
  done
  return 1
}

recent_health() {  # recent_health <leg>; prints status if still cooling down
  local leg="$1" row status at now
  [[ -f "$HEALTH_FILE" ]] || return 1
  row="$(awk -F '\t' -v n="$leg" '$1==n {row=$0} END{print row}' "$HEALTH_FILE")"
  [[ -n "$row" ]] || return 1
  # 🔴 **按列取,不许用 `read` 吞字段**(2026-08-25,panel subglm 抓到、我亲手复现):
  # health.tsv 从 3 列长到 5 列之后,`IFS=$'\t' read -r _ status at` 会把**多余字段
  # 连分隔符一起塞进最后一个变量** ⇒ at="<epoch>\t<streak>\t<first>" ⇒
  # `^[0-9]+$` 永不匹配 ⇒ **冷却对新格式行整个失效**。
  # 那让"阈值 3 横跨两个冷却窗口"这个设计前提当场变成假的:三次背靠背的瞬时故障
  # 几分钟内就能判死一条好腿。判据 V44l/m。
  status="$(printf '%s' "$row" | cut -f2)"
  at="$(printf '%s' "$row" | cut -f3)"
  case "$status" in PASS|healthy) return 1 ;; esac
  [[ "$at" =~ ^[0-9]+$ && "$HEALTH_COOLDOWN" =~ ^[0-9]+$ ]] || return 1
  now="$(date +%s)"
  (( now - at < HEALTH_COOLDOWN )) || return 1
  printf '%s\n' "$status"
}

dead_health() {  # dead_health <leg>; 连续硬失败到阈值就打印 dead:<status>:<streak>
  local leg="$1" row status streak
  [[ "$HEALTH_DEAD_STREAK" =~ ^[0-9]+$ && "$HEALTH_DEAD_STREAK" -gt 0 ]] || return 1
  [[ -f "$HEALTH_FILE" ]] || return 1
  row="$(awk -F '\t' -v n="$leg" '$1==n {row=$0} END{print row}' "$HEALTH_FILE")"
  [[ -n "$row" ]] || return 1
  status="$(printf '%s' "$row" | cut -f2)"
  streak="$(printf '%s' "$row" | cut -f4)"
  # 老的三列行没有第 4 列 ⇒ 当 0(不许因为格式变了就崩,也不许把老行误判成 dead)。
  [[ "$streak" =~ ^[0-9]+$ ]] || return 1
  (( streak >= HEALTH_DEAD_STREAK )) || return 1
  printf 'dead:%s:%s\n' "$status" "$streak"
}

for _leg in "${LEGS[@]}"; do
  LEG_SELECTED[$_leg]=0
  if [[ -z "${LEG_CMD[$_leg]}" || ! -x "${LEG_CMD[$_leg]}" ]]; then
    LEG_AVAILABLE[$_leg]=0; LEG_HEALTH[$_leg]="off"
    continue
  fi
  LEG_AVAILABLE[$_leg]=1; LEG_HEALTH[$_leg]="healthy"
  LEG_OVERRIDE_OK[$_leg]=0
  _health="$(override_health "$_leg" 2>/dev/null || true)"
  if [[ -n "$_health" ]]; then
    # 记住"这一轮是被 override 强行放回来的" —— 打印段要靠它改口,
    # 否则会叫人去做他刚做完的那件事(判据 V44w)。
    case "${_health,,}" in healthy|pass|up|ok) LEG_OVERRIDE_OK[$_leg]=1 ;; *) LEG_HEALTH[$_leg]="$_health" ;; esac
  elif [[ "$FORCE_ALL" -ne 1 ]]; then
    # dead 优先于 cooldown:冷却过了照样不放它回来 —— 那正是这个机制的全部意义。
    _health="$(dead_health "$_leg" 2>/dev/null || true)"
    if [[ -n "$_health" ]]; then
      LEG_HEALTH[$_leg]="$_health"
    else
      _health="$(recent_health "$_leg" 2>/dev/null || true)"
      [[ -n "$_health" ]] && LEG_HEALTH[$_leg]="cooldown:$_health"
    fi
  fi
done
unset _leg _health

if [[ "${PANEL_SELECTION_START:-}" =~ ^[0-9]+$ ]]; then
  SELECT_START=$((PANEL_SELECTION_START % ${#LEGS[@]}))
elif [[ -f "$CURSOR_FILE" ]] && read -r SELECT_START < "$CURSOR_FILE" \
     && [[ "$SELECT_START" =~ ^[0-9]+$ ]]; then
  SELECT_START=$((SELECT_START % ${#LEGS[@]}))
else
  SELECT_START=$((RANDOM % ${#LEGS[@]}))
fi

SELECTED_COUNT=0
for ((_off=0; _off<${#LEGS[@]} && SELECTED_COUNT<REVIEW_BUDGET; _off++)); do
  _idx=$(((SELECT_START + _off) % ${#LEGS[@]})); _leg="${LEGS[$_idx]}"
  [[ "${LEG_AVAILABLE[$_leg]}" -eq 1 ]] || continue
  if [[ "$FORCE_ALL" -ne 1 && "${LEG_HEALTH[$_leg]}" != "healthy" ]]; then continue; fi
  LEG_SELECTED[$_leg]=1
  SELECTED_COUNT=$((SELECTED_COUNT + 1))
done
if [[ "$FORCE_ALL" -ne 1 ]]; then
  _cursor_tmp="$CURSOR_FILE.tmp.$$"
  printf '%s\n' "$(((SELECT_START + 1) % ${#LEGS[@]}))" > "$_cursor_tmp" && mv -f "$_cursor_tmp" "$CURSOR_FILE"
fi
unset _off _idx _leg _cursor_tmp

# Oracle record slot: run BEFORE dispatch so the arbiter never reads reviewer
# verdicts without knowing whether the objective check is green. Records only -
# the verdict stays with the main agent.
if [[ -n "${PANEL_ORACLE_CMD:-}" ]]; then
  ORACLE_LOG="${LOG_PREFIX}.oracle.log"
  ( cd "$REPO_DIR" && bash -c "$PANEL_ORACLE_CMD" ) >"$ORACLE_LOG" 2>&1
  ORACLE_RC=$?
  echo "ORACLE: $PANEL_ORACLE_CMD rc=$ORACLE_RC (output: $ORACLE_LOG)"
  if [[ $ORACLE_RC -ne 0 ]]; then
    echo "  WARNING: oracle is RED - reviewer PASS 不可信 (07-04 教训: 先跑 oracle 再读 panel)"
    tail -n 5 "$ORACLE_LOG" | sed 's/^/  | /'
  fi
fi

# PANEL_INCLUDE -> chat legs (2026-07-21 工具债): a chat leg only ever sees the
# incremental `git diff`, so oracle/test files that live in the BASELINE commit are
# invisible to it — both chat legs literally reported "测试文件不在 diff 里没法评".
# Forward the patterns verbatim to each chat leg's own INCLUDE var (agent legs read
# the repo themselves and ignore this).
if [[ -n "${PANEL_INCLUDE:-}" ]]; then
  export ZHIPU_INCLUDE="${ZHIPU_INCLUDE:-$PANEL_INCLUDE}"
  export DEEPSEEK_INCLUDE="${DEEPSEEK_INCLUDE:-$PANEL_INCLUDE}"
fi

# PANEL_DIFF_BASE 默认值(2026-07-27 实事故):chat 腿默认只看**工作区未提交改动**,
# 而本机流程是「先 commit 再派发」(oracle 先行、my-review 落在仓外),所以派发时
# 工作区通常是干净的 —— chat 腿拿到的实现代码是**空的**。那次 subglm 的 agent 腿挂了
# 回落 chat 腿,报告里自己写着「bin/ds_web.py 的具体实现内容不可得」,findings 全是把
# 任务书复述回来还标 HIGH。**这是结构性盲评,不是模型差**,而且 agent 腿一回落就复发。
# 故:未显式指定时,把 diff 基线设成仓库的默认分支,让 chat 腿看见整条分支的改动。
if [[ -z "${PANEL_DIFF_BASE:-}" ]]; then
  for _b in main master; do
    if git -C "$REPO_DIR" rev-parse --verify --quiet "$_b" >/dev/null 2>&1 \
       && [[ "$(git -C "$REPO_DIR" rev-parse "$_b" 2>/dev/null)" \
             != "$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null)" ]]; then
      export PANEL_DIFF_BASE="$_b"
      echo "  NOTE: PANEL_DIFF_BASE 未给,自动用 '$_b' 作 diff 基线(chat 腿否则只看未提交改动)"
      break
    fi
  done
  unset _b
fi

echo "panel-review: task=$TASK_FILE repo=$REPO_DIR"
echo "  impact-risk=$IMPACT_RISK requested-budget=$REVIEW_BUDGET selected=$SELECTED_COUNT"
for _leg in "${LEGS[@]}"; do
  # 🔴 dead 这一支必须排在 SELECTED 前面:`--all` 会把死腿也选中,
  # 排在后面就永远到不了 —— 加了一道防线却没接进主路(判据 V44p 逮到)。
  if [[ -n "$(dead_health "$_leg" 2>/dev/null || true)" && "${LEG_HEALTH[$_leg]}" != "off" ]]; then
    # 🔴 `--all` 也走这里:**派它和告诉我它是死的,不矛盾**(两条评审腿独立命中)。
    # `--all` 恰恰是最该知道"其实只有 3 条腿"的场合,原来它信息最少。判据 V44p。
    _dinfo="$(dead_health "$_leg")"; _dstatus="${_dinfo#dead:}"
    _dstreak="${_dstatus##*:}"; _dstatus="${_dstatus%:*}"
    _dfirst="$(awk -F '\t' -v n="$_leg" '$1==n {f=$5} END{print f}' "$HEALTH_FILE" 2>/dev/null)"
    _dlog="$(awk -F '\t' -v n="$_leg" '$1==n {f=$6} END{print f}' "$HEALTH_FILE" 2>/dev/null)"
    if [[ "${LEG_SELECTED[$_leg]}" -eq 1 ]]; then
      echo "  $_leg -> ${LEG_LOG[$_leg]} (leg: $(basename "${LEG_CMD[$_leg]}") family: $(panel_leg_family "$_leg"))"
    else
      echo "  $_leg = skipped(health:$_dinfo)"
    fi
    # 措辞不再断言"都以 X 失败":streak 对任意 rc≠0 计数,而 status 只是**最近一次**。
    echo "  🔴 $_leg 连续 $_dstreak 轮 rc≠0(最近一次:$_dstatus)$(
      [[ "$_dfirst" =~ ^[0-9]+$ ]] && printf ',最早一次 %s' "$(date -d "@$_dfirst" '+%m-%d %H:%M' 2>/dev/null)")。"
    echo "     冷却重试救不了这一类 —— 它要人动手。上一轮它的日志:${_dlog:-(没记到,去 $(dirname "${LEG_LOG[$_leg]}") 里找最近的 $_leg.log)}"
    if [[ "${LEG_OVERRIDE_OK[$_leg]:-0}" -eq 1 ]]; then
      # 已经强行放回了就别再叫人去强行放回 ——「你处理完了它还在响」的报警器,
      # 就是下一个被当成背景噪音的报警器,而那正是这一单要治的病。
      # (我自审 M2 与第二轮 subdeepseek F3 独立命中同一处。判据 V44w。)
      echo "     本轮已强行放回(PANEL_HEALTH_OVERRIDE),跑成功一次 streak 自动清零。"
    else
      echo "     处理完强行放回:PANEL_HEALTH_OVERRIDE=$_leg=healthy(跑成功一次 streak 自动清零)"
    fi
  elif [[ "${LEG_SELECTED[$_leg]}" -eq 1 ]]; then
    echo "  $_leg -> ${LEG_LOG[$_leg]} (leg: $(basename "${LEG_CMD[$_leg]}") family: $(panel_leg_family "$_leg"))"
  elif [[ "${LEG_HEALTH[$_leg]}" == "off" ]]; then
    echo "  $_leg = off/unavailable"
  elif [[ "${LEG_HEALTH[$_leg]}" != "healthy" ]]; then
    echo "  $_leg = skipped(${LEG_HEALTH[$_leg]})"
  else
    echo "  $_leg = skipped(rotation/budget)"
  fi
done
unset _leg _dinfo _dstatus _dstreak _dfirst _dlog
# 🔴 派不满风险预算这件事**要说出来**(2026-08-25 三方独立命中:我自审 M1 /
# submimo「无人值守 CI 只看 rc」/ subglm「高风险欠配额静默放行」)。
# 每条死腿自己那三行提示一直是打的 —— 缺的是**"这一轮没凑够 high 要的家族数"这句话本身**。
# 它和冷却造成的缺口不是一回事:冷却过 6 小时自己好,dead 不会。归档闸会因为
# 家族覆盖不足 BLOCK,而那时评审的钱已经花完了 —— 所以要在派发这一刻就说。
# 用 RISK_BUDGET(风险等级要求的最低家族数)而不是 REVIEW_BUDGET:`--all` 把预算
# 顶成 4,一条腿 off 就报"不足"是误报,而误报会逼出绕开它的习惯。判据 V44u。
if [[ "$SELECTED_COUNT" -lt "$RISK_BUDGET" ]]; then
  _missing=""
  for _leg in "${LEGS[@]}"; do
    [[ "${LEG_SELECTED[$_leg]}" -eq 1 ]] && continue
    _missing+="${_missing:+,}$_leg(${LEG_HEALTH[$_leg]:-healthy})"
  done
  echo "  🔴 家族覆盖不足:impact-risk=$IMPACT_RISK 要 $RISK_BUDGET 个不同家族,这轮只派出 $SELECTED_COUNT 个;少了 $_missing。"
  echo "     dead 不随冷却过期 —— 这个缺口不会自己好,而归档闸会因为家族覆盖不足 BLOCK。"
  echo "     现在就定:按上面的提示清掉死腿,或 PANEL_HEALTH_OVERRIDE=<leg>=healthy 强行放回。"
  unset _missing _leg
fi
# A chat leg with nothing attached beyond the diff cannot review the oracle itself
# ("是规格错还是实现错"就查不了)。Nudge, never block — the arbiter decides.
_chat_in_play=0
for _leg in "${LEGS[@]}"; do
  [[ "${LEG_SELECTED[$_leg]}" -eq 1 && -n "${LEG_CHAT[$_leg]}" \
     && "${LEG_CMD[$_leg]}" == "${LEG_CHAT[$_leg]}" ]] && _chat_in_play=1
done
unset _leg
if [[ -z "${PANEL_INCLUDE:-}" && "$_chat_in_play" -eq 1 ]]; then
  echo "  HINT: chat leg in play and PANEL_INCLUDE is empty — it only sees the incremental diff."
  echo "        Pass PANEL_INCLUDE=\"tests/test_x.py tests/e2e/y.mjs\" so it can review the oracle too."
fi

# Anti-anchoring leak check (2026-07-21 实事故): the engine inlines untracked repo
# files and the whole diff into every reviewer prompt. If the main agent's OWN
# findings are sitting in the repo (a filled-in tracks/**/verify.md, a stray
# *my-review*), the "independent" legs end up quoting them back — one chat leg
# literally cited verify.md as evidence. Warn (never block); the arbiter decides.
anchor_leak_files() {
  # -uall: 不带它 git 会把未跟踪目录折叠成 `tracks/`,verify.md 就漏检了(oracle 实抓)
  { git -C "$REPO_DIR" status --porcelain -uall 2>/dev/null | awk '{print $NF}'
    if [[ -n "${PANEL_DIFF_BASE:-}" ]]; then
      git -C "$REPO_DIR" diff --name-only "${PANEL_DIFF_BASE}...HEAD" 2>/dev/null
    fi
    # 第三臂(2026-08-05 实测):上面两臂在**本机默认形状**下都照不到 ——
    # 我一直在 main 上干活(main == HEAD ⇒ PANEL_DIFF_BASE 那一臂结构上不存在),
    # 而 verify.md 是已提交的(⇒ status 那一臂也空)。那次 DeepSeek 日志第 28 行
    # 读了 verify.md、第 101 行原文引用我的「规格自查第 2 条」,两臂一声没吭。
    # 底座腿自己读仓库,**不看 diff**,所以只要文件在树上就够得着。
    # 只报与本任务同名的 track(任务文件常叫 <track>-review.md),不相干的 track
    # 不报 —— 误报会把警告变噪音,下一次就没人看了。
    local _base="${TASKNAME%-my-review}"; _base="${_base%-review}"
    if [[ -n "$_base" ]]; then
      local _f _t
      while IFS= read -r _f; do
        [[ -n "$_f" ]] || continue
        _t="${_f#tracks/}"; _t="${_t%%/*}"
        [[ -n "$_t" ]] || continue
        if [[ "$_base" == "$_t"* || "$_t" == "$_base"* ]]; then echo "$_f"; fi
      done < <(git -C "$REPO_DIR" ls-files 'tracks/*/verify.md' 2>/dev/null)
    fi
  } | grep -Ei 'verify\.md$|my.?review' | sort -u
}
LEAK="$(anchor_leak_files)"
if [[ -n "$LEAK" ]]; then
  echo "  WARNING: anchor leak(反锚定) — 主审自己的评审可能进了评审腿的 prompt:"
  echo "$LEAK" | sed 's/^/    /'
  # 这行字 08-24 把我指错过一整轮:它说的"整份 diff"只在 chat 腿 + PANEL_DIFF_BASE
  # 设上时才成立,而本机默认形状下泄漏走的是"底座腿自己读树"。报警要说得出自己在报什么。
  echo "    (底座腿自己读树、未跟踪文件会被内联、chat 腿另看 diff —— 已提交的照样够得着;"
  echo "     先派发、后写 verify.md;详见 skills/panel/SKILL.md 反锚定一节)"
fi

# 派发窗口的树是不是同一棵(2026-08-05 实事故):22:40 我趁 Kimi 还在跑提交了 80d2d23,
# 它的日志 1027–1094 行整段在追查"仓库正在被人改",并把 BLOCK 押在这个幻影上 —— 25 分钟全废。
# 各腿是**并行**的,谁在哪一刻读到哪棵树没人知道;所以派发前后各记一次 HEAD,不同就明说。
HEAD_BEFORE="$(git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null || true)"

echo "  running all in parallel..."

# Light pre-launch stagger: the three reviewers share provider tpm budgets, and
# bursting all at once is the main 429 trigger. Sleep a small random gap (default
# up to 2s; PANEL_STAGGER_MAX=0 disables) before the 2nd and 3rd launches so the
# token bursts don't perfectly overlap. $RANDOM seeds awk to dodge same-second
# srand() collisions. Pairs with the engine's 429 backoff (belt and suspenders).
stagger() {
  local max="${PANEL_STAGGER_MAX:-2}"
  [[ "$max" == 0 || "$max" == 0.0 ]] && return 0
  sleep "$(awk -v m="$max" -v r="$RANDOM" 'BEGIN{printf "%.3f", (r/32768)*m}')"
}

# Capture each reviewer's stderr to a sidecar .err file so an early startup failure
# (missing key, bad endpoint, etc.) is recorded instead of swallowed. We do NOT
# redirect into the .log itself because each reviewer truncates its own .log on
# success; a sidecar avoids that race. stdout is dropped (the result is in the .log).
# Agent-leg failure -> automatic chat-leg fallback (2026-07-21): a dead agent leg
# used to cost a whole reviewer (GLM: unsubscribed CodingPlan -> 400; DeepSeek:
# "Reached max turns"). The chat leg is a weaker but live reviewer, so retry there
# instead of silently shipping a 2-leg panel. The failed agent output is preserved
# as <log>.agent.log(+.err) so the infra failure stays diagnosable.
# ⚠ `setsid` 套不到 bash 函数上,所以下面是套在**函数里那两处真正的调用**上:
#   会话一死,run_leg 这层壳会跟着没(于是回落逻辑不再跑),但**腿自己活着写完日志** ——
#   要保的正是那份日志。
run_leg() {  # run_leg <agent_cmd> <chat_cmd> <log> <err> <label>
  local agent="$1" chat="$2" log="$3" err="$4" label="$5" rc
  # --panel-dispatch 走**命令行**,不用环境变量(后者会被 shell 继承 = 随手可按的后门);
  # 而且放在**参数末尾** —— 放开头会把各腿的位置参数整体顶偏一位,
  # 任何按 $3 取日志路径的调用方(判据里的假腿全是这么写的)当场就坏。08-06 实测。
  session_run "${log%.log}.state" "$agent" review "$TASK_FILE" "$log" "$REPO_DIR" --panel-dispatch >/dev/null 2>"$err"; rc=$?
  if [[ $rc -eq 0 || "$agent" == "$chat" ]]; then return $rc; fi
  # agent leg died and a distinct chat leg exists -> keep the evidence, then retry
  [[ -e "$log" ]] && mv -f "$log" "${log%.log}.agent.log"
  # state 跟着 log 一起归档:回落之后聊天腿会写同名的 state,不挪就被覆盖掉,
  # 花名册里"底座腿死于 rc 几"这件事就没了。
  [[ -e "${log%.log}.state" ]] && mv -f "${log%.log}.state" "${log%.log}.agent.state"
  [[ -s "$err" ]] && mv -f "$err" "${log%.log}.agent.log.err" || rm -f "$err"
  local agent_rc=$rc   # 底座腿的死因;下面 rc 会被聊天腿的返回码覆盖
  echo "  NOTE: $label agent leg failed (rc=$agent_rc) -> fallback to chat leg;" \
       "agent output kept at ${log%.log}.agent.log(.err)"
  session_run "${log%.log}.state" "$chat" review "$TASK_FILE" "$log" "$REPO_DIR" --panel-dispatch >/dev/null 2>"$err"; rc=$?
  # 横幅写进日志本身,不只印在 stdout:这份结论以后会被单独读到(归档、断线重连),
  # 那时终端上那行 NOTE 早就没了,而一份降级腿的结论长得和健康腿一模一样。
  # 2026-08-03 我就是这样差点按「四审三腿 PASS」给权重,实际只有两腿睁着眼。
  if [[ -s "$log" ]]; then
    { echo "⚠️  DEGRADED / 降级腿 —— 这份结论不是底座腿给的。"
        echo "    $label 的底座腿(自己读仓库)先死了:rc=$agent_rc,证据在 ${log##*/}"
      echo "    去掉 .log 后加 .agent.log(.err);随后自动回落到聊天腿重跑。"
      echo "    ⇒ 它只看得见 diff,**没有独立查证仓库的能力**。给权重时按此折扣。"
      echo
      cat "$log"
    } > "$log.tmp" && mv -f "$log.tmp" "$log"
  fi
  return $rc
}

# ── 每条腿都起在**自己的会话里**(2026-08-17)────────────────────────────
# 起因:08-16 和 08-17 两次断线,都砍在四审跑到一半。腿是这个驱动的后台子进程,
# 整串在调用者的进程组里 ⇒ 会话一死,SIGTERM 打到整组,**谁还没跑完谁全丢**。
# submimo 三分钟交卷、保住了;kimi 要跑 11~18 分钟,于是每次被砍的都是它 ——
# **它不是最脆的那条,是尾巴最长的那条**。
#
# `setsid --wait` 两头都要:腿进新会话(SIGTERM 够不着),而 setsid 自己仍是本脚本
# 的子进程 ⇒ 下面的 `wait` 和 rc 语义一个字都不用改。
# 注意 subkimi 里那套"先写裁决、超时也不亏"的兜底**防不了这个** ——
# 被 SIGTERM 打死时那段抢救代码根本没机会跑。兜底装在了另一种失败模式上。

# ── 腿自己把退出码落盘(track panel-roster-from-disk,2026-08-23)────────────
# 根因:`wait_leg` 里的 `wait; rc=$?` 只有亲手起腿的那个进程拿得到 ⇒ 退出码是整套
# 系统里**唯一不落盘的事实**,而花名册恰恰只需要它。控制器一死,它永久消失。
#
# ⚠️ 写入点必须在 **setsid 出去的那个会话里面**,不能在控制器里、也不能在
# `run_leg` 的后台子 shell 里 —— 那两处都跟控制器同进程组,一起被杀。
# 08-23 的真实时间线证伪了"控制器增量写"那个看起来对的方案:
# 控制器死在**第一条腿交卷之前**,增量写和一次性写落盘字节数都是 0。
session_run() {  # session_run <statefile> <cmd...>
  local state="$1"; shift
  setsid --wait bash -c '
    st="$1"; shift
    started="$(date -u +%FT%TZ)"
    "$@"; rc=$?
    # 原子落盘:先写临时文件再 mv。直接 `> "$st"` 的话,腿在写到一半被砍会留下
    # 半截 state,读不到 rc= ⇒ 花名册印出 FAIL(rc=)(空 rc)这种没设计过的第三种形态。
    printf "rc=%s\nstarted=%s\nfinished=%s\n" "$rc" "$started" "$(date -u +%FT%TZ)" > "$st.tmp" && mv -f "$st.tmp" "$st"
    exit $rc
  ' _ "$state" "$@"
}
declare -A LEG_PID
launch_leg() {  # launch_leg <name>
  local name="$1" cmd="${LEG_CMD[$1]}" log="${LEG_LOG[$1]}" err="${LEG_ERR[$1]}" chat="${LEG_CHAT[$1]}"
  # 🔴 派发**不再按腿名分支**(2026-08-26,subgemini 那一单的四审,两条腿独立命中)。
  # 原来这里是 `case "$name" in submimo|subkimi) … subdeepseek) … subglm) …`,
  # 加第五条腿时我漏了这一处:case 落空 ⇒ **什么都不启动**,而紧接着的
  # `LEG_PID[$name]=$!` 拿到的是**上一条腿**的 pid ⇒ `wait` 返回那条腿的退出码 ⇒
  # 屏幕上印 "subgemini rc=0"、花名册记 PASS、observation 记一条成功的腿,
  # 而它一次都没跑。**"看起来跑完了、其实没审"是这套系统最贵的一种失败。**
  # 现在只剩一条路:run_leg。没有聊天腿回落的腿把 chat 传成它自己 ⇒ run_leg 不回落
  # (它自己第一行就是 `[[ $rc -eq 0 || "$agent" == "$chat" ]] && return`)。
  run_leg "$cmd" "${chat:-$cmd}" "$log" "$err" "$name" &
  LEG_PID[$name]=$!
}

wait_leg() {  # wait_leg <name>
  local name="$1" rc
  wait "${LEG_PID[$name]}"; rc=$?
  LEG_RC[$name]="$rc"
}

selected_identities() {
  local name out="" family cmd
  for name in "${LEGS[@]}"; do
    [[ "${LEG_SELECTED[$name]}" -eq 1 ]] || continue
    # 🔴 `local family` 在 set -u 下**未赋值**:case 落空时下一行引用它整个函数就崩,
    # plan 里的 `selected=` 变成空行 —— "派了谁"这件事当场丢失,而屏幕上一切正常。
    # 2026-08-26 探针实测到的就是这个(第五条腿没有 case 分支)。表 + fail-closed。
    family="$(panel_leg_family "$name")" || { echo "panel-review: 腿 $name 没有模型家族(不在 PANEL_LEG_SPECS 里)⇒ 拒绝派发" >&2; exit 70; }
    cmd="$(basename "${LEG_CMD[$name]}")"
    out+="${out:+,}$name($family/$cmd)"
  done
  printf '%s\n' "${out:-none}"
}

# ── plan:**派发之前**就落盘(track panel-roster-from-disk,2026-08-23)────────
# 这一格的事实在派腿之前就全部已知(选腿逻辑跑在 launch_leg 之前)。写在这里,
# 控制器之后死在哪一步都不影响"派了谁"这件事查得到 —— 08-23/08-19 两次事故
# 丢掉的正是它:整轮零记录,而腿的完整日志就躺在盘上。
#
# 兜底的强度在这一格,不在腿那一格:就算哪天腿也死了、一份 state 都没有,
# 花名册照样答得出"派了谁",只把那条腿标成「未收尾(无 state:被砍或仍在跑)」。
PLAN_FILE="${LOG_PREFIX}.plan"
{
  printf 'task=%s\n' "$TASKNAME"
  printf 'impact-risk=%s\n' "$IMPACT_RISK"
  printf 'requested-budget=%s\n' "$REVIEW_BUDGET"
  printf 'selected-count=%s\n' "$SELECTED_COUNT"
  printf 'selected=%s\n' "$(selected_identities)"
  printf 'snapshot-head=%s\n' "$HEAD_BEFORE"
  for _leg in "${LEGS[@]}"; do
    printf 'leg\t%s\t%s\t%s\n' "$_leg" "${LEG_SELECTED[$_leg]}" "${LEG_HEALTH[$_leg]}"
  done
} > "$PLAN_FILE"

_launched=0
for _leg in "${LEGS[@]}"; do
  [[ "${LEG_SELECTED[$_leg]}" -eq 1 ]] || continue
  [[ "$_launched" -eq 0 ]] || stagger
  launch_leg "$_leg"
  _launched=$((_launched + 1))
done
for _leg in "${LEGS[@]}"; do
  [[ "${LEG_SELECTED[$_leg]}" -eq 1 ]] && wait_leg "$_leg"
done


# Default high lane starts with two. Only evidence problems add one spare; we do
# not turn a single provider failure into a mandatory all-four wait.
ESCALATION_REASON="none"
if [[ "$REVIEW_BUDGET" -eq 2 && "$FORCE_ALL" -ne 1 && "$SELECTED_COUNT" -gt 0 ]]; then
  _seen_verdict=""; _has_failure=0; _has_degraded=0; _has_incomplete=0; _has_need_more=0; _has_conflict=0
  for _leg in "${LEGS[@]}"; do
    [[ "${LEG_SELECTED[$_leg]}" -eq 1 ]] || continue
    if [[ "${LEG_RC[$_leg]}" -ne 0 ]]; then _has_failure=1; continue; fi
    if [[ -e "${LEG_LOG[$_leg]%.log}.agent.log" || -e "${LEG_LOG[$_leg]%.log}.agent.log.err" ]]; then
      _has_degraded=1
    fi
    _verdict="$(verdict_of "${LEG_LOG[$_leg]}")"
    case "$_verdict" in
      UNKNOWN) _has_incomplete=1 ;;
      NEEDS_MORE_INFO) _has_need_more=1 ;;
      *)
        if [[ -n "$_seen_verdict" && "$_seen_verdict" != "$_verdict" ]]; then _has_conflict=1; fi
        _seen_verdict="$_verdict"
        ;;
    esac
  done
  if [[ "$_has_failure" -eq 1 ]]; then ESCALATION_REASON="failure"
  elif [[ "$_has_degraded" -eq 1 ]]; then ESCALATION_REASON="degraded"
  elif [[ "$_has_incomplete" -eq 1 ]]; then ESCALATION_REASON="incomplete"
  elif [[ "$_has_need_more" -eq 1 ]]; then ESCALATION_REASON="needs-more-info"
  elif [[ "$_has_conflict" -eq 1 ]]; then ESCALATION_REASON="conflict"
  fi

  if [[ "$ESCALATION_REASON" != "none" ]]; then
    _spare=""
    for ((_off=0; _off<${#LEGS[@]}; _off++)); do
      _idx=$(((SELECT_START + _off) % ${#LEGS[@]})); _leg="${LEGS[$_idx]}"
      [[ "${LEG_SELECTED[$_leg]}" -eq 0 && "${LEG_AVAILABLE[$_leg]}" -eq 1 \
         && "${LEG_HEALTH[$_leg]}" == "healthy" ]] || continue
      _spare="$_leg"; break
    done
    if [[ -n "$_spare" ]]; then
      echo "  escalation: $ESCALATION_REASON -> add $_spare"
      LEG_SELECTED[$_spare]=1; SELECTED_COUNT=$((SELECTED_COUNT + 1))
      stagger; launch_leg "$_spare"; wait_leg "$_spare"
    else
      ESCALATION_REASON="$ESCALATION_REASON(no-healthy-spare)"
      echo "  escalation: $ESCALATION_REASON"
    fi
  fi
fi
unset _launched _leg _seen_verdict _has_failure _has_degraded _has_incomplete _has_need_more _has_conflict _verdict _spare _off _idx

# Parent process records only actual review outcomes; no extra provider probe.
record_health() {  # record_health <leg>
  local name="$1" status tmp now rc="${LEG_RC[$1]}" log="${LEG_LOG[$1]}" err="${LEG_ERR[$1]}"
  now="$(date +%s)"; status="PASS"
  if [[ "$rc" -ne 0 ]]; then
    status="FAIL"
    if grep -Eqi 'quota|额度|rate.?limit|too many requests|429|balance|billing' "$err" "$log" 2>/dev/null; then status="quota"; fi
    if grep -Eqi 'unauthori[sz]ed|forbidden|invalid.*key|auth|401|403' "$err" "$log" 2>/dev/null; then status="auth"; fi
  elif [[ -e "${log%.log}.agent.log" || -e "${log%.log}.agent.log.err" ]]; then
    if [[ "$(verdict_of "$log")" == "UNKNOWN" ]]; then status="DEGRADED_INCOMPLETE"
    else status="DEGRADED"; fi
  elif [[ "$(verdict_of "$log")" == "UNKNOWN" ]]; then
    status="INCOMPLETE"
  fi
  # 连续**硬**失败计数。判据 V44g/h 盯死的那一条:只有 rc≠0 才 +1。
  # `INCOMPLETE` / `DEGRADED` 都是 **rc=0** —— 腿产出了东西,只是裁决行没匹配上。
  # 把它们算进来,就会把正在干活的腿踢掉(submimo 2026-08-25 当轮就是 INCOMPLETE,
  # 而它那份评审是那一轮最有价值的两份之一)。
  local prior_streak prior_first streak first
  prior_streak=0; prior_first=""
  if [[ -f "$HEALTH_FILE" ]]; then
    local prow
    prow="$(awk -F '\t' -v n="$name" '$1==n {row=$0} END{print row}' "$HEALTH_FILE")"
    if [[ -n "$prow" ]]; then
      prior_streak="$(printf '%s' "$prow" | cut -f4)"
      prior_first="$(printf '%s' "$prow" | cut -f5)"
      [[ "$prior_streak" =~ ^[0-9]+$ ]] || prior_streak=0   # 老三列行
    fi
  fi
  local lastlog
  if [[ "$rc" -ne 0 ]]; then
    if [[ "$prior_first" =~ ^[0-9]+$ && "$prior_streak" -gt 0 ]]; then
      first="$prior_first"
      # 🔴 **一个冷却窗口里的连发失败只算一次**(2026-08-25 第二轮 subdeepseek F1)。
      # 定阈 3 的**全部依据**是那句「连续 3 轮横跨至少两个冷却窗口,已经不像抖动」。
      # 而 `--all` 绕过冷却、record_health 却对任何被派发的失败都 +1 ⇒ 那句话在
      # --all 路径下整个是假的:实测冷却 3600s,三轮 --all 在 **1 秒**内把 streak
      # 顶到 3,第四轮普通轮换当场判死。几分钟的共模抖动(出口断网 / 网关 5xx /
      # 跨腿限流)就能永久踢掉一条好腿 —— 而误踢好腿是这一单唯一不可接受的后果。
      # 所以把"横跨 N 个冷却窗口"从**副作用**变成**显式条件**:第 n 次计入,
      # 要求距最早那次已经过了 (n-1) 个冷却窗口。冷却设 0(或非法)时窗口为 0,
      # 一切照旧计数 —— 没有窗口就没有窗口要守。对照组判据 V44s 钉着"别修成永不计数"。
      local _cd=0
      [[ "$HEALTH_COOLDOWN" =~ ^[0-9]+$ ]] && _cd="$HEALTH_COOLDOWN"
      if (( now - first >= prior_streak * _cd )); then streak=$((prior_streak + 1))
      else streak="$prior_streak"; fi
    else
      first="$now"; streak=1
    fi
    # 记下**这一轮**的日志:下一轮它被跳过时,提示得指得出一个真的存在的文件。
    # (panel subglm 发现 2:原来指的是本轮前缀,而被跳过的腿本轮根本不产生日志。)
    lastlog="$log"
  else
    streak=0; first=""; lastlog=""
  fi
  tmp="$HEALTH_FILE.tmp.$$"
  { [[ -f "$HEALTH_FILE" ]] && awk -F '\t' -v n="$name" '$1!=n' "$HEALTH_FILE"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$status" "$now" "$streak" "$first" "$lastlog"
  } > "$tmp" && mv -f "$tmp" "$HEALTH_FILE"
}
for _leg in "${LEGS[@]}"; do
  [[ "${LEG_SELECTED[$_leg]}" -eq 1 ]] && record_health "$_leg"
done
unset _leg

echo
# ── 派发期间 HEAD 动了没有 ────────────────────────────────────────────
# 横幅**写进每份腿日志**,不只印在 stdout:这些结论以后会被单独读到(归档、断线重连),
# 那时终端上这行早没了,而一份"评的是别的树"的结论长得和正常结论一模一样(同 V19)。
HEAD_AFTER="$(git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null || true)"
if [[ -n "$HEAD_BEFORE" && -n "$HEAD_AFTER" && "$HEAD_BEFORE" != "$HEAD_AFTER" ]]; then
  echo "  ⚠️  评审期间仓库 HEAD 从 $HEAD_BEFORE 移到 $HEAD_AFTER —— 各腿看到的可能不是同一棵树。"
  echo "     腿报告里的「仓库正在被改/文件对不上」多半是这个,不是被评代码的问题;"
  echo "     受影响就重跑,别拿它当 finding(2026-08-05 实事故:一条腿为此白跑 25 分钟)。"
  # 名单第五份拷贝(2026-08-26 四审顺出来的):这里原本手抄了四条腿的日志变量,
  # 第五条腿的报告因此收不到这条警告。改成走 LEG_LOG,加腿自动跟上。
  for _leg in "${LEGS[@]}"; do
    _log="${LEG_LOG[$_leg]}"
    [[ -s "$_log" ]] || continue
    { echo
      echo "⚠️  评审期间仓库 HEAD 从 $HEAD_BEFORE 移到 $HEAD_AFTER(本报告尾部由 panel-review 追加)。"
      echo "    这条腿读到的树可能不是你现在看到的那棵;它若抱怨「仓库正在被人改」,那是这个原因。"
    } >> "$_log"
  done
  unset _log _leg
fi

echo -n "panel-review: done."
for _leg in "${LEGS[@]}"; do
  if [[ "${LEG_SELECTED[$_leg]}" -eq 1 ]]; then
    echo -n " $_leg rc=${LEG_RC[$_leg]}"
  elif [[ "${LEG_HEALTH[$_leg]}" == "off" ]]; then
    echo -n " $_leg=off"
  elif [[ "${LEG_HEALTH[$_leg]}" != "healthy" ]]; then
    echo -n " $_leg=skip(${LEG_HEALTH[$_leg]})"
  else
    echo -n " $_leg=skip(rotation)"
  fi
done
echo
# On success, drop the empty stderr sidecar; on failure keep it and point to it.
for _leg in "${LEGS[@]}"; do
  [[ "${LEG_SELECTED[$_leg]}" -eq 1 ]] || continue
  if [[ "${LEG_RC[$_leg]}" -eq 0 ]]; then
    [[ -s "${LEG_ERR[$_leg]}" ]] || rm -f "${LEG_ERR[$_leg]}"
  else
    echo "  WARNING: $_leg review failed (rc=${LEG_RC[$_leg]}); reason in ${LEG_ERR[$_leg]}, log ${LEG_LOG[$_leg]}"
  fi
done
unset _leg
# ── 花名册落盘 ────────────────────────────────────────────────────────
# 2026-08-05 实事故:各腿状态只活在终端里,事后我在 verify.md 写下"三条腿一致 PASS",
# 而 Kimi 那条腿根本没出结论(同一页第 90 行我自己还写着它没出报告)—— 同页自相矛盾。
# 手抄一份终端上的东西,抄错的那次不会有人发现。⇒ 机器写一行,verify.md 直接粘。
# 注意:这里的 PASS 只表示**进程 rc=0**,不表示它给了裁决;裁决永远要自己读日志。
ROSTER_FILE="${LOG_PREFIX}.roster"
# ── final:只有控制器活到这一步才写(escalation / HEAD_AFTER 也只有此刻才知道)
# 缺了不是错 —— 它说明**没有收尾记录**(控制器没活到收尾,**或者仍在跑**),
# panel-roster 会照实说,不猜死因。
{
  printf 'escalation=%s\n' "$ESCALATION_REASON"
  printf 'head-after=%s\n' "$HEAD_AFTER"
  # 升级追加增补腿之后,选腿结果变了,而 plan 是派发之前写的 ⇒ 这里补一份最终的。
  # 控制器没活到这一步时,render_roster 回落用 plan 的,并靠"盘上有 state"补齐腿。
  printf 'selected=%s\n' "$(selected_identities)"
  printf 'selected-count=%s\n' "$SELECTED_COUNT"
} > "${LOG_PREFIX}.final"
# 花名册**不再由内存渲染**:走和 panel-roster 完全同一条路(共享 lib 的 render_roster),
# 保证"控制器当场写的"和"事后重建的"**归一化后一致** —— 判据 R5b 守着这一条。
# (不是字面逐字节:抬头嵌了渲染时间戳,两次渲染必然不同;R5b 的 norm 抹掉
#  时间戳/HEAD/日志前缀三行再比。说"逐字节"会让人对这道闸产生错误预期。)
render_roster "$LOG_PREFIX" > "$ROSTER_FILE"
echo "  roster -> $ROSTER_FILE(各腿状态一行,粘进 verify.md,别再手写)"

echo "  read all logs above, then arbitrate."

# Non-zero only if every dispatched reviewer process failed. A standalone verdict
# remains a separate evidence property in roster/health: process success lets the
# main agent inspect a partial report, but never turns UNKNOWN into a verdict.
# self=0 is a deliberate no-external-review mode and succeeds without a process.
PANEL_RC=0
if [[ "$REVIEW_BUDGET" -ne 0 ]]; then
  _evidence=0
  for _leg in "${LEGS[@]}"; do
    [[ "${LEG_SELECTED[$_leg]}" -eq 1 && "${LEG_RC[$_leg]}" -eq 0 ]] && _evidence=$((_evidence + 1))
  done
  [[ "$_evidence" -gt 0 ]] || PANEL_RC=1
fi

# Controller-side compact observation. The roster/raw logs stay outside the repo;
# only whitelisted actual facts enter the main track. Missing model/usage remain null.
if [[ -n "$TRACK_NAME" ]]; then
  _obs_legs=(); _obs_degraded=false
  for _leg in "${LEGS[@]}"; do
    [[ "${LEG_SELECTED[$_leg]}" -eq 1 ]] || continue
    # 归档闸数的"覆盖了 N 个不同模型家族"就是数这个字段。取不到 ⇒ 拒跑,
    # 不许写一条 family 为空的腿进去(它会静默不算数,而报告读起来完全正常)。
    _family="$(panel_leg_family "$_leg")" || { echo "panel-review: 腿 $_leg 没有模型家族 ⇒ 拒绝写 observation" >&2; exit 70; }
    _adapter="$(basename "${LEG_CMD[$_leg]}")"
    _degraded=false
    if [[ -e "${LEG_LOG[$_leg]%.log}.agent.log" || -e "${LEG_LOG[$_leg]%.log}.agent.log.err" ]]; then
      _degraded=true; _obs_degraded=true
      # 降级 = 底座腿死了、聊天腿顶上来的 ⇒ 落盘的适配器要是**聊天腿**那个。
      [[ -n "${LEG_CHAT[$_leg]}" ]] && _adapter="$(basename "${LEG_CHAT[$_leg]}")"
    fi
    _verdict="$(verdict_of "${LEG_LOG[$_leg]}")"
    [[ "$_verdict" == UNKNOWN ]] && _verdict=null
    _obs_legs+=(--leg "$_leg,$_family,$_adapter,${LEG_RC[$_leg]},$_verdict,$_degraded")
  done
  PANEL_FINISHED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  PANEL_END_NS="$(date +%s%N)"
  PANEL_DURATION_MS=$(( (PANEL_END_NS - PANEL_START_NS) / 1000000 ))
  _obs_label="$(printf '%s' "$TASKNAME" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//')"
  [[ -n "$_obs_label" ]] || _obs_label=panel
  _obs_label="${_obs_label:0:128}"
  _run_id="$TS-$$-panel-review"
  if ! "$TRACK_RECORD_BIN" observe --repo "$CONTROL_REPO" --track "$TRACK_NAME" \
      --run-id "$_run_id" --controller panel-review --event execution_finished \
      --label "$_obs_label" --started-at "$PANEL_STARTED_AT" --finished-at "$PANEL_FINISHED_AT" \
      --duration-ms "$PANEL_DURATION_MS" --exit-code "$PANEL_RC" --adapter panel-review \
      --work-exit-code "$PANEL_RC" --risk "$IMPACT_RISK" --degraded "$_obs_degraded" \
      "${_obs_legs[@]}" >/dev/null; then
    echo "panel-review: OBSERVATION_WRITE_FAILED track=$TRACK_NAME run_id=$_run_id (controller rc 保持 $PANEL_RC)" >&2
  fi
fi

exit "$PANEL_RC"
