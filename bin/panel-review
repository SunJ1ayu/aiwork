#!/usr/bin/env bash
set -uo pipefail

# panel-review - run the review employees in parallel on one task, then let the
# main agent (the frontier model driving the session) arbitrate.
#   submimo (MiMo) + subdeepseek (DeepSeek) + subglm (Zhipu GLM) [+ subkimi (Moonshot)]
#
# Each reviewer writes its own log; this script does NOT decide anything - it just
# fans out the work and reports where the reports landed.

usage() {
  cat >&2 <<'EOF'
Usage:
  panel-review TASK_FILE [REPO_DIR] [LOG_PREFIX]

Runs all reviewers in parallel on TASK_FILE:
  submimo review  -> <LOG_PREFIX>.submimo.log
  subdeepseek review -> <LOG_PREFIX>.subdeepseek.log
  subglm review   -> <LOG_PREFIX>.subglm.log   (默认**聊天腿**,后端 OpenCode Go;
                                                 PANEL_GLM_LEG=agent 切底座腿 / off 关掉)
  subkimi review  -> <LOG_PREFIX>.subkimi.log   (4th leg, only if installed;
                                                 PANEL_KIMI_LEG=off disables)

Args:
  TASK_FILE    markdown task/review brief (required)
  REPO_DIR     repo to review (default: $PWD)
  LOG_PREFIX   log path prefix (default: /root/aiwork/logs/panel-<taskname>-<ts>)

Options / env:
  (my-review gate is DEFAULT-ON) With no flag, panel-review looks for the
                             convention file /root/aiwork/tasks/<taskname>-my-review.md
                             (taskname = TASK_FILE basename) and REFUSES to dispatch
                             if it is absent - so forgetting to write your own review
                             stops the panel instead of silently skipping the gate.
  --require-my-review PATH   use PATH instead of the convention path (still must
                             exist and live OUTSIDE REPO_DIR - the engine inlines
                             untracked repo files into reviewer prompts).
  --no-my-review             explicit opt-out: run without the gate (a conscious
                             choice, e.g. a task that has no diff to self-review).
  PANEL_ORACLE_CMD           if set, run it (in REPO_DIR) BEFORE dispatching and
                             record 'ORACLE: <cmd> rc=<N>' + <prefix>.oracle.log.
                             Records only, never blocks: 07-04 lesson - three
                             reviewers PASSed a broken oracle nobody had run.

The main agent reads ALL logs and makes the final call. Reviewers are advisors,
not voters. A failure in one reviewer does not block the others.
EOF
}

MY_REVIEW=""
NO_MY_REVIEW=0
POSARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --require-my-review)
      MY_REVIEW="${2:-}"
      [[ -n "$MY_REVIEW" ]] || { echo "panel-review: --require-my-review needs a path" >&2; exit 2; }
      shift 2 ;;
    --no-my-review) NO_MY_REVIEW=1; shift ;;
    *) POSARGS+=("$1"); shift ;;
  esac
done
set -- "${POSARGS[@]}"
if [[ $# -lt 1 || $# -gt 3 ]]; then usage; exit 2; fi

BIN="$(dirname "$0")"
TASK_FILE="$1"
REPO_DIR="${2:-$PWD}"

[[ -f "$TASK_FILE" ]] || { echo "panel-review: task file not found: $TASK_FILE" >&2; exit 1; }
[[ -d "$REPO_DIR" ]]  || { echo "panel-review: repo dir not found: $REPO_DIR" >&2; exit 1; }

# The my-review gate is DEFAULT-ON. Unless explicitly opted out, resolve a path:
# an explicit --require-my-review wins; otherwise derive the convention path from
# the task name. Then require it to exist and to live outside the repo. This flips
# the anti-anchoring discipline from "remember to arm it" to "forgetting stops you".
if [[ $NO_MY_REVIEW -eq 0 && -z "$MY_REVIEW" ]]; then
  MY_REVIEW="/root/aiwork/tasks/$(basename "${TASK_FILE%.*}")-my-review.md"
fi
if [[ $NO_MY_REVIEW -eq 0 ]]; then
  if [[ ! -f "$MY_REVIEW" ]]; then
    echo "panel-review: my-review file not found: $MY_REVIEW" >&2
    echo "  write your OWN review there first (anti-anchoring), then dispatch;" >&2
    echo "  or pass --no-my-review to consciously opt out." >&2
    exit 1
  fi
  RPD="$(realpath "$REPO_DIR")"
  # Check BOTH the symlink-resolved path AND the lexical path (realpath -s, which
  # resolves .. but does NOT follow a final-component symlink). A review file that
  # is physically a symlink inside the repo resolves outside via plain realpath but
  # is still listed by `git ls-files --others` and read-followed by the engine -
  # so the lexical location is what actually decides the leak.
  for MRV in "$(realpath "$MY_REVIEW")" "$(realpath -s "$MY_REVIEW")"; do
    case "$MRV" in
      "$RPD"/*)
        echo "panel-review: my-review file is INSIDE the repo under review: $MRV" >&2
        echo "  the engine inlines untracked repo files into reviewer prompts and would leak it" >&2
        echo "  (a symlink physically in the repo counts too). Move it outside," >&2
        echo "  e.g. /root/aiwork/tasks/<name>-my-review.md" >&2
        exit 1 ;;
    esac
  done
fi

TS="$(date +%Y%m%d-%H%M%S)"
TASKNAME="$(basename "${TASK_FILE%.*}")"
LOG_PREFIX="${3:-/root/aiwork/logs/panel-${TASKNAME}-${TS}}"
mkdir -p "$(dirname "$LOG_PREFIX")"

# GLM leg selection.
# 开关史:2026-08-04 智谱账号余额不足(429 / 1113),这条腿每轮只是白等一次超时,
# 还让"四审"看起来满编、实际三腿 ⇒ 用户拍板「先关掉」,默认 off。
# **2026-08-18 默认翻回开着**:后端换成业主的 OpenCode Go 订阅,欠费这个理由消失了。
# 「默认关着」当初是为欠费立的,不是永久规格 —— 理由没了还留着,四审就永远只有三腿
# (这条腿已经这样关了两周)。没钱/出故障时的关法仍在:`PANEL_GLM_LEG=off`。
#
# **默认档是 chat(聊天腿),不是 agent** —— 这不是偏好,是后端逼出来的:
# OpenCode Go 的 Anthropic 面**不做工具格式转换**(它把请求体直接转发给 OpenAI 形状的
# 上游),带 Anthropic 形状的 tools 一律 400「Missing required input field:
# 'tools[0].function.name'」。08-18 实测三档:无工具 200 / Anthropic 形状工具 400 /
# OpenAI 形状工具 200。而底座腿的全部意义就是自带工具自己读仓库 ⇒ 在这个后端上它起不来,
# 默认写 agent 只会每轮回落一次(或者更糟:看起来在跑、其实每次都 400)。
# 代价要认:聊天腿看不见仓库,只看得见 diff ⇒ **派它时记得带 PANEL_INCLUDE**
# (下面那条 `HINT: chat leg in play and PANEL_INCLUDE is empty` 就是干这个的,
#  默认走 chat 之后它会常亮)。**这里不写行号**:上一版写了"第 207 行",而我加的
#  注释自己就把它推到了 221 行 —— 写下的那一刻就是错的。行号不是身份。
# 哪天 Go 把格式转换补上、或换成 opencode 自己的底座,把这里改回 agent 即可。
# 取值:chat = 聊天腿(默认);agent = 底座腿(自己读仓库,本后端上会 400);off = 不派发。
GLM_LEG="${PANEL_GLM_LEG:-chat}"
GLM_CMD=""
if [[ "$GLM_LEG" == "off" ]]; then
  GLM_CMD=""                      # 关着:不派发、不报 rc
elif [[ "$GLM_LEG" == "agent" && -x "$BIN/subglm-agent" ]]; then
  GLM_CMD="$BIN/subglm-agent"
else
  GLM_CMD="$BIN/subglm"           # 要 agent 但没装 → 回落聊天腿(老行为,不许退化)
fi

# DeepSeek leg selection: agent base (subdeepseek-agent = DeepSeek via
# Claude Code, reads the repo itself) is the default when installed;
# PANEL_DEEPSEEK_LEG=chat forces the chat leg
# (subdeepseek -> DeepSeek official chat API), which goes
# blind on an empty diff. Mirrors the GLM leg above.
DEEPSEEK_LEG="${PANEL_DEEPSEEK_LEG:-agent}"
if [[ "$DEEPSEEK_LEG" == "agent" && -x "$BIN/subdeepseek-agent" ]]; then
  DEEPSEEK_CMD="$BIN/subdeepseek-agent"
else
  DEEPSEEK_CMD="$BIN/subdeepseek"
fi

# Kimi leg (4th reviewer, Moonshot kimi-code agent base): auto-enabled when
# subkimi is installed; PANEL_KIMI_LEG=off disables. There is no chat fallback -
# absent or disabled just means the classic 3-leg panel.
KIMI_CMD=""
if [[ "${PANEL_KIMI_LEG:-agent}" != "off" && -x "$BIN/subkimi" ]]; then
  KIMI_CMD="$BIN/subkimi"
fi

SUBMIMO_LOG="${LOG_PREFIX}.submimo.log"
SUBDEEPSEEK_LOG="${LOG_PREFIX}.subdeepseek.log"
SUBGLM_LOG="${LOG_PREFIX}.subglm.log"
SUBKIMI_LOG="${LOG_PREFIX}.subkimi.log"
SUBMIMO_ERR="${SUBMIMO_LOG}.err"
SUBDEEPSEEK_ERR="${SUBDEEPSEEK_LOG}.err"
SUBGLM_ERR="${SUBGLM_LOG}.err"
SUBKIMI_ERR="${SUBKIMI_LOG}.err"

# Oracle record slot: run BEFORE dispatch so the arbiter never reads reviewer
# verdicts without knowing whether the objective check is green. Records only -
# the verdict stays with the main agent.
if [[ -n "${PANEL_ORACLE_CMD:-}" ]]; then
  ORACLE_LOG="${LOG_PREFIX}.oracle.log"
  ( cd "$REPO_DIR" && bash -c "$PANEL_ORACLE_CMD" ) >"$ORACLE_LOG" 2>&1
  ORACLE_RC=$?
  echo "ORACLE: $PANEL_ORACLE_CMD rc=$ORACLE_RC (output: $ORACLE_LOG)"
  if [[ $ORACLE_RC -ne 0 ]]; then
    echo "  WARNING: oracle is RED - reviewer PASS 不可信 (07-04 教训: 先跑 oracle 再读 panel)"
    tail -n 5 "$ORACLE_LOG" | sed 's/^/  | /'
  fi
fi

# PANEL_INCLUDE -> chat legs (2026-07-21 工具债): a chat leg only ever sees the
# incremental `git diff`, so oracle/test files that live in the BASELINE commit are
# invisible to it — both chat legs literally reported "测试文件不在 diff 里没法评".
# Forward the patterns verbatim to each chat leg's own INCLUDE var (agent legs read
# the repo themselves and ignore this).
if [[ -n "${PANEL_INCLUDE:-}" ]]; then
  export ZHIPU_INCLUDE="${ZHIPU_INCLUDE:-$PANEL_INCLUDE}"
  export DEEPSEEK_INCLUDE="${DEEPSEEK_INCLUDE:-$PANEL_INCLUDE}"
fi

# PANEL_DIFF_BASE 默认值(2026-07-27 实事故):chat 腿默认只看**工作区未提交改动**,
# 而本机流程是「先 commit 再派发」(oracle 先行、my-review 落在仓外),所以派发时
# 工作区通常是干净的 —— chat 腿拿到的实现代码是**空的**。那次 subglm 的 agent 腿挂了
# 回落 chat 腿,报告里自己写着「bin/ds_web.py 的具体实现内容不可得」,findings 全是把
# 任务书复述回来还标 HIGH。**这是结构性盲评,不是模型差**,而且 agent 腿一回落就复发。
# 故:未显式指定时,把 diff 基线设成仓库的默认分支,让 chat 腿看见整条分支的改动。
if [[ -z "${PANEL_DIFF_BASE:-}" ]]; then
  for _b in main master; do
    if git -C "$REPO_DIR" rev-parse --verify --quiet "$_b" >/dev/null 2>&1 \
       && [[ "$(git -C "$REPO_DIR" rev-parse "$_b" 2>/dev/null)" \
             != "$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null)" ]]; then
      export PANEL_DIFF_BASE="$_b"
      echo "  NOTE: PANEL_DIFF_BASE 未给,自动用 '$_b' 作 diff 基线(chat 腿否则只看未提交改动)"
      break
    fi
  done
  unset _b
fi

echo "panel-review: task=$TASK_FILE repo=$REPO_DIR"
echo "  submimo  -> $SUBMIMO_LOG"
echo "  subdeepseek -> $SUBDEEPSEEK_LOG (leg: $(basename "$DEEPSEEK_CMD"))"
echo "  subglm   -> $SUBGLM_LOG (leg: $(basename "$GLM_CMD"))"
if [[ -n "$KIMI_CMD" ]]; then
  echo "  subkimi  -> $SUBKIMI_LOG (leg: $(basename "$KIMI_CMD"))"
fi
# A chat leg with nothing attached beyond the diff cannot review the oracle itself
# ("是规格错还是实现错"就查不了)。Nudge, never block — the arbiter decides.
if [[ -z "${PANEL_INCLUDE:-}" ]] \
   && { [[ "$(basename "$GLM_CMD")" == "subglm" ]] || [[ "$(basename "$DEEPSEEK_CMD")" == "subdeepseek" ]]; }; then
  echo "  HINT: chat leg in play and PANEL_INCLUDE is empty — it only sees the incremental diff."
  echo "        Pass PANEL_INCLUDE=\"tests/test_x.py tests/e2e/y.mjs\" so it can review the oracle too."
fi

# Anti-anchoring leak check (2026-07-21 实事故): the engine inlines untracked repo
# files and the whole diff into every reviewer prompt. If the main agent's OWN
# findings are sitting in the repo (a filled-in tracks/**/verify.md, a stray
# *my-review*), the "independent" legs end up quoting them back — one chat leg
# literally cited verify.md as evidence. Warn (never block); the arbiter decides.
anchor_leak_files() {
  # -uall: 不带它 git 会把未跟踪目录折叠成 `tracks/`,verify.md 就漏检了(oracle 实抓)
  { git -C "$REPO_DIR" status --porcelain -uall 2>/dev/null | awk '{print $NF}'
    if [[ -n "${PANEL_DIFF_BASE:-}" ]]; then
      git -C "$REPO_DIR" diff --name-only "${PANEL_DIFF_BASE}...HEAD" 2>/dev/null
    fi
    # 第三臂(2026-08-05 实测):上面两臂在**本机默认形状**下都照不到 ——
    # 我一直在 main 上干活(main == HEAD ⇒ PANEL_DIFF_BASE 那一臂结构上不存在),
    # 而 verify.md 是已提交的(⇒ status 那一臂也空)。那次 DeepSeek 日志第 28 行
    # 读了 verify.md、第 101 行原文引用我的「规格自查第 2 条」,两臂一声没吭。
    # 底座腿自己读仓库,**不看 diff**,所以只要文件在树上就够得着。
    # 只报与本任务同名的 track(任务文件常叫 <track>-review.md),不相干的 track
    # 不报 —— 误报会把警告变噪音,下一次就没人看了。
    local _base="${TASKNAME%-my-review}"; _base="${_base%-review}"
    if [[ -n "$_base" ]]; then
      local _f _t
      while IFS= read -r _f; do
        [[ -n "$_f" ]] || continue
        _t="${_f#tracks/}"; _t="${_t%%/*}"
        [[ -n "$_t" ]] || continue
        if [[ "$_base" == "$_t"* || "$_t" == "$_base"* ]]; then echo "$_f"; fi
      done < <(git -C "$REPO_DIR" ls-files 'tracks/*/verify.md' 2>/dev/null)
    fi
  } | grep -Ei 'verify\.md$|my.?review' | sort -u
}
LEAK="$(anchor_leak_files)"
if [[ -n "$LEAK" ]]; then
  echo "  WARNING: anchor leak(反锚定) — 主审自己的评审可能进了评审腿的 prompt:"
  echo "$LEAK" | sed 's/^/    /'
  echo "    (引擎会把未跟踪文件与整份 diff 内联进每条腿;先派发、后写 verify.md)"
fi

# 派发窗口的树是不是同一棵(2026-08-05 实事故):22:40 我趁 Kimi 还在跑提交了 80d2d23,
# 它的日志 1027–1094 行整段在追查"仓库正在被人改",并把 BLOCK 押在这个幻影上 —— 25 分钟全废。
# 各腿是**并行**的,谁在哪一刻读到哪棵树没人知道;所以派发前后各记一次 HEAD,不同就明说。
HEAD_BEFORE="$(git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null || true)"

echo "  running all in parallel..."

# Light pre-launch stagger: the three reviewers share provider tpm budgets, and
# bursting all at once is the main 429 trigger. Sleep a small random gap (default
# up to 2s; PANEL_STAGGER_MAX=0 disables) before the 2nd and 3rd launches so the
# token bursts don't perfectly overlap. $RANDOM seeds awk to dodge same-second
# srand() collisions. Pairs with the engine's 429 backoff (belt and suspenders).
stagger() {
  local max="${PANEL_STAGGER_MAX:-2}"
  [[ "$max" == 0 || "$max" == 0.0 ]] && return 0
  sleep "$(awk -v m="$max" -v r="$RANDOM" 'BEGIN{printf "%.3f", (r/32768)*m}')"
}

# Capture each reviewer's stderr to a sidecar .err file so an early startup failure
# (missing key, bad endpoint, etc.) is recorded instead of swallowed. We do NOT
# redirect into the .log itself because each reviewer truncates its own .log on
# success; a sidecar avoids that race. stdout is dropped (the result is in the .log).
# Agent-leg failure -> automatic chat-leg fallback (2026-07-21): a dead agent leg
# used to cost a whole reviewer (GLM: unsubscribed CodingPlan -> 400; DeepSeek:
# "Reached max turns"). The chat leg is a weaker but live reviewer, so retry there
# instead of silently shipping a 2-leg panel. The failed agent output is preserved
# as <log>.agent.log(+.err) so the infra failure stays diagnosable.
# ⚠ `setsid` 套不到 bash 函数上,所以下面是套在**函数里那两处真正的调用**上:
#   会话一死,run_leg 这层壳会跟着没(于是回落逻辑不再跑),但**腿自己活着写完日志** ——
#   要保的正是那份日志。
run_leg() {  # run_leg <agent_cmd> <chat_cmd> <log> <err> <label>
  local agent="$1" chat="$2" log="$3" err="$4" label="$5" rc
  # --panel-dispatch 走**命令行**,不用环境变量(后者会被 shell 继承 = 随手可按的后门);
  # 而且放在**参数末尾** —— 放开头会把各腿的位置参数整体顶偏一位,
  # 任何按 $3 取日志路径的调用方(判据里的假腿全是这么写的)当场就坏。08-06 实测。
  setsid --wait "$agent" review "$TASK_FILE" "$log" "$REPO_DIR" --panel-dispatch >/dev/null 2>"$err"; rc=$?
  if [[ $rc -eq 0 || "$agent" == "$chat" ]]; then return $rc; fi
  # agent leg died and a distinct chat leg exists -> keep the evidence, then retry
  [[ -e "$log" ]] && mv -f "$log" "${log%.log}.agent.log"
  [[ -s "$err" ]] && mv -f "$err" "${log%.log}.agent.log.err" || rm -f "$err"
  local agent_rc=$rc   # 底座腿的死因;下面 rc 会被聊天腿的返回码覆盖
  echo "  NOTE: $label agent leg failed (rc=$agent_rc) -> fallback to chat leg;" \
       "agent output kept at ${log%.log}.agent.log(.err)"
  setsid --wait "$chat" review "$TASK_FILE" "$log" "$REPO_DIR" --panel-dispatch >/dev/null 2>"$err"; rc=$?
  # 横幅写进日志本身,不只印在 stdout:这份结论以后会被单独读到(归档、断线重连),
  # 那时终端上那行 NOTE 早就没了,而一份降级腿的结论长得和健康腿一模一样。
  # 2026-08-03 我就是这样差点按「四审三腿 PASS」给权重,实际只有两腿睁着眼。
  if [[ -s "$log" ]]; then
    { echo "⚠️  DEGRADED / 降级腿 —— 这份结论不是底座腿给的。"
        echo "    $label 的底座腿(自己读仓库)先死了:rc=$agent_rc,证据在 ${log##*/}"
      echo "    去掉 .log 后加 .agent.log(.err);随后自动回落到聊天腿重跑。"
      echo "    ⇒ 它只看得见 diff,**没有独立查证仓库的能力**。给权重时按此折扣。"
      echo
      cat "$log"
    } > "$log.tmp" && mv -f "$log.tmp" "$log"
  fi
  return $rc
}

# ── 每条腿都起在**自己的会话里**(2026-08-17)────────────────────────────
# 起因:08-16 和 08-17 两次断线,都砍在四审跑到一半。腿是这个驱动的后台子进程,
# 整串在调用者的进程组里 ⇒ 会话一死,SIGTERM 打到整组,**谁还没跑完谁全丢**。
# submimo 三分钟交卷、保住了;kimi 要跑 11~18 分钟,于是每次被砍的都是它 ——
# **它不是最脆的那条,是尾巴最长的那条**。
#
# `setsid --wait` 两头都要:腿进新会话(SIGTERM 够不着),而 setsid 自己仍是本脚本
# 的子进程 ⇒ 下面的 `wait` 和 rc 语义一个字都不用改。
# 注意 subkimi 里那套"先写裁决、超时也不亏"的兜底**防不了这个** ——
# 被 SIGTERM 打死时那段抢救代码根本没机会跑。兜底装在了另一种失败模式上。
LEG=(setsid --wait)
"${LEG[@]}" "$BIN/submimo"  review "$TASK_FILE" "$SUBMIMO_LOG"  "$REPO_DIR" --panel-dispatch >/dev/null 2>"$SUBMIMO_ERR"  &
PID_MIMO=$!
stagger
run_leg "$DEEPSEEK_CMD" "$BIN/subdeepseek" "$SUBDEEPSEEK_LOG" "$SUBDEEPSEEK_ERR" subdeepseek &
PID_DEEPSEEK=$!
stagger
PID_GLM=""
if [[ -n "$GLM_CMD" ]]; then
  run_leg "$GLM_CMD" "$BIN/subglm" "$SUBGLM_LOG" "$SUBGLM_ERR" subglm &
  PID_GLM=$!
fi
PID_KIMI=""
if [[ -n "$KIMI_CMD" ]]; then
  stagger
  "${LEG[@]}" "$KIMI_CMD"   review "$TASK_FILE" "$SUBKIMI_LOG"  "$REPO_DIR" --panel-dispatch >/dev/null 2>"$SUBKIMI_ERR"  &
  PID_KIMI=$!
fi

wait "$PID_MIMO";  RC_MIMO=$?
wait "$PID_DEEPSEEK"; RC_DEEPSEEK=$?
RC_GLM=0
if [[ -n "$PID_GLM" ]]; then wait "$PID_GLM"; RC_GLM=$?; fi
RC_KIMI=0
if [[ -n "$PID_KIMI" ]]; then
  wait "$PID_KIMI"; RC_KIMI=$?
fi

echo
# ── 派发期间 HEAD 动了没有 ────────────────────────────────────────────
# 横幅**写进每份腿日志**,不只印在 stdout:这些结论以后会被单独读到(归档、断线重连),
# 那时终端上这行早没了,而一份"评的是别的树"的结论长得和正常结论一模一样(同 V19)。
HEAD_AFTER="$(git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null || true)"
if [[ -n "$HEAD_BEFORE" && -n "$HEAD_AFTER" && "$HEAD_BEFORE" != "$HEAD_AFTER" ]]; then
  echo "  ⚠️  评审期间仓库 HEAD 从 $HEAD_BEFORE 移到 $HEAD_AFTER —— 各腿看到的可能不是同一棵树。"
  echo "     腿报告里的「仓库正在被改/文件对不上」多半是这个,不是被评代码的问题;"
  echo "     受影响就重跑,别拿它当 finding(2026-08-05 实事故:一条腿为此白跑 25 分钟)。"
  for _log in "$SUBMIMO_LOG" "$SUBDEEPSEEK_LOG" "$SUBGLM_LOG" "$SUBKIMI_LOG"; do
    [[ -s "$_log" ]] || continue
    { echo
      echo "⚠️  评审期间仓库 HEAD 从 $HEAD_BEFORE 移到 $HEAD_AFTER(本报告尾部由 panel-review 追加)。"
      echo "    这条腿读到的树可能不是你现在看到的那棵;它若抱怨「仓库正在被人改」,那是这个原因。"
    } >> "$_log"
  done
  unset _log
fi

GLM_REPORT=" subglm rc=$RC_GLM"
[[ -z "$GLM_CMD" ]] && GLM_REPORT=" subglm=off(是有人显式设了 PANEL_GLM_LEG=off)"
if [[ -n "$KIMI_CMD" ]]; then
  echo "panel-review: done. submimo rc=$RC_MIMO  subdeepseek rc=$RC_DEEPSEEK $GLM_REPORT  subkimi rc=$RC_KIMI"
else
  echo "panel-review: done. submimo rc=$RC_MIMO  subdeepseek rc=$RC_DEEPSEEK $GLM_REPORT"
fi
# On success, drop the (empty) stderr sidecar; on failure keep it and point to it.
if [[ $RC_MIMO -eq 0 ]]; then
  [[ -s "$SUBMIMO_ERR" ]] || rm -f "$SUBMIMO_ERR"
else
  echo "  WARNING: submimo review failed (rc=$RC_MIMO); reason in $SUBMIMO_ERR, log $SUBMIMO_LOG"
fi
if [[ $RC_DEEPSEEK -eq 0 ]]; then
  [[ -s "$SUBDEEPSEEK_ERR" ]] || rm -f "$SUBDEEPSEEK_ERR"
else
  echo "  WARNING: subdeepseek review failed (rc=$RC_DEEPSEEK); reason in $SUBDEEPSEEK_ERR, log $SUBDEEPSEEK_LOG"
fi
if [[ -z "$GLM_CMD" ]]; then
  :   # 腿关着,没有 rc 可报(报了会被误读成"跑过且通过")
elif [[ $RC_GLM -eq 0 ]]; then
  [[ -s "$SUBGLM_ERR" ]] || rm -f "$SUBGLM_ERR"
else
  echo "  WARNING: subglm review failed (rc=$RC_GLM); reason in $SUBGLM_ERR, log $SUBGLM_LOG"
fi
if [[ -n "$KIMI_CMD" ]]; then
  if [[ $RC_KIMI -eq 0 ]]; then
    [[ -s "$SUBKIMI_ERR" ]] || rm -f "$SUBKIMI_ERR"
  else
    echo "  WARNING: subkimi review failed (rc=$RC_KIMI); reason in $SUBKIMI_ERR, log $SUBKIMI_LOG"
  fi
fi
# ── 花名册落盘 ────────────────────────────────────────────────────────
# 2026-08-05 实事故:各腿状态只活在终端里,事后我在 verify.md 写下"三条腿一致 PASS",
# 而 Kimi 那条腿根本没出结论(同一页第 90 行我自己还写着它没出报告)—— 同页自相矛盾。
# 手抄一份终端上的东西,抄错的那次不会有人发现。⇒ 机器写一行,verify.md 直接粘。
# 注意:这里的 PASS 只表示**进程 rc=0**,不表示它给了裁决;裁决永远要自己读日志。
ROSTER_FILE="${LOG_PREFIX}.roster"
roster_entry() {  # roster_entry <名字> <rc> <这条腿派没派> <log>
  local name="$1" rc="$2" enabled="$3" log="$4" state
  if [[ "$enabled" != 1 ]]; then printf '%s=off' "$name"; return; fi
  if [[ "$rc" -eq 0 ]]; then state="PASS"; else state="FAIL(rc=$rc)"; fi
  # 底座腿死了、聊天腿顶上来的:结论可以旅行,资格要跟着走(同 V19 的降级横幅)
  if [[ -e "${log%.log}.agent.log" || -e "${log%.log}.agent.log.err" ]]; then
    if [[ "$rc" -eq 0 ]]; then state="PASS(降级:回落聊天腿,只看得见 diff)"
    else state="FAIL(rc=$rc,降级:回落聊天腿也没成)"; fi
  fi
  printf '%s=%s' "$name" "$state"
}
{
  echo "# panel-review 花名册($(date '+%F %T'))task=$TASKNAME"
  echo "# PASS = 进程 rc=0,**不等于给了裁决**;off = 这条腿压根没派(不许读成通过)。"
  echo "# 日志:${LOG_PREFIX}.*.log"
  echo "$(roster_entry submimo     "$RC_MIMO"     1 "$SUBMIMO_LOG") \
$(roster_entry subdeepseek "$RC_DEEPSEEK" 1 "$SUBDEEPSEEK_LOG") \
$(roster_entry subglm      "$RC_GLM"      "$([[ -n "$GLM_CMD"  ]] && echo 1 || echo 0)" "$SUBGLM_LOG") \
$(roster_entry subkimi     "$RC_KIMI"     "$([[ -n "$KIMI_CMD" ]] && echo 1 || echo 0)" "$SUBKIMI_LOG")"
  if [[ -n "$HEAD_BEFORE" && -n "$HEAD_AFTER" && "$HEAD_BEFORE" != "$HEAD_AFTER" ]]; then
    echo "# ⚠️ 评审期间 HEAD 从 $HEAD_BEFORE 移到 $HEAD_AFTER —— 各腿未必评的同一棵树。"
  fi
} > "$ROSTER_FILE"
echo "  roster -> $ROSTER_FILE(各腿状态一行,粘进 verify.md,别再手写)"

echo "  read all logs above, then arbitrate."

# Non-zero only if ALL dispatched reviewers failed (panel produced no evidence).
if [[ $RC_MIMO -ne 0 && $RC_DEEPSEEK -ne 0 && $RC_GLM -ne 0 ]]; then
  if [[ -z "$KIMI_CMD" || $RC_KIMI -ne 0 ]]; then exit 1; fi
fi
exit 0
