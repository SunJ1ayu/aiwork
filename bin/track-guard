#!/usr/bin/env bash
# track-guard — pre-commit 守卫:暂存工件和证据卫生,红一条挡一条。
#   规矩1: bump 版本号的 commit 必须挂在一个 track 下(本次提交里 tracks/ 有动静,
#          或最近一次 verify.md 改动落在 7 天内 —— 兜住「归进现成 track」的情况)。
#   规矩2: 最近被改动的 track 的 verify.md 里,lane 和 派给 不许空着。
# 这里只做提交信息生成前能做的早期提醒；关键 commit 与具体轮次的硬绑定由
# commit-msg 阶段的 track-commit-msg 负责。`--no-verify` 可以绕过本地 hook，
# 所以历史审计仍需调用 `track-commit-msg --audit <range>`，不能把 hook 当权限边界。
set -u

BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

fail=0
say() { printf 'track-guard: %s\n' "$1" >&2; }

# 打印进药方里的路径必须能**原样粘进 shell**:仓里的正文文件名是中文的常态
# (`设计文档.md`),空格也不是没有。裸路径会当场断在 word-split 上,而**不带 -z** 的
# `git ls-files` 还会把非 ASCII C-quote 成 "\346\224\266..." —— 那种字符串连剥前缀
# 都剥不掉。两件事同一把锁:列残件走 `ls-files -z`,打印一律过下面这个引号函数。
# `-z` 与 core.quotepath 无关 —— 09-09 实测两种设置下 -z 输出逐字节相同,所以这里
# **不再写 `-c core.quotepath=false`**:那一格红检咬不动(变异后判据全绿),
# 留着只会让下一个人以为它承重。承重的两把锁各有一条变异咬着。
# (2026-09-09 第四轮 subdeepseek 提出,主裁复现;G14⑤ 钉住。)
shq() {
  case "$1" in
    *[!A-Za-z0-9._/-]*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
    *) printf '%s' "$1" ;;
  esac
}

staged() { git diff --cached --name-only; }

# active typed 机器源不能依赖 working verify.md 才触发校验；否则同一 commit 删除
# verify，再把 observation 塞进 transcript，就会被 `[ -f verify ] || continue` 跳过。
# 真正搬入 archive 的 active 删除由下面 archive/staged validator 接管。
active_typed_dirs_changed() {
  local path
  while IFS= read -r -d '' path; do
    if [[ "$path" =~ ^(tracks/[^/]+)/(decision\.json|verify\.md|observations(/.*)?)$ ]]; then
      printf '%s\0' "${BASH_REMATCH[1]}"
    fi
  done < <(git diff --cached --name-only -z) | sort -zu
}

while IFS= read -r -d '' track_dir; do
  name="${track_dir#tracks/}"
  # 合法 archive move：staged destination 的 typed facts 会在归档循环完整校验。
  staged_active=0; staged_archive=0
  git cat-file -e ":$track_dir/decision.json" 2>/dev/null && staged_active=1
  git cat-file -e ":tracks/archive/$name/decision.json" 2>/dev/null && staged_archive=1
  if [[ "$staged_archive" -eq 1 && "$staged_active" -eq 0 ]]; then
    active_left="$(git ls-files -- "$track_dir" 2>/dev/null)"
    if [[ -z "$active_left" ]]; then
      continue
    fi
    fail=1
    say "🔴 archive destination 已存在，但 staged active 目录仍有残留:$track_dir（归档必须完整 move）。"
    continue
  fi
  if [[ "$staged_archive" -eq 1 && "$staged_active" -eq 1 ]]; then
    fail=1
    say "🔴 track 名全生命周期必须唯一，staged active/archive 同名:$name（归档必须 move，不能 copy）。"
  fi
  known_decision=0
  [[ "$staged_active" -eq 1 ]] && known_decision=1
  [ -f "$track_dir/decision.json" ] && known_decision=1
  git cat-file -e "HEAD:$track_dir/decision.json" 2>/dev/null && known_decision=1
  [[ "$known_decision" -eq 1 ]] || continue
  if ! git cat-file -e ":$track_dir/decision.json" 2>/dev/null; then
    fail=1
    say "🔴 typed decision 没有出现在 staged snapshot（新文件漏 add 或已被删除）:$track_dir/decision.json"
    continue
  fi
  if ! git cat-file -e ":$track_dir/verify.md" 2>/dev/null; then
    fail=1
    say "🔴 typed active track 的 staged snapshot 缺 verify.md:$track_dir/verify.md"
  fi
  if ! "$BIN/track-record" validate --phase shape --source staged "$track_dir"; then
    fail=1
    say "🔴 typed active 机器源的 staged snapshot 未通过 shape:$track_dir"
  fi
done < <(active_typed_dirs_changed)
unset active_left staged_active staged_archive

# 逃生口(规矩1 与规矩4 共用):本次提交带了 track 工件,或近 7 天有 verify.md 改动。
# **只此一份** —— 08-06 第一版把这五行在两条规矩里各抄了一遍,而"两份拷贝总有一份
# 会落下"是本机反复记账的那条债(底座腿因此合并过躯干)。趁只有两份先合掉。
hangs_on_a_track() {
  staged | grep -q '^tracks/' && return 0
  local recent
  recent=$(git log --since='7 days ago' --name-only --pretty=format: -- 'tracks/*/verify.md' | grep . | head -1)
  [ -n "$recent" ]
}

# ---- 规矩1:bump 必挂 track ----
# 版本号住在哪由项目决定:npm 系在 package.json,而 design-studio 的真版本号在
# `bin/ds_web.py` 的 `VERSION = "..."`(/api/health 回显的、部署铁律核对的都是它;
# web/package.json 自建仓起一直是 0.1.0)。08-04 实证:`41f8aa6` 把 0.69.0 bump 到
# 0.70.0、tracks/ 零文件,**守卫一声没响** —— 规矩是真的,只是守在这个项目不用的门上。
bumped=""
for f in $(staged || true); do
  case "$f" in
    *package.json)
      git diff --cached -U0 -- "$f" | grep -qE '^\+.*"version"[[:space:]]*:' && bumped="$f" ;;
    *)
      git diff --cached -U0 -- "$f" | grep -qE '^\+[[:space:]]*VERSION[[:space:]]*=[[:space:]]*["'"'"']' && bumped="$f" ;;
  esac
  [ -n "$bumped" ] && break
done

if [ -n "$bumped" ] && ! hangs_on_a_track; then
  fail=1
  say "🔴 规矩1:$bumped 在 bump 版本号,但本提交没动 tracks/,近 7 天也没有 verify.md 更新。"
  say "   bump 必须挂 track(新起一个,或把这单归进现成 track 的 verify.md)。"
fi

# ---- 规矩4:动了评审/派活工具或判据,也必须挂 track ----
# 为什么加(2026-08-06 当天自查):规矩1 只在 **bump 版本号** 时触发,而 `/root/aiwork`
# 这个仓**根本没有版本号** ⇒ 那个仓的改动结构上永远不会被要求挂 track。当天实证:
# 我改了 `bin/panel-review`(评审工具链本身 = 信任面)并新建了两个工具,三条改动
# 没有任何 track、没有 verify ⇒ **`lane:` 那道题从头到尾没被问过**;而同一天我却因为
# "碰判卷防线"给另一单走了 full 四审 —— 同性质两种待遇,差别只在有没有触发器。
# 守卫守错门的第二例(第一例:守在 package.json,而真版本号在 ds_web.py)。
# 逃生口与规矩1 同款(本次提交带 track 工件,或近 7 天有 verify.md 改动),
# 因为同一个 track 里连着改好几次是常态,每次都要求带工件就成了误报。
# 名单只此一份,在 bin/_tooling-paths.sh(track-guard 与总跑的漏网报告共用)。
. "$(dirname "$0")/_tooling-paths.sh" 2>/dev/null || {
  say "🔴 找不到 _tooling-paths.sh —— 规矩4 的名单缺件,拒绝放行(fail closed)"; exit 1; }
tooling=""
for f in $(staged || true); do
  if is_judging_surface "$f"; then tooling="$f"; break; fi
done

if [ -n "$tooling" ] && ! hangs_on_a_track; then
  fail=1
  say "🔴 规矩4:$tooling 属于评审/派活工具或判据(判卷防线),但本提交没动 tracks/,"
  say "   近 7 天也没有 verify.md 更新 ⇒ 这单的 lane 从头到尾没人问过。"
  say "   挂个 track(新起,或归进现成 track 的 verify.md)再提交。"
fi

# ---- 规矩2:最近改动的 verify.md 里 lane / 派给 非空 ----
# 取「本提交涉及的 verify.md」∪「工作区里最近 7 天内改过的 verify.md」逐个查。
verifies=$( { staged | grep -E '^tracks/[^/]+/verify\.md$' || true; \
              staged | sed -nE 's#^(tracks/[^/]+)/decision\.json$#\1/verify.md#p' || true; \
              staged | sed -nE 's#^(tracks/[^/]+)/observations/.*$#\1/verify.md#p' || true; \
              git log --since='7 days ago' --name-only --pretty=format: -- 'tracks/*/verify.md' | grep . || true; } | sort -u )

for v in $verifies; do
  [ -f "$v" ] || continue
  track_dir="${v%/verify.md}"
  # typed track 的机器字段只认 decision.json。这里必须验 **staged snapshot**:
  # working copy 可以已经被下一步编辑，不能替本次 commit 应试。
  staged_decision=0; known_decision=0
  git cat-file -e ":$track_dir/decision.json" 2>/dev/null && staged_decision=1
  if [[ "$staged_decision" -eq 1 ]] || [ -f "$track_dir/decision.json" ] \
      || git cat-file -e "HEAD:$track_dir/decision.json" 2>/dev/null; then
    known_decision=1
  fi
  if [[ "$known_decision" -eq 1 ]]; then
    if [[ "$staged_decision" -eq 0 ]]; then
      fail=1
      say "🔴 typed decision 没有出现在 staged snapshot（新文件漏 add 或已被删除）:$track_dir/decision.json"
      continue
    fi
    if ! "$BIN/track-record" validate --phase shape --source staged "$track_dir"; then
      fail=1
      say "🔴 typed decision 的 staged snapshot 未通过 shape:$track_dir/decision.json"
    fi
    continue
  fi
  # 有暂存版本时以暂存内容为准
  if staged | grep -qx "$v"; then
    content=$(git show ":$v" 2>/dev/null) || content=$(cat "$v")
  else
    content=$(cat "$v")
  fi
  if printf '%s\n' "$content" | grep -qE '^-[[:space:]]*lane:[[:space:]]*(<|$)'; then
    fail=1
    say "🔴 规矩2:$v 的 lane 空着(空着 = 走哪条 lane 从头到尾没被问过)。"
  fi
  if printf '%s\n' "$content" | grep -qE '^-[[:space:]]*派给:[[:space:]]*(<|$)'; then
    fail=1
    say "🔴 规矩2:$v 的 派给 空着(开工前就该写一句派给谁、为什么)。"
  fi
done

# ---- 规矩3:归档时 verify.md 的结论栏不许还是模板占位符 ----
# 为什么钉在归档而不是每次提交:`Verdict:` 按设计是**最后**才填的,verify.md 从
# `track new` 起就带着占位符。每次提交都查 = 误报 = 守卫被 --no-verify 绕过,比没有更糟。
# 归档那一刻"做完了"没有歧义,是唯一不误报的钉点。
# 出处:stage-timer 已合并上线、记忆写着"全流程走完",结论栏至今是占位符;
# 上一次(todo-one-view)靠人工清理才发现。lane/派给 有守卫,7 份里一次没空过。
for v in $(staged | grep -E '^tracks/archive/[^/]+/verify\.md$' || true); do
  content=$(git show ":$v" 2>/dev/null) || content=$(cat "$v" 2>/dev/null) || continue
  if printf '%s\n' "$content" | grep -qE '^-[[:space:]]*Verdict:[[:space:]]*<'; then
    fail=1
    say "🔴 规矩3:$v 在归档,但结论栏还是模板占位符(空着 = 没判过)。"
    say "   归档 = 宣布做完了;做完了却没有主裁结论,这单的判断从头到尾没被问过。"
  fi
done

# ---- 规矩5:verify.md 里粘的数,必须是 runlog 写下的那个数 ----
# 为什么加(2026-08-05 turn_id 实证):我写「python 866/0」,听起来完美 —— 实际上
# 回归用的解释器没装 mcp,**一整块闸被整块 SKIP**,汇总照印 OK。汇总会撒谎,细节不会。
# 08-08 起我已经在粘机器输出了,但**靠自觉**:没有任何东西拦着我写一句「全绿」交差,
# 而翻开 verify.md 也看不出那行字是机器吐的还是我编的。
# 强度只到这儿:堵**顺手四舍五入**,堵不住蓄意伪造(手改收据文件即可)——
# 别高估它,高估一道闸比没有闸更危险。逻辑只此一份,在 bin/_evidence.sh。
. "$(dirname "$0")/_evidence.sh" 2>/dev/null || {
  say "🔴 找不到 _evidence.sh —— 规矩5 缺件,拒绝放行(fail closed)"; exit 1; }

verify_content() {  # 有暂存版本时以暂存内容为准
  local v="$1" tmp; tmp="$(mktemp)"
  if staged | grep -qx "$v"; then git show ":$v" > "$tmp" 2>/dev/null || cp "$v" "$tmp"
  else cp "$v" "$tmp"; fi
  printf '%s' "$tmp"
}

# 5a 一致性:每次都查(没有 runlog 行的 verify.md 一条都不会被碰 ⇒ 老工件全身而退)
for v in $verifies; do
  [ -f "$v" ] || continue
  tmp="$(verify_content "$v")"
  ev_check "$(dirname "$v")" "$tmp" always "track-guard" "$v" || fail=1
  rm -f "$tmp"
done

# 5b/5c/5d 只在**归档**那一刻查(理由同规矩3:判据是一路补的,中途每次都查必然误报)。
# 「那一刻」= 这次提交把它**搬进/新建进** archive/(状态 A 或 R),**不是**"路径长得像归档"。
# 2026-08-08 四审两条腿独立命中:按路径匹配的话,改一份两个月前就归档的 verify.md
# 的错字也会被当成"你在归档"挡下,而仓里 8 份历史归档工件全部零收据 ⇒ 一碰就挡,
# 报错文案还是错的。任务书自己写着「误报比漏报更致命」,我照样踩了进去。
# 路径从 Git 到目录消费者都用 NUL 分隔；展示用 C-quote 与逐行解析会漏掉
# 中文/引号/制表符/换行路径。状态 R/C 后有两个路径，其余状态只有一个。
archiving_dirs_now() {
  local status path source
  while IFS= read -r -d '' status && IFS= read -r -d '' path; do
    source=""
    case "$status" in
      R*|C*) source="$path"; IFS= read -r -d '' path || return 1 ;;
    esac
    case "$status" in
      R*) [[ "$source" == tracks/archive/* ]] && continue ;; # archive 内部改名不是归档
      M*|D*) continue ;;
    esac
    if [[ "$path" =~ ^(tracks/archive/[^/]+)/ ]]; then
      printf '%s\0' "${BASH_REMATCH[1]}"
    fi
  done < <(git diff --cached --name-status --find-renames -z) | sort -zu
}

# 归档后交付正文的改动也要复验；只提取这笔 diff 实际触碰的归档目录。
# 收口记录由 validator 的投影排除，无关旧档案不进名单。
archive_machine_dirs_changed() {
  local path
  while IFS= read -r -d '' path; do
    if [[ "$path" =~ ^(tracks/archive/[^/]+)/ ]]; then
      printf '%s\0' "${BASH_REMATCH[1]}"
    fi
  done < <(staged_and_rename_sources) | sort -zu
}

# 名单只问哪些路径改变，不需要相似度推断：关闭 rename 检测，重命名自然成为
# D 源路径 + A 目标路径。完整取回仍由下游的 index 搬空检查豁免(G16)。
staged_and_rename_sources() {
  git diff --cached --name-only --no-renames -z
}

archive_typed_validation_dirs() {
  { archiving_dirs_now; archive_machine_dirs_changed; } | sort -zu
}

while IFS= read -r -d '' dir; do
  name="${dir#tracks/archive/}"
  known_typed=0
  git cat-file -e ":$dir/decision.json" 2>/dev/null && known_typed=1
  git cat-file -e "HEAD:$dir/decision.json" 2>/dev/null && known_typed=1
  # 搬入同时删 decision 时，destination 与 HEAD 同路径都看不见它；active source
  # 才能证明这原本是 typed track，不能让它在移动中降级成 legacy。
  git cat-file -e "HEAD:tracks/$name/decision.json" 2>/dev/null && known_typed=1
  [[ "$known_typed" -eq 1 ]] || continue
  # 取回(unarchive):整份档案搬回 tracks/<name>/ 时,decision.json 在 staged 里出现在
  # **active** 路径而不是 archive 路径。那不是"删除或降级 legacy",而是 archive_drift
  # 那条 BLOCK 自己指的合法出路的第一步 —— 不放行,闸就在拦自己给的药方
  # (2026-09-09 第二轮 panel,subdeepseek 实跑复现;G13① 钉住)。
  # 尺子有**两个**条件,缺一不可(2026-09-09 第三轮 panel,subkimi 提出、主裁复现):
  #   ① active 路径有 decision.json;② archive 侧在 index 里**已经搬空**。
  # 只查 ① 是不够的 —— `git cat-file -e ":path"` 问的是 **index**,而 index 装着
  # 全部已提交文件,不只是这次 staged 的。只查 ① 的话:同一笔提交里"删掉 archive 的
  # decision.json + 在 active 路径摆一份同名的"就能顺手改掉归档正文(G14①),
  # 而且这笔一旦落库,那个 decision.json 常驻 index ⇒ 此后**每一笔**改
  # tracks/archive/<name>/** 的提交都命中豁免,连塞一份伪造收据都放行(G14②)。
  # 加上 ② 之后,"取回"必须是名副其实的整份搬出;"搬出去的同时让 decision.json
  # 消失"(G13②)、"原地删掉它"(G13③)、"留着正文只搬走 decision"(G14①②)全部照旧拦。
  archive_left_list=()
  while IFS= read -r -d '' left; do archive_left_list+=("$left"); done \
    < <(git ls-files -z -- "$dir" 2>/dev/null)
  if git cat-file -e ":tracks/$name/decision.json" 2>/dev/null && [[ ${#archive_left_list[@]} -eq 0 ]]; then
    continue
  fi
  if ! git cat-file -e ":$dir/decision.json" 2>/dev/null; then
    fail=1
    if git cat-file -e ":tracks/$name/decision.json" 2>/dev/null; then
      # 像取回但没搬干净。说真原因 + 给**走得通**的出路(这单的主题就是"闸不许指错方向";
      # 到这里为止本单已经写坏过三句药方了)。
      # ⚠️ 这里不能写 `git mv $dir tracks/$name` —— 目标目录已存在时 git 会把整个目录
      # **塞进去变成 tracks/<name>/<name>/**,而且 rc=0(主裁 2026-09-09 亲跑,见 G14④)。
      # 所以逐个文件给,目标路径写全。
      say "🔴 取回没搬干净:$dir/decision.json 已不在 index，但 archive 侧还留着这些"
      say "   (正文留在原地、decision.json 却搬走了 ⇒ 这份档案再没人复验得了):"
      printf '%s\n' "${archive_left_list[@]}" | sed 's#^#   - #' >&2
      say "   出路:取回要**整份**搬出 —— 把上面这些也搬进 tracks/$name/:"
      # 三处都是"药方必须真跑得通"踩出来的,别删:
      #   · 目标子目录不存在时 `git mv` 是 **rc=128 fatal**,不是自己建 —— 而真实 track
      #     全都带 evidence/ observations/(本单第 5 句坏药方,G14④a 钉住);
      #   · 路径带空格/非 ASCII 时不加引号会当场断(G14⑤ 钉住);
      #   · 残件只在 index、工作树已经没有时,`git mv` 是 rc=128 "bad source" ——
      #     得先 `git checkout --` 把它取回工作树(G14⑥ 钉住)。
      for left in "${archive_left_list[@]}"; do
        rel="${left#$dir/}"
        pre=""
        [ -e "$left" ] || pre="git checkout -- $(shq "$left") && "
        if [[ "$rel" == */* ]]; then
          say "     ${pre}mkdir -p $(shq "tracks/$name/${rel%/*}") && git mv $(shq "$left") $(shq "tracks/$name/$rel")"
        else
          say "     ${pre}git mv $(shq "$left") $(shq "tracks/$name/$rel")"
        fi
      done
      say "   (目标已存在时 git mv 会拒绝,先决定留哪一份;确实要作废整份档案就连正文一起删。)"
    else
      say "🔴 typed archive 的 staged snapshot 缺 decision.json（不许删除或降级 legacy）:$dir/decision.json"
    fi
    continue
  fi
  if ! "$BIN/track-record" validate --phase archive --source staged "$dir"; then
    fail=1
    say "🔴 规矩3:$dir 的 staged typed outcome/coverage 未满足归档条件。"
  fi
done < <(archive_typed_validation_dirs)

while IFS= read -r -d '' dir; do
  v="$dir/verify.md"
  if ! git cat-file -e ":$v" 2>/dev/null; then
    fail=1
    say "🔴 规矩3:$v 没有出现在 staged archive（归档不能同时删掉验收结论）。"
    continue
  fi
  tmp="$(mktemp)"
  git show ":$v" > "$tmp" 2>/dev/null || { rm -f "$tmp"; fail=1; continue; }
  ev_check "$dir" "$tmp" archive "track-guard" "$v" || fail=1
  rm -f "$tmp"
  # 5d 留痕:证据必须进 git。闸① 同款盲点 —— 未跟踪文件在 diff 里是隐形的,
  # 只躺在本地的证据随手一删就没了,而"删掉就没了"的东西不叫证据。
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if ! git ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
      fail=1
      say "🔴 5d:$f 未跟踪、也没暂存 —— 证据没进 git(随手一删就没了)。"
      say "   git add 它,再提交。"
    fi
  done <<< "$(ev_files "$dir")"
done < <(archiving_dirs_now)

if [ "$fail" -ne 0 ]; then
  say "被挡下的不是这次改动,是没留痕的判断。补上再提交。"
  exit 1
fi
exit 0
