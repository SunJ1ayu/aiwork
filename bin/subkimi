#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(python3 -c 'import os, sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")" || exit 1

. "$BIN_DIR/_review-platform.sh" || exit 78
review_platform_check subkimi || exit 78

# Kimi reviews/explores with a CLI agent profile containing only file readers.
# The PreToolUse hook is a second layer; preflight failures refuse dispatch.
# Runtime state lives in a disposable home outside the source repository.

# 「运行期 home 不许在被评审的仓里」的共享闸(track repo-write-audit 第二轮)。
# 缺件就拒跑:少了它 = 这条腿没有这道检查,而"腿被自家防线弄死"的错误信息
# 长得像额度耗尽 —— 静默失效正是这一单反复记账的那种病。
_RHG="$BIN_DIR/_review-home-guard.sh"
[ -f "$_RHG" ] || { echo "subkimi: 找不到 _review-home-guard.sh —— 闸缺件,拒跑(fail closed)" >&2; exit 1; }
. "$_RHG"

# 仓内目录仅提供 config.toml 和 hooks/ 种子；运行状态随 review workspace 清理。
# KIMI_REVIEW_HOME 的用法见下方 Environment；覆盖时仍检查数据目录存在。
"$BIN_DIR/aiwork-config" data-path >/dev/null || exit 78

usage() {
  cat >&2 <<'EOF'
Usage:
  subkimi review  TASK_FILE LOG_FILE [REPO_DIR]
  subkimi explore TASK_FILE LOG_FILE [REPO_DIR]
  subkimi fix     TASK_FILE LOG_FILE [REPO_DIR]   (unsupported - see notes)

Runs Kimi (Moonshot kimi-code CLI, headless) as an isolated review sub-agent.
The reviewer reads a disposable snapshot with the file readers in bin/_reader_tools.py.
Shell and write tools are unavailable. Do not claim to have run tests.

Environment:
  AIWORK_DATA_DIR  optional, overrides the common machine data directory
  KIMI_MODEL        optional, kimi-code/<model-id> (default from ~/.config/aiwork/models.env)
                    (the seed config declares 1M context + effort=max for ANY model;
                    check the server's /models before switching)
  KIMI_TIMEOUT      optional, seconds before timeout (default 1500; 07-27 取证:
                    900 不够,时间花在长推理而非自读仓库)
  KIMI_REVIEW_HOME  optional, caller-owned home; default is a disposable workspace home
                    (override: no seed rendering or cleanup; reader profile still rewritten;
                     checked by _review-home-guard.sh)

Examples:
  subkimi review <数据目录>/tasks/001-review.md <数据目录>/logs/001-review.log /path/to/repo
EOF
}

die() { echo "subkimi: $*" >&2; exit 1; }
config_die() { echo "subkimi: $* ⇒ 拒绝派发" >&2; exit 78; }

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then usage; exit 0; fi
if [[ $# -lt 3 || $# -gt 4 ]]; then usage; exit 2; fi

MODE="$1"; TASK_FILE="$2"; LOG_FILE="$3"; REPO_DIR="${4:-$PWD}"
SOURCE_REPO="$REPO_DIR"

if [[ "$MODE" == "review" || "$MODE" == "explore" ]]; then
  _SOURCE_TOP="$(git -C "$SOURCE_REPO" rev-parse --show-toplevel 2>/dev/null)" \
    || die "review/explore needs a Git worktree with HEAD: $SOURCE_REPO"
  SOURCE_REPO="$(cd "$_SOURCE_TOP" && pwd -P)" || die "cannot resolve source repo: $_SOURCE_TOP"
  REPO_DIR="$SOURCE_REPO"
fi

# 历史记录（下面描述的是已移除的 REVIEW_PRINT_HOME 查询；现在直接用 CLI 桩检验生命周期）：
# 自省开关:让 wrapper 自己把解析结果打出来,判据据此断言(**查工件不查自述**,
# 别让判据去 grep 源码里的默认值 —— 那查的是我写了什么,不是它算出了什么)。
# 🔴 **必须排在种子同步之前**:这是个「问一句默认路径是什么」的查询,查询不该改东西。
#    排在同步之后时,判据每问一次就触发一次首次同步 —— 运行期 home 不存在时那是
#    `cp -a` 整份种子(实测 100MB,**含那条指向业主真凭证的符号链接**),
#    等于judging 每跑一遍就在临时目录里重建一次它刚消灭掉的通道。
#    2026-08-25 三条评审腿里两条独立指出,探针实测。REVIEW_HOME 在本文件顶部就解析完了,
#    这里不依赖同步的任何结果。

# 模型选择只有一个源；CLI alias 与 API model ID 均从它派生。
MODEL="$("$BIN_DIR/aiwork-config" model kimi "${KIMI_MODEL:-}")" || exit 1
"$BIN_DIR/aiwork-config" family subkimi "$MODEL" >/dev/null || die 'model must be one kimi-code/<model-id>'

# Platform source protection is separate from the CLI tool allowlist.
review_platform_reader_exec "$SOURCE_REPO" || exit 78
[[ -x "$BIN_DIR/aiwork-timeout" ]] || { printf '%s: 少了 %s ⇒ 拒绝派发\n' "$(basename "$0")" "$BIN_DIR/aiwork-timeout" >&2; exit 78; }
TIMEOUT_SECONDS="${KIMI_TIMEOUT:-1500}"

if [[ "$MODE" == "fix" ]]; then
  die "fix is not supported on this command. Change code in your own worktree."
fi
[[ "$MODE" == "review" || "$MODE" == "explore" ]] || { usage; exit 2; }

[[ -f "$TASK_FILE" ]] || die "task file not found: $TASK_FILE"
[[ -d "$REPO_DIR" ]]  || die "repo dir not found: $REPO_DIR"
command -v kimi >/dev/null 2>&1 || die "kimi CLI not found on PATH (npm i -g @moonshot-ai/kimi-code)"
command -v node >/dev/null 2>&1 || config_die "node not found on PATH (guard hook needs it; without it the hook fails OPEN)"

_RW="$BIN_DIR/_review-workspace.sh"
[ -f "$_RW" ] || die '找不到 _review-workspace.sh ⇒ 拒绝派发(fail-closed)'
# shellcheck source=_review-workspace.sh
. "$_RW"
# Absolute log path: the agent runs with cwd = REPO_DIR.
LOG_FILE="$(python3 "$BIN_DIR/_paths.py" canon -- "$LOG_FILE")" || { echo 'subkimi: canonicalize helper 失败' >&2; exit 78; }
review_workspace_reset_report || exit 78
if ! review_workspace_prepare "$SOURCE_REPO" subkimi; then
  die 'review workspace 准备失败 ⇒ 模型未启动'
fi
REVIEW_WORKSPACE_ACTIVE=1
_subkimi_cleanup() {
  local rc=$?
  if [[ "${REVIEW_WORKSPACE_ACTIVE:-0}" -eq 1 ]]; then
    review_workspace_cleanup \
      || echo "subkimi: 警告:review workspace 清理失败:${REVIEW_WORKSPACE_DIR:-?}" >&2
  fi
  trap - EXIT
  exit "$rc"
}
trap _subkimi_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
SOURCE_REPO="$REVIEW_SOURCE_REPO"
review_platform_reader_exec "$SOURCE_REPO" || exit 78
REPO_DIR="$(review_workspace_repo)" || exit 78
REVIEW_HOME="${KIMI_REVIEW_HOME:-$(review_workspace_home kimi-home)}" || exit 78
# 先检查位置，再同步种子。
review_home_guard kimi "$REVIEW_HOME" "$SOURCE_REPO" KIMI_REVIEW_HOME || exit 1

# ── 运行期 home:种子同步 + 位置检查(track repo-write-audit,2026-08-19 第二轮)──
# 仓内的 `kimi-review-home/` 是版本控制中的种子。config.toml 和
# hooks/guard.mjs 是判卷防线的一部分,必须可审计。每次跑都从种子覆盖到运行期 home
# —— 不覆盖的话,改了仓内那份守卫**不生效**,又是"同一件事写两处、只更新一处"。
# 只在用默认 home 时同步:显式指定 KIMI_REVIEW_HOME 的调用方自己负责(判据夹具靠这个)。
KIMI_SEED_HOME="$BIN_DIR/../kimi-review-home"
if [[ -z "${KIMI_REVIEW_HOME:-}" ]]; then
  KIMI_CREDENTIALS_DIR="$HOME/.kimi-code/credentials"
  [[ -f "$KIMI_CREDENTIALS_DIR/kimi-code.json" ]] || die "Kimi 凭证缺少 kimi-code.json；先用 kimi 登录"
  ln -s -- "$KIMI_CREDENTIALS_DIR" "$REVIEW_HOME/credentials" || die 'cannot link Kimi CLI credentials'
  umask 077
  mkdir -p "$REVIEW_HOME/hooks" || config_die 'cannot create review hook directory'
  cp -f "$KIMI_SEED_HOME/hooks/guard.mjs" "$REVIEW_HOME/hooks/guard.mjs" || config_die 'cannot sync review guard'
  # 种子只声明占位符；命令渲染为运行期 home 自己那份 guard。
  KIMI_RUNTIME_HOME="$REVIEW_HOME" python3 - "$KIMI_SEED_HOME/config.toml" "$MODEL" <<'PYHOOK' || config_die 'cannot render review config'
import json, os, shlex, sys
home = os.environ["KIMI_RUNTIME_HOME"].rstrip("/")
model = sys.argv[2]
p = home + "/config.toml"
s = open(sys.argv[1]).read()
s = s.replace("__KIMI_MODEL_ALIAS__", model).replace("__KIMI_MODEL_ID__", model.split("/", 1)[1])
s2 = s.replace('"__KIMI_GUARD_COMMAND__"', json.dumps('node ' + shlex.quote(home + '/hooks/guard.mjs')))
tmp = p + ".tmp." + str(os.getpid())
with open(tmp, "w") as fh:
    fh.write(s2)
os.replace(tmp, p)      # 原子改名:别让并发的另一条腿读到半截 config
PYHOOK
fi

GUARD="$REVIEW_HOME/hooks/guard.mjs"
[[ -f "$REVIEW_HOME/config.toml" ]] || config_die "review home config missing"
[[ -f "$GUARD" ]] || config_die "guard hook missing"
[[ -f "$REVIEW_HOME/credentials/kimi-code.json" ]] || die "Kimi 凭证缺少 kimi-code.json；先用 kimi 登录"

# A working hook file is useless if the CLI configuration does not attach it.
python3 - "$REVIEW_HOME/config.toml" "$GUARD" <<'PYCHECK' || config_die 'invalid review hook configuration'
import shlex, sys, tomllib
with open(sys.argv[1], "rb") as fh:
    config = tomllib.load(fh)
hooks = config.get("hooks", [])
if len(hooks) != 1:
    raise ValueError("expected exactly one review guard")
hook = hooks[0]
if (hook["event"] != "PreToolUse" or hook["matcher"] != ".*"
        or shlex.split(hook["command"]) != ["node", sys.argv[2]]
        or hook.get("timeout", 0) <= 0):
    raise ValueError("review guard is not attached to every tool")
PYCHECK

# kimi-code fails open on hook errors. Both canaries must be denied before launch.
for CANARY in Write Bash; do
  GUARD_RC=0
  printf '{"tool_name":"%s","tool_input":{}}\n' "$CANARY" | node "$GUARD" >/dev/null 2>&1 || GUARD_RC=$?
  [[ $GUARD_RC -eq 2 ]] || config_die "guard $CANARY preflight failed (rc=$GUARD_RC, want 2)"
done

# --agent-file is the CLI's native tool configuration (both engine versions).
# The allowlist is bin/_reader_tools.py, the same list the post-run check uses.
AGENT_FILE="$REVIEW_HOME/aiwork-review.md"
python3 "$BIN_DIR/_reader_tools.py" kimi-profile "$AGENT_FILE" \
  || config_die 'cannot write read-only agent profile'
READER_TOOLS="$(python3 "$BIN_DIR/_reader_tools.py" kimi-tools)" \
  || config_die 'cannot read reader tool list'

review_workspace_write_facts "$MODEL" "$MODEL" subscription || exit 78

mkdir -p "$(dirname "$LOG_FILE")"

# Keep task bytes out of argv: even an inline diff below review-pr's threshold
# can exceed the OS limit for one argument. Read consumes the complete file.
TASK_COPY="$(mktemp "$REPO_DIR/.subkimi-task-XXXXXX")" || config_die 'cannot create task snapshot'
cp "$TASK_FILE" "$TASK_COPY" || config_die 'cannot copy task into snapshot'
_READER_CONTEXT="$BIN_DIR/_review-reader-context.sh"
[[ -f "$_READER_CONTEXT" ]] || config_die 'missing reader context helper'
. "$_READER_CONTEXT"
review_reader_context "$REPO_DIR" || config_die 'cannot prepare Git context'
PROMPT="Read the task file \"${TASK_COPY##*/}\" first with Read.
You are an independent code reviewer reading a disposable repository snapshot ($MODE mode).
Use $READER_TOOLS to verify the task against actual files.
Shell and write tools are unavailable. Do not claim to have run tests.
Git history and status are in aiwork-git-context.txt. Read aiwork-review.diff when the task refers to it.
Answer the task in your final message. If context is insufficient, return NEEDS_MORE_INFO with the missing context."

{
  echo "# subkimi $MODE log"
  echo "time: $(date -Iseconds)"
  echo "mode: $MODE (agent base: kimi-code headless)"
  echo "model: $MODEL"
  echo "review_home: $REVIEW_HOME"
  echo "repo: $REPO_DIR"
  echo "source_repo: $SOURCE_REPO"
  echo "task: $TASK_FILE"
  echo
} > "$LOG_FILE"

RC=0
STREAM="${LOG_FILE}.stream.jsonl"
(
  cd "$REPO_DIR"
  KIMI_CODE_HOME="$REVIEW_HOME" \
  KIMI_CODE_NO_AUTO_UPDATE=1 \
    ${RO_EXEC[@]+"${RO_EXEC[@]}"} "$BIN_DIR/aiwork-timeout" "$TIMEOUT_SECONDS" kimi --agent-file "$AGENT_FILE" --output-format stream-json -m "$MODEL" -p "$PROMPT"
) > "$STREAM" 2>>"$LOG_FILE" || RC=$?
if [[ -s "$STREAM" ]]; then cat "$STREAM" >> "$LOG_FILE"; fi
python3 - "$STREAM" "$REPORT" <<'PY'
import json, pathlib, sys
stream, dest = sys.argv[1:]
last = None
if pathlib.Path(stream).is_file():
    for line in pathlib.Path(stream).read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(event, dict) and event.get("role") == "assistant" and isinstance(event.get("content"), str):
            last = event["content"]
if last is None:
    raise SystemExit(0)
pathlib.Path(dest).write_text(last)
PY

# kimi 把供应商错误打在自己的输出里(进了腿日志),不在我们的 stderr;终端产物只按我们的
# 诊断归类(不扫模型正文)。09-09 "5-hour usage limit" 因此被记成 runtime。只抄 CLI 自己的错误行。
if [[ $RC -ne 0 ]]; then
  { grep -a -E '^error: failed to run prompt:' "$LOG_FILE" || true; } | tail -n 3 >&2
fi
AUDIT_MSG=""
if [[ "$RC" -eq 0 ]]; then
  AUDIT_RC=0
  AUDIT_OUT="$(review_workspace_reader_audit audit-kimi "$STREAM")" || AUDIT_RC=$?
  if [[ "$AUDIT_RC" -eq 0 ]]; then
    printf '核实工具: %s\n' "$AUDIT_OUT" >> "$LOG_FILE"
  elif [[ "$AUDIT_RC" -eq 1 ]]; then
    AUDIT_MSG="$AUDIT_OUT"
  else
    printf 'subkimi: %s\n' "$AUDIT_OUT" >&2
    exit 78
  fi
fi
review_workspace_finish subkimi "$RC" "$MODE" "$MODEL" subscription "" "" "$AUDIT_MSG"
