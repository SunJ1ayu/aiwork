#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(python3 -c 'import os, sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")" || exit 1

# subkimi - Kimi (Moonshot) review command on kimi-code CLI, headless (`kimi -p`).
# The model explores the repo itself (Read/Glob/Grep + Bash). Review runs in a
# writable disposable clone while the original repository stays physically read-only.
#
#   review -> kimi -p, verdict-gated.
#   fix    -> not on this command. Change code in your own worktree.
#
# Isolation: KIMI_CODE_HOME points at a dedicated review home whose config
# carries a PreToolUse guard hook. Read/ReadMediaFile/Glob/Grep/todo-goal and
# Bash are allowed; Bash writes only the disposable clone. The original repo is
# separately protected by ro-repo-exec. Write/Edit/Agent/AgentSwarm/Skill,
# Cron*/FetchURL/WebSearch, and unknown tools are blocked. The user's global
# ~/.kimi-code is never touched. Auth is the
# Kimi membership OAuth token, shared via a credentials symlink in the review
# home. NOTE: kimi-code's hook protocol is fail-open (non-0/2 exit = allow),
# so this wrapper preflights the guard (must deny a canary Write with rc=2)
# and refuses to dispatch if the guard is broken or node is missing.


# 「运行期 home 不许在被评审的仓里」的共享闸(track repo-write-audit 第二轮)。
# 缺件就拒跑:少了它 = 这条腿没有这道检查,而"腿被自家防线弄死"的错误信息
# 长得像额度耗尽 —— 静默失效正是这一单反复记账的那种病。
_RHG="$BIN_DIR/_review-home-guard.sh"
[ -f "$_RHG" ] || { echo "subkimi: 找不到 _review-home-guard.sh —— 闸缺件,拒跑(fail closed)" >&2; exit 1; }
. "$_RHG"

# 运行期状态走本机数据入口；仓内目录仅提供 config.toml 和 hooks/ 种子。
REVIEW_HOME="${KIMI_REVIEW_HOME:-$("$BIN_DIR/aiwork-config" data-path kimi-review-home)}"

usage() {
  cat >&2 <<'EOF'
Usage:
  subkimi review  TASK_FILE LOG_FILE [REPO_DIR]
  subkimi explore TASK_FILE LOG_FILE [REPO_DIR]
  subkimi fix     TASK_FILE LOG_FILE [REPO_DIR]   (unsupported - see notes)

Runs Kimi (Moonshot kimi-code CLI, headless) as an isolated review sub-agent.
The reviewer reads and tests a disposable clone; the source repo remains
read-only and direct write tools stay blocked in an isolated KIMI_CODE_HOME.

Environment:
  AIWORK_DATA_DIR  optional, overrides the common machine data directory
  KIMI_MODEL        optional, kimi-code/<model-id> (default from ~/.config/aiwork/models.env)
                    (the seed config declares 1M context + effort=max for ANY model;
                    check the server's /models before switching)
  KIMI_TIMEOUT      optional, seconds before timeout (default 1500; 07-27 取证:
                    900 不够,时间花在长推理而非自读仓库)
  KIMI_REVIEW_HOME  optional, default $HOME/.local/share/aiwork/kimi-review-home
                    (仓内的 kimi-review-home/ 只是**种子**,不是运行期 home ——
                     运行期 home 落在被评审的仓里会被拒跑,见 _review-home-guard.sh)

Examples:
  subkimi review ~/.local/share/aiwork/tasks/001-review.md ~/.local/share/aiwork/logs/001-review.log /path/to/repo
EOF
}

die() { echo "subkimi: $*" >&2; exit 1; }

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then usage; exit 0; fi
if [[ $# -lt 3 || $# -gt 4 ]]; then usage; exit 2; fi

MODE="$1"; TASK_FILE="$2"; LOG_FILE="$3"; REPO_DIR="${4:-$PWD}"
SOURCE_REPO="$REPO_DIR"

if [[ "$MODE" == "review" || "$MODE" == "explore" ]]; then
  _SOURCE_TOP="$(git -C "$SOURCE_REPO" rev-parse --show-toplevel 2>/dev/null)" \
    || die "review/explore needs a Git worktree with HEAD: $SOURCE_REPO"
  SOURCE_REPO="$(cd "$_SOURCE_TOP" && pwd -P)" || die "cannot resolve source repo: $_SOURCE_TOP"
  REPO_DIR="$SOURCE_REPO"
fi


# 自省开关:让 wrapper 自己把解析结果打出来,判据据此断言(**查工件不查自述**,
# 别让判据去 grep 源码里的默认值 —— 那查的是我写了什么,不是它算出了什么)。
# 🔴 **必须排在种子同步之前**:这是个「问一句默认路径是什么」的查询,查询不该改东西。
#    排在同步之后时,判据每问一次就触发一次首次同步 —— 运行期 home 不存在时那是
#    `cp -a` 整份种子(实测 100MB,**含那条指向业主真凭证的符号链接**),
#    等于judging 每跑一遍就在临时目录里重建一次它刚消灭掉的通道。
#    2026-08-25 三条评审腿里两条独立指出,探针实测。REVIEW_HOME 在本文件顶部就解析完了,
#    这里不依赖同步的任何结果。
if [[ -n "${REVIEW_PRINT_HOME:-}" ]]; then printf '%s\n' "$REVIEW_HOME"; exit 0; fi

# 模型选择只有一个源；CLI alias 与 API model ID 均从它派生。
MODEL="$("$BIN_DIR/aiwork-config" model kimi "${KIMI_MODEL:-}")" || exit 1
"$BIN_DIR/aiwork-config" family subkimi "$MODEL" >/dev/null || die 'model must be one kimi-code/<model-id>'

# 先检查位置，再创建运行目录或同步种子。
review_home_guard kimi "$REVIEW_HOME" "$SOURCE_REPO" KIMI_REVIEW_HOME || exit 1

# ── 运行期 home:种子同步 + 位置检查(track repo-write-audit,2026-08-19 第二轮)──
# 仓内的 `kimi-review-home/` 是版本控制中的种子。config.toml 和
# hooks/guard.mjs 是判卷防线的一部分,必须可审计。每次跑都从种子覆盖到运行期 home
# —— 不覆盖的话,改了仓内那份守卫**不生效**,又是"同一件事写两处、只更新一处"。
# 只在用默认 home 时同步:显式指定 KIMI_REVIEW_HOME 的调用方自己负责(判据夹具靠这个)。
KIMI_SEED_HOME="$BIN_DIR/../kimi-review-home"
if [[ -z "${KIMI_REVIEW_HOME:-}" && -d "$KIMI_SEED_HOME" ]]; then
  mkdir -p "$REVIEW_HOME/hooks"
  cp -f "$KIMI_SEED_HOME/hooks/guard.mjs" "$REVIEW_HOME/hooks/guard.mjs" || die 'cannot sync review guard'
  # 种子只声明占位符；命令渲染为运行期 home 自己那份 guard。
  KIMI_RUNTIME_HOME="$REVIEW_HOME" python3 - "$KIMI_SEED_HOME/config.toml" "$MODEL" <<'PYHOOK' || die 'cannot render review config'
import json, os, shlex, sys
home = os.environ["KIMI_RUNTIME_HOME"].rstrip("/")
model = sys.argv[2]
p = home + "/config.toml"
s = open(sys.argv[1]).read()
s = s.replace("__KIMI_MODEL_ALIAS__", model).replace("__KIMI_MODEL_ID__", model.split("/", 1)[1])
s2 = s.replace('"__KIMI_GUARD_COMMAND__"', json.dumps('node ' + shlex.quote(home + '/hooks/guard.mjs')))
tmp = p + ".tmp." + str(os.getpid())
with open(tmp, "w") as fh:
    fh.write(s2)
os.replace(tmp, p)      # 原子改名:别让并发的另一条腿读到半截 config
PYHOOK
fi


# ── 原仓只读 + review 副本可写 ─────────────────────────────────────────────
# Kimi 的 cwd 是独立 clone；mount namespace 只保护 SOURCE_REPO。腿可在 clone
# 跑 tests/build，但原仓写口物理消失 —— 08-18 我发现
# `git diff --output=<path>` 绕得过任何命令行白名单,而"把 bash 整个关掉"那条路
# 已被四审推翻(腿会静默起不来,比腿写个文件危险得多)。
# **一个写口都不开。** 腿日志是父 shell 重定向写的(`>> "$LOG_FILE"` / `| tee -a`),
# fd 在**父 namespace** 就打开了,挂载管不着已经打开的 fd —— 探针实测过。
# 第一版开了 `--rw <日志目录>`,那个写口不但多余,还带来两条真 bug:
# `dirname` 相对调用方 cwd 解析 ⇒ 从仓根裸文件名调用时整仓开闸(安静失效);
# 以及它在 mkdir 日志目录之前构建 ⇒ 新日志目录直接拒跑(行为回归)。判据 V37。
# fail-closed 在 ro-repo-exec 里:挂不上就拒跑,绝不降级成"在可写的仓里跑"。
[[ -x "$BIN_DIR/ro-repo-exec" ]] || { printf '%s: 少了 %s/ro-repo-exec ⇒ 拒绝在可写的仓里跑评审腿(fail-closed)\n' "$(basename "$0")" "$BIN_DIR" >&2; exit 78; }
RO_EXEC=("$BIN_DIR/ro-repo-exec" "$SOURCE_REPO" --)
TIMEOUT_SECONDS="${KIMI_TIMEOUT:-1500}"

if [[ "$MODE" == "fix" ]]; then
  die "fix is not supported on this command. Change code in your own worktree."
fi
[[ "$MODE" == "review" || "$MODE" == "explore" ]] || { usage; exit 2; }

[[ -f "$TASK_FILE" ]] || die "task file not found: $TASK_FILE"
[[ -d "$REPO_DIR" ]]  || die "repo dir not found: $REPO_DIR"
command -v kimi >/dev/null 2>&1 || die "kimi CLI not found on PATH (npm i -g @moonshot-ai/kimi-code)"
command -v node >/dev/null 2>&1 || die "node not found on PATH (guard hook needs it; without it the hook fails OPEN)"

GUARD="$REVIEW_HOME/hooks/guard.mjs"
[[ -f "$REVIEW_HOME/config.toml" ]] || die "review home config missing: $REVIEW_HOME/config.toml"
[[ -f "$GUARD" ]] || die "guard hook missing: $GUARD"
[[ -e "$REVIEW_HOME/credentials/kimi-code.json" ]] || die "no Kimi credentials in $REVIEW_HOME/credentials; 已有凭证请用合并后搬迁命令接回运行目录，勿重复登录；新机器请先完成 Kimi 认证"

# Preflight the guard: it must DENY a canary Write with rc=2. kimi-code hooks
# fail open on any other exit code, so a broken guard means no sandbox at all.
set +e
echo '{"tool_name":"Write","tool_input":{"path":"canary"}}' | node "$GUARD" >/dev/null 2>&1
GUARD_RC=$?
set -e
[[ $GUARD_RC -eq 2 ]] || die "guard preflight failed (rc=$GUARD_RC, want 2) - refusing to dispatch with a fail-open sandbox"

_RW="$BIN_DIR/_review-workspace.sh"
[ -f "$_RW" ] || die '找不到 _review-workspace.sh ⇒ 拒绝派发(fail-closed)'
# shellcheck source=_review-workspace.sh
. "$_RW"
if ! review_workspace_prepare "$SOURCE_REPO" subkimi; then
  die 'review workspace 准备失败 ⇒ 模型未启动'
fi
REVIEW_WORKSPACE_ACTIVE=1
SOURCE_REPO="$REVIEW_SOURCE_REPO"
RO_EXEC=("$BIN_DIR/ro-repo-exec" "$SOURCE_REPO" --)
REPO_DIR="$(review_workspace_repo)" || exit 78
review_workspace_write_facts "$MODEL" "$MODEL" subscription || exit 78

_subkimi_cleanup() {
  local rc=$?
  if [[ "${REVIEW_WORKSPACE_ACTIVE:-0}" -eq 1 ]]; then
    review_workspace_cleanup \
      || echo "subkimi: 警告:review workspace 清理失败:${REVIEW_WORKSPACE_DIR:-?}" >&2
  fi
  trap - EXIT
  exit "$rc"
}
trap _subkimi_cleanup EXIT

# Absolute log path: the agent runs with cwd = REPO_DIR.
case "$LOG_FILE" in /*) ;; *) LOG_FILE="$PWD/$LOG_FILE" ;; esac
mkdir -p "$(dirname "$LOG_FILE")"

# 08-18~08-19 这里曾经有一整套 diff 注入(为了补偿"把 bash 关掉"造成的失明):
# 按 argv 预算截断、基线校验、工件排除。业主推翻了那个方向 —— 评审腿没有
# "改判据让自己及格"的动机(那是执行腿的威胁模型),而关 bash 的代价是
# E2BIG(这条腿 rc=126 直接起不来)、`git diff | head -c N` 在本文件的
# `set -euo pipefail` 下让 git 吃 SIGPIPE **静默暴毙 rc=141 一个字不留**。
# 现在腿在独立副本里自己看 diff 并跑本地检查；原仓由只读挂载承重。
if [[ "$MODE" == "explore" ]]; then
PROMPT="You are reading a disposable snapshot of a repository.
Read it with Read, Glob, Grep, and Bash. The original repository stays read-only.
Answer the task in your final message. Do not modify source files, push, merge,
install dependencies, or spawn other agents.

--- TASK ---
$(cat "$TASK_FILE")"
else
PROMPT="You are an independent code reviewer running inside a disposable writable repository snapshot.
Explore the repository yourself with the tools you have
(Read, Glob, Grep, and Bash for local tests, lint, build, and diagnostics).
Do not take the task's claims at face value -
verify them against the actual files. Some tools are intentionally blocked by
the harness; if a call is denied, work with the allowed tools instead of
retrying it.

Command outputs and caches may be written inside this disposable snapshot, but
do not intentionally edit source files. Do not push, merge, install dependencies,
run migrations, access production systems, or change credentials.

Report findings with file:line references and a severity each.

--- REVIEW TASK ---
$(cat "$TASK_FILE")"
fi

{
  echo "# subkimi $MODE log"
  echo "time: $(date -Iseconds)"
  echo "mode: $MODE (agent base: kimi-code headless)"
  echo "model: $MODEL"
  echo "review_home: $REVIEW_HOME"
  echo "repo: $REPO_DIR"
  echo "source_repo: $SOURCE_REPO"
  echo "task: $TASK_FILE"
  echo
} > "$LOG_FILE"

RC=0
STREAM="${LOG_FILE}.stream.jsonl"
(
  cd "$REPO_DIR"
  KIMI_CODE_HOME="$REVIEW_HOME" \
  KIMI_CODE_NO_AUTO_UPDATE=1 \
    "${RO_EXEC[@]}" timeout "$TIMEOUT_SECONDS" kimi --output-format stream-json -m "$MODEL" -p "$PROMPT"
) > "$STREAM" 2>>"$LOG_FILE" || RC=$?
if [[ -s "$STREAM" ]]; then cat "$STREAM" >> "$LOG_FILE"; fi
python3 - "$STREAM" "${LOG_FILE}.report" "${AIWORK_REVIEW_REPORT_PATH:-}" <<'PY'
import json, pathlib, sys
stream, local, dest = sys.argv[1:]
last = None
if pathlib.Path(stream).is_file():
    for line in pathlib.Path(stream).read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(event, dict) and event.get("role") == "assistant" and isinstance(event.get("content"), str) and event["content"]:
            last = event["content"]
if last is None:
    raise SystemExit(0)
pathlib.Path(local).write_text(last)
if dest:
    pathlib.Path(dest).write_text(last)
PY

# Verdict gate shares the contract normalizer with the terminal producer.  The
# adapter publishes what it actually observed; it does not decide coverage.
_RR="${AIWORK_REVIEW_RESULT_BIN:-$BIN_DIR/_review_result.py}"
[ -f "$_RR" ] || die "typed verdict normalizer missing"
if [[ -f "${LOG_FILE}.report" ]]; then
  VERDICT="$(python3 "$_RR" normalize "${LOG_FILE}.report" 2>/dev/null)" \
    || die "typed verdict normalization failed (report: ${LOG_FILE}.report)"
else
  VERDICT=UNKNOWN
fi

# A timeout is not a successful review. Publish the facts, then return 124 so a
# later reader cannot treat the run as coverage.
if [[ $RC -eq 124 ]]; then
  review_workspace_write_facts "$MODEL" "$MODEL" subscription \
    timed_out partial timeout "$VERDICT" || exit 78
  echo "subkimi: timed out after ${TIMEOUT_SECONDS}s (log: $LOG_FILE)" >&2
  exit 124
fi
if [[ $RC -ne 0 ]]; then
  # kimi 把供应商错误打在自己的输出里(进了腿日志),不在我们的 stderr;终端产物只按我们的
  # 诊断归类(不扫模型正文)。09-09 "5-hour usage limit" 因此被记成 runtime。只抄 CLI 自己的错误行。
  { grep -a -E '^error: failed to run prompt:' "$LOG_FILE" || true; } | tail -n 3 >&2
fi
[[ $RC -eq 0 ]] || die "kimi exited rc=$RC (log: $LOG_FILE)"

if [[ "$MODE" == "review" && "$VERDICT" == "UNKNOWN" ]]; then
  review_workspace_write_facts "$MODEL" "$MODEL" subscription \
    exited partial no_verdict "$VERDICT" || exit 78
  die "model returned no verdict (expected 'Conclusion: PASS|BLOCK|NEEDS_MORE_INFO'; log: $LOG_FILE)"
fi
if [[ "$MODE" == "review" ]]; then
  review_workspace_write_facts "$MODEL" "$MODEL" subscription \
    exited complete "" "$VERDICT" || exit 78
else
  review_workspace_write_facts "$MODEL" "$MODEL" subscription \
    exited complete "" "" || exit 78
fi

exit 0
