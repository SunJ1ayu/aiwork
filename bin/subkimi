#!/usr/bin/env bash
set -euo pipefail

# subkimi - Kimi (Moonshot) review employee on an AGENT base: kimi-code CLI
# run headless (`kimi -p`). Like subglm-agent/subdeepseek-agent, the model
# explores the repo itself (Read/Glob/Grep;无 shell/git,diff 由 wrapper 喂), so no blind
# reviews and no manual INCLUDE feeding.
#
#   review -> kimi -p, review-only guard, verdict-gated. Works now.
#   fix    -> NOT supported here on purpose: panel reviewers stay review-only.
#             Use `submimo fix` (mimo) for fix work.
#
# Isolation: KIMI_CODE_HOME points at a dedicated review home whose config
# carries a PreToolUse guard hook (default-DENY: only Read/ReadMediaFile/Glob/
# Grep/todo-goal tools 允许;**Bash 一律拒绝(含只读 git)** —— 08-18 实测白名单挡不住
# git 自己的参数(--output= 能写、--no-index 能读仓外),diff 改由 wrapper 算好喂进提示词;
# Write/Edit/Agent/AgentSwarm/Skill/Cron*/FetchURL/WebSearch and unknown tools
# are blocked). The user's global ~/.kimi-code is never touched. Auth is the
# Kimi membership OAuth token, shared via a credentials symlink in the review
# home. NOTE: kimi-code's hook protocol is fail-open (non-0/2 exit = allow),
# so this wrapper preflights the guard (must deny a canary Write with rc=2)
# and refuses to dispatch if the guard is broken or node is missing.


# 反锚定闸:先 source(只定义函数),并在解析位置参数**之前**摘掉 --panel-dispatch。
_GATE="$(dirname "$0")/_my-review-gate.sh"
[ -f "$_GATE" ] || _GATE=/root/aiwork/bin/_my-review-gate.sh   # 脚本被拷到别处跑时的家
[ -f "$_GATE" ] || { echo "subkimi: 找不到 _my-review-gate.sh —— 闸缺件,拒跑(fail closed)" >&2; exit 1; }
. "$_GATE"
gate_strip_flags "$@"; set -- ${GATE_ARGS[@]+"${GATE_ARGS[@]}"}

REVIEW_HOME="${KIMI_REVIEW_HOME:-/root/aiwork/kimi-review-home}"
DEFAULT_MODEL="kimi-code/k3"

usage() {
  cat >&2 <<'EOF'
Usage:
  subkimi review TASK_FILE LOG_FILE [REPO_DIR]
  subkimi fix    TASK_FILE LOG_FILE [REPO_DIR]   (unsupported - see notes)

Runs Kimi (Moonshot kimi-code CLI, headless) as an agentic read-only review
sub-agent. The reviewer reads the repo itself; mutations are hard-blocked by
a PreToolUse guard in an isolated KIMI_CODE_HOME.

Environment:
  KIMI_MODEL        optional, model alias (default: kimi-code/k3, 1M context;
                    kimi-code/kimi-for-coding = K2.7 coding-tuned, also available)
  KIMI_TIMEOUT      optional, seconds before timeout (default 1500; 07-27 取证:
                    900 不够,时间花在长推理而非自读仓库)
  KIMI_REVIEW_HOME  optional, default /root/aiwork/kimi-review-home

Examples:
  subkimi review /root/aiwork/tasks/001-review.md /root/aiwork/logs/001-review.log /path/to/repo
EOF
}

die() { echo "subkimi: $*" >&2; exit 1; }

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then usage; exit 0; fi
if [[ $# -lt 3 || $# -gt 4 ]]; then usage; exit 2; fi

MODE="$1"; TASK_FILE="$2"; LOG_FILE="$3"; REPO_DIR="${4:-$PWD}"

# 反锚定闸(2026-08-06 补):第四条腿也要接 —— 上一版只接了三条躯干,
# 而 subkimi 是**默认开着**的那条,直调它就能跳过"先写自己的一遍"。
# 四审两条腿把这条顶成 HIGH:目标说的是"每一条评审路径",实现漏了一条 = 实质落差。
my_review_gate "$MODE" "$TASK_FILE" "$REPO_DIR" "subkimi" || exit 1
MODEL="${KIMI_MODEL:-$DEFAULT_MODEL}"
TIMEOUT_SECONDS="${KIMI_TIMEOUT:-1500}"

if [[ "$MODE" == "fix" ]]; then
  die "fix is not supported: panel reviewers are review-only. Use: submimo fix $TASK_FILE $LOG_FILE $REPO_DIR"
fi
[[ "$MODE" == "review" ]] || { usage; exit 2; }

[[ -f "$TASK_FILE" ]] || die "task file not found: $TASK_FILE"
[[ -d "$REPO_DIR" ]]  || die "repo dir not found: $REPO_DIR"
command -v kimi >/dev/null 2>&1 || die "kimi CLI not found on PATH (npm i -g @moonshot-ai/kimi-code)"
command -v node >/dev/null 2>&1 || die "node not found on PATH (guard hook needs it; without it the hook fails OPEN)"

GUARD="$REVIEW_HOME/hooks/guard.mjs"
[[ -f "$REVIEW_HOME/config.toml" ]] || die "review home config missing: $REVIEW_HOME/config.toml"
[[ -f "$GUARD" ]] || die "guard hook missing: $GUARD"
[[ -e "$REVIEW_HOME/credentials/kimi-code.json" ]] || die "no Kimi credentials in $REVIEW_HOME/credentials (run 'kimi login' once, then symlink ~/.kimi-code/credentials)"

# Preflight the guard: it must DENY a canary Write with rc=2. kimi-code hooks
# fail open on any other exit code, so a broken guard means no sandbox at all.
set +e
echo '{"tool_name":"Write","tool_input":{"path":"canary"}}' | node "$GUARD" >/dev/null 2>&1
GUARD_RC=$?
set -e
[[ $GUARD_RC -eq 2 ]] || die "guard preflight failed (rc=$GUARD_RC, want 2) - refusing to dispatch with a fail-open sandbox"

# Absolute log path: the agent runs with cwd = REPO_DIR.
case "$LOG_FILE" in /*) ;; *) LOG_FILE="$PWD/$LOG_FILE" ;; esac
mkdir -p "$(dirname "$LOG_FILE")"

# ── 把 diff 算好塞进提示词(2026-08-18,track deepseek-leg-bash-hole)────────
# 守卫里的 Bash(含只读 git)已经整个关掉:命令行白名单挡不住 git 自己的参数
# (`git diff --output=` 能往仓里写、`--no-index` 能读仓外)。
# 但这条腿需要的是**那份 diff,不是一个 shell** —— 所以由我们算好喂进去。
#
# 2026-08-19 修(同 track,四审抓出来的):这条腿把整个提示词当 `-p <prompt>`
# **一个 argv 参数**传,卡内核的 MAX_ARG_STRLEN=131072,而原来的上限拍的是 200KB。
# 更隐蔽的是本文件开头的 `set -euo pipefail`:老写法 `git diff | head -c N` 在 diff
# 超过 N 时让 git 吃 SIGPIPE ⇒ **整条 wrapper 静默暴毙 rc=141,一个字都不留**。
# 两条都由 _prompt-budget.sh 统一处理(它不用 head、按通道算预算)。
# 找库的形状照抄 _my-review-gate.sh 那条(脚本会被判据拷到别处跑),**缺件拒跑**:
# 悄悄退回老的 200KB 常数 = 悄悄把这道闸拆了。
_PB="$(dirname "$0")/_prompt-budget.sh"
[ -f "$_PB" ] || _PB=/root/aiwork/bin/_prompt-budget.sh
[ -f "$_PB" ] || { echo "subkimi: 找不到 _prompt-budget.sh —— 提示词预算缺件,拒跑(fail closed)" >&2; exit 1; }
. "$_PB"

PROMPT="You are an independent code reviewer running inside a read-only harness.
Explore the repository yourself with the tools you have
(Read, Glob, Grep - note there is NO shell and NO git in this harness).
Do not take the task's claims at face value -
verify them against the actual files. Some tools are intentionally blocked by
the harness; if a call is denied, work with the allowed tools instead of
retrying it.

Report findings with file:line references and a severity each.

Write the verdict line AS SOON AS you have enough to judge, immediately after
your findings — do not save it for the end. You may keep analysing afterwards
and restate the line at the end if your judgement changes; the last one counts.
(This harness kills long reviews on a timeout. 2026-07-27: a run was cut off
with its best finding already written out but no verdict line, so the whole
review was discarded. Verdict first means a timeout still costs you nothing.)

The verdict line must be exactly this form:
Conclusion: PASS | BLOCK | NEEDS_MORE_INFO

--- REVIEW TASK ---
$(cat "$TASK_FILE")"

# 提示词走 `-p <prompt>` ⇒ 通道恒为 argv。先量骨架,再给 diff 分剩下的空间。
DIFF_SECTION=""
if [[ -n "${PANEL_DIFF_BASE:-}" ]] && git -C "$REPO_DIR" rev-parse --git-dir >/dev/null 2>&1; then
  DIFF_SECTION="$(_diff_section "$REPO_DIR" "$PANEL_DIFF_BASE" \
    "$(_diff_budget argv "$(_bytes "$PROMPT")")")"
fi
PROMPT="${PROMPT}${DIFF_SECTION}"

# 放不下就响亮失败(见 _prompt-budget.sh 的理由:rc=126 那种失败没人看得见)。
_assert_prompt_fits argv "$PROMPT" "subkimi" || exit 1

{
  echo "# subkimi review log"
  echo "time: $(date -Iseconds)"
  echo "mode: review (agent base: kimi-code headless)"
  echo "model: $MODEL"
  echo "review_home: $REVIEW_HOME"
  echo "repo: $REPO_DIR"
  echo "task: $TASK_FILE"
  echo
} > "$LOG_FILE"

RC=0
(
  cd "$REPO_DIR"
  KIMI_CODE_HOME="$REVIEW_HOME" \
  KIMI_CODE_NO_AUTO_UPDATE=1 \
    timeout "$TIMEOUT_SECONDS" kimi -m "$MODEL" -p "$PROMPT"
) >> "$LOG_FILE" 2>&1 || RC=$?

# Verdict gate (same semantics as the other legs): a review that never
# concludes is a failed review, but the log is kept for forensics. Accepts
# 「结论: PASS」/full-width colon (Chinese backends drift to it); ： via
# ANSI-C quoting per the 07-17 full-width-punctuation lesson.
VERDICT_RE=$'(Conclusion|结论)(:|\uFF1A)[[:space:]]*(PASS|BLOCK|NEEDS_MORE_INFO)'
HAS_VERDICT=0
grep -qE "$VERDICT_RE" "$LOG_FILE" && HAS_VERDICT=1

# A timeout with the verdict already written is a COMPLETE review, not a lost one
# (2026-07-27: kimi was cut off at 900s with its best finding already in the log,
# and the whole thing got discarded for want of a last line). Paired with the
# verdict-first instruction in the prompt: judgement lands early, extra thinking
# is a bonus. Still loud on stderr — a truncated review must never look like a
# clean one to the arbiter.
if [[ $RC -eq 124 ]]; then
  [[ $HAS_VERDICT -eq 1 ]] || die "kimi timed out after ${TIMEOUT_SECONDS}s with no verdict (log: $LOG_FILE)"
  echo "subkimi: timed out after ${TIMEOUT_SECONDS}s, but a verdict was already written —" \
       "accepting it; the analysis may be cut off mid-flow (log: $LOG_FILE)" >&2
  exit 0
fi
[[ $RC -eq 0 ]] || die "kimi exited rc=$RC (log: $LOG_FILE)"

[[ $HAS_VERDICT -eq 1 ]] \
  || die "model returned no verdict (expected 'Conclusion: PASS|BLOCK|NEEDS_MORE_INFO'; log: $LOG_FILE)"

exit 0
