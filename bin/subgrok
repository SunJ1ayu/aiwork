#!/usr/bin/env bash
set -euo pipefail

# Grok Build review/explore adapter. Each invocation owns its runtime home and
# disposable snapshot. The CLI and its shell tools run inside ro-repo-exec;
# never attach to a user's existing leader outside that mount namespace.
BIN_DIR="$(python3 -c 'import os, sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")" || exit 1
die() { echo "subgrok: $*" >&2; exit 1; }
usage() {
  cat <<'EOF'
Usage: subgrok <review|explore> TASK_FILE LOG_FILE [REPO_DIR]

Grok Build reads/tests a disposable snapshot; the source repo stays read-only.
review requires a verdict; explore requires one direction and its tradeoffs.
No implementation/fix mode and no chat fallback.

Environment:
  GROK_MODEL       exact Grok model ID (default from ~/.config/aiwork/models.env)
  GROK_TIMEOUT     wall-clock seconds (default 900)
  GROK_MAX_TURNS   turn cap (default 80)
  GROK_AUTH_FILE   session credentials (default $HOME/.grok/auth.json)
  XAI_API_KEY     API billing instead of session login, when set
  PANEL_GROK_LEG  agent (default) or off, in panel-review/panel-explore

Logs: LOG_FILE = header + assistant text; sibling .stream.jsonl contains
tool events and .stream-summary.json records completion, model and usage.
EOF
}
. "$BIN_DIR/_my-review-gate.sh" || die 'missing review gate'
gate_strip_flags "$@"; set -- "${GATE_ARGS[@]}"
if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then usage; exit 0; fi
[[ $# -ge 3 && $# -le 4 ]] || { usage >&2; exit 2; }
MODE="$1"; TASK_FILE="$2"; LOG_FILE="$3"; SOURCE_REPO="${4:-$PWD}"
[[ "$MODE" == review || "$MODE" == explore ]] || { usage >&2; exit 2; }
[[ -f "$TASK_FILE" ]] || die "task file not found: $TASK_FILE"
TASK_FILE="$(realpath "$TASK_FILE")"
LOG_FILE="$(realpath -m "$LOG_FILE")"
SOURCE_REPO="$(git -C "$SOURCE_REPO" rev-parse --show-toplevel)" || die 'needs a Git worktree with HEAD'
SOURCE_REPO="$(realpath "$SOURCE_REPO")"
my_review_gate "$MODE" "$TASK_FILE" "$SOURCE_REPO" subgrok || exit 1
MODEL="$("$BIN_DIR/aiwork-config" model grok "${GROK_MODEL:-}")" || exit 1
"$BIN_DIR/aiwork-config" family subgrok "$MODEL" >/dev/null || die 'GROK_MODEL must be an exact Grok model ID'
TIMEOUT_SECONDS="${GROK_TIMEOUT:-900}"
MAX_TURNS="${GROK_MAX_TURNS:-80}"
[[ "$TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ && "$MAX_TURNS" =~ ^[1-9][0-9]*$ ]] \
  || die 'timeout and max turns must be positive integers'
command -v grok >/dev/null || die 'Grok Build CLI not found; install the official CLI and run grok login'
AUTH_FILE="${GROK_AUTH_FILE:-$HOME/.grok/auth.json}"
BILLING=subscription
if [[ -n "${XAI_API_KEY:-}" ]]; then
  BILLING=api
else
  [[ -s "$AUTH_FILE" ]] || die "no session credentials: $AUTH_FILE (run grok login)"
fi
[[ -x "$BIN_DIR/ro-repo-exec" ]] || { echo 'subgrok: missing ro-repo-exec; refusing dispatch' >&2; exit 78; }
[[ -f "$BIN_DIR/_grok-stream.py" ]] || die 'missing Grok stream decoder'
. "$BIN_DIR/_review-workspace.sh" || die 'missing review workspace helper'
review_workspace_prepare "$SOURCE_REPO" subgrok || exit 78
cleanup() {
  local rc=$?
  review_workspace_cleanup || echo 'subgrok: workspace cleanup failed' >&2
  trap - EXIT
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
REPO_DIR="$(review_workspace_repo)"
RUNTIME_HOME="$REVIEW_WORKSPACE_DIR/grok-home"
mkdir -m 700 "$RUNTIME_HOME"
# Copy only credentials, not user hooks, plugins, memory or sessions. A private
# copy permits token refresh without concurrent legs modifying the user's auth.
if [[ "$BILLING" == subscription ]]; then
  install -m 600 "$AUTH_FILE" "$RUNTIME_HOME/auth.json"
fi
cat > "$RUNTIME_HOME/config.toml" <<'EOF'
[cli]
auto_update = false
use_leader = false
[session]
load_envrc = false
[features]
telemetry = false
feedback = false
codebase_indexing = false
EOF
PROMPT_FILE="$REVIEW_WORKSPACE_DIR/task.txt"
cat > "$PROMPT_FILE" <<'EOF'
You are an independent agent working in a disposable writable repository snapshot.
Read the actual files and verify the task's claims. You may run local tests,
lint, builds and diagnostics, writing their outputs/caches inside this snapshot.
Do not intentionally edit source files. Do not push, merge, install dependencies,
run migrations, access production, change credentials, or spawn other agents.
Use only the supplied read/search/list/shell tools. Do not wait for user input.
EOF
if [[ "$MODE" == review ]]; then
  cat >> "$PROMPT_FILE" <<'EOF'
Review the task. Give findings with severity, file:line evidence and reasoning.
Write a verdict as soon as you can judge; restate it if your judgement changes.
The last standalone verdict line counts. Choose exactly one:
Conclusion: PASS
Conclusion: BLOCK
Conclusion: NEEDS_MORE_INFO
EOF
else
  cat >> "$PROMPT_FILE" <<'EOF'
Propose exactly ONE concrete direction. State assumptions and tradeoffs, and
ground it in the repository. Do not output PASS/BLOCK or a menu of alternatives.
Use all these labels, with substantive content for each:
Direction: / Core bet: / How it works: / Best at: / Sacrifices: /
Blind spots in the brief: / Smallest first step:
EOF
fi
printf '\n--- TASK ---\n' >> "$PROMPT_FILE"
cat "$TASK_FILE" >> "$PROMPT_FILE"
mkdir -p "$(dirname "$LOG_FILE")"
BASE="${LOG_FILE%.log}"
STREAM="$BASE.stream.jsonl"; SUMMARY="$BASE.stream-summary.json"
# Same header shape as the other legs: review-pr separates the report at its end.
{
  echo "# subgrok $MODE log"
  echo "time: $(date -Iseconds)"
  echo "model: $MODEL"
  echo "repo: $REPO_DIR (snapshot of $SOURCE_REPO, source mounted read-only)"
  echo "task: $TASK_FILE"
  echo
} > "$LOG_FILE"
review_workspace_write_facts "$MODEL" "$MODEL" "$BILLING" || exit 78
# No caller GROK_* reaches the CLI; only the values set below. The binary reads
# dozens of them: GROK_FOLDER_TRUST=0 ungates repo hooks/MCP (reviewed-repo code
# execution under --always-approve), GROK_CODE_XAI_API_KEY / GROK_AUTH_PROVIDER_*
# bypass the copied login, GROK_CONFIG* point at other config (track
# grok-leg-kimi-model, panel round one).
GROK_ENV_UNSET=()
for _name in $(compgen -e); do
  [[ "$_name" == GROK_* ]] && GROK_ENV_UNSET+=(-u "$_name")
done
set +e
(
  cd "$REPO_DIR" || exit 78
  # Disable compatibility MCP/hook/skill scanning and repo instruction scans
  # (CLAUDE.md, Claude/Cursor rules and agents) as well as memory/subagents.
  # --tools uses internal IDs: the shell's ID is run_terminal_cmd, not bash.
  # Auto-approve only the admitted tools inside the source-read-only namespace.
  # v1.0.24 dontAsk + --allow Bash cancelled real shell calls with CLI rc=0;
  # the stream completion gate caught that cancellation (live shell probe).
  env ${GROK_ENV_UNSET[@]+"${GROK_ENV_UNSET[@]}"} \
    GROK_HOME="$RUNTIME_HOME" GROK_DISABLE_AUTOUPDATER=1 GROK_MEMORY=0 \
    GROK_SUBAGENTS=0 GROK_TOOL_SEARCH=0 GROK_WRITE_FILE=0 \
    GROK_CLAUDE_MCPS_ENABLED=0 GROK_CURSOR_MCPS_ENABLED=0 \
    GROK_CLAUDE_HOOKS_ENABLED=0 GROK_CURSOR_HOOKS_ENABLED=0 \
    GROK_CLAUDE_SKILLS_ENABLED=0 GROK_CURSOR_SKILLS_ENABLED=0 \
    GROK_CLAUDE_AGENTS_ENABLED=0 GROK_CURSOR_AGENTS_ENABLED=0 \
    GROK_CLAUDE_RULES_ENABLED=0 GROK_CURSOR_RULES_ENABLED=0 \
    "$BIN_DIR/ro-repo-exec" "$SOURCE_REPO" -- \
    timeout -k 10 "$TIMEOUT_SECONDS" grok --cwd "$REPO_DIR" \
      --leader-socket "$RUNTIME_HOME/leader.sock" -m "$MODEL" \
      --no-plan --no-subagents --disable-web-search \
      --tools read_file,list_dir,grep,run_terminal_cmd \
      --disallowed-tools search_tool,use_tool \
      --always-approve \
      --max-turns "$MAX_TURNS" --output-format streaming-messages-json \
      --prompt-file "$PROMPT_FILE" </dev/null
) | tee "$STREAM" | python3 "$BIN_DIR/_grok-stream.py" "$LOG_FILE" "$SUMMARY" "$MODEL"
STATUS=("${PIPESTATUS[@]}")
set -e
RC="${STATUS[0]}"
VERDICT=UNKNOWN
if [[ "$MODE" == review ]]; then
  VERDICT="$(python3 "$BIN_DIR/_review_result.py" normalize "$LOG_FILE")"
fi
if [[ "$RC" == 124 || "$RC" == 137 ]]; then
  review_workspace_write_facts "$MODEL" "$MODEL" "$BILLING" timed_out partial timeout "$VERDICT" || exit 78
  echo "subgrok: timed out after ${TIMEOUT_SECONDS}s; partial output kept in $LOG_FILE" >&2
  exit 124
fi
if [[ "$RC" != 0 || "${STATUS[1]}" != 0 || "${STATUS[2]}" != 0 ]]; then
  review_workspace_write_facts "$MODEL" "$MODEL" "$BILLING" exited partial "" "$VERDICT" || exit 78
  echo "subgrok: incomplete/failed run (cli=$RC, stream=${STATUS[1]}, decoder=${STATUS[2]}); see $STREAM and $SUMMARY" >&2
  [[ "$RC" != 0 ]] || RC=1
  exit "$RC"
fi
if [[ "$MODE" == review && "$VERDICT" == UNKNOWN ]]; then
  review_workspace_write_facts "$MODEL" "$MODEL" "$BILLING" exited partial no_verdict UNKNOWN || exit 78
  die "model returned no verdict (log: $LOG_FILE)"
fi
if [[ "$MODE" == explore ]]; then
  python3 - "$LOG_FILE" <<'PY' || die 'incomplete direction paper'
import re, sys
text = open(sys.argv[1]).read()
for label in ('Direction', 'Core bet', 'How it works', 'Best at', 'Sacrifices',
              'Blind spots in the brief', 'Smallest first step'):
    if not re.search(r'(?m)^\s*(?:#+\s*)?(?:\*\*)?' + re.escape(label) + r'\s*:', text):
        raise SystemExit('subgrok: missing explore section: ' + label)
PY
fi
review_workspace_write_facts "$MODEL" "$MODEL" "$BILLING" exited complete "" "$VERDICT" || exit 78
