#!/usr/bin/env bash
# rotate-mimo-key —— 换 mimo key 的**唯一入口**(2026-09-01,track mimo-key-single-source)。
#
#   rotate-mimo-key <新key>
#   rotate-mimo-key --stdin        # 从标准输入读,不进 shell 历史
#
# 为什么有它:09-01 业主账号过期换 key,那把钥匙抄在 9 处、没有源头。我手工换了一轮
# **漏掉 3 处**,而漏掉的那处(submimo 的 canonical home)会在下次派活时把旧 key
# **重播回隔离树**,不报错、只 401。手工换 = 一定会漏,区别只是这次漏在哪。
#
# 它的顺序是刻意的,每一步都对应本机踩过的坑:
#   ① **先验 key 真的能用,再动任何文件。** 09-01 业主头两把 key 都是 401
#      (第一把是已装的旧 key、第二把不通),我装完才发现 —— 白改两轮。
#   ② 写之前先把**现值全读进内存**;任何一处写后校验失败 ⇒ **整体回滚**。
#      不留 `.bak` 文件:那些备份装的都是作废的 key,是垃圾也是泄漏面
#      (09-01 我自己就散了 11 个,业主问「有没有屎山」时才清掉)。
#   ③ 改完**让运行中的目标自己回话**:重启 gateway、真跑一条 cron 看它 ok。
#      盘上和运行时对不上 = BLOCK,不是警告。
#
# 位置清单**不在本文件里**,在 bin/_mimo-key-locations.sh —— 全机唯一一份,
# 判据读的是同一份。抄第二份就等于把本单要治的病又犯一遍。
#
# 环境变量:
#   MIMO_KEY_DRY_RUN=1   只走校验、打印计划,一个字节都不写(判据用)
#   MIMO_KEY_NO_DEPLOY=1 写文件但不重启 gateway、不跑 cron(离线环境用)
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
. "$HERE/_mimo-key-locations.sh" || { echo "rotate-mimo-key: 读不到位置清单" >&2; exit 64; }

DRY="${MIMO_KEY_DRY_RUN:-0}"
NO_DEPLOY="${MIMO_KEY_NO_DEPLOY:-0}"
say()  { printf '%s\n' "$*"; }
die()  { printf 'rotate-mimo-key: %s\n' "$1" >&2; exit "${2:-1}"; }

# ── 取新 key ──────────────────────────────────────────────────────────────
case "${1:-}" in
  ""|-h|--help)
    sed -n '2,30p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 64 ;;
  --stdin) read -r NEW_KEY ;;
  *)       NEW_KEY="$1" ;;
esac
NEW_KEY="$(printf '%s' "${NEW_KEY:-}" | tr -d '[:space:]')"

# ── ① 形状 ───────────────────────────────────────────────────────────────
# 形状不对时**在碰任何文件之前**退出。判据专门问这一条:被拒时源头必须一字未动。
mimo_key_shape_ok "$NEW_KEY" || die "key 形状不对(要 tp- 开头 + 40~60 位小写字母数字,拿到 ${#NEW_KEY} 位)" 2

OLD_KEY="$(mimo_key_read_source)"
if [[ "$NEW_KEY" == "$OLD_KEY" ]]; then
  say "新 key 和当前源头里的**完全一样**,无需替换。"
  exit 0
fi

# ── ② 先验它真的能用 ─────────────────────────────────────────────────────
# 端点从 openclaw 的 provider 配置读,不在这里再写死一份地址。
BASE_URL="$(python3 -c '
import json
try:
    d=json.load(open("/root/.openclaw/openclaw.json"))
    print(d["models"]["providers"]["xiaomi-coding"]["baseUrl"])
except Exception:
    print("")' 2>/dev/null)"
[[ -n "$BASE_URL" ]] || die "读不出 xiaomi-coding 的 baseUrl(openclaw.json)" 3

if [[ "$DRY" == "1" ]]; then
  say "[dry-run] 跳过联网校验"
else
  say "① 验这把 key 小米认不认($BASE_URL/models)…"
  code="$(curl -s -m 30 -o /dev/null -w '%{http_code}' "$BASE_URL/models" -H "Authorization: Bearer $NEW_KEY" 2>/dev/null)"
  if [[ "$code" != "200" ]]; then
    die "小米拒绝了这把 key(HTTP $code)—— **一个文件都没动**。先去后台确认套餐/余额,别装。" 4
  fi
  say "   HTTP 200 ✓"
fi

# ── ③ 读现值(为回滚)──────────────────────────────────────────────────────
say "② 读现值备内存(不落盘,免得留下装着死 key 的垃圾备份)…"
declare -a TOUCHED=()
snapshot_of() { cat "$1" 2>/dev/null | base64 -w0; }
declare -A SNAP=()
for f in "$MIMO_KEY_SOURCE" $(printf '%s\n' "${MIMO_KEY_COPIES[@]}" | cut -d'|' -f2 | sort -u); do
  [[ -f "$f" ]] || die "要写的文件不存在:$f" 5
  SNAP["$f"]="$(snapshot_of "$f")"
done

rollback() {
  say "‼️  写入校验失败 —— 回滚到改之前的内容"
  for f in "${!SNAP[@]}"; do
    printf '%s' "${SNAP[$f]}" | base64 -d > "$f"
  done
}

if [[ "$DRY" == "1" ]]; then
  say "[dry-run] 将要写:"
  say "   源头  $MIMO_KEY_SOURCE [$MIMO_KEY_SOURCE_SELECTOR]"
  for e in "${MIMO_KEY_COPIES[@]}"; do IFS='|' read -r _ p s <<< "$e"; say "   副本  $p [$s]"; done
  exit 0
fi

# ── ④ 写 ─────────────────────────────────────────────────────────────────
say "③ 写源头 + ${#MIMO_KEY_COPIES[@]} 处副本…"
# 🔴 **原子写**(自审抓到的缺陷):本机断线是常态,而本工具刻意不留 .bak。
# `open(path,"w")` 先截断再写 ⇒ 写到一半被砍 = 一份**截断的 JSON**,
# 那比"留下一个装着死 key 的备份"坏得多 —— 配置直接解析不了。
# 所以写临时文件 + fsync + os.replace(同目录内是原子的):要么旧的完整,要么新的完整。
write_json() {   # 路径 取值路径 新值
  python3 -c '
import json,os,sys,tempfile
path,sel,val=sys.argv[1],sys.argv[2],sys.argv[3]
d=json.load(open(path))
node=d
keys=sel.split(".")
for k in keys[:-1]:
    node=node[k]
node[keys[-1]]=val
st=os.stat(path)
dirn=os.path.dirname(path) or "."
fd,tmp=tempfile.mkstemp(dir=dirn, prefix=".rotate-", suffix=".tmp")
try:
    with os.fdopen(fd,"w") as f:
        json.dump(d,f,ensure_ascii=False,indent=2)
        f.write("\n")
        f.flush(); os.fsync(f.fileno())
    os.chmod(tmp, st.st_mode & 0o7777)   # 别把 600 的凭证写成 644
    os.replace(tmp, path)
except BaseException:
    try: os.unlink(tmp)
    except OSError: pass
    raise' "$1" "$2" "$3"
}

write_json "$MIMO_KEY_SOURCE" "$MIMO_KEY_SOURCE_SELECTOR" "$NEW_KEY" || { rollback; die "写源头失败" 6; }
for e in "${MIMO_KEY_COPIES[@]}"; do
  IFS='|' read -r kind p s <<< "$e"
  [[ "$kind" == "json" ]] || { rollback; die "清单里有未知类型:$kind" 6; }
  write_json "$p" "$s" "$NEW_KEY" || { rollback; die "写副本失败:$p" 6; }
done

# ── ⑤ 逐处回读校验 ───────────────────────────────────────────────────────
say "④ 逐处回读校验…"
bad=0
got="$(mimo_key_read_source)"
[[ "$got" == "$NEW_KEY" ]] || { say "   ✗ 源头没写进去:$MIMO_KEY_SOURCE"; bad=1; }
for e in "${MIMO_KEY_COPIES[@]}"; do
  IFS='|' read -r _ p s <<< "$e"
  got="$(python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
for k in sys.argv[2].split("."):
    d=d[k]
print(d)' "$p" "$s" 2>/dev/null)"
  if [[ "$got" == "$NEW_KEY" ]]; then say "   ✓ $p [$s]"; else say "   ✗ $p [$s]"; bad=1; fi
done
[[ $bad -eq 0 ]] || { rollback; die "有位置没写成功,已整体回滚" 7; }

# 隔离树:submimo-iso 每次跑都从源头 re-seed,本来会自愈。这里顺手刷一遍,
# 只是免得盘上躺着一份过期凭证让人误判。路径是 glob 出来的,不是手抄的第二份清单。
for f in /root/aiwork/mimo-home/*/data/mimocode/auth.json; do
  [[ -f "$f" ]] || continue
  write_json "$f" "xiaomi.key" "$NEW_KEY" >/dev/null 2>&1 && say "   ✓ (顺手)$f"
done

if [[ "$NO_DEPLOY" == "1" ]]; then
  say "⑤ MIMO_KEY_NO_DEPLOY=1,跳过重启与实跑验证。**盘上改了但运行时没换,别当完成。**"
  exit 0
fi

# ── ⑥ 让运行中的目标自己回话 ─────────────────────────────────────────────
say "⑤ 重启 gateway…"
systemctl --user restart openclaw-gateway || die "gateway 重启失败" 8
for _ in $(seq 1 15); do
  out="$("$HERE/check-gateway-version" 2>&1)" && break
  sleep 4
done
say "   $out"

say "⑥ 真跑一条 cron 看它 ok(不是看文件躺在盘上)…"
JOB="${MIMO_KEY_SMOKE_JOB:-gmail-check-30m}"
res="$(timeout 300 openclaw cron run "$JOB" --wait --wait-timeout 240s 2>&1 | tr -d '\n')"
if grep -q '"status": *"ok"' <<< "$res"; then
  say "   ✓ $JOB → status ok"
else
  say "   ✗ $JOB 没跑成:$(printf '%s' "$res" | tail -c 300)"
  die "盘上换好了,但运行中的目标没回绿 —— 按规矩这是 BLOCK,不是警告。" 9
fi

say ""
say "✅ 换完了。源头:$MIMO_KEY_SOURCE"
say "   下一步没有 —— 判据 tests/test-mimo-key-single-source.sh 会在每周总跑里盯着它。"
