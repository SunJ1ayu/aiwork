#!/usr/bin/env bash
set -euo pipefail

# subgemini - Gemini review employee on an AGENT base: Antigravity CLI (`agy`)
# run headless (`agy -p`). Fifth panel leg (2026-08-25, track subgemini-review-leg).
# Rides the owner's Gemini membership (OAuth, auth_method=consumer), not an API key.
#
#   review -> agy -p, verdict-gated, review-only. Works now.
#   fix    -> NOT supported on purpose: panel reviewers stay review-only.
#
# Isolation: agy has NO dedicated home variable (paths are built from $HOME), so
# isolation is done by swapping HOME (same shape as subglm's OPENCODE_REVIEW_HOME).
# The OAuth token is COPIED into the review home, never symlinked: a link is a
# write channel pointing outside the sandbox, and that was the root cause of
# panel-kimi-credential-wipe. Losing the owner's agy login is not recoverable by
# us - only he can redo the browser OAuth by hand.
#
# 三条实测过的坑(2026-08-25,全部有判据 V46 盯着):
#   ① rc 信不得:未登录跑 `agy models` 仍然 rc=0;文档载明拿不到批准的工具是
#      soft-deny「继续跑、exit 0、只在 stderr 印一句」⇒ 判死活只能看裁决行。
#   ② 未登录时 `agy -p` **静默挂死**(实测 40s 零输出)⇒ 必须预检 + 硬超时。
#   ③ 不给 workspace 时它读写自己的 ~/.gemini/antigravity-cli/scratch/,
#      **不碰 cwd** ⇒ 必须显式 --add-dir,否则腿等于没看见被评审的仓。

BIN_DIR="$(python3 -c 'import os, sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")" || exit 1

# 反锚定闸:先 source(只定义函数),并在解析位置参数**之前**摘掉 --panel-dispatch。
_GATE="$BIN_DIR/_my-review-gate.sh"
[ -f "$_GATE" ] || { echo "subgemini: 找不到 _my-review-gate.sh —— 闸缺件,拒跑(fail closed)" >&2; exit 1; }
. "$_GATE"
gate_strip_flags "$@"; set -- ${GATE_ARGS[@]+"${GATE_ARGS[@]}"}

# 「运行期 home 不许在被评审的仓里」的共享闸。缺件就拒跑:少了它 = 这条腿没有这道
# 检查,而"腿被自家防线弄死"的错误信息长得像额度耗尽。
_RHG="$BIN_DIR/_review-home-guard.sh"
[ -f "$_RHG" ] || { echo "subgemini: 找不到 _review-home-guard.sh —— 闸缺件,拒跑(fail closed)" >&2; exit 1; }
. "$_RHG"

REVIEW_HOME="${AGY_REVIEW_HOME:-$("$BIN_DIR/aiwork-config" data-path agy-review-home)}"
DEFAULT_MODEL="$("$BIN_DIR/aiwork-config" model gemini "${AGY_MODEL:-}")" || exit 1
OWNER_TOKEN="${AGY_OWNER_TOKEN:-$HOME/.gemini/antigravity-cli/antigravity-oauth-token}"
TIMEOUT_SECONDS="${AGY_TIMEOUT:-1500}"

usage() {
  cat >&2 <<'EOF'
Usage:
  subgemini review TASK_FILE LOG_FILE [REPO_DIR]
  subgemini fix    TASK_FILE LOG_FILE [REPO_DIR]   (unsupported - see notes)

Runs Gemini (Google Antigravity CLI `agy`, headless) as an isolated review leg
on the owner's Gemini membership. The reviewer reads a disposable writable clone;
the source repo stays read-only.

Environment:
  AIWORK_DATA_DIR  optional, overrides the common machine data directory
  AGY_MODEL         optional, default from ~/.config/aiwork/models.env.
                    MUST match ^gemini- : agy also serves claude-* / gpt-oss-*,
                    and a Claude-backed "Gemini leg" silently guts panel's
                    distinct-model-family coverage check.
  AGY_TIMEOUT       optional, seconds (default 1500)
  AGY_REVIEW_HOME   optional, default $HOME/.local/share/aiwork/agy-review-home (仓外)
EOF
}

die() { echo "subgemini: $*" >&2; exit 1; }

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then usage; exit 0; fi
if [[ $# -lt 3 || $# -gt 4 ]]; then usage; exit 2; fi

MODE="$1"; TASK_FILE="$2"; LOG_FILE="$3"; REPO_DIR="${4:-$PWD}"
SOURCE_REPO="$REPO_DIR"

my_review_gate "$MODE" "$TASK_FILE" "$REPO_DIR" "subgemini" || exit 1

[[ "$MODE" == "review" ]] || { usage; exit 2; }

# 🔴 任务文件不存在就拒跑。原来是下面那句 `cat "$TASK_FILE" 2>/dev/null || true`
# 把一切错误吞掉:路径写错时腿拿到一份**没有任务的提示词**,照样可能吐一个裁决行
# ⇒ 收一个 PASS,而它什么都没审。"看起来跑完了、其实没审"是这套系统最贵的失败,
# 而这是它最便宜的一条入口。subkimi 早就是这么挡的。(四审 F8,判据 V46⑮)
[[ -f "$TASK_FILE" ]] || die "task file not found: $TASK_FILE(任务文件不存在 ⇒ 拒跑,不许审一份空提示词)"

# ── 模型硬闸 ────────────────────────────────────────────────────────────
# 这不是"默认值",是闸。agy 的 models 表里同时有 claude-sonnet-4-6 /
# claude-opus-4-6-thinking / gpt-oss-120b。这条腿在花名册里代表 **Google 家族**,
# 它跑成 Claude 就等于:归档闸数到"两个不同家族"、实际上两条腿都是 Claude。
# 闸查的是腿名,查不出模型 —— 所以只能在这里挡。
MODEL="${AGY_MODEL:-$DEFAULT_MODEL}"
"$BIN_DIR/aiwork-config" family subgemini "$MODEL" >/dev/null || die "AGY_MODEL='$MODEL' 不是 gemini-* ⇒ 拒跑。
  这条腿在 panel 花名册里代表 Google 模型家族;跑成 claude-*/gpt-* 会破坏家族覆盖。"

review_home_guard subgemini "$REVIEW_HOME" "$SOURCE_REPO" AGY_REVIEW_HOME || exit 1

if [[ -n "${REVIEW_PRINT_HOME:-}" ]]; then printf '%s\n' "$REVIEW_HOME"; exit 0; fi

# ── 隔离 home:同一时刻只许一条腿用 ──────────────────────────────────────
# 🔴 `AGY_REVIEW_HOME` 是**固定路径**,而 settings.json 里写着**每次不同**的副本路径
# (read_file 授权)。两条 subgemini 撞上(panel 与手动跑并行、或两轮 panel 相撞),
# 后写的会把先跑那条的授权改成指向自己的副本 ⇒ 先跑那条突然读不到自己的仓、交白卷,
# 而错误长得像额度或凭证问题。2026-08-26 判据 V46⑭ 实测过这条串味,不是推论。
# 取**非阻塞**锁、响亮失败:一条腿在等另一条的沉默,比一次明确的拒跑贵得多。
# (没做"每轮一个新 home":agy 的 conversations DB 是 subgemini-diag 唯一的输入,
#  它需要一个稳定路径;而新 home 的首跑向导行为在闭源二进制上是未知的。)
mkdir -p "$REVIEW_HOME"
exec 9>"$REVIEW_HOME/.subgemini.lock" || die "开不了评审 home 的锁文件($REVIEW_HOME/.subgemini.lock)"
flock -n 9 || die "另一条 subgemini 正在用同一个评审 home($REVIEW_HOME)⇒ 拒跑。
  两条并发会互相覆盖 settings.json 里的读授权,先跑那条会突然读不到自己的副本、
  交白卷,而错误长得像额度或凭证问题。等它跑完,或用 AGY_REVIEW_HOME=<别的路径> 分开跑。"

# ── 凭证用复制(不是链接)+ 关掉遥测 ─────────────────────────────────────
AGY_HOME_DIR="$REVIEW_HOME/.gemini/antigravity-cli"
mkdir -p "$AGY_HOME_DIR"
[[ -f "$OWNER_TOKEN" ]] || die "找不到 agy 凭证($OWNER_TOKEN)⇒ 拒跑。
  业主需要跑一次 \`agy\` 完成 OAuth(会打印授权网址,要人在浏览器里点)。"
# 🔴 复制,不是 ln -s。链接会让腿写穿到业主的登录上,而掉登录只有他本人能修。
# trap 装在 **cp 之前**:`cp` 成功而 `chmod` 失败(set -e)那一瞬间,
# 凭证已经在盘上、而擦除还没挂上。窗口很小,但这条腿护的是不可逆的东西。
# (第二轮四审 subkimi 与 gemini 腿各自独立点了这处。)
_subgemini_wipe_token() { rm -f "$AGY_HOME_DIR/antigravity-oauth-token"; }
trap '_subgemini_wipe_token' EXIT
rm -f "$AGY_HOME_DIR/antigravity-oauth-token"
cp "$OWNER_TOKEN" "$AGY_HOME_DIR/antigravity-oauth-token"
chmod 600 "$AGY_HOME_DIR/antigravity-oauth-token"
# 🔴 **跑完即删**。这份副本内含 refresh_token(它自己能刷新),一份能自己刷新的
# 长期凭证不该在盘上过夜:多一份泄漏面,而且闭源二进制若做 refresh-token 轮换,
# 副本抢先刷新就可能把业主的登录刷失效 —— 正是本单最不能接受的那种不可逆损害。
# 注释里原来那句"每次重写,不留隔夜残留"只对 settings.json 成立,对 token 不成立。
# trap 装在**拷贝之后立刻**,不等 workspace 那一步:中间任何一次 die(预检失败、
# workspace 建不起来)都不许把凭证留在盘上。(四审 F9/F6,判据 V46⑬)
# 🔴 遥测:业主在首次向导里亲手关掉了数据收集,但那条写在**他的** home。
# 换 HOME 之后评审 home 是全新的、没有 settings.json ⇒ 走默认值 ⇒ 他的选择被绕过,
# 而这条腿读的正是他的仓库代码。每次重写。
# 写评审 home 的 settings。**分两次调用**:
#   第一次(无参)在预检之前 —— 预检只调 `agy models`,不需要文件权限;
#   第二次(带可丢弃副本的路径)在 workspace 准备之后 —— 那时才知道副本在哪。
# 三件事焊在这里:
#  ① enableTelemetry:false —— 业主在首次向导里亲手关掉了数据收集,但那写在**他的**
#     home;换 HOME 后评审 home 是全新的、连 settings.json 都没有 = 走默认值 =
#     他的选择被绕过,而这条腿读的正是他的仓库代码。
#  ② read_file/write_file **限定在那份可丢弃副本上**。2026-08-26 实测:
#     `--add-dir` 给的目录**不算 active workspace**(文档那句"workspace 内读写
#     自动允许"不覆盖它),每个新目录要 project 授权、headless 拿不到 ⇒
#     read_file 被 auto-deny ⇒ 腿交白卷而 agy 仍 rc=0。
#     `read_file(*)` 和 `read_file(/)` 也能解开,但那让腿读得到 ~/.ssh、业主凭证、
#     别的项目 —— **这条腿的全部安全前提就是"它只看得见那份副本"**,不许通配。
#  ③ 命令白名单**只留只读 git**。headless 下命令默认 Ask ⇒ 被 auto-deny ⇒ 同样交白卷,
#     所以非给不可;但**不许给 cat/ls/grep/find 这类通用文件命令** —— 它们绕过 ②
#     的副本限定,`command(cat)` 等于让腿读得到 ~/.ssh 和业主凭证。文件读取走内置
#     read_file 工具(受 ② 约束)。与 subglm 的 bash 白名单姿态一致。
#     ⚠️ **分组语法是死的**:实测 `command(git log)` 通过、`command(git (log|diff))`
#     被拒 —— 而官方文档的例子恰恰是分组写法。照文档写 = 规则静默失效 = 腿交白卷。
# 🔴 绝不用 --dangerously-skip-permissions:那会把网络与仓外写一并放开。
# 白名单不是这条腿的安全边界 —— 边界是"可丢弃副本 + 原仓 ro-repo-exec 只读挂载",
# 而那道挂载 2026-08-26 才真的接上(在下面 RO_EXEC 那一段;之前这句话是**假的**)。
# 白名单挡得住误伤、并且让腿的能力边界是写下来可审的,但它挡不住 git 自己的参数
# (`git diff --output=` 写、`git diff --no-index` 读,08-19 已实证)。
# ⚠️ 仍然敞着、且**各 agent 腿都一样**的口子:namespace 只把被评审的原仓变只读,
#    管不住仓**外**的读(`~/.ssh`、业主凭证)。要堵它得给 ro-repo-exec 加"遮住
#    敏感路径"的能力,那是跨全部 agent 腿的改动,单开一单(tasks.md 敞账 D3),
#    不在这条腿里假装已经解决。
write_agy_settings() {   # write_agy_settings [可丢弃副本路径]
  local ws="${1:-}" scoped=""
  [[ -n "$ws" ]] && scoped="\"read_file($ws)\", \"write_file($ws)\", "
  cat > "$AGY_HOME_DIR/settings.json" <<EOF
{
  "enableTelemetry": false,
  "permissions": {
    "allow": [
      ${scoped}"command(git log)",
      "command(git diff)",
      "command(git status)",
      "command(git show)",
      "command(git ls-files)",
      "command(git rev-parse)",
      "command(git blame)"
    ]
  }
}
EOF
  chmod 600 "$AGY_HOME_DIR/settings.json"
}
write_agy_settings

AGY_BIN="${AGY_BIN:-$(command -v agy 2>/dev/null || echo "$HOME/.local/bin/agy")}"
[[ -x "$AGY_BIN" ]] || die "找不到可执行的 agy($AGY_BIN)"

# ── 预检:凭证活着吗 ────────────────────────────────────────────────────
# 存在的理由:未登录时 `agy -p` **一个字都不印、也不退出**(实测 40s)。
# 没有这一步,失效凭证的表现是"腿像在跑,然后超时",和额度耗尽长得一模一样。
PRE="$(env HOME="$REVIEW_HOME" timeout 90 "$AGY_BIN" models </dev/null 2>&1 9>&- || true)"
grep -q '^gemini-' <<<"$PRE" \
  || die "agy 凭证预检失败 ⇒ 拒绝派发(不进入静默挂死)。agy 说:
$(printf '%s' "$PRE" | head -3)
  业主需要重新跑一次 \`agy\` 走 OAuth。"

# ── 可丢弃副本 + 原仓只读 ──────────────────────────────────────────────
_RW="$BIN_DIR/_review-workspace.sh"
[ -f "$_RW" ] || die '找不到 _review-workspace.sh ⇒ 拒绝派发(fail-closed)'
# shellcheck source=_review-workspace.sh
. "$_RW"
review_workspace_prepare "$SOURCE_REPO" subgemini || die 'review workspace 准备失败 ⇒ 模型未启动'
REVIEW_WORKSPACE_ACTIVE=1
SOURCE_REPO="$REVIEW_SOURCE_REPO"
REPO_DIR="$(review_workspace_repo)" || exit 78
review_workspace_write_facts "$MODEL" "$MODEL" subscription || exit 78

# 🔴 原仓**物理只读**:和 subkimi / submimo / subagent 一样,把模型命令放进
# ro-repo-exec 的 mount namespace 里跑。2026-08-26 之前这条腿只在注释里写着
# "原仓 ro-repo-exec 只读",代码里一个字都没接 —— 四审两条腿各自 grep 出来,
# 判据 V46⑫ 用假模型试写实测过:**当时真能写进被评审的原仓**。
# 命令白名单挡不住这个(`git diff --output=<路径>` 08-19 已实证),它从来不是边界。
# fail-closed 在 ro-repo-exec 里:挂不上就拒跑,绝不降级成"在可写的仓里跑"。
[[ -x "$BIN_DIR/ro-repo-exec" ]] || { printf '%s: 少了 %s/ro-repo-exec ⇒ 拒绝在可写的仓里跑评审腿(fail-closed)\n' "$(basename "$0")" "$BIN_DIR" >&2; exit 78; }
RO_EXEC=("$BIN_DIR/ro-repo-exec" "$SOURCE_REPO" --)

# 副本路径现在才知道 —— 重写 settings,把 read_file/write_file 授权**限定到它身上**。
write_agy_settings "$REPO_DIR"

_subgemini_cleanup() {
  local rc=$?
  # 凭证副本永远先擦掉 —— 这个 trap 覆盖了上面那个只擦凭证的,擦的动作不能跟着丢。
  _subgemini_wipe_token
  if [[ "${REVIEW_WORKSPACE_ACTIVE:-0}" -eq 1 ]]; then
    review_workspace_cleanup \
      || echo "subgemini: 警告:review workspace 清理失败:${REVIEW_WORKSPACE_DIR:-?}" >&2
  fi
  trap - EXIT
  exit "$rc"
}
trap _subgemini_cleanup EXIT

case "$LOG_FILE" in /*) ;; *) LOG_FILE="$PWD/$LOG_FILE" ;; esac
mkdir -p "$(dirname "$LOG_FILE")"

TASK_TEXT="$(cat "$TASK_FILE" 2>/dev/null || true)"
# 🔴 提示词里必须写清沙箱边界。这不是客气话,是**这条腿能不能交卷**的关键:
# agy 在 headless 下拿不到批准的工具是 soft-deny,而实测 soft-deny **一次就让整个 run
# 零产出**(不是"换个工具继续")。所以治本的办法不是把它想跑的命令一个个加进白名单
# (2026-08-26 连追四轮:RunCommand → read_file → git 分组语法 → `bash tests/...`,
# 追不完),而是**让它一开始就不去调那些工具**。
# 捞报告的落点:**每轮一个独一无二的名字 + 开跑前先删干净**。
# 🔴 第一版用的是固定名 SUBGEMINI-REVIEW.md,那是被评审仓里的一个普通路径 ——
# 仓里躺着一份同名文件(上一轮留下的、作者放的、提示注入写的)时,模型零产出的
# 那一轮会把它捞出来当裁决:**rc=0 + PASS,而没有任何模型写过它**。伪造的结论,
# 正是这条腿存在要防的那种病(2026-08-26 亲手复现;第二轮四审里那条超时失败的
# GLM 腿设计了这个探针,判据 V46㉒ 盯着)。
# 两道一起上:名字带本轮的 PID+时间戳(仓里不可能预先有),开跑前再 rm 一次。
SALVAGE_FILE="$REPO_DIR/.subgemini-review-$$-$(date +%s).md"
rm -f "$SALVAGE_FILE"
# 🔴 提示词里**绝不许出现反引号**:在双引号串里它就是命令替换,写进去的那一刻
# 就会被 shell 真跑一遍。2026-08-26 我拿 git 命令当例子写进这段提示词,
# 判据当场 12 红,错误信息是 git 自己吐的 "ambiguous argument X" —— 它真跑了。
# 本仓 08-19 为"判据注释里的反引号被 shell 执行"记过一次账(判据 V41),这是第二次,
# 换了个地方(实现的提示词里)。写例子一律用单引号。
PROMPT="You are a code reviewer. Read the repository yourself; do not assume a diff was pasted.

SANDBOX CONSTRAINTS — read this first, it decides whether your review survives:
- You CAN read any file in this workspace with your file-reading tools. Use them freely.
- You CANNOT run shell commands, EXCEPT read-only git, run BARE:
  git log / git diff / git status / git show / git ls-files / git rev-parse / git blame
- NO PIPES, NO REDIRECTS, NO CHAINING. 'git diff X | grep Y', 'cmd > file', 'a && b'
  all count as running a DIFFERENT command that is not allowed. A real run died exactly
  this way: 43 steps of good work, then one 'git diff … | grep …' — and everything was lost.
  If you want to search inside a diff, read the file instead, or run the git command bare.
- Do NOT try to run tests, build, install, or execute any script (no bash/sh/python/npm).
  Those are blocked, and a single blocked attempt ABORTS YOUR ENTIRE RUN WITH ZERO OUTPUT —
  your whole review would be lost. Base your review on READING the code.

SAVE YOUR WORK AS YOU GO — this is your insurance against the above:
Write your review into the file $SALVAGE_FILE (you have write access to it), starting with
the verdict line, and keep updating it. If your run is aborted, that file is the ONLY thing
that survives; whatever you only printed is thrown away. Print the review as well at the end.

$TASK_TEXT

Write the verdict line AS SOON AS you have enough to judge, then keep explaining.
The verdict line must be exactly this form:
Conclusion: PASS | BLOCK | NEEDS_MORE_INFO"

# Same header shape as the other legs: review-pr separates the report at its end.
{
  echo "# subgemini review log"
  echo "time: $(date -Iseconds)"
  echo "model: $MODEL"
  echo "repo: $REPO_DIR (disposable clone; source stays read-only)"
  echo "home: $REVIEW_HOME"
  echo
} > "$LOG_FILE"

set +e
# `9>&-`:把评审 home 那把锁的 fd **对模型这一支关掉**。不关的话它被整棵子进程树
# 继承 ⇒ 腿被砍留下的孤儿会替它举着锁 ⇒ 之后每一轮都被判成"撞车",而根本没有腿在跑。
# 断线砍腿在本机是反复发生的事,所以这不是理论风险(判据 V46⑱ 用 setsid 孤儿实证)。
( cd "$REPO_DIR" && env HOME="$REVIEW_HOME" "${RO_EXEC[@]}" timeout "$TIMEOUT_SECONDS" \
    "$AGY_BIN" -p "$PROMPT" --model "$MODEL" --add-dir "$REPO_DIR" \
    --output-format text </dev/null ) >> "$LOG_FILE" 2>&1 9>&-
RC=$?
set -e

# 🔴 裁决判定复用 typed result 的唯一 normalizer,不在这里另写一条正则。
# 它是严格的(裁决必须独立成行) —— 因为提示词里就原样含有
# "Conclusion: PASS | BLOCK | NEEDS_MORE_INFO",宽松匹配会把"没交卷"记成 PASS。
# 腿自己用宽松正则、terminal producer 用严格正则 = 腿自认成功而结果记 UNKNOWN,
# 「同一个事实存两处、只更新其中一个」正是本机反复记账的老毛病。
_RR="${AIWORK_REVIEW_RESULT_BIN:-$BIN_DIR/_review_result.py}"
[ -f "$_RR" ] || die '找不到 _review_result.py ⇒ 拒绝派发(fail-closed:裁决判定没有唯一源)'
VERDICT="$(python3 "$_RR" normalize "$LOG_FILE" 2>/dev/null)" \
  || die "typed verdict normalization failed (log: $LOG_FILE)"
HAS_VERDICT=0
[[ "$VERDICT" != "UNKNOWN" ]] && HAS_VERDICT=1
DEGRADED=false

# 🔴 stdout 零产出时,把副本里的报告捞出来(2026-08-26 真链实测立的这道)。
# agy 的行为:**一次 soft-deny 就把整轮扔掉**,哪怕它已经干了 43 步的活。
# 那次死在 `git diff … | grep …` 一个管道上,几分钟的真评审一个字都没留下。
# 我们改不了 agy,但报告可以先落盘 —— write_file 本来就授权在这份可丢弃副本上。
# **必须标明出处**:一份"被丢弃那轮的残骸"不许读起来像正常产出(同 V19 降级横幅)。
# 捞之前先问它有没有内容:**只有一行裁决的残骸不收**。那确实是模型写的(不是伪造),
# 但它是一份没有理由的评审 —— 收下等于给这一轮盖橡皮图章。
# (第三轮四审 submimo 点的;判据 V46㉓。)阈值取 3 行非空正文:够低,不会误伤
# 一份"短但有话"的报告;又足以挡住只写了裁决就被砍的那种。
_salvage_body_lines() {
  grep -vE '^[[:space:]]*$' "$SALVAGE_FILE" 2>/dev/null \
    | grep -viE '^[[:space:]]*[*_`]*[[:space:]]*(Conclusion|Verdict|结论)[[:space:]]*[：:]' | wc -l
}
if [[ $HAS_VERDICT -eq 0 && -s "$SALVAGE_FILE" ]] && [[ "$(_salvage_body_lines)" -lt 3 ]]; then
  echo "subgemini: 工作区里那份报告只有裁决行、没有理由($(_salvage_body_lines) 行正文)⇒ 不收。
  那是模型写完裁决就被砍的残骸;收下它等于给这一轮盖个橡皮图章。日志:$LOG_FILE" >&2
elif [[ $HAS_VERDICT -eq 0 && -s "$SALVAGE_FILE" ]]; then
  { echo
    echo "⚠️  下面这份报告是**从工作区里捞出来的**:模型 stdout 零产出"
    echo "    (agy 的老毛病:一次 soft-deny 就把整轮扔掉),而它把报告写进了"
    echo "    副本里的 SUBGEMINI-REVIEW.md。它可能是**半截的** —— 按此折扣。"
    echo "---- 捞出来的内容开始 ----"
    cat "$SALVAGE_FILE"
    echo "---- 捞出来的内容结束 ----"
  } >> "$LOG_FILE"
  VERDICT="$(python3 "$_RR" normalize "$LOG_FILE" 2>/dev/null)" \
    || die "typed verdict normalization failed after salvage (log: $LOG_FILE)"
  if [[ "$VERDICT" != "UNKNOWN" ]]; then
    HAS_VERDICT=1
    DEGRADED=true
  fi
fi

# 超时可以保留已落盘裁决，但它始终是 partial + degraded，且 rc=124。
if [[ $RC -eq 124 ]]; then
  # 横幅**写进日志本身**,不只印在 stderr:这份结论以后会被单独读到(归档、断线
  # 重连),那时终端上那行早就没了,而一份"写完裁决就被砍"的报告长得和完整评审
  # 一模一样。同 V19 降级横幅的理由。(判据 V46⑯)
  { echo
    echo "⚠️  超时被砍(${TIMEOUT_SECONDS}s)—— 这是**部分运行**；已写裁决仅作证据，不计覆盖。"
  } >> "$LOG_FILE"
  review_workspace_write_facts "$MODEL" "$MODEL" subscription \
    timed_out partial timeout "$VERDICT" true || exit 78
  if [[ $HAS_VERDICT -eq 1 ]]; then
    echo "subgemini: timed out after ${TIMEOUT_SECONDS}s; preserving verdict=$VERDICT as partial evidence, not coverage." >&2
  else
    echo "subgemini: timed out after ${TIMEOUT_SECONDS}s with no verdict (log: $LOG_FILE)" >&2
  fi
  exit 124
fi

# 🔴 这两行的顺序是有意的:**先看裁决行,再看 rc**。
# agy 未登录/软拒绝都会 rc=0,rc 在这条腿上不是死活的证据。
if [[ $HAS_VERDICT -ne 1 ]]; then
  if [[ $RC -eq 0 ]]; then
    review_workspace_write_facts "$MODEL" "$MODEL" subscription \
      exited partial no_verdict "$VERDICT" || exit 78
  fi
  die "model returned no verdict (expected 'Conclusion: PASS|BLOCK|NEEDS_MORE_INFO'; rc=$RC; log: $LOG_FILE)"
fi
if [[ $RC -ne 0 ]]; then
  review_workspace_write_facts "$MODEL" "$MODEL" subscription \
    exited partial runtime "$VERDICT" "$DEGRADED" || exit 78
  die "agy exited rc=$RC (log: $LOG_FILE)"
fi
if [[ "$DEGRADED" == true ]]; then
  review_workspace_write_facts "$MODEL" "$MODEL" subscription \
    exited partial runtime "$VERDICT" true || exit 78
else
  review_workspace_write_facts "$MODEL" "$MODEL" subscription \
    exited complete "" "$VERDICT" false || exit 78
fi
exit 0
