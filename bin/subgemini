#!/usr/bin/env bash
set -euo pipefail

# subgemini - Gemini review employee on an AGENT base: Antigravity CLI (`agy`)
# run headless (`agy -p`). Fifth panel leg (2026-08-25, track subgemini-review-leg).
# Rides the owner's Gemini membership (OAuth, auth_method=consumer), not an API key.
#
#   review -> agy -p, verdict-gated, review-only. Works now.
#   fix    -> NOT supported on purpose: panel reviewers stay review-only.
#
# Isolation: agy has NO dedicated home variable (paths are built from $HOME), so
# isolation is done by swapping HOME (same shape as subglm's OPENCODE_REVIEW_HOME).
# The OAuth token is COPIED into the review home, never symlinked: a link is a
# write channel pointing outside the sandbox, and that was the root cause of
# panel-kimi-credential-wipe. Losing the owner's agy login is not recoverable by
# us - only he can redo the browser OAuth by hand.
#
# 三条实测过的坑(2026-08-25,全部有判据 V46 盯着):
#   ① rc 信不得:未登录跑 `agy models` 仍然 rc=0;文档载明拿不到批准的工具是
#      soft-deny「继续跑、exit 0、只在 stderr 印一句」⇒ 判死活只能看裁决行。
#   ② 未登录时 `agy -p` **静默挂死**(实测 40s 零输出)⇒ 必须预检 + 硬超时。
#   ③ 不给 workspace 时它读写自己的 ~/.gemini/antigravity-cli/scratch/,
#      **不碰 cwd** ⇒ 必须显式 --add-dir,否则腿等于没看见被评审的仓。

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"

# 反锚定闸:先 source(只定义函数),并在解析位置参数**之前**摘掉 --panel-dispatch。
_GATE="$BIN_DIR/_my-review-gate.sh"
[ -f "$_GATE" ] || _GATE=/root/aiwork/bin/_my-review-gate.sh
[ -f "$_GATE" ] || { echo "subgemini: 找不到 _my-review-gate.sh —— 闸缺件,拒跑(fail closed)" >&2; exit 1; }
. "$_GATE"
gate_strip_flags "$@"; set -- ${GATE_ARGS[@]+"${GATE_ARGS[@]}"}

# 「运行期 home 不许在被评审的仓里」的共享闸。缺件就拒跑:少了它 = 这条腿没有这道
# 检查,而"腿被自家防线弄死"的错误信息长得像额度耗尽。
_RHG="$BIN_DIR/_review-home-guard.sh"
[ -f "$_RHG" ] || _RHG=/root/aiwork/bin/_review-home-guard.sh
[ -f "$_RHG" ] || { echo "subgemini: 找不到 _review-home-guard.sh —— 闸缺件,拒跑(fail closed)" >&2; exit 1; }
. "$_RHG"

REVIEW_HOME="${AGY_REVIEW_HOME:-$HOME/.cache/aiwork/agy-review-home}"
DEFAULT_MODEL="gemini-3.7-flash-high"
OWNER_TOKEN="${AGY_OWNER_TOKEN:-$HOME/.gemini/antigravity-cli/antigravity-oauth-token}"
TIMEOUT_SECONDS="${AGY_TIMEOUT:-1500}"

usage() {
  cat >&2 <<'EOF'
Usage:
  subgemini review TASK_FILE LOG_FILE [REPO_DIR]
  subgemini fix    TASK_FILE LOG_FILE [REPO_DIR]   (unsupported - see notes)

Runs Gemini (Google Antigravity CLI `agy`, headless) as an isolated review leg
on the owner's Gemini membership. The reviewer reads a disposable writable clone;
the source repo stays read-only.

Environment:
  AGY_MODEL         optional, default gemini-3.7-flash-high.
                    MUST match ^gemini- : agy also serves claude-* / gpt-oss-*,
                    and a Claude-backed "Gemini leg" silently guts panel's
                    distinct-model-family coverage check.
  AGY_TIMEOUT       optional, seconds (default 1500)
  AGY_REVIEW_HOME   optional, default $HOME/.cache/aiwork/agy-review-home (仓外)
EOF
}

die() { echo "subgemini: $*" >&2; exit 1; }

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then usage; exit 0; fi
if [[ $# -lt 3 || $# -gt 4 ]]; then usage; exit 2; fi

MODE="$1"; TASK_FILE="$2"; LOG_FILE="$3"; REPO_DIR="${4:-$PWD}"
SOURCE_REPO="$REPO_DIR"

my_review_gate "$MODE" "$TASK_FILE" "$REPO_DIR" "subgemini" || exit 1

[[ "$MODE" == "review" ]] || { usage; exit 2; }

# ── 模型硬闸 ────────────────────────────────────────────────────────────
# 这不是"默认值",是闸。agy 的 models 表里同时有 claude-sonnet-4-6 /
# claude-opus-4-6-thinking / gpt-oss-120b。这条腿在花名册里代表 **Google 家族**,
# 它跑成 Claude 就等于:归档闸数到"两个不同家族"、实际上两条腿都是 Claude。
# 闸查的是腿名,查不出模型 —— 所以只能在这里挡。
MODEL="${AGY_MODEL:-$DEFAULT_MODEL}"
case "$MODEL" in
  gemini-*) ;;
  *) die "AGY_MODEL='$MODEL' 不是 gemini-* ⇒ 拒跑。
  这条腿在 panel 花名册里代表 Google 模型家族;跑成 claude-*/gpt-* 会让
  归档闸的「覆盖 N 个不同模型家族」变成一句假话(那道闸查腿名,查不出模型)。
  要换档请在 gemini-* 里选,例如 gemini-3.6-flash-high / gemini-3.1-pro-high。" ;;
esac

review_home_guard subgemini "$REVIEW_HOME" "$SOURCE_REPO" AGY_REVIEW_HOME || exit 1

if [[ -n "${REVIEW_PRINT_HOME:-}" ]]; then printf '%s\n' "$REVIEW_HOME"; exit 0; fi

# ── 隔离 home:凭证用复制(不是链接)+ 关掉遥测 ────────────────────────────
AGY_HOME_DIR="$REVIEW_HOME/.gemini/antigravity-cli"
mkdir -p "$AGY_HOME_DIR"
[[ -f "$OWNER_TOKEN" ]] || die "找不到 agy 凭证($OWNER_TOKEN)⇒ 拒跑。
  业主需要跑一次 \`agy\` 完成 OAuth(会打印授权网址,要人在浏览器里点)。"
# 🔴 复制,不是 ln -s。链接会让腿写穿到业主的登录上,而掉登录只有他本人能修。
rm -f "$AGY_HOME_DIR/antigravity-oauth-token"
cp "$OWNER_TOKEN" "$AGY_HOME_DIR/antigravity-oauth-token"
chmod 600 "$AGY_HOME_DIR/antigravity-oauth-token"
# 🔴 遥测:业主在首次向导里亲手关掉了数据收集,但那条写在**他的** home。
# 换 HOME 之后评审 home 是全新的、没有 settings.json ⇒ 走默认值 ⇒ 他的选择被绕过,
# 而这条腿读的正是他的仓库代码。每次重写,不留隔夜残留。
# 写评审 home 的 settings。**分两次调用**:
#   第一次(无参)在预检之前 —— 预检只调 `agy models`,不需要文件权限;
#   第二次(带可丢弃副本的路径)在 workspace 准备之后 —— 那时才知道副本在哪。
# 三件事焊在这里:
#  ① enableTelemetry:false —— 业主在首次向导里亲手关掉了数据收集,但那写在**他的**
#     home;换 HOME 后评审 home 是全新的、连 settings.json 都没有 = 走默认值 =
#     他的选择被绕过,而这条腿读的正是他的仓库代码。
#  ② read_file/write_file **限定在那份可丢弃副本上**。2026-08-26 实测:
#     `--add-dir` 给的目录**不算 active workspace**(文档那句"workspace 内读写
#     自动允许"不覆盖它),每个新目录要 project 授权、headless 拿不到 ⇒
#     read_file 被 auto-deny ⇒ 腿交白卷而 agy 仍 rc=0。
#     `read_file(*)` 和 `read_file(/)` 也能解开,但那让腿读得到 ~/.ssh、业主凭证、
#     别的项目 —— **这条腿的全部安全前提就是"它只看得见那份副本"**,不许通配。
#  ③ 命令白名单**只留只读 git**。headless 下命令默认 Ask ⇒ 被 auto-deny ⇒ 同样交白卷,
#     所以非给不可;但**不许给 cat/ls/grep/find 这类通用文件命令** —— 它们绕过 ②
#     的副本限定,`command(cat)` 等于让腿读得到 ~/.ssh 和业主凭证。文件读取走内置
#     read_file 工具(受 ② 约束)。与 subglm 的 bash 白名单姿态一致。
#     ⚠️ **分组语法是死的**:实测 `command(git log)` 通过、`command(git (log|diff))`
#     被拒 —— 而官方文档的例子恰恰是分组写法。照文档写 = 规则静默失效 = 腿交白卷。
# 🔴 绝不用 --dangerously-skip-permissions:那会把网络与仓外写一并放开。
# 白名单不是这条腿的安全边界 —— 真正的边界是"可丢弃副本 + 原仓 ro-repo-exec 只读"。
# 它挡不住所有花招(`git diff --output=` 那类,08-19 已实证),但挡得住误伤,
# 并且让腿的能力边界是写下来的、可审的。
write_agy_settings() {   # write_agy_settings [可丢弃副本路径]
  local ws="${1:-}" scoped=""
  [[ -n "$ws" ]] && scoped="\"read_file($ws)\", \"write_file($ws)\", "
  cat > "$AGY_HOME_DIR/settings.json" <<EOF
{
  "enableTelemetry": false,
  "permissions": {
    "allow": [
      ${scoped}"command(git log)",
      "command(git diff)",
      "command(git status)",
      "command(git show)",
      "command(git ls-files)",
      "command(git rev-parse)",
      "command(git blame)"
    ]
  }
}
EOF
  chmod 600 "$AGY_HOME_DIR/settings.json"
}
write_agy_settings

AGY_BIN="${AGY_BIN:-$(command -v agy 2>/dev/null || echo "$HOME/.local/bin/agy")}"
[[ -x "$AGY_BIN" ]] || die "找不到可执行的 agy($AGY_BIN)"

# ── 预检:凭证活着吗 ────────────────────────────────────────────────────
# 存在的理由:未登录时 `agy -p` **一个字都不印、也不退出**(实测 40s)。
# 没有这一步,失效凭证的表现是"腿像在跑,然后超时",和额度耗尽长得一模一样。
PRE="$(env HOME="$REVIEW_HOME" timeout 90 "$AGY_BIN" models </dev/null 2>&1 || true)"
grep -q '^gemini-' <<<"$PRE" \
  || die "agy 凭证预检失败 ⇒ 拒绝派发(不进入静默挂死)。agy 说:
$(printf '%s' "$PRE" | head -3)
  业主需要重新跑一次 \`agy\` 走 OAuth。"

# ── 可丢弃副本 + 原仓只读 ──────────────────────────────────────────────
_RW="$BIN_DIR/_review-workspace.sh"
[ -f "$_RW" ] || die '找不到 _review-workspace.sh ⇒ 拒绝派发(fail-closed)'
# shellcheck source=_review-workspace.sh
. "$_RW"
review_workspace_prepare "$SOURCE_REPO" subgemini || die 'review workspace 准备失败 ⇒ 模型未启动'
REVIEW_WORKSPACE_ACTIVE=1
SOURCE_REPO="$REVIEW_SOURCE_REPO"
REPO_DIR="$(review_workspace_repo)" || exit 78

# 副本路径现在才知道 —— 重写 settings,把 read_file/write_file 授权**限定到它身上**。
write_agy_settings "$REPO_DIR"

_subgemini_cleanup() {
  local rc=$?
  if [[ "${REVIEW_WORKSPACE_ACTIVE:-0}" -eq 1 ]]; then
    review_workspace_cleanup \
      || echo "subgemini: 警告:review workspace 清理失败:${REVIEW_WORKSPACE_DIR:-?}" >&2
  fi
  trap - EXIT
  exit "$rc"
}
trap _subgemini_cleanup EXIT

case "$LOG_FILE" in /*) ;; *) LOG_FILE="$PWD/$LOG_FILE" ;; esac
mkdir -p "$(dirname "$LOG_FILE")"

TASK_TEXT="$(cat "$TASK_FILE" 2>/dev/null || true)"
PROMPT="You are a code reviewer. Read the repository yourself; do not assume a diff was pasted.

$TASK_TEXT

Write the verdict line AS SOON AS you have enough to judge, then keep explaining.
The verdict line must be exactly this form:
Conclusion: PASS | BLOCK | NEEDS_MORE_INFO"

{
  echo "=== subgemini review ==="
  echo "model:    $MODEL"
  echo "repo:     $REPO_DIR (disposable clone; source stays read-only)"
  echo "home:     $REVIEW_HOME"
  echo "started:  $(date -Is)"
  echo "========================"
} > "$LOG_FILE"

set +e
( cd "$REPO_DIR" && env HOME="$REVIEW_HOME" timeout "$TIMEOUT_SECONDS" \
    "$AGY_BIN" -p "$PROMPT" --model "$MODEL" --add-dir "$REPO_DIR" \
    --output-format text </dev/null ) >> "$LOG_FILE" 2>&1
RC=$?
set -e

# 🔴 裁决判定**复用花名册的唯一源** `verdict_of`,不在这里另写一条正则。
# 理由:花名册那条是**严格**的(裁决必须独立成行) —— 因为提示词里就原样含有
# "Conclusion: PASS | BLOCK | NEEDS_MORE_INFO",宽松匹配会把"没交卷"记成 PASS。
# 腿自己用宽松正则、花名册用严格正则 = 腿自认成功而花名册记 UNKNOWN,
# 「同一个事实存两处、只更新其中一个」正是本机反复记账的老毛病。
_RL="$BIN_DIR/_panel-roster-lib.sh"
[ -f "$_RL" ] || die '找不到 _panel-roster-lib.sh ⇒ 拒绝派发(fail-closed:裁决判定没有唯一源)'
# shellcheck source=_panel-roster-lib.sh
. "$_RL"
HAS_VERDICT=0
[[ "$(verdict_of "$LOG_FILE")" != "UNKNOWN" ]] && HAS_VERDICT=1

# 超时但裁决已经落盘 = 完整的评审,不是丢失的
if [[ $RC -eq 124 ]]; then
  [[ $HAS_VERDICT -eq 1 ]] || die "agy timed out after ${TIMEOUT_SECONDS}s with no verdict (log: $LOG_FILE)"
  echo "subgemini: timed out after ${TIMEOUT_SECONDS}s, but a verdict was already written — accepting." >&2
  exit 0
fi

# 🔴 这两行的顺序是有意的:**先看裁决行,再看 rc**。
# agy 未登录/软拒绝都会 rc=0,rc 在这条腿上不是死活的证据。
[[ $HAS_VERDICT -eq 1 ]] \
  || die "model returned no verdict (expected 'Conclusion: PASS|BLOCK|NEEDS_MORE_INFO'; rc=$RC; log: $LOG_FILE)"
[[ $RC -eq 0 ]] || die "agy exited rc=$RC (log: $LOG_FILE)"
exit 0
