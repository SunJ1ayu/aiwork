#!/bin/sh
"""exec" "$(/usr/bin/dirname "$(/bin/realpath "$0")")/_python" "$0" "$@"
Read machine settings and locate machine data through the aiwork entries."""
import argparse
import json
import sys

from _aiwork_config import (
    ConfigError, RUNTIME_OPTIONS, program, check_programs, app_key, apps_dir, data_path,
    model, model_family, prune_data, runtime_value, setting_path, setting_value,
)


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[1])
    commands = parser.add_subparsers(dest='command', required=True)
    programs = commands.add_parser('program')
    programs.add_argument('name')
    checks = commands.add_parser('check-programs')
    checks.add_argument('entry')
    models = commands.add_parser('model')
    models.add_argument('leg')
    models.add_argument('override', nargs='?')
    defaults = '\n'.join(
        f'{adapter} {option}: {variable}; direct={direct}, reader={reader or direct}'
        for adapter, settings in RUNTIME_OPTIONS.items()
        for option, (variable, direct, reader) in settings.items())
    runtime = commands.add_parser('runtime', formatter_class=argparse.RawDescriptionHelpFormatter,
                                  description='Environment > optional runtime.env > code fallback. '
                                              'Empty environment overrides are ignored.',
                                  epilog='Code fallbacks (seconds / turns / effort):\n' + defaults)
    runtime.add_argument('adapter', choices=tuple(RUNTIME_OPTIONS))
    runtime.add_argument('option', choices=tuple(dict.fromkeys(
        option for settings in RUNTIME_OPTIONS.values() for option in settings)))
    runtime.add_argument('--context', choices=('direct', 'reader'), default='direct')
    names = ('models.env', 'runtime.env', 'deepseek.env', 'mimo.env', 'apps', 'private-terms')
    paths = commands.add_parser('path')
    paths.add_argument('name', choices=names)
    values = commands.add_parser('value')
    values.add_argument('name', choices=names)
    values.add_argument('variable')
    data = commands.add_parser('data-path')
    data.add_argument('name', nargs='?', default='')
    prune = commands.add_parser('prune-data', help='prune data using the registry retention policy')
    prune.add_argument('--dry-run', action='store_true', help='list expired paths, logical bytes and last modification times')
    keys = commands.add_parser('app-key')
    keys.add_argument('configured')
    families = commands.add_parser('family')
    families.add_argument('adapter')
    families.add_argument('model')
    args = parser.parse_args()
    try:
        if args.command == 'program':
            value = program(args.name)
        elif args.command == 'check-programs':
            check_programs(args.entry)
            return 0
        elif args.command == 'model':
            value = model(args.leg, args.override)
        elif args.command == 'runtime':
            value = runtime_value(args.adapter, args.option, context=args.context)
        elif args.command == 'data-path':
            value = data_path(args.name)
        elif args.command == 'prune-data':
            value = prune_data(dry_run=args.dry_run)
        elif args.command == 'app-key':
            value = app_key(args.configured)
        elif args.command == 'family':
            value = model_family(args.adapter, args.model)
        elif args.command == 'value':
            value = setting_value(args.name, args.variable)
        else:
            value = apps_dir() if args.name == 'apps' else setting_path(args.name)
    except ConfigError as exc:
        print(f'aiwork-config: {exc}', file=sys.stderr)
        return 2
    print(json.dumps(value, ensure_ascii=True, indent=2) if args.command == 'prune-data' else value)
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
