#!/bin/bash
# Claude Code 模型切换脚本
# 用法: bash ~/.claude/switch-model.sh [mimo|claude]

SETTINGS=~/.claude/settings.json

case "$1" in
  mimo)
    # key 不再内嵌(2026-09-01,track mimo-key-single-source):从全机唯一源头读。
    # 源头 = /root/.local/share/mimocode/auth.json,清单见 aiwork/bin/_mimo-key-locations.sh。
    # 读不到就**不写 settings**:写出一份认证注定失败的配置,比不写更难查。
    MIMO_KEY="$(grep -oE 'tp-[a-z0-9]{40,60}' /root/.local/share/mimocode/auth.json 2>/dev/null | head -1)"
    if [ -z "$MIMO_KEY" ]; then
      echo "❌ 读不到 mimo key(源头 /root/.local/share/mimocode/auth.json)—— 没有改动任何文件" >&2
      exit 1
    fi
    cat > "$SETTINGS" << 'EOF'
{
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "ANTHROPIC_BASE_URL": "https://token-plan-cn.xiaomimimo.com/anthropic",
    "ANTHROPIC_AUTH_TOKEN": "__MIMO_KEY__"
  },
  "model": "mimo-v2.5-pro",
  "statusLine": {
    "type": "command",
    "command": "bash -c 'export COLUMNS=120; exec /root/.nvm/versions/node/v22.23.1/bin/node /root/.claude/plugins/cache/claude-hud/claude-hud/0.1.0/dist/index.js'"
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  }
}
EOF
    # 占位符换成真 key(heredoc 是引号版、刻意不做变量展开,免得 JSON 里别的 $ 被吃掉)
    sed -i "s|__MIMO_KEY__|$MIMO_KEY|" "$SETTINGS"
    # 同步更新 bashrc
    sed -i '/ANTHROPIC_BASE_URL/d; /ANTHROPIC_AUTH_TOKEN/d; /ANTHROPIC_API_KEY/d' ~/.bashrc
    echo 'export ANTHROPIC_BASE_URL="https://token-plan-cn.xiaomimimo.com/anthropic"' >> ~/.bashrc
    echo 'export ANTHROPIC_AUTH_TOKEN="$(grep -oE '"'"'tp-[a-z0-9]{40,60}'"'"' /root/.local/share/mimocode/auth.json 2>/dev/null | head -1)"' >> ~/.bashrc
    echo "✅ 已切换到小米 Mimo V2.5 Pro (1M上下文)"
    ;;
  claude)
    cat > "$SETTINGS" << 'EOF'
{
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash -c 'export COLUMNS=120; exec /root/.nvm/versions/node/v22.23.1/bin/node /root/.claude/plugins/cache/claude-hud/claude-hud/0.1.0/dist/index.js'"
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  }
}
EOF
    # 清理 bashrc 里的 Mimo 配置
    sed -i '/ANTHROPIC_BASE_URL/d; /ANTHROPIC_AUTH_TOKEN/d; /ANTHROPIC_API_KEY/d' ~/.bashrc
    echo "✅ 已切换回 Claude Opus (官方模型)"
    ;;
  *)
    echo "用法: bash ~/.claude/switch-model.sh [mimo|claude]"
    echo "  mimo   - 切换到小米 Mimo V2.5 Pro (1M上下文)"
    echo "  claude - 切换回官方 Claude Opus"
    ;;
esac
