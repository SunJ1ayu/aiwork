#!/usr/bin/env bash
# gh-app-token <角色> [--grant]
#   用这个角色的 GitHub App 私钥换一个 1 小时有效的 installation token,标准输出只打印 token 本身。
#   --grant:不打印 token,只打印 GitHub 实际给的权限、仓库和到期时间(验收用)。
#
# 三层:App = 角色和权限(GitHub 上建);本脚本 = 适配器(拿私钥换短期令牌);模型 = 谁来用这个令牌。
# 换模型不碰这里;换 App 或收窄权限只改角色配置 /etc/aiwork/apps/<角色>.env:
#   APP_ID=5116249
#   INSTALLATION_ID=165993669
#   KEY=/etc/aiwork/apps/aiwork-review.pem
#   REPOS="OpenDesign"                                         # 令牌只对这些仓库有效(空格分隔)
#   PERMISSIONS='{"contents":"read","pull_requests":"write"}'  # 令牌只带这些权限;App 以后多给了也不会带上
#
# 用法:GH_TOKEN="$(gh-app-token review)" gh pr review …   (GH_TOKEN 优先于 gh 里登录的账号)
# 私钥和 token 都不许打印、不许写进日志或仓库;JWT 与 token 都不出现在命令行参数里(ps 看不到)。
set -euo pipefail

role=${1:?用法: gh-app-token <角色> [--grant]}
mode=${2:-token}
case $mode in token|--grant) ;; *) echo "gh-app-token: 不认识的参数 $mode" >&2; exit 2 ;; esac
conf=${AIWORK_APPS_DIR:-/etc/aiwork/apps}/$role.env
[ -r "$conf" ] || { echo "gh-app-token: 读不到角色配置 $conf" >&2; exit 2; }
APP_ID= INSTALLATION_ID= KEY= REPOS= PERMISSIONS=
# shellcheck disable=SC1090
. "$conf"
for v in APP_ID INSTALLATION_ID KEY REPOS PERMISSIONS; do
  [ -n "${!v}" ] || { echo "gh-app-token: $conf 里缺 $v" >&2; exit 2; }
done
[ -r "$KEY" ] || { echo "gh-app-token: 读不到私钥 $KEY" >&2; exit 2; }

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
now=$(date +%s)
head=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
claims=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$APP_ID" | b64url)
sig=$(printf '%s.%s' "$head" "$claims" | openssl dgst -sha256 -sign "$KEY" -binary | b64url)
jwt="$head.$claims.$sig"

body=$(jq -cn --arg r "$REPOS" --argjson p "$PERMISSIONS" \
  '{repositories: ($r | split(" ") | map(select(. != ""))), permissions: $p}')
out=$(curl -sS -X POST -w '\n%{http_code}' \
  -H @<(printf 'Authorization: Bearer %s\n' "$jwt") \
  -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' \
  --data-binary @<(printf '%s' "$body") \
  "https://api.github.com/app/installations/$INSTALLATION_ID/access_tokens")
code=${out##*$'\n'}
resp=${out%$'\n'*}
if [ "$code" != 201 ]; then
  echo "gh-app-token: 换令牌失败 HTTP $code:$(jq -r '.message // empty' <<<"$resp" 2>/dev/null)" >&2
  exit 1
fi

# GitHub 给的必须恰好是要的那些(外加它总会带上的 metadata:read)和那几个仓库,多一样少一样都不用
if ! jq -e --argjson want "$PERMISSIONS" --arg r "$REPOS" '
    (.permissions | del(.metadata)) == $want
    and ([.repositories[]?.name] | sort) == ($r | split(" ") | map(select(. != "")) | sort)' <<<"$resp" >/dev/null; then
  echo "gh-app-token: GitHub 给的权限或仓库和 $conf 不一致,不用这个令牌" >&2
  jq '{permissions, repositories: [.repositories[]?.full_name]}' <<<"$resp" >&2
  exit 1
fi

if [ "$mode" = --grant ]; then
  jq '{permissions, repositories: [.repositories[].full_name], expires_at}' <<<"$resp"
else
  jq -r .token <<<"$resp"
fi
