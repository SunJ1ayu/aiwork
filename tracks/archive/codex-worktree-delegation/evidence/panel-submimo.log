+# ── 判卷面内容摘要 ──────────────────────────────────────────────────────
+# 打印「<条目数> <哈希>」。规格写在 design「十·10.1」,判据侧**另有一份独立实现**
+# (tests/_oracle_hash.sh 走 find + sha256sum),两边不共享一行代码 ——
+# 算法两边一起错的话判据会全绿,那是本机 08-01 栽过的形状。
+_oracle_digest() {  # _oracle_digest <repo> <protect...>
+  python3 - "$@" <<'PY'
+import hashlib, os, sys
+repo, *protect = sys.argv[1:]
+entries = {}
+
+def note(rel, full):
+    if "__pycache__" in rel.split("/"):
+        return
+    if os.path.islink(full):                      # 链接目标也是考卷的一部分:
+        entries[rel] = b"symlink:" + os.readlink(full).encode("utf-8", "surrogateescape")
+    elif os.path.isfile(full):                    # 改指向 = 换了判据,必须让哈希变
+        h = hashlib.sha256()
+        with open(full, "rb") as f:
+            for chunk in iter(lambda: f.read(1 << 20), b""):
+                h.update(chunk)
+        entries[rel] = h.hexdigest().encode()
+
+def walk(rel, full):
+    if os.path.islink(full) or os.path.isfile(full):
+        note(rel, full)
+    elif os.path.isdir(full):
+        if os.path.basename(rel) == "__pycache__":
+            return
+        for name in sorted(os.listdir(full)):
+            walk(f"{rel}/{name}" if rel else name, os.path.join(full, name))
+
+for p in protect:
+    p = p.strip("/")
+    walk(p, os.path.join(repo, p))
+
+h = hashlib.sha256()
+for rel in sorted(entries):
+    h.update(rel.encode("utf-8", "surrogateescape") + b"\0" + entries[rel] + b"\n")
+print(len(entries), h.hexdigest())
+PY
+}
