import hashlib, os, sys
repo = '.'
protect = ['link_to_dir']
entries = {}
def note(rel, full):
    if '__pycache__' in rel.split('/'): return
    if os.path.islink(full):
        entries[rel] = b'symlink:' + os.readlink(full).encode('utf-8', 'surrogateescape')
    elif os.path.isfile(full):
        h = hashlib.sha256()
        with open(full, 'rb') as f:
            for chunk in iter(lambda: f.read(1<<20), b''):
                h.update(chunk)
        entries[rel] = h.hexdigest().encode()
def walk(rel, full):
    if os.path.islink(full) or os.path.isfile(full):
        note(rel, full)
    elif os.path.isdir(full):
        if os.path.basename(rel) == '__pycache__': return
        for name in sorted(os.listdir(full)):
            walk(f'{rel}/{name}' if rel else name, os.path.join(full, name))
for p in protect:
    p = p.strip('/')
    walk(p, os.path.join(repo, p))
h = hashlib.sha256()
for rel in sorted(entries):
    h.update(rel.encode('utf-8','surrogateescape') + b'\0' + entries[rel] + b'\n')
print('Python entries:', entries)
print('Python hash:', h.hexdigest())
"
